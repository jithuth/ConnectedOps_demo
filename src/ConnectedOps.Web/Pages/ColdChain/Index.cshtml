@page
@using ConnectedOps.Domain.ColdChain
@model ConnectedOps.Web.Pages.ColdChain.IndexModel
@{
    ViewData["Title"] = "Cold Chain & Cargo Environmental Monitoring";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="m-0 fs-3 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-thermometer-snow text-info"></i> Cold Chain &amp; Cargo Monitoring
                </h1>
                <p class="text-muted small mb-0">
                    Real-time BLE wireless sensor telemetry, reefer compartment temperature/humidity tracking &amp; HACCP excursion incidents
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newTelemetryModal">
                    <i class="bi bi-broadcast-pin"></i> Push Sensor Telemetry
                </button>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#registerSensorModal">
                    <i class="bi bi-plus-circle"></i> Register IoT Sensor
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@Model.SuccessMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@Model.ErrorMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- METRIC KPI CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Active Cargo Sensors</span>
                                <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.Dashboard.TotalActiveSensors</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-cpu fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Wireless BLE probe units online
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Within Target Tolerance</span>
                                <h3 class="fw-bold mb-0 mt-1 text-success">@Model.Dashboard.CompartmentsInToleranceCount / @Model.Dashboard.TotalActiveSensors</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                                <i class="bi bi-shield-check fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Complying with HACCP temperature window
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Active Excursions</span>
                                <h3 class="fw-bold mb-0 mt-1 @(Model.Dashboard.ActiveExcursionsCount > 0 ? "text-danger" : "text-success")">
                                    @Model.Dashboard.ActiveExcursionsCount
                                </h3>
                            </div>
                            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-thermometer-high fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Unresolved temperature breaches in transit
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Critical / HACCP Breaches</span>
                                <h3 class="fw-bold mb-0 mt-1 @(Model.Dashboard.CriticalExcursionsCount > 0 ? "text-danger" : "text-success")">
                                    @Model.Dashboard.CriticalExcursionsCount
                                </h3>
                            </div>
                            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-radioactive fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Spoilage risk requires cargo inspection
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN TABS -->
        <ul class="nav nav-pills mb-3" id="coldChainTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="sensors-tab" data-bs-toggle="tab" data-bs-target="#sensorsTabPane" type="button" role="tab">
                    <i class="bi bi-grid-fill me-1"></i> Reefer Compartments &amp; Sensors (@(Model.Sensors?.TotalCount ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="excursions-tab" data-bs-toggle="tab" data-bs-target="#excursionsTabPane" type="button" role="tab">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> HACCP Excursions Audit Log (@(Model.Excursions?.TotalCount ?? 0))
                </button>
            </li>
        </ul>

        <div class="tab-content" id="coldChainTabsContent">
            <!-- TAB 1: SENSORS & REEFER GAUGES -->
            <div class="tab-pane fade show active" id="sensorsTabPane" role="tabpanel">
                @if (Model.Sensors == null || !Model.Sensors.Items.Any())
                {
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-snow text-muted display-4 mb-3"></i>
                            <h5 class="fw-bold text-dark">No Cargo Sensors Configured</h5>
                            <p class="text-muted small">Register BLE temperature sensors to start tracking chilled and frozen refrigerated compartments.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var sensor in Model.Sensors.Items)
                        {
                            var hasTemp = sensor.CurrentTemperatureCelsius.HasValue;
                            var inRange = hasTemp &&
                                          sensor.CurrentTemperatureCelsius!.Value >= sensor.MinTargetTemperatureCelsius &&
                                          sensor.CurrentTemperatureCelsius!.Value <= sensor.MaxTargetTemperatureCelsius;

                            <div class="col-xl-4 col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                                    <div class="card-body p-4">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div>
                                                <span class="badge bg-light text-dark border font-monospace me-1">@sensor.SensorTagNumber</span>
                                                <span class="badge @(sensor.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary")">
                                                    @(sensor.IsActive ? "Active" : "Disabled")
                                                </span>
                                            </div>
                                            <div class="d-flex align-items-center gap-1 text-muted small">
                                                <i class="bi bi-battery-charging text-success"></i> @sensor.BatteryLevelPercent%
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-3 my-3">
                                            <div class="rounded-circle p-3 @(inRange ? "bg-success bg-opacity-10 text-success" : (hasTemp ? "bg-danger bg-opacity-10 text-danger" : "bg-light text-muted"))">
                                                <i class="bi bi-thermometer-half fs-1"></i>
                                            </div>
                                            <div>
                                                <div class="display-6 fw-bold @(inRange ? "text-success" : (hasTemp ? "text-danger" : "text-muted"))">
                                                    @(hasTemp ? $"{sensor.CurrentTemperatureCelsius:F1}°C" : "--")
                                                </div>
                                                <div class="small fw-semibold text-muted">
                                                    Target: @sensor.MinTargetTemperatureCelsius°C to @sensor.MaxTargetTemperatureCelsius°C
                                                </div>
                                            </div>
                                        </div>

                                        <div class="bg-light p-3 rounded-2 mb-3">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span class="text-muted">Vehicle:</span>
                                                <span class="fw-semibold text-dark"><i class="bi bi-truck me-1"></i> @sensor.VehiclePlateNumber</span>
                                            </div>
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span class="text-muted">Compartment:</span>
                                                <span class="fw-semibold text-dark">@sensor.CompartmentName</span>
                                            </div>
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span class="text-muted">Cargo Door:</span>
                                                <span class="fw-semibold @(sensor.CurrentDoorOpen ? "text-danger" : "text-success")">
                                                    @(sensor.CurrentDoorOpen ? "OPEN (Alert)" : "Closed (Secure)")
                                                </span>
                                            </div>
                                            @if (sensor.CurrentHumidityPercent.HasValue)
                                            {
                                                <div class="d-flex justify-content-between small">
                                                    <span class="text-muted">Humidity:</span>
                                                    <span class="fw-semibold text-dark">@sensor.CurrentHumidityPercent.Value.ToString("F0")% RH</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center text-muted small">
                                            <span><i class="bi bi-clock me-1"></i> @sensor.LastReadingAtUtc.ToString("HH:mm:ss") UTC</span>
                                            <span class="badge @(inRange ? "bg-success" : "bg-danger")">
                                                @(inRange ? "In Tolerance" : "TEMPERATURE EXCURSION")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- TAB 2: EXCURSIONS AUDIT LOG -->
            <div class="tab-pane fade" id="excursionsTabPane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        @if (Model.Excursions == null || !Model.Excursions.Items.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-check2-all text-success display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">No Temperature Excursions Recorded</h5>
                                <p class="text-muted small">All refrigerated compartments have maintained continuous cold chain compliance.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Severity</th>
                                            <th>Sensor / Tag</th>
                                            <th>Vehicle &amp; Compartment</th>
                                            <th>Breach Temp</th>
                                            <th>Allowed Range</th>
                                            <th>Started At</th>
                                            <th>Duration</th>
                                            <th>Status</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var exc in Model.Excursions.Items)
                                        {
                                            <tr>
                                                <td>
                                                    @if (exc.Severity == ExcursionSeverity.HaccpBreach)
                                                    {
                                                        <span class="badge bg-dark text-white"><i class="bi bi-radioactive me-1"></i> HACCP BREACH</span>
                                                    }
                                                    else if (exc.Severity == ExcursionSeverity.Critical)
                                                    {
                                                        <span class="badge bg-danger"><i class="bi bi-exclamation-octagon me-1"></i> Critical</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Warning</span>
                                                    }
                                                </td>
                                                <td><span class="badge bg-light text-dark border font-monospace">@exc.SensorTagNumber</span></td>
                                                <td>
                                                    <div class="fw-bold text-dark">@exc.VehiclePlateNumber</div>
                                                    <div class="text-muted small">@exc.CompartmentName</div>
                                                </td>
                                                <td>
                                                    <span class="fw-bold text-danger fs-6">@exc.BreachTemperatureCelsius.ToString("F1")°C</span>
                                                </td>
                                                <td>
                                                    <span class="text-muted small">@exc.AllowableMinCelsius°C to @exc.AllowableMaxCelsius°C</span>
                                                </td>
                                                <td>
                                                    <span class="text-muted small">@exc.StartedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                                                </td>
                                                <td>
                                                    <span class="small">@(exc.DurationMinutes.HasValue ? $"{exc.DurationMinutes.Value} mins" : "Ongoing")</span>
                                                </td>
                                                <td>
                                                    @if (exc.Status == ExcursionStatus.Active)
                                                    {
                                                        <span class="badge bg-danger">ACTIVE BREACH</span>
                                                    }
                                                    else if (exc.Status == ExcursionStatus.Resolved)
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-check me-1"></i> Resolved</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@exc.StatusName</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-3">
                                                    @if (exc.Status == ExcursionStatus.Active || exc.Status == ExcursionStatus.Acknowledged)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#resolveExcModal-@exc.Id">
                                                            <i class="bi bi-check-circle"></i> Resolve
                                                        </button>
                                                    }
                                                    else if (!string.IsNullOrEmpty(exc.ActionTaken))
                                                    {
                                                        <span class="text-muted small" title="@exc.ActionTaken">
                                                            @exc.ActionTaken
                                                        </span>
                                                    }

                                                    <!-- RESOLVE EXCURSION MODAL -->
                                                    <div class="modal fade" id="resolveExcModal-@exc.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered text-start">
                                                            <div class="modal-content">
                                                                <form method="post" asp-page-handler="ResolveExcursion">
                                                                    <input type="hidden" name="excursionId" value="@exc.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Sign-Off &amp; Resolve Temperature Excursion</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p class="mb-2"><strong>Breach Temperature:</strong> <span class="text-danger fw-bold">@exc.BreachTemperatureCelsius.ToString("F1")°C</span> (Vehicle: @exc.VehiclePlateNumber)</p>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Action Taken / Corrective Verification</label>
                                                                            <textarea class="form-control" name="actionTaken" rows="3" placeholder="Reefer unit defrosted and restarted, cargo inspected with thermal probe OK..." required></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-success">Mark Resolved</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- REGISTER SENSOR MODAL -->
<div class="modal fade" id="registerSensorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="RegisterSensor">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Register Wireless Cargo BLE Sensor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Sensor Tag #</label>
                            <input type="text" class="form-control" name="sensorTagNumber" placeholder="e.g. CC-PROBE-01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Compartment</label>
                            <input type="text" class="form-control" name="compartmentName" value="Frozen Compartment A" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reefer Vehicle</label>
                        <select class="form-select" name="vehicleId" required>
                            <option value="">Select vehicle...</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id">@(v.RegistrationNumber ?? v.VehicleNumber) - @v.MakeName @v.ModelName</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Min Target Temp (°C)</label>
                            <input type="number" step="0.5" class="form-control" name="minTargetTemperatureCelsius" value="-22.0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Max Target Temp (°C)</label>
                            <input type="number" step="0.5" class="form-control" name="maxTargetTemperatureCelsius" value="-18.0" required />
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Battery (%)</label>
                            <input type="number" class="form-control" name="batteryLevelPercent" value="100" min="0" max="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">BLE MAC Address</label>
                            <input type="text" class="form-control" name="macAddress" placeholder="e.g. AA:BB:CC:11:22:33" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Register Sensor</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- PUSH TELEMETRY MODAL -->
<div class="modal fade" id="newTelemetryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="RecordTelemetry">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Push Cargo Telemetry Reading</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sensor Device</label>
                        <select class="form-select" name="cargoSensorDeviceId" required>
                            <option value="">Select sensor...</option>
                            @if (Model.Sensors != null)
                            {
                                @foreach (var s in Model.Sensors.Items)
                                {
                                    <option value="@s.Id">@s.SensorTagNumber - @s.VehiclePlateNumber (@s.CompartmentName)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Current Temperature (°C)</label>
                            <input type="number" step="0.1" class="form-control" name="temperatureCelsius" value="-19.5" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Humidity (% RH)</label>
                            <input type="number" step="1" class="form-control" name="humidityPercent" value="65" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Reefer Operating Mode</label>
                            <select class="form-select" name="reeferMode" required>
                                <option value="2">Cooling</option>
                                <option value="3">Freezing</option>
                                <option value="4">Defrost</option>
                                <option value="5">Standby</option>
                                <option value="1">Off</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Setpoint (°C)</label>
                            <input type="number" step="0.5" class="form-control" name="setpointTemperatureCelsius" value="-20.0" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="doorOpen" id="doorOpen" value="true" />
                        <label class="form-check-label small fw-semibold text-danger" for="doorOpen">
                            Cargo Door Currently Open
                        </label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reading Timestamp (UTC)</label>
                        <input type="datetime-local" class="form-control" name="recordedAtUtc" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white">Record Reading</button>
                </div>
            </form>
        </div>
    </div>
</div>
