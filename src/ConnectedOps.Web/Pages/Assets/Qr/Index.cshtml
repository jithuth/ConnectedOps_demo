@page
@model ConnectedOps.Web.Pages.Assets.Qr.IndexModel
@{
    ViewData["Title"] = "Asset QR Scanner & Tag Labels";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-qr-code-scan text-primary me-2"></i>QR Scanner &amp; Tag Center</h1>
                <p class="text-muted small mb-0">Scan asset tags, verify authenticity, and generate batch equipment labels.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Tag Sheet
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="row g-3">
            <!-- TOKEN SCANNER CARD -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-white border-bottom p-3">
                        <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-upc-scan me-2"></i>Token / Barcode Scanner</h6>
                    </div>
                    <div class="card-body p-3">
                        <form method="get" class="mb-3">
                            <label class="form-label small fw-semibold">Scan or Paste Public Token / Barcode</label>
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" name="token" class="form-control font-monospace" placeholder="Scan or enter token..." value="@Model.ScannedToken" autofocus>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search me-1"></i> Verify
                                </button>
                            </div>
                            <small class="text-muted">Compatible with Bluetooth 2D barcode scanners and optical camera inputs.</small>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger p-2 small">
                                <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
                            </div>
                        }

                        @if (Model.ScanResult != null)
                        {
                            <div class="border rounded-2 p-3 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold text-primary mb-0">@Model.ScanResult.Name</h6>
                                    <span class="badge bg-success">@Model.ScanResult.Status</span>
                                </div>
                                <div class="small mb-1"><strong>Asset #:</strong> @Model.ScanResult.AssetNumber</div>
                                <div class="small mb-1"><strong>Condition:</strong> @Model.ScanResult.Condition</div>
                                <div class="small mb-2"><strong>Custodian:</strong> @(Model.ScanResult.CurrentCustodianEmployeeName ?? "In Inventory")</div>
                                <a href="/Assets/Details?id=@Model.ScanResult.AssetId" class="btn btn-sm btn-primary w-100">
                                    Open Asset Record &rarr;
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- PRINTABLE LABELS GRID -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-grid-3x3-gap me-2"></i>Printable Equipment Labels (Batch)</h6>
                        <span class="badge bg-secondary-subtle text-secondary">@Model.Assets.Count Assets Ready</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2">
                            @foreach (var asset in Model.Assets.Take(12))
                            {
                                <div class="col-6 col-md-4">
                                    <div class="border rounded-2 p-2 text-center bg-white shadow-sm h-100">
                                        <div class="fw-bold small text-truncate" title="@asset.Name">@asset.Name</div>
                                        <div class="small text-primary font-monospace fw-bold">@asset.AssetNumber</div>
                                        <div class="my-2">
                                            <img src="/api/assets/@asset.Id/qr-code" alt="QR" style="width: 80px; height: 80px;" />
                                        </div>
                                        <div class="badge bg-light text-muted border" style="font-size: 0.65rem;">@(asset.CategoryName ?? "Asset")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
