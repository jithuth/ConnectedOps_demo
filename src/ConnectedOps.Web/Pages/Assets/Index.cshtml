@page
@model ConnectedOps.Web.Pages.Assets.IndexModel
@{
    ViewData["Title"] = "Asset Directory";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-tools text-primary me-2"></i>Operational Assets &amp; Equipment</h1>
                <p class="text-muted small mb-0">Master catalog of tools, machinery, instruments, IT equipment, and attachments.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Assets/Dashboard" class="btn btn-outline-secondary btn-sm me-1">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
                <a href="/Assets/Qr" class="btn btn-outline-info btn-sm me-1">
                    <i class="bi bi-qr-code me-1"></i> QR Hub
                </a>
                <a href="/Assets/Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Register New Asset
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- FILTER CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Search Assets</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="Asset #, name, serial, barcode..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Category</label>
                        <select name="CategoryId" class="form-select form-select-sm">
                            <option value="">All Categories</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                        <select name="Status" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            <option value="Available" selected="@(Model.Status?.ToString() == "Available")">Available</option>
                            <option value="InUse" selected="@(Model.Status?.ToString() == "InUse")">In Use</option>
                            <option value="UnderMaintenance" selected="@(Model.Status?.ToString() == "UnderMaintenance")">Under Maintenance</option>
                            <option value="InTransit" selected="@(Model.Status?.ToString() == "InTransit")">In Transit</option>
                            <option value="Disposed" selected="@(Model.Status?.ToString() == "Disposed")">Disposed</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Condition</label>
                        <select name="Condition" class="form-select form-select-sm">
                            <option value="">All Conditions</option>
                            <option value="Excellent" selected="@(Model.Condition?.ToString() == "Excellent")">Excellent</option>
                            <option value="Good" selected="@(Model.Condition?.ToString() == "Good")">Good</option>
                            <option value="Fair" selected="@(Model.Condition?.ToString() == "Fair")">Fair</option>
                            <option value="Poor" selected="@(Model.Condition?.ToString() == "Poor")">Poor</option>
                            <option value="Damaged" selected="@(Model.Condition?.ToString() == "Damaged")">Damaged</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a href="/Assets" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- ASSETS TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Assets.Items.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-boxes text-muted fs-1 d-block mb-3"></i>
                        <h5 class="fw-semibold text-muted">No Assets Found</h5>
                        <p class="text-muted small">Try adjusting your filters or register a new piece of equipment.</p>
                        <a href="/Assets/Create" class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-plus-circle me-1"></i> Register Asset
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Asset # &amp; Name</th>
                                    <th>Category &amp; Type</th>
                                    <th>Custody / Location</th>
                                    <th>Status</th>
                                    <th>Condition</th>
                                    <th>Usage Hours</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in Model.Assets.Items)
                                {
                                    var statusBadge = asset.Status switch
                                    {
                                        ConnectedOps.Domain.Assets.AssetStatus.Available => "bg-success-subtle text-success border border-success-subtle",
                                        ConnectedOps.Domain.Assets.AssetStatus.InUse => "bg-primary-subtle text-primary border border-primary-subtle",
                                        ConnectedOps.Domain.Assets.AssetStatus.UnderMaintenance => "bg-warning-subtle text-warning border border-warning-subtle",
                                        ConnectedOps.Domain.Assets.AssetStatus.Disposed => "bg-dark-subtle text-dark border border-dark-subtle",
                                        _ => "bg-secondary-subtle text-secondary"
                                    };

                                    var conditionBadge = asset.Condition switch
                                    {
                                        ConnectedOps.Domain.Assets.AssetCondition.Excellent => "badge bg-success",
                                        ConnectedOps.Domain.Assets.AssetCondition.Good => "badge bg-info",
                                        ConnectedOps.Domain.Assets.AssetCondition.Fair => "badge bg-warning text-dark",
                                        ConnectedOps.Domain.Assets.AssetCondition.NeedsAttention => "badge bg-danger",
                                        ConnectedOps.Domain.Assets.AssetCondition.Damaged => "badge bg-dark",
                                        _ => "badge bg-secondary"
                                    };

                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-light border p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                                    <i class="bi bi-tools text-primary"></i>
                                                </div>
                                                <div>
                                                    <a href="/Assets/Details?id=@asset.Id" class="fw-bold text-decoration-none text-body">@asset.Name</a>
                                                    <div class="small text-muted">
                                                        <span class="fw-semibold text-primary">@asset.AssetNumber</span>
                                                        @if (!string.IsNullOrEmpty(asset.SerialNumber))
                                                        {
                                                            <span> &bull; S/N: @asset.SerialNumber</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold">@asset.CategoryName</div>
                                            <small class="text-muted">@(asset.AssetTypeName ?? "General")</small>
                                        </td>
                                        <td>
                                            @if (asset.CurrentCustodianEmployeeName != null)
                                            {
                                                <div class="small fw-semibold text-primary"><i class="bi bi-person-fill me-1"></i>@asset.CurrentCustodianEmployeeName</div>
                                            }
                                            else if (asset.CurrentAssignedVehiclePlate != null)
                                            {
                                                <div class="small fw-semibold text-info"><i class="bi bi-truck me-1"></i>Vehicle @asset.CurrentAssignedVehiclePlate</div>
                                            }
                                            else
                                            {
                                                <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@(asset.CurrentLocationName ?? asset.CurrentBranchName ?? "Depot / Unassigned")</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @statusBadge px-2 py-1">@asset.Status</span>
                                        </td>
                                        <td>
                                            <span class="@conditionBadge">@asset.Condition</span>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold">@asset.TotalUsageHours.ToString("N1") hrs</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/Assets/Details?id=@asset.Id" class="btn btn-outline-primary" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="/Assets/Edit?id=@asset.Id" class="btn btn-outline-secondary" title="Edit Asset">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="/api/assets/@asset.Id/qr-code" target="_blank" class="btn btn-outline-dark" title="Download QR Tag">
                                                    <i class="bi bi-qr-code"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- PAGINATION -->
                    @if (Model.Assets.TotalPages > 1)
                    {
                        <div class="card-footer bg-transparent border-top p-3 d-flex justify-content-between align-items-center">
                            <span class="small text-muted">
                                Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.Assets.TotalCount)) of @Model.Assets.TotalCount assets
                            </span>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(!Model.Assets.HasPreviousPage ? "disabled" : "")">
                                        <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&SearchTerm=@Model.SearchTerm&CategoryId=@Model.CategoryId&Status=@Model.Status">Previous</a>
                                    </li>
                                    @for (var p = 1; p <= Model.Assets.TotalPages; p++)
                                    {
                                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                            <a class="page-link" href="?PageNumber=@p&SearchTerm=@Model.SearchTerm&CategoryId=@Model.CategoryId&Status=@Model.Status">@p</a>
                                        </li>
                                    }
                                    <li class="page-item @(!Model.Assets.HasNextPage ? "disabled" : "")">
                                        <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&SearchTerm=@Model.SearchTerm&CategoryId=@Model.CategoryId&Status=@Model.Status">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
