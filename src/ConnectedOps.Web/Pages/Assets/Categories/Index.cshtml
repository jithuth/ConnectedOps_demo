@page
@model ConnectedOps.Web.Pages.Assets.Categories.IndexModel
@{
    ViewData["Title"] = "Asset Categories & Types";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-tags text-primary me-2"></i>Asset Classification Catalog</h1>
                <p class="text-muted small mb-0">Manage hierarchical equipment categories, asset types, and compliance standards.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-outline-primary btn-sm me-1" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Category
                </button>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newTypeModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Asset Type
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-octagon-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-3">
            <!-- CATEGORIES TREE / LIST -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom p-3">
                        <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-folder2-open me-2"></i>Categories Hierarchy</h6>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.CategoryTree.Count == 0)
                        {
                            <p class="text-muted small">No categories registered.</p>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var cat in Model.CategoryTree)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold small"><i class="bi bi-folder-fill text-warning me-2"></i>@cat.Name <span class="badge bg-light text-muted border font-monospace">@cat.Code</span></div>
                                            <small class="text-muted">@cat.Description</small>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary">@cat.AssetCount Assets</span>
                                    </div>
                                    @if (cat.Children.Count > 0)
                                    {
                                        @foreach (var sub in cat.Children)
                                        {
                                            <div class="list-group-item ps-4 d-flex justify-content-between align-items-center bg-light-subtle">
                                                <div>
                                                    <div class="fw-semibold small"><i class="bi bi-arrow-return-right me-2 text-muted"></i>@sub.Name <span class="badge bg-light text-muted border font-monospace">@sub.Code</span></div>
                                                    <small class="text-muted">@sub.Description</small>
                                                </div>
                                                <span class="badge bg-secondary-subtle text-secondary">@sub.AssetCount Assets</span>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ASSET TYPES LIST -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom p-3">
                        <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-tag-fill me-2"></i>Asset Types Catalog</h6>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.AllTypes.Count == 0)
                        {
                            <div class="p-4 text-muted small">No asset types registered.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Type Name</th>
                                            <th>Category</th>
                                            <th>QA Interval</th>
                                            <th>Calibration</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tp in Model.AllTypes)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="fw-semibold small">@tp.Name</div>
                                                    <div class="small text-muted font-monospace">@tp.Code</div>
                                                </td>
                                                <td class="small">@(tp.CategoryName ?? "General")</td>
                                                <td class="small">@(tp.DefaultInspectionIntervalDays.HasValue ? $"{tp.DefaultInspectionIntervalDays}d" : "—")</td>
                                                <td class="small">@(tp.DefaultCalibrationIntervalDays.HasValue ? $"{tp.DefaultCalibrationIntervalDays}d" : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NEW CATEGORY MODAL -->
<div class="modal fade" id="newCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateCategory">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Asset Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category Code <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control form-control-sm font-monospace" placeholder="e.g. PWR-TOOLS" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Power Tools &amp; Drills" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="description" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- NEW TYPE MODAL -->
<div class="modal fade" id="newTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateType">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Asset Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Parent Category <span class="text-danger">*</span></label>
                        <select name="categoryId" class="form-select form-select-sm" required>
                            <option value="">Select Category...</option>
                            @foreach (var cat in Model.CategoryTree)
                            {
                                <option value="@cat.Id">@cat.Name (@cat.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Type Code <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control form-control-sm font-monospace" placeholder="e.g. ROTARY-HAMMER" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Type Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Rotary Hammer Drill" required>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-semibold">QA Interval (Days)</label>
                            <input type="number" name="defaultInspectionIntervalDays" class="form-control form-control-sm" placeholder="e.g. 90">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small fw-semibold">Calibration Interval (Days)</label>
                            <input type="number" name="defaultCalibrationIntervalDays" class="form-control form-control-sm" placeholder="e.g. 365">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Create Type</button>
                </div>
            </form>
        </div>
    </div>
</div>
