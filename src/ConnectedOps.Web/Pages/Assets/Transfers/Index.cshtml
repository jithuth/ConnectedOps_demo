@page
@model ConnectedOps.Web.Pages.Assets.Transfers.IndexModel
@{
    ViewData["Title"] = "Asset Transfers";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-arrow-left-right text-primary me-2"></i>Asset Transfers &amp; Relocations</h1>
                <p class="text-muted small mb-0">Monitor movements between branches, field locations, vehicles, and employees.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Assets" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-tools me-1"></i> Asset Directory
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-check text-primary me-2"></i>Transfer Log</h6>
            </div>

            <div class="card-body p-0">
                @if (Model.Transfers.Items.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-arrow-left-right fs-1 d-block mb-2"></i>
                        <h5>No Transfers Recorded</h5>
                        <p class="small">Transfers initiated from asset details will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Asset</th>
                                    <th>Type</th>
                                    <th>Origin</th>
                                    <th>Destination</th>
                                    <th>Status</th>
                                    <th>Initiated</th>
                                    <th>Completed</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tr in Model.Transfers.Items)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a href="/Assets/Details?id=@tr.AssetId" class="fw-bold text-decoration-none">@tr.AssetName</a>
                                            <div class="small text-muted font-monospace">@tr.AssetNumber</div>
                                        </td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@tr.TransferType</span></td>
                                        <td class="small">@(tr.FromBranchName ?? tr.FromLocationName ?? tr.FromEmployeeName ?? "—")</td>
                                        <td class="small fw-semibold text-primary">@(tr.ToBranchName ?? tr.ToLocationName ?? tr.ToEmployeeName ?? "—")</td>
                                        <td>
                                            @{
                                                var statusBadge = tr.Status switch
                                                {
                                                    ConnectedOps.Domain.Assets.AssetTransferStatus.Completed => "bg-success",
                                                    ConnectedOps.Domain.Assets.AssetTransferStatus.InTransit => "bg-warning text-dark",
                                                    ConnectedOps.Domain.Assets.AssetTransferStatus.Cancelled => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @statusBadge">@tr.Status</span>
                                        </td>
                                        <td class="small">@tr.InitiatedAtUtc.ToLocalTime().ToString("g")</td>
                                        <td class="small text-muted">@(tr.CompletedAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                                        <td class="text-end pe-3">
                                            <a href="/Assets/Details?id=@tr.AssetId" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                View Asset &rarr;
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
