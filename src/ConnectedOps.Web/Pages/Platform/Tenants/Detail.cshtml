@page "/Platform/Tenants/Detail"
@model ConnectedOps.Web.Pages.Platform.Tenants.DetailModel
@{
    ViewData["Title"] = Model.Tenant.Name;
    ViewData["Subtitle"] = $"Tenant Control Center - Code: {Model.Tenant.Code}";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <div class="d-flex align-items-center gap-2">
        <a href="/Platform/Tenants" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Tenants
        </a>
        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modal-edit-contact">
            <i class="bi bi-pencil me-1"></i> Edit Contact
        </button>
    </div>
}

<!-- TENANT STATUS BANNER -->
<div class="card bg-body border mb-4">
    <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="brand-icon" style="width: 46px; height: 46px; font-size: 1.4rem;">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h4 class="fw-bold mb-0">@Model.Tenant.Name</h4>
                    <span class="status-badge @(Model.Tenant.Status switch {
                        TenantStatus.Active => "badge-active",
                        TenantStatus.Pending => "badge-pending",
                        TenantStatus.Suspended => "badge-suspended",
                        _ => "badge-disabled"
                    })">
                        @Model.Tenant.Status
                    </span>
                </div>
                <div class="small text-secondary mt-1">
                    <code>@Model.Tenant.Code</code> &bull; Created @Model.Tenant.CreatedAtUtc.ToString("MMMM dd, yyyy") &bull; ID: @Model.Tenant.Id
                </div>
            </div>
        </div>

        <!-- QUICK LIFECYCLE CONTROLS -->
        <div class="d-flex align-items-center gap-2">
            @if (Model.Tenant.Status != TenantStatus.Active)
            {
                <form method="post" asp-page-handler="Activate" asp-route-id="@Model.Tenant.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-circle me-1"></i> Activate</button>
                </form>
            }
            @if (Model.Tenant.Status == TenantStatus.Active)
            {
                <form method="post" asp-page-handler="Suspend" asp-route-id="@Model.Tenant.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-pause-circle me-1"></i> Suspend</button>
                </form>
            }
            @if (Model.Tenant.Status != TenantStatus.Disabled)
            {
                <form method="post" asp-page-handler="Disable" asp-route-id="@Model.Tenant.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to disable this tenant organization?');">
                        <i class="bi bi-slash-circle me-1"></i> Disable
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<!-- STATS SUMMARY CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3 bg-body">
            <div class="small text-secondary text-uppercase fw-semibold">Total Users</div>
            <h3 class="fw-bold my-1">@Model.Stats.TotalUsers</h3>
            <div class="small text-success">@Model.Stats.ActiveUsers active members</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3 bg-body">
            <div class="small text-secondary text-uppercase fw-semibold">Custom Roles</div>
            <h3 class="fw-bold my-1">@Model.Stats.RoleCount</h3>
            <div class="small text-secondary">Configured RBAC roles</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3 bg-body">
            <div class="small text-secondary text-uppercase fw-semibold">Pending Invitations</div>
            <h3 class="fw-bold my-1">@Model.Stats.InvitationCount</h3>
            <div class="small text-secondary">Unclaimed invites</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card metric-card p-3 bg-body">
            <div class="small text-secondary text-uppercase fw-semibold">Country Region</div>
            <h3 class="fw-bold my-1">@(Model.Tenant.CountryCode ?? "GLOBAL")</h3>
            <div class="small text-secondary">Jurisdiction code</div>
        </div>
    </div>
</div>

<!-- TABS NAVIGATION -->
<div class="card bg-body border">
    <div class="card-header bg-transparent p-0 border-bottom">
        <ul class="nav nav-tabs card-header-tabs m-0 px-3" role="tablist">
            <li class="nav-item">
                <button class="nav-link active py-3 px-3" data-bs-toggle="tab" data-bs-target="#tab-overview" role="tab">
                    <i class="bi bi-info-circle me-1"></i> Overview
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link py-3 px-3" data-bs-toggle="tab" data-bs-target="#tab-users" role="tab">
                    <i class="bi bi-people me-1"></i> Users (@Model.Users.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link py-3 px-3" data-bs-toggle="tab" data-bs-target="#tab-settings" role="tab">
                    <i class="bi bi-sliders me-1"></i> Settings
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link py-3 px-3" data-bs-toggle="tab" data-bs-target="#tab-activity" role="tab">
                    <i class="bi bi-journal-text me-1"></i> Activity Logs
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link py-3 px-3" data-bs-toggle="tab" data-bs-target="#tab-security" role="tab">
                    <i class="bi bi-shield-lock me-1"></i> Security Events
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-4">
        <div class="tab-content">
            <!-- OVERVIEW TAB -->
            <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-secondary text-uppercase small">Contact Information</h6>
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-secondary small">Email</dt>
                            <dd class="col-sm-8 small">@(Model.Tenant.Email ?? "Not provided")</dd>

                            <dt class="col-sm-4 text-secondary small">Phone</dt>
                            <dd class="col-sm-8 small">@(Model.Tenant.Phone ?? "Not provided")</dd>

                            <dt class="col-sm-4 text-secondary small">Country Code</dt>
                            <dd class="col-sm-8 small">@(Model.Tenant.CountryCode ?? "N/A")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3 text-secondary text-uppercase small">Lifecycle & Auditing</h6>
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-secondary small">Created At</dt>
                            <dd class="col-sm-8 small">@Model.Tenant.CreatedAtUtc.ToString("f")</dd>

                            <dt class="col-sm-4 text-secondary small">Last Updated</dt>
                            <dd class="col-sm-8 small">@(Model.Tenant.UpdatedAtUtc?.ToString("f") ?? "Never")</dd>

                            <dt class="col-sm-4 text-secondary small">Status State</dt>
                            <dd class="col-sm-8 small">@Model.Tenant.Status</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- USERS TAB -->
            <div class="tab-pane fade" id="tab-users" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>USER</th>
                                <th>EMAIL</th>
                                <th>ROLES</th>
                                <th>STATUS</th>
                                <th>JOINED</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Users.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-secondary small">No user memberships in this tenant.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td class="fw-semibold">@u.FullName</td>
                                        <td>@u.Email</td>
                                        <td>
                                            @if (u.Roles.Count == 0)
                                            {
                                                <span class="text-muted small">No roles assigned</span>
                                            }
                                            else
                                            {
                                                @foreach (var r in u.Roles)
                                                {
                                                    <span class="badge bg-secondary-subtle text-body me-1">@r</span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(u.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                @(u.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="small text-secondary">@u.JoinedAtUtc.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SETTINGS TAB -->
            <div class="tab-pane fade" id="tab-settings" role="tabpanel">
                @if (Model.Tenant.Settings is null)
                {
                    <div class="text-center py-4 text-secondary small">Default platform settings are active for this tenant.</div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-sm-6 col-md-4">
                            <label class="small text-secondary">Time Zone</label>
                            <div class="fw-semibold">@Model.Tenant.Settings.TimeZone</div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <label class="small text-secondary">Currency</label>
                            <div class="fw-semibold">@Model.Tenant.Settings.CurrencyCode</div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <label class="small text-secondary">Language</label>
                            <div class="fw-semibold">@Model.Tenant.Settings.LanguageCode</div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <label class="small text-secondary">Distance Unit</label>
                            <div class="fw-semibold">@Model.Tenant.Settings.DistanceUnit</div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <label class="small text-secondary">Fuel Unit</label>
                            <div class="fw-semibold">@Model.Tenant.Settings.FuelUnit</div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <label class="small text-secondary">Date Format</label>
                            <div class="fw-semibold">@Model.Tenant.Settings.DateFormat</div>
                        </div>
                    </div>
                }
            </div>

            <!-- ACTIVITY TAB -->
            <div class="tab-pane fade" id="tab-activity" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>ACTION</th>
                                <th>ENTITY</th>
                                <th>DESCRIPTION</th>
                                <th>IP</th>
                                <th class="text-end">TIME</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AuditLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-secondary small">No audit records found for this tenant.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.AuditLogs)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary-subtle text-primary">@log.Action</span></td>
                                        <td class="small fw-semibold">@log.EntityType</td>
                                        <td class="small text-secondary">@(log.Description ?? "-")</td>
                                        <td class="small font-monospace">@(log.IpAddress ?? "-")</td>
                                        <td class="small text-secondary text-end">@log.CreatedAtUtc.ToString("MMM dd, HH:mm:ss")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECURITY TAB -->
            <div class="tab-pane fade" id="tab-security" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-secondary">
                                <th>EVENT</th>
                                <th>TARGET EMAIL</th>
                                <th>STATUS</th>
                                <th>IP ADDRESS</th>
                                <th class="text-end">TIMESTAMP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SecurityLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-secondary small">No security events found for this tenant.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var s in Model.SecurityLogs)
                                {
                                    <tr>
                                        <td class="small fw-semibold">@s.EventType</td>
                                        <td class="small">@(s.Email ?? "-")</td>
                                        <td>
                                            <span class="badge @(s.Succeeded ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                @(s.Succeeded ? "Succeeded" : "Failed")
                                            </span>
                                        </td>
                                        <td class="small font-monospace">@(s.IpAddress ?? "-")</td>
                                        <td class="small text-secondary text-end">@s.CreatedAtUtc.ToString("MMM dd, HH:mm:ss")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- EDIT CONTACT MODAL -->
<div class="modal fade" id="modal-edit-contact" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdateContact" asp-route-id="@Model.Tenant.Id">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Update Tenant Contact Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Organization Name</label>
                        <input type="text" name="Name" value="@Model.Tenant.Name" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Contact Email</label>
                        <input type="email" name="Email" value="@Model.Tenant.Email" class="form-control form-control-sm" />
                    </div>
                    <div class="row g-2">
                        <div class="col-8">
                            <label class="form-label small fw-semibold">Phone Number</label>
                            <input type="tel" name="Phone" value="@Model.Tenant.Phone" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">Country Code</label>
                            <input type="text" name="CountryCode" value="@Model.Tenant.CountryCode" class="form-control form-control-sm text-uppercase" maxlength="3" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
