@page "/Platform/Plans"
@model ConnectedOps.Web.Pages.Platform.Plans.IndexModel
@using ConnectedOps.Domain.Billing
@{
    ViewData["Title"] = "Platform Subscription Plans";
    ViewData["Subtitle"] = "Configure SaaS commercial tiers, pricing models, and resource limits";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm bg-body">
    <div class="card-header border-0 bg-transparent py-3 px-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Subscription Tiers</h5>
            <div class="small text-secondary">Platform-wide subscription configurations offered to tenant organizations</div>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPlanModal">
            <i class="bi bi-plus-lg me-1"></i> New Plan
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary text-uppercase">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Plan Name</th>
                        <th>Price</th>
                        <th>Billing Cycle</th>
                        <th>Vehicles</th>
                        <th>Users</th>
                        <th>Assets</th>
                        <th>Storage</th>
                        <th class="text-center">Public</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Plans.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                No plans found. Click "New Plan" to configure a tier.
                            </td>
                        </tr>
                    }
                    @foreach (var plan in Model.Plans.OrderBy(p => p.SortOrder))
                    {
                        <tr>
                            <td class="ps-4 fw-bold font-monospace text-primary">@plan.Code</td>
                            <td>
                                <div class="fw-semibold">@plan.Name</div>
                                <div class="text-secondary small text-truncate" style="max-width: 240px;">@plan.Description</div>
                            </td>
                            <td class="fw-bold fs-6">$@plan.Price.ToString("N0")</td>
                            <td class="small text-secondary">@plan.BillingInterval.ToString()</td>
                            <td class="small fw-semibold">@plan.MaxVehicles</td>
                            <td class="small fw-semibold">@plan.MaxUsers</td>
                            <td class="small fw-semibold">@plan.MaxAssets</td>
                            <td class="small fw-semibold">@plan.MaxStorageGb GB</td>
                            <td class="text-center">
                                @if (plan.IsPublic)
                                {
                                    <span class="badge bg-success-subtle text-success">Public</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Private</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (plan.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                    <input type="hidden" name="planId" value="@plan.Id" />
                                    <input type="hidden" name="isActive" value="@plan.IsActive.ToString().ToLower()" />
                                    <button type="submit" class="btn btn-sm @(plan.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(plan.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: CREATE PLAN -->
<div class="modal fade" id="createPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Create Subscription Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Plan Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Starter Fleet" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Plan Code <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control font-monospace" placeholder="e.g. STARTER" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Price ($) <span class="text-danger">*</span></label>
                            <input type="number" name="price" class="form-control" step="0.01" min="0" placeholder="49.00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Billing Interval</label>
                            <select name="billingInterval" class="form-select">
                                <option value="Monthly" selected>Monthly</option>
                                <option value="Annual">Annual</option>
                                <option value="Quarterly">Quarterly</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Sort Order</label>
                            <input type="number" name="sortOrder" class="form-control" value="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Plan target audience and telemetry scope..."></textarea>
                    </div>

                    <div class="card bg-body-secondary border-0 p-3 mb-3">
                        <h6 class="fw-bold small mb-2 text-uppercase text-secondary">Resource Quotas</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Max Vehicles</label>
                                <input type="number" name="maxVehicles" class="form-control form-control-sm" value="25" min="1" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Max Users</label>
                                <input type="number" name="maxUsers" class="form-control form-control-sm" value="5" min="1" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Max Assets</label>
                                <input type="number" name="maxAssets" class="form-control form-control-sm" value="50" min="1" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Storage (GB)</label>
                                <input type="number" name="maxStorageGb" class="form-control form-control-sm" value="10" min="1" required />
                            </div>
                        </div>
                    </div>

                    <div class="card bg-body-secondary border-0 p-3 mb-2">
                        <h6 class="fw-bold small mb-2 text-uppercase text-secondary">Feature Toggles &amp; Visibility</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hasAdvancedAnalytics" value="true" id="featAnalytics">
                                    <label class="form-check-label small" for="featAnalytics">Advanced Telematics &amp; Analytics</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hasApiAccess" value="true" id="featApi">
                                    <label class="form-check-label small" for="featApi">REST API &amp; Webhooks Access</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hasCustomBranding" value="true" id="featBranding">
                                    <label class="form-check-label small" for="featBranding">Custom Company Branding</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hasAuditExport" value="true" id="featAudit">
                                    <label class="form-check-label small" for="featAudit">Compliance Audit Export</label>
                                </div>
                            </div>
                            <div class="col-12 mt-2 pt-2 border-top">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="isPublic" value="true" id="isPublicCheck" checked>
                                    <label class="form-check-label small fw-semibold" for="isPublicCheck">Public (Visible for self-serve tenant upgrades)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>
