@page "/Platform/AuditLogs"
@model ConnectedOps.Web.Pages.Platform.AuditLogsModel
@{
    ViewData["Title"] = "Audit Log Center";
    ViewData["Subtitle"] = "Comprehensive cross-tenant business data changes, configuration updates, and admin operations";
}

<!-- FILTERS -->
<div class="card bg-body border mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1">From Date</label>
                <input type="date" name="FromUtc" value="@(Model.FromUtc?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1">To Date</label>
                <input type="date" name="ToUtc" value="@(Model.ToUtc?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1">Entity Type</label>
                <input type="text" name="EntityType" value="@Model.EntityType" class="form-control form-control-sm" placeholder="e.g. Tenant, User" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1">Action</label>
                <input type="text" name="ActionName" value="@Model.ActionName" class="form-control form-control-sm" placeholder="e.g. Create, Update" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-secondary mb-1">Tenant ID</label>
                <input type="text" name="TenantId" value="@Model.TenantId" class="form-control form-control-sm" placeholder="Guid" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-secondary flex-grow-1">Filter</button>
                <a href="/Platform/AuditLogs" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- AUDIT LOGS TABLE -->
<div class="card bg-body border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>TIMESTAMP</th>
                    <th>ACTION</th>
                    <th>ENTITY</th>
                    <th>TENANT</th>
                    <th>DESCRIPTION</th>
                    <th>IP ADDRESS</th>
                    <th class="text-end">VALUES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AuditPage.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-muted"></i>
                            <div>No audit records match the current criteria.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.AuditPage.Items)
                    {
                        <tr>
                            <td class="small text-secondary">@log.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm:ss")</td>
                            <td>
                                <span class="badge @(log.Action switch {
                                    "Create" => "bg-success-subtle text-success",
                                    "Update" => "bg-primary-subtle text-primary",
                                    "Delete" => "bg-danger-subtle text-danger",
                                    _ => "bg-secondary-subtle text-secondary"
                                })">
                                    @log.Action
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold small">@log.EntityType</div>
                                <div class="text-secondary small font-monospace">@log.EntityId</div>
                            </td>
                            <td class="small">
                                @(log.TenantId.HasValue ? log.TenantId.Value.ToString()[..8] + "..." : "Platform")
                            </td>
                            <td class="small text-truncate" style="max-width: 250px;">
                                @(log.Description ?? "-")
                            </td>
                            <td class="small font-monospace text-secondary">@(log.IpAddress ?? "-")</td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(log.OldValues) || !string.IsNullOrWhiteSpace(log.NewValues))
                                {
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="viewJsonDiff(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(log.OldValues)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(log.NewValues)), '@log.EntityType', '@log.Action')">
                                        <i class="bi bi-code-square"></i> Diff
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.AuditPage.TotalPages > 1)
    {
        <div class="card-footer bg-transparent py-3 d-flex justify-content-between align-items-center">
            <div class="small text-secondary">
                Showing @((Model.AuditPage.Page - 1) * Model.AuditPage.PageSize + 1) to @(Math.Min(Model.AuditPage.Page * Model.AuditPage.PageSize, Model.AuditPage.TotalCount)) of @Model.AuditPage.TotalCount audit events
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.AuditPage.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" href="?PageIndex=@(Model.AuditPage.Page - 1)&FromUtc=@(Model.FromUtc?.ToString("yyyy-MM-dd"))&ToUtc=@(Model.ToUtc?.ToString("yyyy-MM-dd"))&EntityType=@Model.EntityType&ActionName=@Model.ActionName&TenantId=@Model.TenantId">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.AuditPage.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.AuditPage.Page ? "active" : "")">
                            <a class="page-link" href="?PageIndex=@p&FromUtc=@(Model.FromUtc?.ToString("yyyy-MM-dd"))&ToUtc=@(Model.ToUtc?.ToString("yyyy-MM-dd"))&EntityType=@Model.EntityType&ActionName=@Model.ActionName&TenantId=@Model.TenantId">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.AuditPage.HasNextPage ? "disabled" : "")">
                        <a class="page-link" href="?PageIndex=@(Model.AuditPage.Page + 1)&FromUtc=@(Model.FromUtc?.ToString("yyyy-MM-dd"))&ToUtc=@(Model.ToUtc?.ToString("yyyy-MM-dd"))&EntityType=@Model.EntityType&ActionName=@Model.ActionName&TenantId=@Model.TenantId">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- JSON DIFF MODAL -->
<div class="modal fade" id="modal-json-diff" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="diff-modal-title">Audit Payload</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-semibold small text-danger">Old Values</h6>
                        <pre class="bg-body-tertiary p-3 rounded border small" style="max-height: 350px; overflow-y: auto;" id="diff-old-values">None</pre>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold small text-success">New Values</h6>
                        <pre class="bg-body-tertiary p-3 rounded border small" style="max-height: 350px; overflow-y: auto;" id="diff-new-values">None</pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewJsonDiff(oldVal, newVal, entity, action) {
            document.getElementById('diff-modal-title').textContent = `${action} ${entity} Payload`;
            
            function formatJson(val) {
                if (!val) return 'None';
                try {
                    return JSON.stringify(JSON.parse(val), null, 2);
                } catch {
                    return val;
                }
            }

            document.getElementById('diff-old-values').textContent = formatJson(oldVal);
            document.getElementById('diff-new-values').textContent = formatJson(newVal);

            new bootstrap.Modal(document.getElementById('modal-json-diff')).show();
        }
    </script>
}
