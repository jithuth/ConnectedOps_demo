@page "/Platform/SecurityLogs"
@model ConnectedOps.Web.Pages.Platform.SecurityLogsModel
@{
    ViewData["Title"] = "Security Operations Center";
    ViewData["Subtitle"] = "Real-time surveillance of global authentication attempts, token validity, and threat signals";
}

<!-- SECURITY KPI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card p-3 bg-body">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary fw-semibold text-uppercase">Failed Logins Today</div>
                    <h3 class="fw-bold my-1 text-danger">@Model.Stats.FailedLoginsToday</h3>
                    <div class="small text-secondary">Rejected password attempts</div>
                </div>
                <div class="metric-icon bg-danger-subtle text-danger">
                    <i class="bi bi-shield-x"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card p-3 bg-body">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary fw-semibold text-uppercase">Locked Accounts</div>
                    <h3 class="fw-bold my-1 text-warning">@Model.Stats.LockedAccounts</h3>
                    <div class="small text-secondary">Active brute-force lockouts</div>
                </div>
                <div class="metric-icon bg-warning-subtle text-warning">
                    <i class="bi bi-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card p-3 bg-body">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary fw-semibold text-uppercase">Invalid Tokens Today</div>
                    <h3 class="fw-bold my-1 text-primary">@Model.Stats.InvalidTokensToday</h3>
                    <div class="small text-secondary">Expired or forged signatures</div>
                </div>
                <div class="metric-icon bg-primary-subtle text-primary">
                    <i class="bi bi-key-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card p-3 bg-body">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary fw-semibold text-uppercase">Suspicious Events</div>
                    <h3 class="fw-bold my-1 text-danger">@Model.Stats.SuspiciousEventsToday</h3>
                    <div class="small text-secondary">Token reuse / anomalies</div>
                </div>
                <div class="metric-icon bg-danger-subtle text-danger">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS -->
<div class="card bg-body border mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-2">
                <input type="text" name="Email" value="@Model.Email" class="form-control form-control-sm" placeholder="Email / Subject..." />
            </div>
            <div class="col-md-2">
                <input type="text" name="IpAddress" value="@Model.IpAddress" class="form-control form-control-sm" placeholder="IP Address..." />
            </div>
            <div class="col-md-2">
                <input type="text" name="EventType" value="@Model.EventType" class="form-control form-control-sm" placeholder="Event Type..." />
            </div>
            <div class="col-md-2">
                <select name="Succeeded" class="form-select form-select-sm">
                    <option value="">All Outcomes</option>
                    <option value="true" selected="@(Model.Succeeded == true)">Succeeded</option>
                    <option value="false" selected="@(Model.Succeeded == false)">Failed</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="FromUtc" value="@(Model.FromUtc?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-secondary flex-grow-1">Filter</button>
                <a href="/Platform/SecurityLogs" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- SECURITY EVENTS TABLE -->
<div class="card bg-body border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>TIMESTAMP</th>
                    <th>EVENT TYPE</th>
                    <th>TARGET EMAIL</th>
                    <th>STATUS</th>
                    <th>IP ADDRESS</th>
                    <th>REQUEST PATH</th>
                    <th>TRACE ID</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SecurityPage.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-shield-check fs-1 d-block mb-2 text-success"></i>
                            <div>No security logs match the current filters.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model.SecurityPage.Items)
                    {
                        <tr>
                            <td class="small text-secondary">@s.CreatedAtUtc.ToString("MMM dd, HH:mm:ss")</td>
                            <td class="small fw-semibold">
                                <i class="bi bi-shield-@(s.Succeeded ? "check text-success" : "exclamation text-danger") me-1"></i>
                                @s.EventType
                            </td>
                            <td class="small">@(s.Email ?? "-")</td>
                            <td>
                                <span class="badge @(s.Succeeded ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    @(s.Succeeded ? "Success" : "Failed")
                                </span>
                            </td>
                            <td class="small font-monospace">@(s.IpAddress ?? "-")</td>
                            <td class="small text-secondary">@(s.RequestPath ?? "-")</td>
                            <td class="small text-secondary font-monospace">@(s.TraceId?.Length > 8 ? s.TraceId[..8] + "..." : s.TraceId ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.SecurityPage.TotalPages > 1)
    {
        <div class="card-footer bg-transparent py-3 d-flex justify-content-between align-items-center">
            <div class="small text-secondary">
                Showing @((Model.SecurityPage.Page - 1) * Model.SecurityPage.PageSize + 1) to @(Math.Min(Model.SecurityPage.Page * Model.SecurityPage.PageSize, Model.SecurityPage.TotalCount)) of @Model.SecurityPage.TotalCount security events
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.SecurityPage.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" href="?PageIndex=@(Model.SecurityPage.Page - 1)&Email=@Model.Email&IpAddress=@Model.IpAddress&EventType=@Model.EventType&Succeeded=@Model.Succeeded">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.SecurityPage.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.SecurityPage.Page ? "active" : "")">
                            <a class="page-link" href="?PageIndex=@p&Email=@Model.Email&IpAddress=@Model.IpAddress&EventType=@Model.EventType&Succeeded=@Model.Succeeded">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.SecurityPage.HasNextPage ? "disabled" : "")">
                        <a class="page-link" href="?PageIndex=@(Model.SecurityPage.Page + 1)&Email=@Model.Email&IpAddress=@Model.IpAddress&EventType=@Model.EventType&Succeeded=@Model.Succeeded">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
