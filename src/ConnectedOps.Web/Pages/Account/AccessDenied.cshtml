@page "/Account/AccessDenied"
@model ConnectedOps.Web.Pages.Account.AccessDeniedModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="display-1 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
        <h2 class="fw-bold">Access Denied</h2>
        <p class="text-secondary mb-4">You do not have the required administrative privileges to view or perform operations on this resource.</p>
        <div class="d-flex justify-content-center gap-2">
            <a href="/Platform/Dashboard" class="btn btn-primary"><i class="bi bi-arrow-left me-1"></i> Return to Dashboard</a>
            <a href="/Account/Login" class="btn btn-outline-secondary">Sign in with Another Account</a>
        </div>
    </div>
</div>
