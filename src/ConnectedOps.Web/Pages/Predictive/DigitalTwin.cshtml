@page
@model ConnectedOps.Web.Pages.Predictive.DigitalTwinModel
@using ConnectedOps.Domain.Predictive
@{
    ViewData["Title"] = "AI Predictive Maintenance & Digital Twin Health";
    ViewData["Subtitle"] = "Continuous CAN telemetry diagnostics, component RUL forecasting, and proactive breakdown prevention";
}

@section HeaderActions {
    <form method="post" asp-page-handler="RunDiagnostics" class="d-inline">
        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-cpu-fill"></i> Run Fleet AI Diagnostics Scan
        </button>
    </form>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- STATS CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-@(Model.Dashboard.AverageFleetHealthScore >= 80 ? "success" : Model.Dashboard.AverageFleetHealthScore >= 65 ? "warning" : "danger") border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Fleet Health Index</div>
                        <div class="h3 fw-bold mb-0">@Model.Dashboard.AverageFleetHealthScore%</div>
                    </div>
                    <div class="p-3 bg-@(Model.Dashboard.AverageFleetHealthScore >= 80 ? "success" : Model.Dashboard.AverageFleetHealthScore >= 65 ? "warning" : "danger")-subtle text-@(Model.Dashboard.AverageFleetHealthScore >= 80 ? "success" : Model.Dashboard.AverageFleetHealthScore >= 65 ? "warning" : "danger") rounded-circle">
                        <i class="bi bi-speedometer fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Critical Failures Imminent</div>
                        <div class="h3 fw-bold mb-0 text-danger">@Model.Dashboard.CriticalVehiclesCount</div>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                        <i class="bi bi-exclamation-octagon fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Subsystems on Watch</div>
                        <div class="h3 fw-bold mb-0 text-warning">@Model.Dashboard.WatchVehiclesCount</div>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-shield-exclamation fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Est. Breakdown Savings</div>
                        <div class="h3 fw-bold mb-0 text-info">$@Model.Dashboard.PotentialSavingsEstimated.ToString("N0")</div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-piggy-bank fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DIGITAL TWIN AT-RISK VEHICLES -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-diagram-3-fill me-2 text-primary"></i> Vehicle Digital Twin Health Matrix</h5>
        <span class="badge bg-secondary">Real-time CAN bus telemetry scoring</span>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            @if (Model.Dashboard.TopAtRiskVehicles.Count == 0)
            {
                <div class="col-12 text-center py-4 text-secondary">
                    <i class="bi bi-check2-circle fs-2 d-block mb-2 text-success"></i>
                    No vehicles found or diagnostic evaluation has not been run yet. Click <strong>Run Fleet AI Diagnostics Scan</strong> above.
                </div>
            }
            else
            {
                @foreach (var twin in Model.Dashboard.TopAtRiskVehicles)
                {
                    var isCritical = twin.OverallRisk == PredictiveRiskLevel.CriticalFailureImminent;
                    var isWarning = twin.OverallRisk == PredictiveRiskLevel.ElevatedWarning;

                    <div class="col-md-6 col-xl-3">
                        <div class="card h-100 border @(isCritical ? "border-danger border-2" : isWarning ? "border-warning border-2" : "border-light-subtle") shadow-none bg-body-tertiary">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-0">@twin.VehicleNumber</h6>
                                        <span class="badge @(isCritical ? "bg-danger" : isWarning ? "bg-warning text-dark" : "bg-success")">
                                            @twin.OverallHealthScore% Health
                                        </span>
                                    </div>
                                    <div class="small text-secondary mb-3">@(twin.RegistrationNumber ?? "No Plate") - @(twin.DisplayName ?? "Fleet Unit")</div>

                                    <!-- 5 Subsystems progress bars -->
                                    <div class="small mb-2">
                                        @foreach (var sub in twin.Subsystems)
                                        {
                                            var barColor = sub.HealthScore >= 80 ? "bg-success" : sub.HealthScore >= 60 ? "bg-warning" : "bg-danger";
                                            <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 0.75rem;">
                                                <span class="text-secondary text-truncate" style="max-width: 130px;">@sub.SubsystemName</span>
                                                <span class="fw-bold">@sub.HealthScore%</span>
                                            </div>
                                            <div class="progress" style="height: 4px;">
                                                <div class="progress-bar @barColor" style="width: @sub.HealthScore%;"></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="badge @(twin.ActiveAlertsCount > 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")" style="font-size: 0.72rem;">
                                        @twin.ActiveAlertsCount Active Alerts
                                    </span>
                                    <a href="/Predictive/DigitalTwin?VehicleId=@twin.VehicleId" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;">
                                        Filter Alerts
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- PREDICTIVE RECOMMENDATIONS & ALERTS TABLE -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-0 fw-bold"><i class="bi bi-wrench-adjustable-circle-fill me-2 text-danger"></i> AI Predictive Maintenance Alerts & Recommendations</h5>
        </div>
        @if (Model.VehicleId.HasValue)
        {
            <div>
                <span class="badge bg-primary me-2">Filtered by vehicle</span>
                <a href="/Predictive/DigitalTwin" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
            </div>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Risk Level</th>
                        <th>Vehicle</th>
                        <th>Subsystem</th>
                        <th>Predicted Failure Mode & Symptom</th>
                        <th>Failure Prob.</th>
                        <th>RUL (Days)</th>
                        <th>Est. Repair</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Alerts == null || Model.Alerts.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-secondary">
                                <i class="bi bi-shield-check fs-2 d-block mb-2 text-success"></i>
                                All fleet components operating within healthy OEM specifications.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var alert in Model.Alerts.Items)
                        {
                            var isCritical = alert.RiskLevel == PredictiveRiskLevel.CriticalFailureImminent;
                            <tr>
                                <td>
                                    <span class="badge @(isCritical ? "bg-danger" : "bg-warning text-dark") px-2 py-1">
                                        <i class="bi @(isCritical ? "bi-exclamation-octagon-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                                        @alert.RiskLevelName
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold">@alert.VehicleNumber</div>
                                    <div class="small text-secondary">@alert.VehicleDisplayName</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@alert.SubsystemName</span></td>
                                <td style="max-width: 320px;">
                                    <div class="fw-bold text-dark">@alert.ComponentTitle</div>
                                    <div class="small text-secondary text-truncate" title="@alert.SymptomDescription">@alert.SymptomDescription</div>
                                    <div class="small text-primary mt-1"><i class="bi bi-info-circle me-1"></i> @alert.RecommendedAction</div>
                                </td>
                                <td>
                                    <span class="fw-bold @(alert.FailureProbability >= 70 ? "text-danger" : "text-warning")">
                                        @alert.FailureProbability%
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(alert.EstimatedRulDays <= 7 ? "bg-danger" : "bg-secondary")">
                                        @alert.EstimatedRulDays days
                                    </span>
                                </td>
                                <td class="fw-bold">@alert.Currency @alert.EstimatedRepairCost.ToString("N0")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (alert.Status == PredictiveRecommendationStatus.Active || alert.Status == PredictiveRecommendationStatus.Acknowledged)
                                        {
                                            <button class="btn btn-sm btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#workOrderModal-@alert.Id" title="Create Work Order">
                                                <i class="bi bi-hammer"></i> Work Order
                                            </button>
                                            <form method="post" asp-page-handler="DismissAlert" asp-route-alertId="@alert.Id" asp-route-reason="Manually dismissed by fleet manager" class="d-inline" onsubmit="return confirm('Dismiss this predictive alert?');">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Dismiss Alert">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (alert.Status == PredictiveRecommendationStatus.WorkOrderCreated)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-all me-1"></i> Work Order Active
                                            </span>
                                        }
                                    </div>

                                    <!-- MODAL: PROMOTE TO WORK ORDER -->
                                    <div class="modal fade text-start" id="workOrderModal-@alert.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <form method="post" asp-page-handler="PromoteToWorkOrder" asp-route-alertId="@alert.Id">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold"><i class="bi bi-hammer me-2 text-success"></i> Schedule Predictive Work Order</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <div class="fw-semibold">Vehicle: @alert.VehicleNumber</div>
                                                            <div class="small text-secondary">Component: @alert.ComponentTitle</div>
                                                        </div>
                                                        <div class="alert alert-warning small">
                                                            <strong>Recommended Action:</strong> @alert.RecommendedAction
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Scheduled Workshop Service Date</label>
                                                            <input type="date" name="scheduledDateUtc" class="form-control" value="@DateTime.UtcNow.AddDays(Math.Min(alert.EstimatedRulDays, 3)).ToString("yyyy-MM-dd")" required>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Workshop Instructions / Notes</label>
                                                            <textarea name="notes" class="form-control" rows="3" placeholder="Priority preventive repair before next dispatch."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success">Confirm Work Order Creation</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
