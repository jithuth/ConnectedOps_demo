@page
@model ConnectedOps.Web.Pages.Fuel.Cards.IndexModel
@{
    ViewData["Title"] = "Fuel Cards";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>Fuel Cards Management</h1>
                <p class="text-muted small mb-0">Securely track company fuel cards, assign limits to vehicles/drivers, and suspend compromised cards.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createCardModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Fuel Card
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label small fw-semibold">Search</label>
                        <input type="text" class="form-control form-control-sm" name="SearchTerm" value="@Model.Query.SearchTerm" placeholder="Reference, provider, masked number, vehicle...">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold">Status</label>
                        <select class="form-select form-select-sm" name="Status">
                            <option value="">All Statuses</option>
                            <option value="Active" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Active)">Active</option>
                            <option value="Suspended" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Suspended)">Suspended</option>
                            <option value="Expired" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Expired)">Expired</option>
                            <option value="Cancelled" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Cancelled)">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill">
                            <i class="bi bi-filter me-1"></i> Filter
                        </button>
                        <a href="/Fuel/Cards" class="btn btn-outline-secondary btn-sm">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- CARDS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Result.Items.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-credit-card-2-front fs-1 d-block mb-2 text-secondary"></i>
                        <h5>No Fuel Cards Found</h5>
                        <p class="small text-muted">No cards registered matching your filters.</p>
                        <button type="button" class="btn btn-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#createCardModal">
                            <i class="bi bi-plus-circle me-1"></i> Add Fuel Card
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Masked Card #</th>
                                    <th>Reference / Label</th>
                                    <th>Provider</th>
                                    <th>Assigned Vehicle</th>
                                    <th>Assigned Driver</th>
                                    <th>Spending Limit</th>
                                    <th>Expiry</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in Model.Result.Items)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-monospace fw-bold small"><i class="bi bi-credit-card me-1 text-primary"></i>@card.CardNumberMasked</span>
                                        </td>
                                        <td class="fw-semibold">@card.CardReference</td>
                                        <td class="small">@card.ProviderName</td>
                                        <td>
                                            @if (card.VehicleId.HasValue)
                                            {
                                                <a href="/Vehicles/Details?id=@card.VehicleId" class="badge bg-light text-dark text-decoration-none">
                                                    @card.VehicleNumber
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Unassigned (Pool)</span>
                                            }
                                        </td>
                                        <td class="small">@(card.DriverName ?? "Unassigned")</td>
                                        <td class="small fw-semibold">
                                            @(card.SpendingLimit.HasValue ? card.SpendingLimit.Value.ToString("C2") : "Unlimited")
                                        </td>
                                        <td class="small text-muted">
                                            @(card.ExpiresAtUtc.HasValue ? card.ExpiresAtUtc.Value.ToLocalTime().ToString("MM/yy") : "—")
                                        </td>
                                        <td>
                                            @if (card.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Active)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else if (card.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Suspended)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Suspended</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">@card.StatusName</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                @if (card.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Active)
                                                {
                                                    <form method="post" asp-page-handler="SetStatus" asp-route-id="@card.Id" class="d-inline">
                                                        <input type="hidden" name="status" value="Suspended" />
                                                        <button type="submit" class="btn btn-outline-warning" title="Suspend Card">
                                                            <i class="bi bi-pause-circle"></i> Suspend
                                                        </button>
                                                    </form>
                                                }
                                                else if (card.Status == ConnectedOps.Domain.Fuel.FuelCardStatus.Suspended)
                                                {
                                                    <form method="post" asp-page-handler="SetStatus" asp-route-id="@card.Id" class="d-inline">
                                                        <input type="hidden" name="status" value="Active" />
                                                        <button type="submit" class="btn btn-outline-success" title="Reactivate Card">
                                                            <i class="bi bi-play-circle"></i> Activate
                                                        </button>
                                                    </form>
                                                }
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@card.Id" class="d-inline" onsubmit="return confirm('Delete this fuel card?');">
                                                    <button type="submit" class="btn btn-outline-danger ms-1" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- CREATE CARD MODAL -->
<div class="modal fade" id="createCardModal" tabindex="-1" aria-labelledby="createCardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createCardModalLabel"><i class="bi bi-plus-circle text-primary me-2"></i>Add Fuel Card</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small py-2">
                        <i class="bi bi-shield-lock me-1"></i> <strong>Card Security:</strong> Full card numbers are never stored in plain text. Only masked digits are saved.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">Card Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm font-monospace" name="CardNumber" placeholder="e.g. 7001 4819 2831 9942" required>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold required">Card Reference / Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="CardReference" placeholder="e.g. Truck 01 Fleet Card" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold required">Provider Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="ProviderName" placeholder="e.g. WEX, Fleetcor, Shell" required>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Assign Vehicle</label>
                            <select class="form-select form-select-sm" name="VehicleId">
                                <option value="">Pool / Unassigned</option>
                                @foreach (var v in Model.Vehicles)
                                {
                                    <option value="@v.Id">@v.VehicleNumber - @v.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Assign Driver</label>
                            <select class="form-select form-select-sm" name="DriverId">
                                <option value="">Pool / Unassigned</option>
                                @foreach (var d in Model.Drivers)
                                {
                                    <option value="@d.Id">@d.DisplayName (@d.DriverNumber)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Spending Limit ($)</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" name="SpendingLimit" placeholder="e.g. 1500.00">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Expiration Date</label>
                            <input type="date" class="form-control form-control-sm" name="ExpiresAtUtc">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Notes</label>
                        <textarea class="form-control form-control-sm" name="Notes" rows="2" placeholder="PIN issued separately to driver..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Add Fuel Card</button>
                </div>
            </div>
        </form>
    </div>
</div>
