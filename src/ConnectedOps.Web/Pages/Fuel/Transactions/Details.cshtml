@page
@model ConnectedOps.Web.Pages.Fuel.Transactions.DetailsModel
@{
    ViewData["Title"] = $"Fuel Transaction - {Model.Transaction.VehicleNumber}";
    var isCancelled = Model.Transaction.Status == ConnectedOps.Domain.Fuel.FuelTransactionStatus.Cancelled;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2">
                    <h1 class="m-0 fw-bold">
                        <i class="bi bi-fuel-pump text-primary me-2"></i>Fuel Transaction
                    </h1>
                    @if (isCancelled)
                    {
                        <span class="badge bg-danger">CANCELLED</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@Model.Transaction.StatusName.ToUpperInvariant()</span>
                    }
                </div>
                <p class="text-muted small mb-0">Refueling entry on @Model.Transaction.TransactionDateUtc.ToLocalTime().ToString("f")</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Fuel/Transactions" class="btn btn-outline-secondary btn-sm me-1">
                    <i class="bi bi-arrow-left me-1"></i> All Transactions
                </a>
                @if (!isCancelled)
                {
                    <a href="/Fuel/Transactions/Edit?id=@Model.Transaction.Id" class="btn btn-outline-primary btn-sm me-1">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="bi bi-x-circle me-1"></i> Cancel Entry
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ANOMALIES ALERT BANNER IF ANY OPEN -->
        @if (Model.Transaction.Anomalies.Any(a => a.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Open))
        {
            <div class="alert alert-warning border-warning shadow-sm mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-shield-exclamation fs-4 text-danger"></i>
                    <h6 class="fw-bold mb-0 text-danger">Fuel Anomaly Detected on this Transaction</h6>
                </div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var a in Model.Transaction.Anomalies.Where(x => x.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Open))
                    {
                        <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded-2 border">
                            <div>
                                <span class="badge bg-danger-subtle text-danger fw-semibold">@a.AnomalyTypeName (@a.SeverityName)</span>
                                <span class="small ms-2 text-dark">@a.Description</span>
                            </div>
                            <div class="d-flex gap-1">
                                <form method="post" asp-page-handler="ResolveAnomaly" asp-route-id="@Model.Transaction.Id" asp-route-anomalyId="@a.Id">
                                    <button type="submit" class="btn btn-sm btn-success py-0 px-2" title="Mark Resolved">
                                        <i class="bi bi-check-lg"></i> Resolve
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="DismissAnomaly" asp-route-id="@Model.Transaction.Id" asp-route-anomalyId="@a.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Dismiss Alert">
                                        <i class="bi bi-x"></i> Dismiss
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- MAIN CARD -->
            <div class="col-12 col-lg-8">
                <!-- FUEL METRICS SUMMARY -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-fuel-pump text-primary me-2"></i>Fueling Summary</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Quantity</span>
                                <div class="fs-4 fw-bold text-dark">@Model.Transaction.Quantity.ToString("N1") <span class="fs-6 text-muted">@Model.Transaction.QuantityUnitName</span></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Unit Price</span>
                                <div class="fs-4 fw-bold text-dark">@Model.Transaction.UnitPrice.ToString("F2") <span class="fs-6 text-muted">/@Model.Transaction.QuantityUnitName</span></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Total Cost</span>
                                <div class="fs-4 fw-bold text-primary">@Model.Transaction.TotalCost.ToString("C2")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted small">Fill Type</span>
                                <div class="mt-1">
                                    @if (Model.Transaction.IsFullTank)
                                    {
                                        <span class="badge bg-primary-subtle text-primary">Full Tank</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Partial Fill</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="row g-3">
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Vehicle</span>
                                <div class="fw-semibold">
                                    <a href="/Vehicles/Details?id=@Model.Transaction.VehicleId" class="text-decoration-none">
                                        @Model.Transaction.VehicleDisplayName
                                    </a>
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Driver</span>
                                <div class="fw-semibold">@(Model.Transaction.DriverName ?? "Unassigned")</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Fuel Type</span>
                                <div><span class="badge bg-secondary-subtle text-secondary">@Model.Transaction.FuelTypeName</span></div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Odometer Reading</span>
                                <div class="fw-semibold">
                                    @(Model.Transaction.OdometerReading.HasValue ? $"{Model.Transaction.OdometerReading.Value:N0} {Model.Transaction.OdometerUnit}" : "Not Recorded")
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Engine Hours</span>
                                <div class="fw-semibold">
                                    @(Model.Transaction.EngineHours.HasValue ? $"{Model.Transaction.EngineHours.Value:N1} hrs" : "Not Recorded")
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted small">Transaction Source</span>
                                <div><span class="badge bg-info-subtle text-info">@Model.Transaction.SourceName</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- EFFICIENCY & ECONOMY ENGINE BREAKDOWN -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-speedometer text-success me-2"></i>Fuel Economy &amp; Efficiency Breakdown</h6>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.Transaction.Efficiency != null && Model.Transaction.Efficiency.HasSufficientData)
                        {
                            <div class="row g-3 text-center mb-3">
                                <div class="col-6 col-md-3">
                                    <div class="p-2 border rounded-2 bg-light-subtle">
                                        <span class="text-muted small">Kilometers / Liter</span>
                                        <div class="fs-4 fw-bold text-success">@Model.Transaction.Efficiency.KilometersPerLiter?.ToString("F2")</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-2 border rounded-2 bg-light-subtle">
                                        <span class="text-muted small">Liters / 100km</span>
                                        <div class="fs-4 fw-bold text-dark">@Model.Transaction.Efficiency.LitersPer100Km?.ToString("F1")</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-2 border rounded-2 bg-light-subtle">
                                        <span class="text-muted small">MPG (US)</span>
                                        <div class="fs-4 fw-bold text-dark">@Model.Transaction.Efficiency.MilesPerGallonUS?.ToString("F1")</div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-2 border rounded-2 bg-light-subtle">
                                        <span class="text-muted small">Cost / Kilometer</span>
                                        <div class="fs-4 fw-bold text-primary">@Model.Transaction.Efficiency.CostPerKilometer?.ToString("C3")</div>
                                    </div>
                                </div>
                            </div>

                            <div class="p-3 bg-light rounded-2 small text-muted">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <strong>Interval Distance:</strong> @Model.Transaction.Efficiency.DistanceKilometers?.ToString("N1") km (@Model.Transaction.Efficiency.DistanceMiles?.ToString("N1") miles)
                                    </div>
                                    <div class="col-6">
                                        <strong>Interval Fuel Volume:</strong> @Model.Transaction.Efficiency.VolumeLiters?.ToString("N1") Liters
                                    </div>
                                    <div class="col-6">
                                        <strong>MPG (Imperial / UK):</strong> @Model.Transaction.Efficiency.MilesPerGallonUK?.ToString("F1") MPG
                                    </div>
                                    <div class="col-6">
                                        <strong>Cost / Mile:</strong> @Model.Transaction.Efficiency.CostPerMile?.ToString("C3")
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded-2 text-center text-muted">
                                <i class="bi bi-info-circle fs-3 text-secondary d-block mb-1"></i>
                                <span class="fw-semibold">Efficiency Baseline In Progress</span>
                                <p class="small mb-0">@(Model.Transaction.Efficiency?.Notes ?? "Calculated automatically upon subsequent full-tank refueling.")</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- DOCUMENTS & ATTACHMENTS -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-paperclip text-primary me-2"></i>Receipts &amp; Attachments</h6>
                        @if (!isCancelled)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#uploadDocModal">
                                <i class="bi bi-plus-circle me-1"></i> Attach Receipt
                            </button>
                        }
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Transaction.Documents.Count == 0)
                        {
                            <div class="p-4 text-center text-muted small">
                                No receipts or documents attached to this transaction.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Type</th>
                                            <th>Title</th>
                                            <th>File</th>
                                            <th>Uploaded</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in Model.Transaction.Documents)
                                        {
                                            <tr>
                                                <td><span class="badge bg-light text-dark">@doc.DocumentTypeName</span></td>
                                                <td class="fw-semibold small">@doc.Title</td>
                                                <td class="small text-truncate" style="max-width: 160px;">@doc.FileName</td>
                                                <td class="small text-muted">@doc.UploadedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                                <td class="text-end">
                                                    @if (!isCancelled)
                                                    {
                                                        <form method="post" asp-page-handler="DeleteDocument" asp-route-id="@Model.Transaction.Id" asp-route-documentId="@doc.Id" class="d-inline" onsubmit="return confirm('Remove attachment?');">
                                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- SIDEBAR DETAILS -->
            <div class="col-12 col-lg-4">
                <!-- STATION & CARD -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 px-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt text-info me-2"></i>Station &amp; Payment Details</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-3">
                            <span class="text-muted small">Station / Vendor</span>
                            <div class="fw-semibold">@(Model.Transaction.FuelStationName ?? "Direct Purchase / On-Site")</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Transaction.FuelStationCode))
                            {
                                <small class="text-muted">Code: @Model.Transaction.FuelStationCode</small>
                            }
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small">Fuel Card</span>
                            <div class="fw-semibold">
                                @if (!string.IsNullOrWhiteSpace(Model.Transaction.FuelCardNumberMasked))
                                {
                                    <i class="bi bi-credit-card-2-front me-1"></i> @Model.Transaction.FuelCardNumberMasked
                                }
                                else
                                {
                                    <span class="text-muted">No card used</span>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small">Receipt / Invoice Number</span>
                            <div class="fw-semibold">@(Model.Transaction.ReceiptNumber ?? "—")</div>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small">Transaction Reference</span>
                            <div class="fw-semibold">@(Model.Transaction.TransactionReference ?? "—")</div>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small">Payment Method</span>
                            <div class="fw-semibold">@(Model.Transaction.PaymentMethod ?? "—")</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Transaction.Notes))
                        {
                            <div class="mb-0">
                                <span class="text-muted small">Notes</span>
                                <div class="small p-2 bg-light rounded-2 text-break">@Model.Transaction.Notes</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- METADATA CARD -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3 px-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Audit Metadata</h6>
                    </div>
                    <div class="card-body p-3 small text-muted">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Transaction ID:</span>
                            <span class="text-dark font-monospace" style="font-size: 0.75rem;">@Model.Transaction.Id</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Created At:</span>
                            <span class="text-dark">@Model.Transaction.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                        </div>
                        @if (Model.Transaction.UpdatedAtUtc.HasValue)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span>Updated At:</span>
                                <span class="text-dark">@Model.Transaction.UpdatedAtUtc.Value.ToLocalTime().ToString("g")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CANCEL MODAL -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Transaction.Id">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="cancelModalLabel"><i class="bi bi-exclamation-octagon me-2"></i>Cancel Fuel Transaction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Are you sure you want to cancel this fuel transaction? It will be marked as cancelled and excluded from fleet analytics.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Cancellation Reason</label>
                        <textarea class="form-control form-control-sm" name="cancellationReason" rows="3" placeholder="Explain why this entry is being cancelled..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Keep Active</button>
                    <button type="submit" class="btn btn-sm btn-danger">Confirm Cancellation</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- UPLOAD DOCUMENT MODAL -->
<div class="modal fade" id="uploadDocModal" tabindex="-1" aria-labelledby="uploadDocModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="AddDocument" asp-route-id="@Model.Transaction.Id">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadDocModalLabel"><i class="bi bi-paperclip me-2"></i>Attach Receipt / Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">Document Type</label>
                        <select class="form-select form-select-sm" name="DocumentType" required>
                            <option value="Receipt">Receipt</option>
                            <option value="Invoice">Invoice</option>
                            <option value="Photo">Fuel Gauge / Pump Photo</option>
                            <option value="FuelCardStatement">Card Statement</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">Title</label>
                        <input type="text" class="form-control form-control-sm" name="Title" placeholder="e.g. Fuel Receipt Shell Station" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">File Name</label>
                        <input type="text" class="form-control form-control-sm" name="FileName" placeholder="e.g. receipt_2026_09.pdf" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold required">File Object Key / URL</label>
                        <input type="text" class="form-control form-control-sm" name="FileObjectKey" placeholder="e.g. storage/fuel/receipt_123.pdf" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Notes</label>
                        <textarea class="form-control form-control-sm" name="Notes" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save Document</button>
                </div>
            </div>
        </form>
    </div>
</div>
