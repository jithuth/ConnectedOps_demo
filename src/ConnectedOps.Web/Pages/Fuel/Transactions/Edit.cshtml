@page
@model ConnectedOps.Web.Pages.Fuel.Transactions.EditModel
@{
    ViewData["Title"] = "Edit Fuel Transaction";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Fuel Transaction</h1>
                <p class="text-muted small mb-0">Update fuel quantities, odometer logs, price records, or station assignments.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Fuel/Transactions/Details?id=@Model.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Details
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-header bg-transparent border-0 pt-3 px-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Refueling Details</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-semibold required">Vehicle <span class="text-danger">*</span></label>
                                    <select class="form-select" asp-for="Input.VehicleId" required>
                                        @foreach (var v in Model.Vehicles)
                                        {
                                            <option value="@v.Id" selected="@(Model.Input.VehicleId == v.Id)">@v.VehicleNumber - @v.DisplayName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.VehicleId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-semibold required">Date &amp; Time (UTC) <span class="text-danger">*</span></label>
                                    <input type="datetime-local" class="form-control" asp-for="Input.TransactionDateUtc" required>
                                    <span asp-validation-for="Input.TransactionDateUtc" class="text-danger small"></span>
                                </div>

                                <div class="col-6 col-md-4">
                                    <label class="form-label small fw-semibold">Fuel Type</label>
                                    <select class="form-select" asp-for="Input.FuelType">
                                        <option value="Diesel">Diesel</option>
                                        <option value="Petrol">Petrol / Gasoline</option>
                                        <option value="Electric">Electric</option>
                                        <option value="CNG">CNG</option>
                                        <option value="LPG">LPG</option>
                                        <option value="Hydrogen">Hydrogen</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>

                                <div class="col-6 col-md-4">
                                    <label class="form-label small fw-semibold">Quantity Unit</label>
                                    <select class="form-select" asp-for="Input.QuantityUnit">
                                        <option value="Liter">Liter (L)</option>
                                        <option value="GallonUS">Gallon US (gal)</option>
                                        <option value="GallonImperial">Gallon UK (gal)</option>
                                        <option value="Kilogram">Kilogram (kg)</option>
                                        <option value="KilowattHour">Kilowatt-hour (kWh)</option>
                                    </select>
                                </div>

                                <div class="col-6 col-md-4">
                                    <label class="form-label small fw-semibold">Currency</label>
                                    <input type="text" class="form-control" asp-for="Input.CurrencyCode" maxlength="3">
                                </div>

                                <div class="col-6 col-md-6">
                                    <label class="form-label small fw-semibold required">Quantity <span class="text-danger">*</span></label>
                                    <input type="number" step="0.01" class="form-control" id="fuel-qty" asp-for="Input.Quantity" required oninput="calculateTotal()">
                                </div>

                                <div class="col-6 col-md-6">
                                    <label class="form-label small fw-semibold required">Unit Price <span class="text-danger">*</span></label>
                                    <input type="number" step="0.001" class="form-control" id="fuel-price" asp-for="Input.UnitPrice" required oninput="calculateTotal()">
                                </div>

                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-2 border d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="small text-muted fw-semibold">Recalculated Total Cost</span>
                                            <div class="small text-muted">Server calculates Quantity &times; Unit Price</div>
                                        </div>
                                        <div class="fs-4 fw-bold text-primary" id="fuel-total-display">@Model.Input.TotalCost?.ToString("C2")</div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" role="switch" id="fullTankSwitch" asp-for="Input.IsFullTank">
                                        <label class="form-check-label fw-semibold" for="fullTankSwitch">Full Tank Refueling</label>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" role="switch" id="partialFillSwitch" asp-for="Input.IsPartialFill">
                                        <label class="form-check-label fw-semibold" for="partialFillSwitch">Partial Fill</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ODOMETER DETAILS -->
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-header bg-transparent border-0 pt-3 px-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-speedometer text-success me-2"></i>Odometer &amp; Distance</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-semibold">Odometer Reading</label>
                                    <input type="number" step="0.1" class="form-control" asp-for="Input.OdometerReading">
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-semibold">Engine Hours</label>
                                    <input type="number" step="0.1" class="form-control" asp-for="Input.EngineHours">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SIDEBAR METADATA -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 mb-4">
                        <div class="card-header bg-transparent border-0 pt-3 px-3">
                            <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt text-info me-2"></i>Station &amp; Payment</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Station / Vendor</label>
                                <select class="form-select form-select-sm" asp-for="Input.FuelStationId">
                                    <option value="">Select Station...</option>
                                    @foreach (var s in Model.Stations)
                                    {
                                        <option value="@s.Id" selected="@(Model.Input.FuelStationId == s.Id)">@s.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Fuel Card</label>
                                <select class="form-select form-select-sm" asp-for="Input.FuelCardId">
                                    <option value="">No Card / Direct</option>
                                    @foreach (var c in Model.Cards)
                                    {
                                        <option value="@c.Id" selected="@(Model.Input.FuelCardId == c.Id)">@c.CardReference (@c.CardNumberMasked)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Driver</label>
                                <select class="form-select form-select-sm" asp-for="Input.DriverId">
                                    <option value="">Select Driver...</option>
                                    @foreach (var d in Model.Drivers)
                                    {
                                        <option value="@d.Id" selected="@(Model.Input.DriverId == d.Id)">@d.DisplayName (@d.DriverNumber)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Receipt Number</label>
                                <input type="text" class="form-control form-control-sm" asp-for="Input.ReceiptNumber">
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Transaction Reference</label>
                                <input type="text" class="form-control form-control-sm" asp-for="Input.TransactionReference">
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Payment Method</label>
                                <input type="text" class="form-control form-control-sm" asp-for="Input.PaymentMethod">
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Notes</label>
                                <textarea class="form-control form-control-sm" rows="3" asp-for="Input.Notes"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <button type="submit" class="btn btn-primary w-100 mb-2">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                            <a href="/Fuel/Transactions/Details?id=@Model.Id" class="btn btn-outline-secondary w-100">
                                Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function calculateTotal() {
        const qty = parseFloat(document.getElementById('fuel-qty').value) || 0;
        const price = parseFloat(document.getElementById('fuel-price').value) || 0;
        const total = (qty * price).toFixed(2);
        document.getElementById('fuel-total-display').innerText = '$' + Number(total).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
</script>
