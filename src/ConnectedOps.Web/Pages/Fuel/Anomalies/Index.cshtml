@page
@model ConnectedOps.Web.Pages.Fuel.Anomalies.IndexModel
@{
    ViewData["Title"] = "Fuel Anomalies & Fraud Detection";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-shield-exclamation text-danger me-2"></i>Fuel Anomalies &amp; Fraud Detection</h1>
                <p class="text-muted small mb-0">Rule-based anomaly detection for tank capacity overfills, rapid repeat transactions, high unit prices, and abnormal fuel economy drops.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Fuel/Dashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-speedometer2 me-1"></i> Fuel Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold">Status</label>
                        <select class="form-select form-select-sm" name="Status">
                            <option value="">All Statuses</option>
                            <option value="Open" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Open)">Open Alerts</option>
                            <option value="Resolved" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Resolved)">Resolved</option>
                            <option value="Dismissed" selected="@(Model.Query.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Dismissed)">Dismissed</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold">Severity</label>
                        <select class="form-select form-select-sm" name="Severity">
                            <option value="">All Severities</option>
                            <option value="Critical" selected="@(Model.Query.Severity == ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Critical)">Critical</option>
                            <option value="High" selected="@(Model.Query.Severity == ConnectedOps.Domain.Fuel.FuelAnomalySeverity.High)">High</option>
                            <option value="Warning" selected="@(Model.Query.Severity == ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Warning)">Warning / Medium</option>
                            <option value="Information" selected="@(Model.Query.Severity == ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Information)">Information</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold">Vehicle</label>
                        <select class="form-select form-select-sm" name="VehicleId">
                            <option value="">All Vehicles</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id" selected="@(Model.Query.VehicleId == v.Id)">@v.VehicleNumber - @v.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill">
                            <i class="bi bi-filter me-1"></i> Filter
                        </button>
                        <a href="/Fuel/Anomalies" class="btn btn-outline-secondary btn-sm">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- ANOMALIES TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Result.Items.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-shield-check text-success fs-1 d-block mb-2"></i>
                        <h5>No Anomalies Detected</h5>
                        <p class="small text-muted">All fuel transactions meet operational parameters and validation rules.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Detected Date</th>
                                    <th>Vehicle</th>
                                    <th>Anomaly Type</th>
                                    <th>Severity</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Result.Items)
                                {
                                    var sevBadge = item.Severity switch
                                    {
                                        ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Critical => "danger",
                                        ConnectedOps.Domain.Fuel.FuelAnomalySeverity.High => "danger",
                                        ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Warning => "warning",
                                        _ => "info"
                                    };

                                    <tr>
                                        <td class="small">
                                            <div class="fw-semibold">@item.DetectedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@item.DetectedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                                        </td>
                                        <td>
                                            <a href="/Vehicles/Details?id=@item.VehicleId" class="fw-semibold text-decoration-none">
                                                @item.VehicleNumber
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(item.RegistrationNumber))
                                            {
                                                <div class="text-muted small">@item.RegistrationNumber</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary">@item.AnomalyTypeName</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-@sevBadge-subtle text-@sevBadge fw-semibold">@item.SeverityName</span>
                                        </td>
                                        <td class="small" style="max-width: 320px;">
                                            <div>@item.Description</div>
                                            @if (!string.IsNullOrWhiteSpace(item.ResolutionNotes))
                                            {
                                                <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                                    <strong>Resolution:</strong> @item.ResolutionNotes
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Open)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Open Alert</span>
                                            }
                                            else if (item.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Resolved)
                                            {
                                                <span class="badge bg-success-subtle text-success">Resolved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Dismissed</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/Fuel/Transactions/Details?id=@item.FuelTransactionId" class="btn btn-outline-secondary" title="View Transaction">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @if (item.Status == ConnectedOps.Domain.Fuel.FuelAnomalyStatus.Open)
                                                {
                                                    <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#resolveModal-@item.Id" title="Resolve">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#dismissModal-@item.Id" title="Dismiss">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                }
                                            </div>

                                            <!-- RESOLVE MODAL -->
                                            <div class="modal fade text-start" id="resolveModal-@item.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <form method="post" asp-page-handler="Resolve" asp-route-id="@item.Id">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i>Resolve Fuel Anomaly</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="small text-muted">@item.Description</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Resolution Notes</label>
                                                                    <textarea class="form-control form-control-sm" name="resolutionNotes" rows="3" placeholder="Action taken (e.g. verified with driver receipt, adjusted duplicate)..." required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-sm btn-success">Mark Resolved</button>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>

                                            <!-- DISMISS MODAL -->
                                            <div class="modal fade text-start" id="dismissModal-@item.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <form method="post" asp-page-handler="Dismiss" asp-route-id="@item.Id">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title"><i class="bi bi-x-circle text-secondary me-2"></i>Dismiss Anomaly Alert</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="small text-muted">@item.Description</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Dismissal Reason</label>
                                                                    <textarea class="form-control form-control-sm" name="dismissalReason" rows="3" placeholder="Reason for dismissal (e.g. false positive, expected off-road generator fueling)..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-sm btn-secondary">Dismiss Alert</button>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
