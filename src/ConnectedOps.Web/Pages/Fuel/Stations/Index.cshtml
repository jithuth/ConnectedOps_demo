@page
@model ConnectedOps.Web.Pages.Fuel.Stations.IndexModel
@{
    ViewData["Title"] = "Fuel Stations & Vendors";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Fuel Stations &amp; Vendors</h1>
                <p class="text-muted small mb-0">Manage on-site fuel depots, preferred third-party commercial stations &amp; retail vendors.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createStationModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Station / Vendor
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-semibold">Search</label>
                        <input type="text" class="form-control form-control-sm" name="SearchTerm" value="@Model.Query.SearchTerm" placeholder="Station name, code, vendor, address...">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold">Station Type</label>
                        <select class="form-select form-select-sm" name="StationType">
                            <option value="">All Station Types</option>
                            <option value="Internal" selected="@(Model.Query.StationType == ConnectedOps.Domain.Fuel.FuelStationType.Internal)">Internal (Depot / Yard)</option>
                            <option value="External" selected="@(Model.Query.StationType == ConnectedOps.Domain.Fuel.FuelStationType.External)">External (Commercial / Retail)</option>
                            <option value="MobileFuel" selected="@(Model.Query.StationType == ConnectedOps.Domain.Fuel.FuelStationType.MobileFuel)">Mobile Bowsers / Tankers</option>
                            <option value="Supplier" selected="@(Model.Query.StationType == ConnectedOps.Domain.Fuel.FuelStationType.Supplier)">Direct Supplier</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold">Branch</label>
                        <select class="form-select form-select-sm" name="BranchId">
                            <option value="">All Branches</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" selected="@(Model.Query.BranchId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-fill">
                            <i class="bi bi-filter me-1"></i> Filter
                        </button>
                        <a href="/Fuel/Stations" class="btn btn-outline-secondary btn-sm">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- STATIONS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Result.Items.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-geo-alt fs-1 d-block mb-2 text-secondary"></i>
                        <h5>No Fuel Stations Found</h5>
                        <p class="small text-muted">No fuel stations or vendors match your query.</p>
                        <button type="button" class="btn btn-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#createStationModal">
                            <i class="bi bi-plus-circle me-1"></i> Add Fuel Station
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Code</th>
                                    <th>Station Name</th>
                                    <th>Vendor / Brand</th>
                                    <th>Type</th>
                                    <th>Branch</th>
                                    <th>Contact Phone</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Result.Items)
                                {
                                    <tr>
                                        <td class="fw-bold font-monospace small">@s.Code</td>
                                        <td>
                                            <div class="fw-semibold">@s.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(s.Address))
                                            {
                                                <small class="text-muted text-truncate d-block" style="max-width: 250px;">@s.Address</small>
                                            }
                                        </td>
                                        <td>@(s.VendorName ?? "—")</td>
                                        <td>
                                            @if (s.StationType == ConnectedOps.Domain.Fuel.FuelStationType.Internal)
                                            {
                                                <span class="badge bg-success-subtle text-success">Internal Depot</span>
                                            }
                                            else if (s.StationType == ConnectedOps.Domain.Fuel.FuelStationType.MobileFuel)
                                            {
                                                <span class="badge bg-warning-subtle text-warning">Mobile Tanker</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info">@s.StationTypeName</span>
                                            }
                                        </td>
                                        <td>@(s.BranchName ?? "All Branches")</td>
                                        <td class="small">@(s.ContactPhone ?? "—")</td>
                                        <td>
                                            @if (s.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline" onsubmit="return confirm('Delete this fuel station?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- CREATE STATION MODAL -->
<div class="modal fade" id="createStationModal" tabindex="-1" aria-labelledby="createStationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createStationModalLabel"><i class="bi bi-plus-circle text-primary me-2"></i>Add Fuel Station / Vendor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold required">Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm text-uppercase" name="Code" placeholder="e.g. ST-01" required>
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-semibold required">Station Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" name="Name" placeholder="e.g. Shell Airport Depot" required>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Vendor / Brand</label>
                            <input type="text" class="form-control form-control-sm" name="VendorName" placeholder="e.g. Shell, BP, Exxon">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Station Type</label>
                            <select class="form-select form-select-sm" name="StationType">
                                <option value="Internal">Internal (Company Depot)</option>
                                <option value="External" selected>External (Commercial / Retail)</option>
                                <option value="MobileFuel">Mobile Bowser / Tanker</option>
                                <option value="Supplier">Direct Bulk Supplier</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Assigned Branch</label>
                        <select class="form-select form-select-sm" name="BranchId">
                            <option value="">All Branches / Global</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Street Address</label>
                        <input type="text" class="form-control form-control-sm" name="Address" placeholder="Physical street address">
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Contact Phone</label>
                            <input type="tel" class="form-control form-control-sm" name="ContactPhone" placeholder="+1-555-0199">
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="stationActiveSwitch">
                                <label class="form-check-label small fw-semibold" for="stationActiveSwitch">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Notes</label>
                        <textarea class="form-control form-control-sm" name="Notes" rows="2" placeholder="Operating hours, discount contracts..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Create Station</button>
                </div>
            </div>
        </form>
    </div>
</div>
