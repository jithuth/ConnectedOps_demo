@page
@model ConnectedOps.Web.Pages.Fuel.DashboardModel
@{
    ViewData["Title"] = "Fuel Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-fuel-pump text-primary me-2"></i>Fuel Intelligence Dashboard</h1>
                <p class="text-muted small mb-0">Real-time fuel consumption, fleet efficiency benchmarks, expenditure trends &amp; fraud anomaly alerts.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Fuel/Anomalies" class="btn btn-outline-warning btn-sm me-1 position-relative">
                    <i class="bi bi-exclamation-triangle me-1"></i> Anomalies
                    @if (Model.Metrics.OpenFuelAnomaliesCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1">@Model.Metrics.OpenFuelAnomaliesCount</span>
                    }
                </a>
                <a href="/Fuel/Analytics" class="btn btn-outline-info btn-sm me-1">
                    <i class="bi bi-graph-up me-1"></i> Analytics
                </a>
                <a href="/Fuel/Transactions/Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Log Fueling
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- TOP KPI ROW -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 bg-gradient h-100 border-start border-4 border-primary">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Fuel Spent (This Month)</span>
                                <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.Metrics.FuelCostThisMonth.ToString("C2")</h3>
                                <small class="text-muted">@Model.Metrics.FuelQuantityThisMonthLiters.ToString("N0") Liters consumed</small>
                            </div>
                            <div class="rounded-circle bg-primary-subtle text-primary p-3">
                                <i class="bi bi-cash-stack fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 bg-gradient h-100 border-start border-4 border-success">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Fleet Fuel Economy</span>
                                <h3 class="fw-bold mb-0 mt-1 text-success">
                                    @(Model.Metrics.AverageFleetEfficiencyKmPerLiter.HasValue ? $"{Model.Metrics.AverageFleetEfficiencyKmPerLiter.Value:F1} km/L" : "N/A")
                                </h3>
                                <small class="text-muted">
                                    @(Model.Metrics.AverageFleetEfficiencyLitersPer100Km.HasValue ? $"{Model.Metrics.AverageFleetEfficiencyLitersPer100Km.Value:F1} L/100km" : "Calculating baseline")
                                </small>
                            </div>
                            <div class="rounded-circle bg-success-subtle text-success p-3">
                                <i class="bi bi-speedometer fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 bg-gradient h-100 border-start border-4 border-info">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Today's Fueling</span>
                                <h3 class="fw-bold mb-0 mt-1 text-info">@Model.Metrics.FuelCostToday.ToString("C2")</h3>
                                <small class="text-muted">@Model.Metrics.FuelTransactionsToday fills (@Model.Metrics.FuelQuantityTodayLiters.ToString("N0") L)</small>
                            </div>
                            <div class="rounded-circle bg-info-subtle text-info p-3">
                                <i class="bi bi-fuel-pump fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 bg-gradient h-100 border-start border-4 border-warning">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Fuel Anomalies</span>
                                <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.Metrics.OpenFuelAnomaliesCount</h3>
                                <small class="text-warning fw-semibold">@Model.Metrics.VehiclesWithPoorEfficiencyCount low-efficiency vehicles</small>
                            </div>
                            <div class="rounded-circle bg-warning-subtle text-warning p-3">
                                <i class="bi bi-exclamation-triangle fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHARTS & CONSUMPTION BREAKDOWN -->
        <div class="row g-3 mb-4">
            <!-- Top Consuming Vehicles -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Top Consuming Vehicles (This Month)</h6>
                        <a href="/Vehicles/Index" class="btn btn-sm btn-link text-decoration-none">All Vehicles</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Metrics.TopFuelConsumingVehicles.Count == 0)
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-truck fs-1 d-block mb-2 text-secondary"></i>
                                No fuel consumption records recorded for this month.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Vehicle</th>
                                            <th>Category</th>
                                            <th class="text-end">Fills</th>
                                            <th class="text-end">Volume (L)</th>
                                            <th class="text-end">Total Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in Model.Metrics.TopFuelConsumingVehicles)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="/Vehicles/Details?id=@v.VehicleId" class="fw-semibold text-decoration-none">
                                                        @v.VehicleNumber
                                                    </a>
                                                    @if (!string.IsNullOrWhiteSpace(v.RegistrationNumber))
                                                    {
                                                        <span class="badge bg-light text-dark ms-1">@v.RegistrationNumber</span>
                                                    }
                                                </td>
                                                <td><span class="badge bg-secondary-subtle text-secondary">@(v.CategoryName ?? "General")</span></td>
                                                <td class="text-end">@v.TransactionCount</td>
                                                <td class="text-end fw-bold">@v.TotalQuantityLiters.ToString("N1")</td>
                                                <td class="text-end fw-bold text-primary">@v.TotalCost.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Fuel By Branch / Type Distribution -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-success me-2"></i>Consumption by Fuel Type &amp; Branch</h6>
                        <a href="/Fuel/Analytics" class="btn btn-sm btn-link text-decoration-none">Detailed Breakdown</a>
                    </div>
                    <div class="card-body p-3">
                        <h6 class="small text-uppercase text-muted fw-semibold mb-2">By Fuel Type</h6>
                        @if (Model.Metrics.FuelByType.Count == 0)
                        {
                            <p class="text-muted small">No data available.</p>
                        }
                        else
                        {
                            @foreach (var item in Model.Metrics.FuelByType)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-semibold">@item.FuelTypeName (@item.TransactionCount fills)</span>
                                        <span>@item.TotalQuantityLiters.ToString("N1") L &bull; <strong class="text-primary">@item.TotalCost.ToString("C2")</strong></span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(Model.Metrics.FuelCostThisYear > 0 ? (item.TotalCost / Model.Metrics.FuelCostThisYear * 100m).ToString("F0") : "0")%"></div>
                                    </div>
                                </div>
                            }
                        }

                        <hr class="my-3">

                        <h6 class="small text-uppercase text-muted fw-semibold mb-2">By Branch</h6>
                        @if (Model.Metrics.FuelByBranch.Count == 0)
                        {
                            <p class="text-muted small">No branch distribution data.</p>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var b in Model.Metrics.FuelByBranch)
                                {
                                    <div class="col-6">
                                        <div class="p-2 border rounded-2 bg-light-subtle">
                                            <div class="fw-semibold small text-truncate">@b.BranchName</div>
                                            <div class="d-flex justify-content-between align-items-center mt-1">
                                                <small class="text-muted">@b.TotalQuantityLiters.ToString("N0") L</small>
                                                <span class="fw-bold small text-primary">@b.TotalCost.ToString("C2")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT TRANSACTIONS & ANOMALIES -->
        <div class="row g-3">
            <!-- Recent Transactions Table -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-info me-2"></i>Recent Fuel Transactions</h6>
                        <a href="/Fuel/Transactions" class="btn btn-sm btn-link text-decoration-none">View All Transactions</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Metrics.RecentTransactions.Count == 0)
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-fuel-pump fs-1 d-block mb-2 text-secondary"></i>
                                No recent fuel transactions found. Click "Log Fueling" to record your first entry.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Date</th>
                                            <th>Vehicle</th>
                                            <th>Type</th>
                                            <th class="text-end">Quantity</th>
                                            <th class="text-end">Cost</th>
                                            <th class="text-center">Economy</th>
                                            <th>Station</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tx in Model.Metrics.RecentTransactions)
                                        {
                                            <tr>
                                                <td class="small">@tx.TransactionDateUtc.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <a href="/Vehicles/Details?id=@tx.VehicleId" class="fw-semibold text-decoration-none">
                                                        @tx.VehicleNumber
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-secondary-subtle text-secondary">@tx.FuelTypeName</span></td>
                                                <td class="text-end fw-bold">@tx.Quantity.ToString("N1") @tx.QuantityUnit</td>
                                                <td class="text-end fw-bold text-primary">@tx.TotalCost.ToString("C2")</td>
                                                <td class="text-center">
                                                    @if (tx.KilometersPerLiter.HasValue)
                                                    {
                                                        <span class="badge bg-success-subtle text-success">@tx.KilometersPerLiter.Value.ToString("F1") km/L</span>
                                                    }
                                                    else if (tx.IsPartialFill)
                                                    {
                                                        <span class="badge bg-light text-muted">Partial</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">&mdash;</span>
                                                    }
                                                </td>
                                                <td class="small text-truncate" style="max-width: 140px;">
                                                    @(tx.FuelStationName ?? "Direct / Other")
                                                </td>
                                                <td class="text-end">
                                                    <a href="/Fuel/Transactions/Details?id=@tx.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Details">
                                                        <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Anomalies / Alerts -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-shield-exclamation text-danger me-2"></i>Recent Anomalies</h6>
                        <a href="/Fuel/Anomalies" class="btn btn-sm btn-link text-decoration-none">All Alerts</a>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.Metrics.RecentAnomalies.Count == 0)
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-check-circle text-success fs-1 d-block mb-2"></i>
                                <span class="fw-semibold">No active fuel anomalies</span>
                                <p class="small text-muted mb-0">All fuelings conform to standard fleet baselines.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var anomaly in Model.Metrics.RecentAnomalies)
                                {
                                    var badgeColor = anomaly.Severity switch
                                    {
                                        ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Critical => "danger",
                                        ConnectedOps.Domain.Fuel.FuelAnomalySeverity.High => "danger",
                                        ConnectedOps.Domain.Fuel.FuelAnomalySeverity.Warning => "warning",
                                        _ => "info"
                                    };

                                    <div class="border rounded-2 p-2 bg-light-subtle">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span class="badge bg-@badgeColor-subtle text-@badgeColor">@anomaly.AnomalyTypeName</span>
                                            <small class="text-muted">@anomaly.DetectedAtUtc.ToLocalTime().ToString("MMM dd")</small>
                                        </div>
                                        <div class="fw-semibold small">@anomaly.VehicleNumber</div>
                                        <p class="small text-muted mb-1 text-truncate" title="@anomaly.Description">@anomaly.Description</p>
                                        <div class="text-end">
                                            <a href="/Fuel/Anomalies" class="btn btn-sm btn-link p-0 text-decoration-none small">Review &rarr;</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
