@page
@model ConnectedOps.Web.Pages.Integrations.FuelFeedsModel
@using ConnectedOps.Domain.Integrations
@{
    ViewData["Title"] = "Fuel Card Automated Clearinghouse (ACH) Feeds";
    ViewData["Subtitle"] = "Direct banking and provider clearinghouse sync for WEX, Shell, FleetCor, ADNOC, and ENOC fuel networks";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- STATS CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Sync Feeds (Month)</div>
                        <div class="h3 fw-bold mb-0">@(Model.Dashboard?.TotalFuelSyncsThisMonth ?? 0)</div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Total Ingested Log Entries</div>
                        <div class="h3 fw-bold mb-0 text-success">@(Model.SyncLogs?.TotalCount ?? 0)</div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-fuel-pump fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Active API Keys</div>
                        <div class="h3 fw-bold mb-0 text-info">@(Model.Dashboard?.ActiveApiKeysCount ?? 0)</div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-key fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Active Webhooks</div>
                        <div class="h3 fw-bold mb-0 text-warning">@(Model.Dashboard?.ActiveWebhooksCount ?? 0)</div>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-broadcast fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PROVIDER CLEARINGHOUSE CARDS -->
<h5 class="fw-bold mb-3"><i class="bi bi-credit-card-2-front me-2 text-primary"></i> Supported Fuel Network Providers</h5>
<div class="row g-3 mb-4">
    <!-- WEX -->
    <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-fuel-pump-fill me-1"></i> WEX Fleet Telepass</h6>
                        <span class="badge bg-success-subtle text-success">ACH Ready</span>
                    </div>
                    <p class="small text-secondary mb-3">Direct North America & Europe clearinghouse transaction ingestion, driver ID matching, and odometer cross-verification.</p>
                </div>
                <form method="post" asp-page-handler="Sync" asp-route-provider="@FuelClearinghouseProvider.Wex">
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-arrow-repeat me-1"></i> Sync WEX Feed Now
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Shell -->
    <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-warning mb-0"><i class="bi bi-fuel-pump-fill me-1"></i> Shell FleetHub</h6>
                        <span class="badge bg-success-subtle text-success">API Connected</span>
                    </div>
                    <p class="small text-secondary mb-3">Global Shell commercial fleet feed with automated fuel volume discrepancy alerts and fraud score detection.</p>
                </div>
                <form method="post" asp-page-handler="Sync" asp-route-provider="@FuelClearinghouseProvider.ShellFleet">
                    <button type="submit" class="btn btn-outline-warning btn-sm w-100">
                        <i class="bi bi-arrow-repeat me-1"></i> Sync Shell Feed Now
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- FleetCor -->
    <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-info mb-0"><i class="bi bi-fuel-pump-fill me-1"></i> FleetCor / Comdata</h6>
                        <span class="badge bg-success-subtle text-success">ACH Ready</span>
                    </div>
                    <p class="small text-secondary mb-3">Enterprise card payment network with virtual card reconciliation and automated GL coding for fleet operations.</p>
                </div>
                <form method="post" asp-page-handler="Sync" asp-route-provider="@FuelClearinghouseProvider.FleetCor">
                    <button type="submit" class="btn btn-outline-info btn-sm w-100">
                        <i class="bi bi-arrow-repeat me-1"></i> Sync FleetCor Feed Now
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ADNOC -->
    <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-fuel-pump-fill me-1"></i> ADNOC Voyage Smart</h6>
                        <span class="badge bg-success-subtle text-success">RFID Sync</span>
                    </div>
                    <p class="small text-secondary mb-3">UAE national fuel network RFID smart tag syncing with real-time station dispenser logging and automated VAT invoicing.</p>
                </div>
                <form method="post" asp-page-handler="Sync" asp-route-provider="@FuelClearinghouseProvider.AdnocFleet">
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-arrow-repeat me-1"></i> Sync ADNOC Feed Now
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ENOC -->
    <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-success mb-0"><i class="bi bi-fuel-pump-fill me-1"></i> ENOC ViP Cardless</h6>
                        <span class="badge bg-success-subtle text-success">Vehicle Plate RFID</span>
                    </div>
                    <p class="small text-secondary mb-3">Cardless fuel identification system with nozzle sensor telemetry and automated transaction matching per vehicle.</p>
                </div>
                <form method="post" asp-page-handler="Sync" asp-route-provider="@FuelClearinghouseProvider.EnocEppco">
                    <button type="submit" class="btn btn-outline-success btn-sm w-100">
                        <i class="bi bi-arrow-repeat me-1"></i> Sync ENOC Feed Now
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- SYNC AUDIT LOG TABLE -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i> Clearinghouse Ingestion Logs</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Provider</th>
                        <th>Transactions</th>
                        <th>Total Spend</th>
                        <th>Total Volume</th>
                        <th>Synced At</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SyncLogs == null || Model.SyncLogs.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-secondary">
                                <i class="bi bi-fuel-pump fs-2 d-block mb-2 text-muted"></i>
                                No fuel clearinghouse feeds synced yet. Click <strong>Sync Feed Now</strong> on any provider above.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model.SyncLogs.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> @log.Status
                                    </span>
                                </td>
                                <td class="fw-bold">@log.ProviderName</td>
                                <td><span class="badge bg-secondary">@log.TransactionsCount txns</span></td>
                                <td class="fw-bold text-success">$@log.TotalSpend.ToString("N2")</td>
                                <td>@log.TotalLiters.ToString("N2") L</td>
                                <td class="small">@log.SyncedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info" type="button" data-bs-toggle="collapse" data-bs-target="#feedSummary-@log.Id">
                                        <i class="bi bi-eye"></i> View Summary
                                    </button>
                                </td>
                            </tr>
                            <tr class="collapse" id="feedSummary-@log.Id">
                                <td colspan="7" class="p-3 bg-body-tertiary">
                                    <div class="fw-semibold small mb-1">Raw Reconciled Clearinghouse Batch:</div>
                                    <pre class="bg-dark text-light p-2 rounded small mb-0" style="max-height: 180px; overflow-y: auto;">@log.RawSummary</pre>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
