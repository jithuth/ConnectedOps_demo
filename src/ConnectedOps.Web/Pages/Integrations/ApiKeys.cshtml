@page
@model ConnectedOps.Web.Pages.Integrations.ApiKeysModel
@using ConnectedOps.Domain.Integrations
@{
    ViewData["Title"] = "Open API Gateway & API Keys";
    ViewData["Subtitle"] = "Issue scoped developer API tokens for machine-to-machine REST access to the ConnectedOps API";
}

@section HeaderActions {
    <button class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newKeyModal">
        <i class="bi bi-key-fill"></i> Generate New API Key
    </button>
}

@if (!string.IsNullOrEmpty(Model.NewlyCreatedKeyPlaintext))
{
    <div class="alert alert-warning border-2 shadow-sm p-4 mb-4" role="alert">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-octagon-fill fs-2 text-warning"></i>
            <div class="w-100">
                <h5 class="alert-heading fw-bold mb-1">Copy Your New API Key Now!</h5>
                <p class="mb-2 small">
                    For security reasons, this key will <strong>never be shown again</strong>. Store it in an environment secret or vault.
                </p>
                <div class="input-group mb-2">
                    <input type="text" class="form-control font-monospace bg-light fw-bold" id="newPlaintextKey" value="@Model.NewlyCreatedKeyPlaintext" readonly>
                    <button class="btn btn-dark" type="button" onclick="copyApiKey()">
                        <i class="bi bi-clipboard me-1"></i> <span id="copyBtnText">Copy Key</span>
                    </button>
                </div>
                <div class="text-secondary small">
                    Key identifier: <code>@Model.NewlyCreatedKeyName</code>. Authentication header format: <code>Authorization: Bearer @Model.NewlyCreatedKeyPlaintext</code>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage) && string.IsNullOrEmpty(Model.NewlyCreatedKeyPlaintext))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- STATS CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Total Keys</div>
                        <div class="h3 fw-bold mb-0">@Model.ApiKeys.Count</div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-key fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Active Keys</div>
                        <div class="h3 fw-bold mb-0 text-success">@Model.ApiKeys.Count(k => k.IsActive && !k.IsExpired)</div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-secondary border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Revoked / Expired</div>
                        <div class="h3 fw-bold mb-0 text-secondary">@Model.ApiKeys.Count(k => !k.IsActive || k.IsExpired)</div>
                    </div>
                    <div class="p-3 bg-secondary-subtle text-secondary rounded-circle">
                        <i class="bi bi-shield-x fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-secondary small fw-bold text-uppercase">Storage Security</div>
                        <div class="h5 fw-bold mb-0 text-info">SHA-256 Hashed</div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="bi bi-lock fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- API KEYS TABLE -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-shield-lock me-2 text-primary"></i> Tenant API Keys</h5>
        <span class="badge bg-secondary">Bearer Token Authorization</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Key Label</th>
                        <th>Prefix</th>
                        <th>Allowed Scopes</th>
                        <th>Expires</th>
                        <th>Last Used</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ApiKeys.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-secondary">
                                <i class="bi bi-key fs-2 d-block mb-2 text-muted"></i>
                                No API keys generated yet. Click <strong>Generate New API Key</strong> above to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var key in Model.ApiKeys)
                        {
                            <tr>
                                <td>
                                    @if (key.IsActive && !key.IsExpired)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Active
                                        </span>
                                    }
                                    else if (key.IsExpired)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-clock-history me-1"></i> Expired
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-slash-circle me-1"></i> Revoked
                                        </span>
                                    }
                                </td>
                                <td class="fw-bold">@key.Name</td>
                                <td>
                                    <span class="font-monospace small bg-body-tertiary px-2 py-1 rounded border">@key.KeyPrefix</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 300px;">
                                        @foreach (var scope in key.Scopes)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;">@scope.ToString()</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (key.ExpiresAtUtc.HasValue)
                                    {
                                        <span>@key.ExpiresAtUtc.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Never</span>
                                    }
                                </td>
                                <td>
                                    @if (key.LastUsedAtUtc.HasValue)
                                    {
                                        <span>@key.LastUsedAtUtc.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Never</span>
                                    }
                                </td>
                                <td>@key.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    @if (key.IsActive && !key.IsExpired)
                                    {
                                        <form method="post" asp-page-handler="Revoke" asp-route-apiKeyId="@key.Id" class="d-inline" onsubmit="return confirm('Revoke this API Key immediately? All integrations using it will be rejected.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Revoke Key">
                                                <i class="bi bi-x-circle me-1"></i> Revoke
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: GENERATE KEY -->
<div class="modal fade" id="newKeyModal" tabindex="-1" aria-labelledby="newKeyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="newKeyModalLabel"><i class="bi bi-key-fill me-2 text-primary"></i> Issue Developer API Key</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Key Identifier / Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. ERP Invoicing Sync Service" required>
                        <div class="form-text">A memorable name indicating what service or partner uses this key.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expiration Date (Optional)</label>
                        <input type="date" name="expiresAtUtc" class="form-control">
                        <div class="form-text">Leave blank for a non-expiring key (revocable anytime).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Granular Permission Scopes <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            @foreach (var scope in Enum.GetValues<ApiKeyScope>())
                            {
                                <div class="col-md-6">
                                    <div class="form-check p-2 border rounded">
                                        <input class="form-check-input" type="checkbox" name="scopes" value="@scope" id="scope-@scope" checked>
                                        <label class="form-check-label fw-semibold small" for="scope-@scope">
                                            <code>@scope.ToString()</code>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> ConnectedOps uses SHA-256 cryptographic hashing to store API keys. Only the plaintext key is returned at creation time.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate API Key</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
function copyApiKey() {
    var copyText = document.getElementById("newPlaintextKey");
    copyText.select();
    copyText.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(copyText.value).then(function() {
        var btnText = document.getElementById("copyBtnText");
        btnText.textContent = "Copied!";
        setTimeout(function() {
            btnText.textContent = "Copy Key";
        }, 3000);
    });
}
</script>
