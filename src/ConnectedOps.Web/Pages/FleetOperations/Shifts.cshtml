@page
@model ConnectedOps.Web.Pages.FleetOperations.ShiftsModel
@{
    ViewData["Title"] = "Fleet Operational Shifts";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">Fleet Operational Shifts</h1>
                <p class="text-muted small mb-0">Define daily shifts, working windows, and branch operational hours for driver assignments</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/FleetOperations/ShiftAssignments" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-calendar-check"></i>
                    <span>Shift Schedule</span>
                </a>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newShiftModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Create Shift</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- SHIFTS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Shift Name</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Branch</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Shifts.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar3 fs-2 d-block mb-2 text-muted"></i>
                                        No fleet shifts configured yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var s in Model.Shifts)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border fw-bold">@s.Code</span>
                                        </td>
                                        <td class="fw-semibold">
                                            <div>@s.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(s.Description))
                                            {
                                                <div class="small text-muted">@s.Description</div>
                                            }
                                        </td>
                                        <td>
                                            <i class="bi bi-clock me-1 text-muted"></i>@s.StartTime.ToString("HH:mm")
                                        </td>
                                        <td>
                                            <i class="bi bi-clock me-1 text-muted"></i>@s.EndTime.ToString("HH:mm")
                                            @if (s.CrossesMidnight)
                                            {
                                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">Overnight (+1 day)</span>
                                            }
                                        </td>
                                        <td>@(s.BranchName ?? "All Branches")</td>
                                        <td>
                                            <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                                @(s.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @if (s.IsActive)
                                            {
                                                <form method="post" asp-page-handler="DeactivateShift" asp-route-id="@s.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Deactivate Shift">
                                                        <i class="bi bi-pause-fill"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="ActivateShift" asp-route-id="@s.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate Shift">
                                                        <i class="bi bi-play-fill"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form method="post" asp-page-handler="DeleteShift" asp-route-id="@s.Id" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to delete this shift?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Shift">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CREATE SHIFT MODAL -->
        <div class="modal fade" id="newShiftModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-page-handler="CreateShift">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Create Operational Shift</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Shift Name <span class="text-danger">*</span></label>
                                <input asp-for="CreateInput.Name" type="text" class="form-control" placeholder="e.g., Morning Route Shift" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Shift Code <span class="text-danger">*</span></label>
                                <input asp-for="CreateInput.Code" type="text" class="form-control" placeholder="e.g., SFT-MORN" required />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold">Start Time <span class="text-danger">*</span></label>
                                    <input asp-for="CreateInput.StartTime" type="time" class="form-control" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold">End Time <span class="text-danger">*</span></label>
                                    <input asp-for="CreateInput.EndTime" type="time" class="form-control" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Branch (Optional)</label>
                                <select asp-for="CreateInput.BranchId" class="form-select">
                                    <option value="">All Branches</option>
                                    @foreach (var b in Model.Branches)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Description / Notes</label>
                                <textarea asp-for="CreateInput.Description" class="form-control" rows="2" placeholder="Operating guidelines, requirements..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary fw-bold px-4">Create Shift</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
