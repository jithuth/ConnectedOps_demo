@page
@model ConnectedOps.Web.Pages.FleetOperations.ShiftAssignmentsModel
@{
    ViewData["Title"] = "Fleet Shift Assignments";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">Fleet Shift Schedule</h1>
                <p class="text-muted small mb-0">Assign drivers and vehicles to operational shifts, track attendance, and schedule coverage</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/FleetOperations/Shifts" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-calendar3"></i>
                    <span>Manage Shifts</span>
                </a>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newAssignmentModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Schedule Assignment</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-lg-3 col-md-6">
                        <select name="ShiftId" class="form-select">
                            <option value="">All Shifts</option>
                            @foreach (var s in Model.Shifts)
                            {
                                <option value="@s.Id" selected="@(Model.ShiftId == s.Id ? "selected" : null)">@s.Name (@s.Code)</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <select name="DriverId" class="form-select">
                            <option value="">All Drivers</option>
                            @foreach (var d in Model.Drivers)
                            {
                                <option value="@d.Id" selected="@(Model.DriverId == d.Id ? "selected" : null)">@d.DriverNumber - @d.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <select name="VehicleId" class="form-select">
                            <option value="">All Vehicles</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id" selected="@(Model.VehicleId == v.Id ? "selected" : null)">@v.VehicleNumber - @v.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                        <a href="/FleetOperations/ShiftAssignments" class="btn btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- ASSIGNMENTS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Shift</th>
                                <th>Driver</th>
                                <th>Vehicle</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Assignments.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-x fs-2 d-block mb-2 text-muted"></i>
                                        No shift assignments scheduled.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var a in Model.Assignments)
                                {
                                    var statusColor = a.AssignmentStatus switch
                                    {
                                        ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Active => "success",
                                        ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Planned => "primary",
                                        ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Completed => "secondary",
                                        _ => "danger"
                                    };

                                    <tr>
                                        <td>
                                            <span class="badge bg-@statusColor">@a.AssignmentStatusName</span>
                                        </td>
                                        <td class="fw-semibold">@a.AssignmentDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <div class="fw-semibold">@a.ShiftName</div>
                                            <div class="text-muted small">@a.ShiftCode</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@(a.DriverDisplayName ?? "Unassigned")</div>
                                            @if (!string.IsNullOrWhiteSpace(a.DriverNumber))
                                            {
                                                <div class="text-muted small">@a.DriverNumber</div>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(a.VehicleNumber))
                                            {
                                                <div class="fw-semibold text-primary">@a.VehicleNumber</div>
                                                <div class="text-muted small">@a.VehicleDisplayName</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Unassigned</span>
                                            }
                                        </td>
                                        <td class="small">@a.StartDateTimeUtc.ToString("g")</td>
                                        <td class="small">@(a.EndDateTimeUtc.HasValue ? a.EndDateTimeUtc.Value.ToString("g") : "—")</td>
                                        <td class="small text-muted text-truncate" style="max-width: 150px;" title="@a.Notes">
                                            @(string.IsNullOrWhiteSpace(a.Notes) ? "—" : a.Notes)
                                        </td>
                                        <td class="text-end">
                                            @if (a.AssignmentStatus == ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Planned)
                                            {
                                                <form method="post" asp-page-handler="ActivateAssignment" asp-route-id="@a.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate">
                                                        <i class="bi bi-play-fill"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (a.AssignmentStatus == ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Active)
                                            {
                                                <form method="post" asp-page-handler="CompleteAssignment" asp-route-id="@a.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Complete">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (a.AssignmentStatus != ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Cancelled && a.AssignmentStatus != ConnectedOps.Domain.FleetOperations.ShiftAssignmentStatus.Completed)
                                            {
                                                <form method="post" asp-page-handler="CancelAssignment" asp-route-id="@a.Id" class="d-inline ms-1" onsubmit="return confirm('Cancel this shift assignment?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CREATE ASSIGNMENT MODAL -->
        <div class="modal fade" id="newAssignmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form method="post" asp-page-handler="CreateAssignment">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold">Schedule Shift Assignment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Shift <span class="text-danger">*</span></label>
                                    <select asp-for="CreateInput.FleetShiftId" class="form-select select2" required>
                                        <option value="">-- Choose Shift --</option>
                                        @foreach (var s in Model.Shifts)
                                        {
                                            <option value="@s.Id">@s.Name (@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm"))</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Assignment Date <span class="text-danger">*</span></label>
                                    <input asp-for="CreateInput.AssignmentDate" type="date" class="form-control" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Driver</label>
                                    <select asp-for="CreateInput.DriverId" class="form-select select2">
                                        <option value="">-- Assign Driver Later --</option>
                                        @foreach (var d in Model.Drivers)
                                        {
                                            <option value="@d.Id">@d.DriverNumber - @d.DisplayName</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Vehicle</label>
                                    <select asp-for="CreateInput.VehicleId" class="form-select select2">
                                        <option value="">-- Assign Vehicle Later --</option>
                                        @foreach (var v in Model.Vehicles)
                                        {
                                            <option value="@v.Id">@v.VehicleNumber - @v.DisplayName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Planned Start Time <span class="text-danger">*</span></label>
                                    <input asp-for="CreateInput.StartDateTimeUtc" type="datetime-local" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Planned End Time</label>
                                    <input asp-for="CreateInput.EndDateTimeUtc" type="datetime-local" class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Assignment Notes</label>
                                <textarea asp-for="CreateInput.Notes" class="form-control" rows="2" placeholder="Route details, standby coverage, etc."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary fw-bold px-4">Schedule</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
