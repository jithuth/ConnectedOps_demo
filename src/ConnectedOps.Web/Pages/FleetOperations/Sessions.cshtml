@page
@model ConnectedOps.Web.Pages.FleetOperations.SessionsModel
@{
    ViewData["Title"] = "Vehicle Usage Sessions";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">Vehicle Usage Sessions</h1>
                <p class="text-muted small mb-0">Complete historical and active vehicle checkout trips, odometer readings, and condition logs</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/FleetOperations/Checkout" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>New Checkout</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-lg-3 col-md-6">
                        <select name="Query.VehicleId" class="form-select">
                            <option value="">All Vehicles</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id" selected="@(Model.Query.VehicleId == v.Id ? "selected" : null)">@v.VehicleNumber - @v.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <select name="Query.DriverId" class="form-select">
                            <option value="">All Drivers</option>
                            @foreach (var d in Model.Drivers)
                            {
                                <option value="@d.Id" selected="@(Model.Query.DriverId == d.Id ? "selected" : null)">@d.DriverNumber - @d.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <select name="Query.Status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="1" selected="@(Model.Query.Status == ConnectedOps.Domain.FleetOperations.UsageSessionStatus.Open ? "selected" : null)">Open (In Use)</option>
                            <option value="2" selected="@(Model.Query.Status == ConnectedOps.Domain.FleetOperations.UsageSessionStatus.Completed ? "selected" : null)">Completed</option>
                            <option value="3" selected="@(Model.Query.Status == ConnectedOps.Domain.FleetOperations.UsageSessionStatus.Cancelled ? "selected" : null)">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <select name="Query.BranchId" class="form-select">
                            <option value="">All Branches</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" selected="@(Model.Query.BranchId == b.Id ? "selected" : null)">@b.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                        <a href="/FleetOperations/Sessions" class="btn btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- SESSIONS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>
                                <th>Vehicle</th>
                                <th>Driver</th>
                                <th>Departure</th>
                                <th>Return</th>
                                <th>Start Odo</th>
                                <th>End Odo</th>
                                <th>Distance</th>
                                <th>Condition</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Sessions.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="bi bi-clock-history fs-2 d-block mb-2 text-muted"></i>
                                        No usage sessions match your filters.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var s in Model.Sessions.Items)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(s.Status == ConnectedOps.Domain.FleetOperations.UsageSessionStatus.Open ? "bg-success" : s.Status == ConnectedOps.Domain.FleetOperations.UsageSessionStatus.Completed ? "bg-secondary" : "bg-danger")">
                                                @s.StatusName
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-primary">
                                            <div>@s.VehicleNumber</div>
                                            <div class="text-muted small">@s.VehicleDisplayName</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@s.DriverDisplayName</div>
                                            <div class="text-muted small">@s.DriverNumber</div>
                                        </td>
                                        <td class="small">
                                            <div>@s.CheckedOutAtUtc.ToString("g")</div>
                                            @if (!string.IsNullOrWhiteSpace(s.Purpose))
                                            {
                                                <div class="text-muted text-truncate" style="max-width: 140px;" title="@s.Purpose">@s.Purpose</div>
                                            }
                                        </td>
                                        <td class="small">
                                            @(s.CheckedInAtUtc.HasValue ? s.CheckedInAtUtc.Value.ToString("g") : "—")
                                        </td>
                                        <td>@s.StartOdometer.ToString("N0") @s.OdometerUnit</td>
                                        <td>@(s.EndOdometer.HasValue ? $"{s.EndOdometer.Value:N0} {s.OdometerUnit}" : "—")</td>
                                        <td class="fw-semibold">
                                            @(s.DistanceTraveled.HasValue ? $"{s.DistanceTraveled.Value:N0} {s.OdometerUnit}" : "—")
                                        </td>
                                        <td class="small">
                                            <span class="badge bg-light text-dark border">Out: @s.CheckoutCondition</span>
                                            @if (s.CheckInCondition.HasValue)
                                            {
                                                <span class="badge @(s.CheckInCondition.Value == ConnectedOps.Domain.FleetOperations.VehicleCondition.Unsafe || s.CheckInCondition.Value == ConnectedOps.Domain.FleetOperations.VehicleCondition.AttentionRequired ? "bg-danger" : "bg-light text-dark border")">In: @s.CheckInCondition.Value</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (s.Status == ConnectedOps.Domain.FleetOperations.UsageSessionStatus.Open)
                                            {
                                                <a href="/FleetOperations/Checkout?sessionId=@s.Id&action=checkin" class="btn btn-sm btn-success me-1" title="Check In">
                                                    <i class="bi bi-box-arrow-in-left me-1"></i> Return
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal-@s.Id" title="Cancel Session">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>

                                                <!-- CANCEL MODAL -->
                                                <div class="modal fade" id="cancelModal-@s.Id" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog text-start">
                                                        <div class="modal-content">
                                                            <form method="post" asp-page-handler="CancelSession">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="sessionId" value="@s.Id" />
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title fw-bold">Cancel Usage Session</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <p>Are you sure you want to cancel the active checkout for vehicle <strong>@s.VehicleNumber</strong> with driver <strong>@s.DriverDisplayName</strong>?</p>
                                                                    <div class="mb-3">
                                                                        <label class="form-label fw-semibold">Cancellation Reason <span class="text-danger">*</span></label>
                                                                        <input type="text" name="reason" class="form-control" placeholder="e.g., Accidental checkout, driver replaced" required />
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                                    <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PAGINATION -->
                @if (Model.Sessions.TotalPages > 1)
                {
                    <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="small text-muted">
                            Showing @(((Model.Sessions.PageNumber - 1) * Model.Sessions.PageSize) + 1) to @(Math.Min(Model.Sessions.PageNumber * Model.Sessions.PageSize, Model.Sessions.TotalCount)) of @Model.Sessions.TotalCount sessions
                        </div>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Sessions.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" href="?Query.PageNumber=@(Model.Sessions.PageNumber - 1)&Query.VehicleId=@Model.Query.VehicleId&Query.DriverId=@Model.Query.DriverId&Query.Status=@Model.Query.Status">Previous</a>
                            </li>
                            @for (var p = 1; p <= Model.Sessions.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Sessions.PageNumber ? "active" : "")">
                                    <a class="page-link" href="?Query.PageNumber=@p&Query.VehicleId=@Model.Query.VehicleId&Query.DriverId=@Model.Query.DriverId&Query.Status=@Model.Query.Status">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Sessions.HasNextPage ? "" : "disabled")">
                                <a class="page-link" href="?Query.PageNumber=@(Model.Sessions.PageNumber + 1)&Query.VehicleId=@Model.Query.VehicleId&Query.DriverId=@Model.Query.DriverId&Query.Status=@Model.Query.Status">Next</a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
