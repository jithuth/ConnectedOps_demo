@page
@model ConnectedOps.Web.Pages.FleetOperations.CheckoutModel
@{
    ViewData["Title"] = "Vehicle Checkout & Return";
    var isCheckIn = string.Equals(Model.Action, "checkin", StringComparison.OrdinalIgnoreCase) || Model.SessionId.HasValue;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">Daily Fleet Dispatch</h1>
                <p class="text-muted small mb-0">Record vehicle checkout to eligible drivers and process vehicle returns with odometer &amp; condition inspection</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/FleetOperations/Board" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-kanban"></i>
                    <span>Operations Board</span>
                </a>
                <a href="/FleetOperations/Sessions" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-clock-history"></i>
                    <span>Session History</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom p-0">
                        <ul class="nav nav-tabs nav-justified" id="dispatchTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-3 fw-bold @(!isCheckIn ? "active text-primary" : "text-muted")" id="checkout-tab" data-bs-toggle="tab" data-bs-target="#checkout-pane" type="button" role="tab">
                                    <i class="bi bi-box-arrow-right me-2 fs-5"></i> Vehicle Checkout
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-3 fw-bold @(isCheckIn ? "active text-success" : "text-muted")" id="checkin-tab" data-bs-toggle="tab" data-bs-target="#checkin-pane" type="button" role="tab">
                                    <i class="bi bi-box-arrow-in-left me-2 fs-5"></i> Vehicle Check-in (Return)
                                </button>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4">
                        <div class="tab-content" id="dispatchTabContent">
                            <!-- CHECKOUT TAB -->
                            <div class="tab-pane fade @(!isCheckIn ? "show active" : "")" id="checkout-pane" role="tabpanel">
                                <form method="post" asp-page-handler="Checkout" id="form-checkout">
                                    @Html.AntiForgeryToken()

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Select Vehicle <span class="text-danger">*</span></label>
                                            <select asp-for="CheckoutInput.VehicleId" class="form-select select2" id="checkout-vehicle-select" required>
                                                <option value="">-- Choose Vehicle --</option>
                                                @foreach (var v in Model.Vehicles)
                                                {
                                                    <option value="@v.Id" data-odo="@v.CurrentOdometer" selected="@(Model.VehicleId == v.Id ? "selected" : null)">
                                                        @v.VehicleNumber - @v.DisplayName (@v.MakeName @v.ModelName)
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Assign Driver <span class="text-danger">*</span></label>
                                            <select asp-for="CheckoutInput.DriverId" class="form-select select2" id="checkout-driver-select" required>
                                                <option value="">-- Choose Driver --</option>
                                                @foreach (var d in Model.Drivers)
                                                {
                                                    <option value="@d.Id" selected="@(Model.DriverId == d.Id ? "selected" : null)">
                                                        @d.DriverNumber - @d.DisplayName
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- REAL-TIME ELIGIBILITY STATUS -->
                                    <div id="eligibility-container" class="mb-3 d-none">
                                        <div id="eligibility-alert" class="alert py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                                            <i id="eligibility-icon" class="bi"></i>
                                            <span id="eligibility-text"></span>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Start Odometer <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <input asp-for="CheckoutInput.StartOdometer" type="number" step="0.01" class="form-control" id="checkout-start-odo" required min="0">
                                                <span class="input-group-text">km</span>
                                            </div>
                                            <span class="form-text small">Must match or exceed vehicle current odometer.</span>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Checkout Condition</label>
                                            <select asp-for="CheckoutInput.CheckoutCondition" class="form-select">
                                                <option value="1">Good (Clean, normal condition)</option>
                                                <option value="2">Acceptable (Minor wear, operable)</option>
                                                <option value="3">Attention Required (Noted defects)</option>
                                                <option value="4">Unsafe</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Departure Location</label>
                                            <select asp-for="CheckoutInput.StartLocationId" class="form-select">
                                                <option value="">-- Fleet Base / Default --</option>
                                                @foreach (var loc in Model.Locations)
                                                {
                                                    <option value="@loc.Id">@loc.Name</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Operational Purpose</label>
                                            <input asp-for="CheckoutInput.Purpose" type="text" class="form-control" placeholder="e.g., Daily route, transfer, client site delivery">
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Trip / Manifest Reference</label>
                                            <input asp-for="CheckoutInput.Reference" type="text" class="form-control" placeholder="e.g., TRP-2026-0901">
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Inspection Notes</label>
                                            <input asp-for="CheckoutInput.Notes" type="text" class="form-control" placeholder="Tire pressure checked, fuel 100%, etc.">
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                                        <a href="/FleetOperations/Board" class="btn btn-outline-secondary">Cancel</a>
                                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm" id="btn-submit-checkout">
                                            <i class="bi bi-check-lg me-1"></i> Confirm Checkout
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <!-- CHECK-IN TAB -->
                            <div class="tab-pane fade @(isCheckIn ? "show active" : "")" id="checkin-pane" role="tabpanel">
                                <form method="post" asp-page-handler="CheckIn" id="form-checkin">
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Select Active Checked-Out Session <span class="text-danger">*</span></label>
                                        <select asp-for="CheckInSessionId" class="form-select select2" id="checkin-session-select" required>
                                            <option value="">-- Select Active Session --</option>
                                            @foreach (var s in Model.OpenSessions)
                                            {
                                                <option value="@s.Id" data-startodo="@s.StartOdometer" data-driver="@s.DriverDisplayName" data-time="@s.CheckedOutAtUtc.ToString("g")" selected="@(Model.SessionId == s.Id ? "selected" : null)">
                                                    @s.VehicleNumber — Driver: @s.DriverDisplayName (Out at @s.CheckedOutAtUtc.ToString("g"), Start Odo: @s.StartOdometer.ToString("N0") km)
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <!-- SESSION SUMMARY CARD -->
                                    <div id="session-summary-box" class="bg-light rounded p-3 mb-3 d-none border">
                                        <div class="row g-2 small">
                                            <div class="col-md-4">
                                                <span class="text-muted">Driver:</span>
                                                <div class="fw-bold" id="summary-driver"></div>
                                            </div>
                                            <div class="col-md-4">
                                                <span class="text-muted">Checked Out At:</span>
                                                <div class="fw-bold" id="summary-time"></div>
                                            </div>
                                            <div class="col-md-4">
                                                <span class="text-muted">Start Odometer:</span>
                                                <div class="fw-bold" id="summary-startodo"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">End Odometer Reading <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <input asp-for="CheckInInput.EndOdometer" type="number" step="0.01" class="form-control" id="checkin-end-odo" required min="0">
                                                <span class="input-group-text">km</span>
                                            </div>
                                            <div id="distance-calc-display" class="form-text text-primary small fw-semibold"></div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Vehicle Condition upon Return <span class="text-danger">*</span></label>
                                            <select asp-for="CheckInInput.Condition" class="form-select" id="checkin-condition-select">
                                                <option value="1">Good (No new issues)</option>
                                                <option value="2">Acceptable (Minor wear)</option>
                                                <option value="3">Attention Required (Defect / needs inspection)</option>
                                                <option value="4">Unsafe / Damaged</option>
                                            </select>
                                            <div id="condition-warning" class="form-text text-danger small d-none">
                                                <i class="bi bi-exclamation-triangle"></i> Selecting Attention Required or Unsafe will automatically trigger an Operational Exception alert.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Return Location</label>
                                            <select asp-for="CheckInInput.EndLocationId" class="form-select">
                                                <option value="">-- Fleet Base / Default --</option>
                                                @foreach (var loc in Model.Locations)
                                                {
                                                    <option value="@loc.Id">@loc.Name</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Check-in / Return Notes</label>
                                            <input asp-for="CheckInInput.Notes" type="text" class="form-control" placeholder="Fuel level, inspection remarks, etc.">
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                                        <a href="/FleetOperations/Board" class="btn btn-outline-secondary">Cancel</a>
                                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm" id="btn-submit-checkin">
                                            <i class="bi bi-box-arrow-in-left me-1"></i> Confirm Return &amp; Record Reading
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const vehicleSelect = document.getElementById('checkout-vehicle-select');
        const driverSelect = document.getElementById('checkout-driver-select');
        const startOdoInput = document.getElementById('checkout-start-odo');
        const eligContainer = document.getElementById('eligibility-container');
        const eligAlert = document.getElementById('eligibility-alert');
        const eligIcon = document.getElementById('eligibility-icon');
        const eligText = document.getElementById('eligibility-text');
        const submitCheckoutBtn = document.getElementById('btn-submit-checkout');

        function updateOdometer() {
            if (!vehicleSelect) return;
            const selectedOpt = vehicleSelect.options[vehicleSelect.selectedIndex];
            if (selectedOpt && selectedOpt.dataset.odo) {
                startOdoInput.value = selectedOpt.dataset.odo;
            }
        }

        async function checkEligibility() {
            const vehicleId = vehicleSelect.value;
            const driverId = driverSelect.value;

            if (!vehicleId || !driverId) {
                eligContainer.classList.add('d-none');
                return;
            }

            try {
                const res = await fetch(`/FleetOperations/Checkout?handler=CheckEligibility&driverId=${driverId}&vehicleId=${vehicleId}`);
                if (res.ok) {
                    const data = await res.json();
                    eligContainer.classList.remove('d-none');
                    if (data.isEligible) {
                        eligAlert.className = "alert alert-success py-2 px-3 small d-flex align-items-center gap-2 mb-0";
                        eligIcon.className = "bi bi-check-circle-fill text-success fs-5";
                        eligText.textContent = "Driver is qualified and eligible to operate this vehicle.";
                        submitCheckoutBtn.disabled = false;
                    } else {
                        eligAlert.className = "alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-0";
                        eligIcon.className = "bi bi-x-circle-fill text-danger fs-5";
                        eligText.textContent = "Ineligible: " + (data.reasons || []).join(", ");
                        submitCheckoutBtn.disabled = true;
                    }
                }
            } catch (err) {
                console.error("Eligibility check failed", err);
            }
        }

        if (vehicleSelect) {
            vehicleSelect.addEventListener('change', function () {
                updateOdometer();
                checkEligibility();
            });
        }

        if (driverSelect) {
            driverSelect.addEventListener('change', checkEligibility);
        }

        // Initial check if values are pre-selected
        if (vehicleSelect && vehicleSelect.value) {
            updateOdometer();
            if (driverSelect && driverSelect.value) {
                checkEligibility();
            }
        }

        // Check-in logic
        const sessionSelect = document.getElementById('checkin-session-select');
        const summaryBox = document.getElementById('session-summary-box');
        const summaryDriver = document.getElementById('summary-driver');
        const summaryTime = document.getElementById('summary-time');
        const summaryStartOdo = document.getElementById('summary-startodo');
        const endOdoInput = document.getElementById('checkin-end-odo');
        const distanceCalc = document.getElementById('distance-calc-display');
        const conditionSelect = document.getElementById('checkin-condition-select');
        const conditionWarning = document.getElementById('condition-warning');

        let currentSessionStartOdo = 0;

        function updateSessionSummary() {
            if (!sessionSelect) return;
            const opt = sessionSelect.options[sessionSelect.selectedIndex];
            if (opt && opt.value) {
                currentSessionStartOdo = parseFloat(opt.dataset.startodo || "0");
                summaryDriver.textContent = opt.dataset.driver || "";
                summaryTime.textContent = opt.dataset.time || "";
                summaryStartOdo.textContent = currentSessionStartOdo.toLocaleString() + " km";
                summaryBox.classList.remove('d-none');
                endOdoInput.min = currentSessionStartOdo;
                if (!endOdoInput.value || parseFloat(endOdoInput.value) < currentSessionStartOdo) {
                    endOdoInput.value = currentSessionStartOdo;
                }
                calcDistance();
            } else {
                summaryBox.classList.add('d-none');
                distanceCalc.textContent = "";
            }
        }

        function calcDistance() {
            const endOdo = parseFloat(endOdoInput.value || "0");
            if (endOdo >= currentSessionStartOdo) {
                const dist = (endOdo - currentSessionStartOdo).toFixed(2);
                distanceCalc.textContent = `Calculated trip distance: ${dist} km`;
            } else {
                distanceCalc.textContent = `Warning: End odometer cannot be less than start odometer (${currentSessionStartOdo} km).`;
            }
        }

        if (sessionSelect) {
            sessionSelect.addEventListener('change', updateSessionSummary);
            if (sessionSelect.value) {
                updateSessionSummary();
            }
        }

        if (endOdoInput) {
            endOdoInput.addEventListener('input', calcDistance);
        }

        if (conditionSelect) {
            conditionSelect.addEventListener('change', function () {
                if (this.value === "3" || this.value === "4") {
                    conditionWarning.classList.remove('d-none');
                } else {
                    conditionWarning.classList.add('d-none');
                }
            });
        }
    });
</script>
}
