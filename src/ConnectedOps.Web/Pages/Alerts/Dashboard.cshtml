@page
@using ConnectedOps.Domain.Alerts
@model ConnectedOps.Web.Pages.Alerts.DashboardModel
@{
    ViewData["Title"] = "Real-Time Alerts & Notification Engine";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="m-0 fs-3 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-bell-fill text-danger"></i> Alerts &amp; Notification Engine
                </h1>
                <p class="text-muted small mb-0">
                    Active operational triggers, rule evaluation, escalation policies &amp; multi-channel dispatch (In-App, SMS, Email, WhatsApp &amp; Telegram)
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newRuleModal">
                    <i class="bi bi-gear-fill"></i> New Alert Rule
                </button>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#dispatchModal">
                    <i class="bi bi-broadcast"></i> Manual Broadcast
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@Model.SuccessMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@Model.ErrorMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- METRIC KPI CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Total Active Alerts</span>
                                <h3 class="fw-bold mb-0 mt-1 @(Model.Metrics.TotalActiveAlerts > 0 ? "text-danger" : "text-success")">
                                    @Model.Metrics.TotalActiveAlerts
                                </h3>
                            </div>
                            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Active fleet incidents requiring attention
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Critical Incidents</span>
                                <h3 class="fw-bold mb-0 mt-1 text-danger">@Model.Metrics.CriticalAlertsCount</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-shield-fill-x fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Immediate safety / compliance impact
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Warnings / Advisory</span>
                                <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.Metrics.WarningAlertsCount</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-cone-striped fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Speeding, minor geofence, idle events
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Dispatches Today</span>
                                <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.Metrics.NotificationsSentTodayCount</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-whatsapp fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            WhatsApp, Telegram &amp; SMS alerts
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN TABS -->
        <ul class="nav nav-pills mb-3" id="alertTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeTabPane" type="button" role="tab">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Active Triggered Alerts (@Model.Metrics.RecentActiveAlerts.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="rules-tab" data-bs-toggle="tab" data-bs-target="#rulesTabPane" type="button" role="tab">
                    <i class="bi bi-sliders me-1"></i> Configured Rules &amp; Thresholds (@Model.Rules.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="dispatches-tab" data-bs-toggle="tab" data-bs-target="#dispatchesTabPane" type="button" role="tab">
                    <i class="bi bi-send-check-fill me-1"></i> Dispatch Log (WhatsApp, Telegram, SMS)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="alertTabsContent">
            <!-- TAB 1: ACTIVE ALERTS -->
            <div class="tab-pane fade show active" id="activeTabPane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        @if (!Model.Metrics.RecentActiveAlerts.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-shield-check text-success display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">No Active Alerts</h5>
                                <p class="text-muted small">All operational parameters and sensors are currently operating within established tolerance thresholds.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Severity</th>
                                            <th>Source</th>
                                            <th>Alert Title &amp; Details</th>
                                            <th>Vehicle / Asset</th>
                                            <th>Driver</th>
                                            <th>Triggered</th>
                                            <th>Status</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var alert in Model.Metrics.RecentActiveAlerts)
                                        {
                                            <tr>
                                                <td>
                                                    @if (alert.Severity == AlertSeverity.Critical)
                                                    {
                                                        <span class="badge bg-danger">Critical</span>
                                                    }
                                                    else if (alert.Severity == AlertSeverity.Warning)
                                                    {
                                                        <span class="badge bg-warning text-dark">Warning</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info text-dark">Info</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary">@alert.SourceTypeName</span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark">@alert.Title</div>
                                                    <div class="text-muted small">@alert.Message</div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(alert.VehiclePlateNumber))
                                                    {
                                                        <span class="badge bg-light text-dark border">
                                                            <i class="bi bi-truck me-1"></i> @alert.VehiclePlateNumber
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">System / Network</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(alert.DriverName))
                                                    {
                                                        <span><i class="bi bi-person me-1"></i> @alert.DriverName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="text-muted small" title="@alert.TriggeredAtUtc.ToString("u")">
                                                        @alert.TriggeredAtUtc.ToString("yyyy-MM-dd HH:mm")
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (alert.Status == AlertStatus.Triggered)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">NEW</span>
                                                    }
                                                    else if (alert.Status == AlertStatus.Acknowledged)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle">ACKNOWLEDGED</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success">@alert.StatusName</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="btn-group btn-group-sm">
                                                        @if (alert.Status == AlertStatus.Triggered)
                                                        {
                                                            <form method="post" asp-page-handler="Acknowledge" class="d-inline">
                                                                <input type="hidden" name="alertId" value="@alert.Id" />
                                                                <button type="submit" class="btn btn-outline-info" title="Acknowledge Alert">
                                                                    <i class="bi bi-check2"></i> Ack
                                                                </button>
                                                            </form>
                                                        }
                                                        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#resolveModal-@alert.Id" title="Resolve Alert">
                                                            <i class="bi bi-check-circle"></i> Resolve
                                                        </button>
                                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#notifyModal-@alert.Id" title="Dispatch Notification">
                                                            <i class="bi bi-send"></i> Notify
                                                        </button>
                                                    </div>

                                                    <!-- RESOLVE MODAL -->
                                                    <div class="modal fade" id="resolveModal-@alert.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered text-start">
                                                            <div class="modal-content">
                                                                <form method="post" asp-page-handler="Resolve">
                                                                    <input type="hidden" name="alertId" value="@alert.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Resolve Alert</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p class="mb-2"><strong>Alert:</strong> @alert.Title</p>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Resolution Notes / Corrective Actions</label>
                                                                            <textarea class="form-control" name="notes" rows="3" placeholder="Describe corrective action taken..." required></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-success">Mark Resolved</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- NOTIFY MODAL -->
                                                    <div class="modal fade" id="notifyModal-@alert.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered text-start">
                                                            <div class="modal-content">
                                                                <form method="post" asp-page-handler="SendNotification">
                                                                    <input type="hidden" name="alertId" value="@alert.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Dispatch Multi-Channel Notification</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Notification Channel</label>
                                                                            <select class="form-select" name="channel" required>
                                                                                <option value="5" selected>WhatsApp (Direct Msg / Group)</option>
                                                                                <option value="6">Telegram (Bot / Channel)</option>
                                                                                <option value="2">SMS (Standard Mobile Gateway)</option>
                                                                                <option value="1">Email (Dispatch &amp; Ops)</option>
                                                                                <option value="4">Webhook (Integration Endpoint)</option>
                                                                                <option value="3">In-App Banner</option>
                                                                            </select>
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Recipient (Phone Number / Chat ID / Email)</label>
                                                                            <input type="text" class="form-control" name="recipient" placeholder="+971501234567 or @@ops_chat" required />
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Message Title</label>
                                                                            <input type="text" class="form-control" name="title" value="[@alert.Severity] @alert.Title" required />
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Message Body</label>
                                                                            <textarea class="form-control" name="body" rows="3" required>@alert.Message (Vehicle: @alert.VehiclePlateNumber)</textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-primary">
                                                                            <i class="bi bi-send-fill me-1"></i> Send Dispatch
                                                                        </button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 2: RULES -->
            <div class="tab-pane fade" id="rulesTabPane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Rule Code</th>
                                        <th>Name &amp; Description</th>
                                        <th>Source</th>
                                        <th>Trigger Severity</th>
                                        <th>Cooldown</th>
                                        <th>Conditions</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rule in Model.Rules)
                                    {
                                        <tr>
                                            <td><span class="badge bg-light text-dark border font-monospace">@rule.Code</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">@rule.Name</div>
                                                <div class="text-muted small">@rule.Description</div>
                                            </td>
                                            <td><span class="badge bg-secondary">@rule.SourceTypeName</span></td>
                                            <td>
                                                @if (rule.Severity == AlertSeverity.Critical)
                                                {
                                                    <span class="badge bg-danger">Critical</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Warning</span>
                                                }
                                            </td>
                                            <td><span class="text-muted small">@rule.CooldownMinutes mins</span></td>
                                            <td>
                                                @if (rule.Conditions.Any())
                                                {
                                                    @foreach (var cond in rule.Conditions)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle me-1">
                                                            @cond.FieldName @cond.OperatorName @cond.ThresholdValue
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Default rule trigger</span>
                                                }
                                            </td>
                                            <td>
                                                @if (rule.IsEnabled)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Disabled</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: DISPATCH LOG -->
            <div class="tab-pane fade" id="dispatchesTabPane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        @if (!Model.Metrics.RecentDispatches.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-chat-left-dots text-muted display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">No Notifications Dispatched Yet</h5>
                                <p class="text-muted small">Dispatches sent via WhatsApp, Telegram, SMS, or Email will be tracked here with delivery confirmation timestamps.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Channel</th>
                                            <th>Recipient</th>
                                            <th>Title</th>
                                            <th>Message Body</th>
                                            <th>Delivery Status</th>
                                            <th>Sent Timestamp</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var msg in Model.Metrics.RecentDispatches)
                                        {
                                            <tr>
                                                <td>
                                                    @if (msg.Channel == NotificationChannelType.WhatsApp)
                                                    {
                                                        <span class="badge bg-success d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-whatsapp"></i> WhatsApp
                                                        </span>
                                                    }
                                                    else if (msg.Channel == NotificationChannelType.Telegram)
                                                    {
                                                        <span class="badge bg-primary d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-telegram"></i> Telegram
                                                        </span>
                                                    }
                                                    else if (msg.Channel == NotificationChannelType.Sms)
                                                    {
                                                        <span class="badge bg-dark d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-chat-text"></i> SMS
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@msg.ChannelName</span>
                                                    }
                                                </td>
                                                <td class="font-monospace small">@msg.Recipient</td>
                                                <td class="fw-semibold">@msg.Title</td>
                                                <td class="text-muted small text-truncate" style="max-width: 300px;">@msg.Body</td>
                                                <td>
                                                    @if (msg.IsDelivered)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                            <i class="bi bi-check-all"></i> Delivered
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning">Queued</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@msg.SentAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NEW RULE MODAL -->
<div class="modal fade" id="newRuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateRule">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Configure New Alert Rule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Rule Code</label>
                            <input type="text" class="form-control" name="code" placeholder="e.g. SPEED_LIMIT_120" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Rule Name</label>
                            <input type="text" class="form-control" name="name" placeholder="e.g. Excessive Speed Warning" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Source Type</label>
                            <select class="form-select" name="sourceType" required>
                                <option value="1">Telematics</option>
                                <option value="2">Geofence</option>
                                <option value="3">ColdChain</option>
                                <option value="4">Speed</option>
                                <option value="5">Dispatch</option>
                                <option value="6">Maintenance</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Trigger Severity</label>
                            <select class="form-select" name="severity" required>
                                <option value="2">Warning</option>
                                <option value="3">Critical</option>
                                <option value="1">Info</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Cooldown (Minutes)</label>
                            <input type="number" class="form-control" name="cooldownMinutes" value="15" min="1" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Description</label>
                            <input type="text" class="form-control" name="description" placeholder="Brief rule trigger explanation..." />
                        </div>
                    </div>
                    <h6 class="fw-bold mt-4 mb-2">Trigger Condition</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Field Name</label>
                            <input type="text" class="form-control" name="fieldName" placeholder="SpeedKmh or Temperature" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Operator</label>
                            <select class="form-select" name="conditionOperator">
                                <option value="2">GreaterThan (&gt;)</option>
                                <option value="4">GreaterThanOrEqual (&gt;=)</option>
                                <option value="1">Equals (==)</option>
                                <option value="3">LessThan (&lt;)</option>
                                <option value="5">LessThanOrEqual (&lt;=)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Threshold Value</label>
                            <input type="text" class="form-control" name="thresholdValue" placeholder="e.g. 120 or -18" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MANUAL BROADCAST MODAL -->
<div class="modal fade" id="dispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="SendNotification">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Manual Notification Broadcast</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Notification Channel</label>
                        <select class="form-select" name="channel" required>
                            <option value="5" selected>WhatsApp (Direct Msg / Group)</option>
                            <option value="6">Telegram (Bot / Channel)</option>
                            <option value="2">SMS (Standard Mobile Gateway)</option>
                            <option value="1">Email (Dispatch &amp; Ops)</option>
                            <option value="4">Webhook (Integration Endpoint)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Recipient (Phone Number / Telegram Handle / Email)</label>
                        <input type="text" class="form-control" name="recipient" placeholder="+971501234567 or @@ops_chat" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Title</label>
                        <input type="text" class="form-control" name="title" placeholder="Operational Broadcast Title" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Message Body</label>
                        <textarea class="form-control" name="body" rows="3" placeholder="Message content..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send-fill me-1"></i> Send Broadcast
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
