@section Scripts {
    <script>
        (function () {
            const vehicleId = '@Model.VehicleId';
            let telematicsLoaded = false;
            const telTab = document.getElementById('telematics-tab');
            if (telTab) {
                telTab.addEventListener('shown.bs.tab', function () {
                    if (telematicsLoaded) return;
                    telematicsLoaded = true;
                    loadTelematics();
                });
            }

            async function loadTelematics() {
                try {
                    // Load assignment
                    const assignResp = await fetch(`/api/tracking-device-assignments/vehicle/${vehicleId}`);
                    const deviceEl = document.getElementById('deviceInfo');
                    if (assignResp.ok) {
                        const assign = await assignResp.json();
                        deviceEl.innerHTML = `
                            <table class="table table-sm table-bordered mb-0">
                                <tr><th class="fw-semibold" style="width:200px">Device</th><td>${assign.deviceIdentifier}</td></tr>
                                <tr><th class="fw-semibold">Assigned Since</th><td>${new Date(assign.assignedFromUtc).toLocaleString()}</td></tr>
                                <tr><th class="fw-semibold">Primary</th><td>${assign.isPrimary ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>'}</td></tr>
                                ${assign.notes ? `<tr><th class="fw-semibold">Notes</th><td>${assign.notes}</td></tr>` : ''}
                            </table>`;
                    }

                    // Load telemetry history
                    const histResp = await fetch(`/api/telematics/vehicle/${vehicleId}/history?Page=1&PageSize=10`);
                    const logEl = document.getElementById('telemetryLog');
                    if (histResp.ok) {
                        const hist = await histResp.json();
                        if (hist.items && hist.items.length > 0) {
                            let rows = hist.items.map(r => `
                                <tr>
                                    <td class="small">${new Date(r.recordedAtUtc).toLocaleString()}</td>
                                    <td class="small">${r.latitude?.toFixed(5) ?? '—'}, ${r.longitude?.toFixed(5) ?? '—'}</td>
                                    <td class="small">${r.speedKph?.toFixed(0) ?? '—'} km/h</td>
                                    <td class="small">${r.ignitionOn === true ? '<i class="bi bi-key-fill text-success"></i> ON' : '<i class="bi bi-key text-muted"></i> OFF'}</td>
                                    <td class="small">${r.eventType ?? '—'}</td>
                                </tr>`).join('');
                            logEl.innerHTML = `<div class="table-responsive"><table class="table table-hover table-sm mb-0">
                                <thead class="table-light"><tr>
                                    <th class="small fw-bold">Time</th><th class="small fw-bold">Position</th>
                                    <th class="small fw-bold">Speed</th><th class="small fw-bold">Ignition</th>
                                    <th class="small fw-bold">Event</th>
                                </tr></thead><tbody>${rows}</tbody></table></div>
                                <div class="p-2 text-muted small text-end">${hist.totalCount} total records</div>`;
                        }
                    }

                    document.getElementById('telematicsLoading').classList.add('d-none');
                    document.getElementById('telematicsContent').classList.remove('d-none');
                } catch (ex) {
                    document.getElementById('telematicsLoading').classList.add('d-none');
                    const errEl = document.getElementById('telematicsError');
                    errEl.textContent = 'Failed to load telematics data: ' + ex.message;
                    errEl.classList.remove('d-none');
                }
            }
        })();
    </script>
}
