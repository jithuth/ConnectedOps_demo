@page "/Vehicles/Details/{id:guid}"
@model ConnectedOps.Web.Pages.Vehicles.DetailsModel
@{
    ViewData["Title"] = $"Vehicle {Model.Vehicle.VehicleNumber} Control Center";
    ViewData["Subtitle"] = $"{Model.Vehicle.DisplayName} - Complete lifecycle intelligence, telemetry, and compliance hub";
}

<!-- ACTION / STATUS HEADER -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 58px; height: 58px; font-size: 1.6rem;">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h3 class="fw-bold mb-0">@Model.Vehicle.VehicleNumber</h3>
                        @switch (Model.Vehicle.Status)
                        {
                            case ConnectedOps.Domain.Vehicles.VehicleStatus.InService:
                                <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle me-1"></i>In Service</span>
                                break;
                            case ConnectedOps.Domain.Vehicles.VehicleStatus.Active:
                                <span class="badge bg-primary px-3 py-2 fs-6">Active</span>
                                break;
                            case ConnectedOps.Domain.Vehicles.VehicleStatus.UnderMaintenance:
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-wrench-adjustable me-1"></i>Maintenance</span>
                                break;
                            case ConnectedOps.Domain.Vehicles.VehicleStatus.OutOfService:
                                <span class="badge bg-danger px-3 py-2 fs-6"><i class="bi bi-x-circle me-1"></i>Out of Service</span>
                                break;
                            case ConnectedOps.Domain.Vehicles.VehicleStatus.Reserved:
                                <span class="badge bg-info px-3 py-2 fs-6"><i class="bi bi-bookmark me-1"></i>Reserved</span>
                                break;
                            default:
                                <span class="badge bg-secondary px-3 py-2 fs-6">@Model.Vehicle.StatusName</span>
                                break;
                        }
                    </div>
                    <div class="text-secondary fw-semibold">
                        @Model.Vehicle.DisplayName &bull; <span class="text-body">@Model.Vehicle.MakeName @Model.Vehicle.ModelName</span> (@(Model.Vehicle.ModelYear?.ToString() ?? "Year N/A"))
                    </div>
                </div>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#odometerModal">
                    <i class="bi bi-speedometer me-1"></i> Record Odometer
                </button>
                <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#statusModal">
                    <i class="bi bi-arrow-repeat me-1"></i> Change Status
                </button>
                <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#documentModal">
                    <i class="bi bi-file-earmark-plus me-1"></i> Add Document
                </button>
                <a href="/Vehicles/Edit/@Model.VehicleId" class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit Vehicle
                </a>
                <a href="/Vehicles/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Fleet Directory
                </a>
            </div>
        </div>

        <hr class="my-3 opacity-25" />

        <!-- QUICK KPI RIBBON -->
        <div class="row g-3 text-center text-sm-start">
            <div class="col-6 col-md-3">
                <div class="small text-secondary fw-semibold text-uppercase">Current Odometer</div>
                <div class="fs-4 fw-bold text-primary">
                    @Model.Vehicle.CurrentOdometer.ToString("N0") <span class="fs-6 fw-normal text-muted">@Model.Vehicle.OdometerUnit</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="small text-secondary fw-semibold text-uppercase">Classification</div>
                <div class="fs-5 fw-bold text-body">
                    @Model.Vehicle.CategoryName
                </div>
                <div class="small text-muted">@Model.Vehicle.FuelTypeName &bull; @Model.Vehicle.TransmissionTypeName</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="small text-secondary fw-semibold text-uppercase">Assigned Station</div>
                <div class="fs-5 fw-bold text-body">
                    @(Model.Vehicle.BranchName ?? "Unassigned")
                </div>
                <div class="small text-muted">@(Model.Vehicle.LocationName ?? "No depot assigned")</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="small text-secondary fw-semibold text-uppercase">Ownership &amp; Compliance</div>
                <div class="fs-5 fw-bold text-body">
                    @Model.Vehicle.OwnershipTypeName
                </div>
                <div class="small">
                    @{
                        var expiringCount = Model.Vehicle.Documents.Count(d => d.IsExpiringSoon || d.IsExpired);
                    }
                    @if (expiringCount > 0)
                    {
                        <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i>@expiringCount doc(s) require attention</span>
                    }
                    else
                    {
                        <span class="text-success"><i class="bi bi-shield-check me-1"></i>@Model.Vehicle.Documents.Count doc(s) up to date</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FEEDBACK ALERTS -->
@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Feedback"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- CONTROL CENTER TABS -->
<div class="card border-0 shadow-sm bg-body">
    <div class="card-header bg-transparent border-bottom p-0">
        <ul class="nav nav-tabs card-header-tabs mx-3 mt-2" id="vehicleTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab">
                    <i class="bi bi-card-heading me-1 text-primary"></i> Overview
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button" role="tab">
                    <i class="bi bi-sliders2 me-1 text-info"></i> Technical Specs
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="reg-tab" data-bs-toggle="tab" data-bs-target="#reg" type="button" role="tab">
                    <i class="bi bi-postcard me-1 text-success"></i> Registrations (@Model.Vehicle.Registrations.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="docs-tab" data-bs-toggle="tab" data-bs-target="#docs" type="button" role="tab">
                    <i class="bi bi-files me-1 text-warning"></i> Documents (@Model.Vehicle.Documents.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="odometer-tab" data-bs-toggle="tab" data-bs-target="#odometer" type="button" role="tab">
                    <i class="bi bi-speedometer2 me-1 text-purple"></i> Odometer Logs
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="activity-tab" data-bs-toggle="tab" data-bs-target="#activity" type="button" role="tab">
                    <i class="bi bi-chat-left-dots me-1 text-secondary"></i> Notes &amp; Activity (@Model.Vehicle.NotesList.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="telematics-tab" data-bs-toggle="tab" data-bs-target="#telematics" type="button" role="tab">
                    <i class="bi bi-broadcast-pin me-1 text-danger"></i> Telematics
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="maintenance-tab" data-bs-toggle="tab" data-bs-target="#maintenance" type="button" role="tab">
                    <i class="bi bi-wrench-adjustable me-1 text-warning"></i> Maintenance (@Model.MaintenanceRecords.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="fuel-tab" data-bs-toggle="tab" data-bs-target="#fuel" type="button" role="tab">
                    <i class="bi bi-fuel-pump me-1 text-danger"></i> Fuel Logs (@(Model.FuelTransactions?.TotalCount ?? 0))
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-4">
        <div class="tab-content" id="vehicleTabsContent">
            <!-- TAB 1: OVERVIEW -->
            <div class="tab-pane fade show active" id="overview" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-upc-scan me-2"></i>Identification &amp; Codes</h6>
                        <table class="table table-bordered table-sm mb-4">
                            <tbody>
                                <tr>
                                    <th class="bg-body-tertiary" style="width: 40%;">Vehicle Number</th>
                                    <td class="fw-bold">@Model.Vehicle.VehicleNumber</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Registration Plate</th>
                                    <td>@(Model.Vehicle.RegistrationNumber ?? "Not Registered")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Internal Code</th>
                                    <td>@(Model.Vehicle.InternalCode ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">VIN</th>
                                    <td class="font-monospace">@(Model.Vehicle.VIN ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Chassis Number</th>
                                    <td class="font-monospace">@(Model.Vehicle.ChassisNumber ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Engine Number</th>
                                    <td class="font-monospace">@(Model.Vehicle.EngineNumber ?? "N/A")</td>
                                </tr>
                            </tbody>
                        </table>

                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-building me-2"></i>Deployment &amp; Operations</h6>
                        <table class="table table-bordered table-sm mb-0">
                            <tbody>
                                <tr>
                                    <th class="bg-body-tertiary" style="width: 40%;">Branch</th>
                                    <td>@(Model.Vehicle.BranchName ?? "None")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Depot / Yard</th>
                                    <td>@(Model.Vehicle.LocationName ?? "None")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">In-Service Date</th>
                                    <td>@(Model.Vehicle.InServiceDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Out-of-Service Date</th>
                                    <td>@(Model.Vehicle.OutOfServiceDate?.ToString("yyyy-MM-dd") ?? "Operational")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-lg-6">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-briefcase me-2"></i>Acquisition &amp; Ownership</h6>
                        <table class="table table-bordered table-sm mb-4">
                            <tbody>
                                <tr>
                                    <th class="bg-body-tertiary" style="width: 40%;">Ownership Type</th>
                                    <td class="fw-bold">@Model.Vehicle.OwnershipTypeName</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Registered Owner</th>
                                    <td>@(Model.Vehicle.OwnerName ?? "Company")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Purchase Date</th>
                                    <td>@(Model.Vehicle.PurchaseDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <th class="bg-body-tertiary">Purchase Price</th>
                                    <td>@(Model.Vehicle.PurchasePrice.HasValue ? $"{Model.Vehicle.CurrencyCode} {Model.Vehicle.PurchasePrice.Value:N2}" : "N/A")</td>
                                </tr>
                                @if (Model.Vehicle.OwnershipType == ConnectedOps.Domain.Vehicles.OwnershipType.Leased)
                                {
                                    <tr>
                                        <th class="bg-body-tertiary">Lessor / Lease Co.</th>
                                        <td>@(Model.Vehicle.LeaseCompany ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Lease Term</th>
                                        <td>@(Model.Vehicle.LeaseStartDate?.ToString("yyyy-MM-dd") ?? "N/A") to @(Model.Vehicle.LeaseEndDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Monthly Lease Cost</th>
                                        <td>@(Model.Vehicle.MonthlyLeaseCost.HasValue ? $"{Model.Vehicle.CurrencyCode} {Model.Vehicle.MonthlyLeaseCost.Value:N2}" : "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-sticky me-2"></i>Operational Remarks</h6>
                        <div class="p-3 bg-body-tertiary rounded border">
                            <p class="mb-0 text-secondary">
                                @(string.IsNullOrWhiteSpace(Model.Vehicle.Notes) ? "No operational remarks recorded." : Model.Vehicle.Notes)
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: TECHNICAL SPECIFICATIONS -->
            <div class="tab-pane fade" id="specs" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-sliders2 me-2"></i>Engineering &amp; Capacity Specifications</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#specsModal">
                        <i class="bi bi-pencil me-1"></i> Edit Specifications
                    </button>
                </div>

                @if (Model.Vehicle.Specification is null)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-sliders2 fs-1 mb-2 d-block text-secondary"></i>
                        <h5>No detailed technical specifications configured</h5>
                        <p class="small text-muted mb-3">Add engine displacement, dimensions, gross weight rating, and axle configuration.</p>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#specsModal">
                            <i class="bi bi-plus-lg me-1"></i> Configure Specifications
                        </button>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6 class="fw-semibold text-secondary mb-2">Powertrain &amp; Electrical</h6>
                            <table class="table table-bordered table-sm mb-4">
                                <tbody>
                                    <tr>
                                        <th class="bg-body-tertiary" style="width: 45%;">Engine Displacement</th>
                                        <td>@(Model.Vehicle.Specification.EngineCapacityCc.HasValue ? $"{Model.Vehicle.Specification.EngineCapacityCc:N0} cc" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Engine Power</th>
                                        <td>@(Model.Vehicle.Specification.EnginePowerKw.HasValue ? $"{Model.Vehicle.Specification.EnginePowerKw:N1} kW" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Cylinders</th>
                                        <td>@(Model.Vehicle.Specification.CylinderCount?.ToString() ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Fuel Tank Capacity</th>
                                        <td>@(Model.Vehicle.Specification.FuelTankCapacity.HasValue ? $"{Model.Vehicle.Specification.FuelTankCapacity:N1} L" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Battery Voltage</th>
                                        <td>@(Model.Vehicle.Specification.BatteryVoltage.HasValue ? $"{Model.Vehicle.Specification.BatteryVoltage:N1} V" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Drive Configuration</th>
                                        <td><span class="badge bg-primary-subtle text-primary">@Model.Vehicle.Specification.DriveTypeName</span></td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Emission Standard</th>
                                        <td>@(Model.Vehicle.Specification.EmissionStandard ?? "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="col-md-6">
                            <h6 class="fw-semibold text-secondary mb-2">Dimensions &amp; Weights</h6>
                            <table class="table table-bordered table-sm mb-4">
                                <tbody>
                                    <tr>
                                        <th class="bg-body-tertiary" style="width: 45%;">Dimensions (L &times; W &times; H)</th>
                                        <td>
                                            @(Model.Vehicle.Specification.LengthMm.HasValue ? $"{Model.Vehicle.Specification.LengthMm:N0}" : "-") &times;
                                            @(Model.Vehicle.Specification.WidthMm.HasValue ? $"{Model.Vehicle.Specification.WidthMm:N0}" : "-") &times;
                                            @(Model.Vehicle.Specification.HeightMm.HasValue ? $"{Model.Vehicle.Specification.HeightMm:N0}" : "-") mm
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Gross Vehicle Weight (GVW)</th>
                                        <td>@(Model.Vehicle.Specification.GrossVehicleWeightKg.HasValue ? $"{Model.Vehicle.Specification.GrossVehicleWeightKg:N0} kg" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Kerb Weight</th>
                                        <td>@(Model.Vehicle.Specification.KerbWeightKg.HasValue ? $"{Model.Vehicle.Specification.KerbWeightKg:N0} kg" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Payload Capacity</th>
                                        <td>@(Model.Vehicle.Specification.PayloadCapacityKg.HasValue ? $"{Model.Vehicle.Specification.PayloadCapacityKg:N0} kg" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Axle &amp; Wheel Count</th>
                                        <td>@(Model.Vehicle.Specification.AxleCount?.ToString() ?? "N/A") axles, @(Model.Vehicle.Specification.WheelCount?.ToString() ?? "N/A") wheels</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Seating Capacity</th>
                                        <td>@(Model.Vehicle.Specification.SeatCount?.ToString() ?? "N/A") seats</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-body-tertiary">Tyre Size (Front / Rear)</th>
                                        <td>@(Model.Vehicle.Specification.TyreSizeFront ?? "N/A") / @(Model.Vehicle.Specification.TyreSizeRear ?? "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <!-- TAB 3: REGISTRATIONS -->
            <div class="tab-pane fade" id="reg" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-postcard me-2"></i>Official Registration History</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#registrationModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Registration Record
                    </button>
                </div>

                @if (!Model.Vehicle.Registrations.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-postcard fs-1 text-secondary mb-2 d-block"></i>
                        <p class="mb-0">No registration history records found.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Status</th>
                                    <th>Plate / Registration</th>
                                    <th>Issuing State / Country</th>
                                    <th>Issuing Authority</th>
                                    <th>Registration Date</th>
                                    <th>Expiry Date</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Vehicle.Registrations)
                                {
                                    <tr>
                                        <td>
                                            @if (r.IsCurrent)
                                            {
                                                <span class="badge bg-success">CURRENT</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Historical</span>
                                            }
                                        </td>
                                        <td class="fw-bold">@r.RegistrationNumber</td>
                                        <td>@(r.RegistrationStateProvince ?? "-") @(r.RegistrationCountryCode ?? "")</td>
                                        <td>@(r.IssuingAuthority ?? "N/A")</td>
                                        <td>@(r.RegistrationDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            @if (r.ExpiryDate.HasValue)
                                            {
                                                <span class="@(r.IsExpired ? "text-danger fw-bold" : "")">
                                                    @r.ExpiryDate.Value.ToString("yyyy-MM-dd")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No Expiry</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@(r.Notes ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- TAB 4: DOCUMENTS -->
            <div class="tab-pane fade" id="docs" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-files me-2"></i>Compliance &amp; Vehicle Documents</h6>
                    <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#documentModal">
                        <i class="bi bi-upload me-1"></i> Upload Document
                    </button>
                </div>

                @if (!Model.Vehicle.Documents.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-file-earmark-medical fs-1 text-secondary mb-2 d-block"></i>
                        <h5>No documents uploaded</h5>
                        <p class="small text-muted mb-3">Upload insurance certificates, roadworthiness permits, emission tests, and lease agreements.</p>
                        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#documentModal">
                            <i class="bi bi-upload me-1"></i> Upload First Document
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Title</th>
                                    <th>Document Number</th>
                                    <th>Issuing Authority</th>
                                    <th>Expiry Date</th>
                                    <th>Compliance Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Vehicle.Documents)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary-subtle text-secondary border">@d.DocumentTypeName</span></td>
                                        <td class="fw-bold">@d.Title</td>
                                        <td class="font-monospace small">@(d.DocumentNumber ?? "-")</td>
                                        <td>@(d.IssuingAuthority ?? "N/A")</td>
                                        <td>@(d.ExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            @if (d.IsExpired)
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>EXPIRED</span>
                                            }
                                            else if (d.IsExpiringSoon)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>EXPIRING SOON</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>VALID</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DeleteDocument" class="d-inline" onsubmit="return confirm('Remove this document?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="documentId" value="@d.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete document">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- TAB 5: ODOMETER -->
            <div class="tab-pane fade" id="odometer" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-speedometer2 me-2"></i>Odometer Telemetry &amp; Log Entries</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#odometerModal">
                        <i class="bi bi-plus-lg me-1"></i> Log Reading
                    </button>
                </div>

                @if (!Model.Vehicle.RecentOdometerEntries.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-speedometer fs-1 text-secondary mb-2 d-block"></i>
                        <p class="mb-0">No odometer entries logged yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reading Date (UTC)</th>
                                    <th>Odometer Reading</th>
                                    <th>Source</th>
                                    <th>Recorded By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.Vehicle.RecentOdometerEntries)
                                {
                                    <tr>
                                        <td>@o.ReadingDateUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="fw-bold fs-6">@o.Reading.ToString("N0") <span class="small fw-normal text-muted">@o.UnitName</span></td>
                                        <td><span class="badge bg-info-subtle text-info border">@o.SourceName</span></td>
                                        <td class="small text-muted">@(o.RecordedByUserId?.ToString() ?? "System")</td>
                                        <td class="small text-muted">@(o.Notes ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- TAB 6: ACTIVITY & NOTES -->
            <div class="tab-pane fade" id="activity" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-chat-left-text me-2"></i>Vehicle Notes Timeline</h6>
                        @if (!Model.Vehicle.NotesList.Any())
                        {
                            <div class="p-4 text-center text-muted bg-body-tertiary rounded">
                                <i class="bi bi-chat-left-dots fs-2 mb-2 d-block"></i>
                                <p class="mb-0">No notes posted yet for this vehicle.</p>
                            </div>
                        }
                        else
                        {
                            <div class="timeline">
                                @foreach (var n in Model.Vehicle.NotesList)
                                {
                                    <div class="card border-0 shadow-sm bg-body mb-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-bold text-primary small">
                                                    <i class="bi bi-person-circle me-1"></i>@(n.CreatedByUserName ?? "Staff Member")
                                                </span>
                                                <span class="small text-muted">@n.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                                            </div>
                                            <p class="mb-0 text-secondary">@n.NoteText</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="col-lg-5">
                        <div class="card border-0 shadow-sm bg-body">
                            <div class="card-header bg-transparent border-bottom py-3">
                                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-pencil-square me-2"></i>Post New Note</h6>
                            </div>
                            <div class="card-body p-3">
                                <form method="post" asp-page-handler="AddNote">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold small">Note Content</label>
                                        <textarea name="noteText" class="form-control" rows="4" placeholder="Record maintenance observation, route incident, tyre change, or inspection..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                                        <i class="bi bi-send me-1"></i> Post Note
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 7: TELEMATICS -->
            <div class="tab-pane fade" id="telematics" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-12">
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-broadcast-pin me-2"></i>Telematics & GPS Tracking</h6>
                        <div id="telematicsLoading" class="text-center p-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-2">Loading telematics data...</p>
                        </div>
                        <div id="telematicsContent" class="d-none">
                            <!-- Active Device Card -->
                            <div class="card border-0 shadow-sm bg-body mb-3" id="deviceCard">
                                <div class="card-header bg-transparent border-bottom py-3">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-cpu me-2 text-primary"></i>Active Tracking Device</h6>
                                </div>
                                <div class="card-body" id="deviceInfo">
                                    <p class="text-muted">No tracking device assigned to this vehicle.</p>
                                </div>
                            </div>
                            <!-- Telemetry State Card -->
                            <div class="card border-0 shadow-sm bg-body mb-3" id="stateCard">
                                <div class="card-header bg-transparent border-bottom py-3">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt me-2 text-success"></i>Latest Position & State</h6>
                                </div>
                                <div class="card-body" id="stateInfo">
                                    <p class="text-muted">No telemetry state available.</p>
                                </div>
                            </div>
                            <!-- Recent Telemetry Log -->
                            <div class="card border-0 shadow-sm bg-body">
                                <div class="card-header bg-transparent border-bottom py-3">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-info"></i>Recent Telemetry Log</h6>
                                </div>
                                <div class="card-body p-0" id="telemetryLog">
                                    <p class="p-3 text-muted">No telemetry records.</p>
                                </div>
                            </div>
                        </div>
                        <div id="telematicsError" class="d-none alert alert-warning"></div>
                    </div>
                </div>
            </div>

            <!-- TAB 8: MAINTENANCE -->
            <div class="tab-pane fade" id="maintenance" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-1"><i class="bi bi-wrench-adjustable text-primary me-2"></i>Vehicle Maintenance &amp; Service Management</h5>
                        <p class="text-muted small mb-0">Assigned preventive maintenance plans, upcoming due schedules, and historical service records.</p>
                    </div>
                    <div>
                        <a href="/Maintenance/Records/Create?vehicleId=@Model.Vehicle.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> New Service Record
                        </a>
                    </div>
                </div>

                <!-- ASSIGNED PLANS & DUE STATUS CARDS -->
                <div class="row g-3 mb-4">
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm bg-body-tertiary h-100">
                            <div class="card-header bg-transparent border-0 pb-0 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0"><i class="bi bi-clipboard2-pulse text-primary me-2"></i>Assigned Plans</h6>
                                <a href="/Maintenance/Plans" class="btn btn-link btn-sm p-0 text-decoration-none">Manage Plans</a>
                            </div>
                            <div class="card-body">
                                @if (!Model.AssignedPlans.Any())
                                {
                                    <div class="text-muted small py-3 text-center">
                                        <i class="bi bi-clipboard-x fs-3 d-block mb-1 text-secondary"></i>
                                        No maintenance plan assigned to this vehicle.
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var plan in Model.AssignedPlans)
                                        {
                                            <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <div class="fw-bold">@plan.PlanName</div>
                                                    <div class="small text-muted font-monospace">@plan.PlanCode &bull; Effective: @plan.EffectiveFromUtc.ToString("yyyy-MM-dd")</div>
                                                </div>
                                                <a href="/Maintenance/Plans/Details?id=@plan.MaintenancePlanId" class="btn btn-sm btn-outline-primary">View Plan</a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm bg-body-tertiary h-100">
                            <div class="card-header bg-transparent border-0 pb-0">
                                <h6 class="fw-bold mb-0"><i class="bi bi-alarm text-warning me-2"></i>Upcoming &amp; Due Items</h6>
                            </div>
                            <div class="card-body">
                                @if (!Model.DueMaintenance.Any())
                                {
                                    <div class="text-muted small py-3 text-center">
                                        <i class="bi bi-check-circle fs-3 d-block mb-1 text-success"></i>
                                        Vehicle is fully serviced. No upcoming or overdue maintenance items.
                                    </div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var due in Model.DueMaintenance)
                                        {
                                            <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <div class="fw-bold">@due.ServiceTypeName</div>
                                                    <div class="small text-muted">
                                                        @(due.ScheduleTypeName)
                                                        @if (due.NextDueOdometer.HasValue)
                                                        {
                                                            <span> &bull; Due at @due.NextDueOdometer.Value.ToString("N0") km</span>
                                                        }
                                                        @if (due.NextDueDateUtc.HasValue)
                                                        {
                                                            <span> &bull; Due @due.NextDueDateUtc.Value.ToString("yyyy-MM-dd")</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div>
                                                    @switch (due.DueStatus)
                                                    {
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceDueStatus.Overdue:
                                                            <span class="badge bg-danger">Overdue</span>
                                                            break;
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceDueStatus.Due:
                                                            <span class="badge bg-warning text-dark">Due Now</span>
                                                            break;
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceDueStatus.Upcoming:
                                                            <span class="badge bg-info text-dark">Upcoming</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary">@due.DueStatusName</span>
                                                            break;
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SERVICE HISTORY TABLE -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Service Record History</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Ref / Order #</th>
                                        <th>Service Type</th>
                                        <th>Provider / Workshop</th>
                                        <th>Date</th>
                                        <th>Odometer / Hours</th>
                                        <th>Total Cost</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.MaintenanceRecords.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-5 text-muted">
                                                <i class="bi bi-tools fs-1 text-muted d-block mb-2"></i>
                                                No maintenance records logged for this vehicle yet.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var rec in Model.MaintenanceRecords)
                                        {
                                            <tr>
                                                <td class="fw-bold font-monospace">
                                                    <a href="/Maintenance/Records/Details?id=@rec.Id" class="text-decoration-none">
                                                        @(rec.ReferenceNumber ?? rec.Id.ToString()[..8].ToUpperInvariant())
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@rec.ServiceTypeName</div>
                                                    <span class="badge bg-light text-dark border">@rec.MaintenanceTypeName</span>
                                                </td>
                                                <td>@(rec.ProviderName ?? "Internal / Not specified")</td>
                                                <td class="small">
                                                    <div>@(rec.CompletedDateTimeUtc?.ToString("yyyy-MM-dd") ?? rec.ServiceDateUtc.ToString("yyyy-MM-dd"))</div>
                                                </td>
                                                <td class="small">
                                                    <div>@(rec.OdometerReading.HasValue ? $"{rec.OdometerReading.Value:N0} km" : "—")</div>
                                                    <div>@(rec.EngineHours.HasValue ? $"{rec.EngineHours.Value:N0} hrs" : "—")</div>
                                                </td>
                                                <td class="fw-bold text-success">
                                                    @rec.TotalCost.ToString("C2")
                                                </td>
                                                <td>
                                                    @switch (rec.Status)
                                                    {
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceRecordStatus.Completed:
                                                            <span class="badge bg-success">Completed</span>
                                                            break;
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceRecordStatus.InProgress:
                                                            <span class="badge bg-primary">In Progress</span>
                                                            break;
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceRecordStatus.Scheduled:
                                                            <span class="badge bg-warning text-dark">Scheduled</span>
                                                            break;
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceRecordStatus.Draft:
                                                            <span class="badge bg-secondary">Draft</span>
                                                            break;
                                                        case ConnectedOps.Domain.Maintenance.MaintenanceRecordStatus.Cancelled:
                                                            <span class="badge bg-dark">Cancelled</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a href="/Maintenance/Records/Details?id=@rec.Id" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye me-1"></i> View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 9: FUEL -->
            <div class="tab-pane fade" id="fuel" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-1"><i class="bi bi-fuel-pump text-danger me-2"></i>Fuel &amp; Energy Telemetry</h5>
                        <p class="text-muted small mb-0">Refueling logs, efficiency calculations, fuel card usage, and anomaly detection.</p>
                    </div>
                    <div>
                        <a href="/Fuel/Transactions/Create?vehicleId=@Model.Vehicle.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Log Refueling
                        </a>
                    </div>
                </div>

                <!-- FUEL SUMMARY KPIS -->
                @if (Model.FuelSummary != null)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm bg-body-tertiary p-3">
                                <div class="text-muted small text-uppercase fw-semibold">This Month Volume</div>
                                <div class="fs-4 fw-bold text-body mt-1">@Model.FuelSummary.FuelQuantityThisMonthLiters.ToString("N1") <span class="fs-6 fw-normal text-muted">L</span></div>
                                <div class="small text-muted">@Model.FuelSummary.TotalTransactions total refueling(s)</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm bg-body-tertiary p-3">
                                <div class="text-muted small text-uppercase fw-semibold">This Month Fuel Cost</div>
                                <div class="fs-4 fw-bold text-success mt-1">@Model.FuelSummary.FuelCostThisMonth.ToString("C2")</div>
                                <div class="small text-muted">@(Model.FuelSummary.OpenAnomalyCount > 0 ? $"{Model.FuelSummary.OpenAnomalyCount} open anomaly alert(s)" : "No fuel anomalies")</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm bg-body-tertiary p-3">
                                <div class="text-muted small text-uppercase fw-semibold">Avg Fuel Economy</div>
                                <div class="fs-4 fw-bold text-primary mt-1">
                                    @(Model.FuelSummary.AverageEfficiencyKmPerLiter.HasValue ? $"{Model.FuelSummary.AverageEfficiencyKmPerLiter.Value:N2} km/L" : "N/A")
                                </div>
                                <div class="small text-muted">
                                    @(Model.FuelSummary.AverageEfficiencyLitersPer100Km.HasValue ? $"{Model.FuelSummary.AverageEfficiencyLitersPer100Km.Value:N2} L/100km" : "No full-fill baseline")
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-0 shadow-sm bg-body-tertiary p-3">
                                <div class="text-muted small text-uppercase fw-semibold">Avg Cost / Distance</div>
                                <div class="fs-4 fw-bold text-dark mt-1">
                                    @(Model.FuelSummary.AverageCostPerKilometer.HasValue ? $"{Model.FuelSummary.AverageCostPerKilometer.Value:C2}/km" : "N/A")
                                </div>
                                <div class="small text-muted">Last refuel: @(Model.FuelSummary.LastFuelingDateUtc?.ToString("yyyy-MM-dd") ?? "None")</div>
                            </div>
                        </div>
                    </div>
                }

                <!-- FUEL TRANSACTIONS TABLE -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-secondary me-2"></i>Refueling Transaction History</h6>
                        <a href="/Fuel/Transactions?VehicleId=@Model.Vehicle.Id" class="btn btn-sm btn-link text-decoration-none">View All in Fuel Ledger</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Ref / Code</th>
                                        <th>Date &amp; Time (UTC)</th>
                                        <th>Station / Vendor</th>
                                        <th>Fuel Type</th>
                                        <th>Quantity</th>
                                        <th>Total Cost</th>
                                        <th>Odometer</th>
                                        <th>Economy</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.FuelTransactions == null || !Model.FuelTransactions.Items.Any())
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center py-5 text-muted">
                                                <i class="bi bi-fuel-pump fs-1 text-muted d-block mb-2"></i>
                                                No fuel transactions logged for this vehicle yet.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var tx in Model.FuelTransactions.Items)
                                        {
                                            <tr>
                                                <td class="fw-bold font-monospace">
                                                    <a href="/Fuel/Transactions/Details?id=@tx.Id" class="text-decoration-none">
                                                        @(tx.TransactionReference ?? tx.Id.ToString()[..8].ToUpperInvariant())
                                                    </a>
                                                </td>
                                                <td class="small">@tx.TransactionDateUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>
                                                    <div class="fw-semibold">@(tx.FuelStationName ?? "Commercial / Vendor")</div>
                                                    <div class="small text-muted">@(tx.DriverName ?? "Driver not recorded")</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary-subtle text-secondary border">@tx.FuelTypeName</span>
                                                    @if (tx.IsFullTank)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border ms-1" title="Full Tank Fill"><i class="bi bi-check2"></i> Full</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-bold">@tx.Quantity.ToString("N2") @tx.QuantityUnit</div>
                                                    <div class="small text-muted">@@ @tx.UnitPrice.ToString("C2")</div>
                                                </td>
                                                <td class="fw-bold text-success">@tx.TotalCost.ToString("C2")</td>
                                                <td class="small">
                                                    <div>@(tx.OdometerReading.HasValue ? $"{tx.OdometerReading.Value:N0} km" : "—")</div>
                                                </td>
                                                <td class="small">
                                                    @if (tx.KilometersPerLiter.HasValue)
                                                    {
                                                        <div class="text-primary fw-semibold">@tx.KilometersPerLiter.Value.ToString("N2") km/L</div>
                                                        <div class="text-muted small">@tx.LitersPer100Km?.ToString("N2") L/100km</div>
                                                    }
                                                    else if (tx.IsFullTank)
                                                    {
                                                        <span class="text-muted fst-italic">Baseline set</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic">Partial fill</span>
                                                    }
                                                </td>
                                                <td>
                                                    @switch (tx.Status)
                                                    {
                                                        case ConnectedOps.Domain.Fuel.FuelTransactionStatus.Confirmed:
                                                            <span class="badge bg-success">Confirmed</span>
                                                            break;
                                                        case ConnectedOps.Domain.Fuel.FuelTransactionStatus.Draft:
                                                            <span class="badge bg-secondary">Draft</span>
                                                            break;
                                                        case ConnectedOps.Domain.Fuel.FuelTransactionStatus.Cancelled:
                                                            <span class="badge bg-danger">Cancelled</span>
                                                            break;
                                                    }
                                                    @if (tx.AnomalyCount > 0)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1" title="@tx.AnomalyCount anomalies flagged"><i class="bi bi-exclamation-triangle"></i> @tx.AnomalyCount</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a href="/Fuel/Transactions/Details?id=@tx.Id" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye me-1"></i> View
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

