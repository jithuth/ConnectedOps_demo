@page "/Vehicles/Dashboard"
@model ConnectedOps.Web.Pages.Vehicles.DashboardModel
@{
    ViewData["Title"] = "Fleet Dashboard";
    ViewData["Subtitle"] = "Real-time telemetry, lifecycle status, operational readiness, and compliance monitoring";
}

<!-- ACTION BAR -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Fleet Intelligence &amp; Overview</h4>
        <p class="text-secondary small mb-0">Monitor active vehicles, service availability, mileage analytics, and document compliance.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Vehicles/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i> Vehicle Directory
        </a>
        <a href="/Vehicles/Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Vehicle
        </a>
    </div>
</div>

<!-- KEY METRICS ROW -->
<div class="row g-3 mb-4">
    <!-- Total Vehicles -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Fleet</div>
                    <div class="fs-2 fw-bold my-1 text-primary">@Model.Stats.TotalVehicles</div>
                    <div class="small text-muted"><span class="text-success fw-semibold">@Model.Stats.ActiveVehicles</span> active / operational</div>
                </div>
                <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                    <i class="bi bi-truck fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- In Service -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">In Service</div>
                    <div class="fs-2 fw-bold my-1 text-success">@Model.Stats.InServiceVehicles</div>
                    <div class="small text-muted">Ready &amp; deployed on missions</div>
                </div>
                <div class="rounded-circle bg-success-subtle p-3 text-success">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Maintenance & Out of Service -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Service Attention</div>
                    <div class="fs-2 fw-bold my-1 text-warning">@(Model.Stats.UnderMaintenanceVehicles + Model.Stats.OutOfServiceVehicles)</div>
                    <div class="small text-muted">@Model.Stats.UnderMaintenanceVehicles in workshop, @Model.Stats.OutOfServiceVehicles grounded</div>
                </div>
                <div class="rounded-circle bg-warning-subtle p-3 text-warning">
                    <i class="bi bi-tools fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Compliance / Expiring Documents -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Expiring Docs</div>
                    <div class="fs-2 fw-bold my-1 @(Model.Stats.ExpiringDocumentsCount > 0 ? "text-danger" : "text-muted")">
                        @Model.Stats.ExpiringDocumentsCount
                    </div>
                    <div class="small text-muted">Expires within 30 days</div>
                </div>
                <div class="rounded-circle @(Model.Stats.ExpiringDocumentsCount > 0 ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary") p-3">
                    <i class="bi bi-file-earmark-medical-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECONDARY METRICS: MILEAGE & RESERVED -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Total Logged Fleet Mileage</div>
                    <div class="fs-4 fw-bold text-info">@Model.Stats.TotalOdometerKm.ToString("N0") <span class="fs-6 fw-normal text-secondary">km</span></div>
                </div>
                <div class="rounded bg-info-subtle text-info p-2">
                    <i class="bi bi-speedometer fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Reserved / Standby Vehicles</div>
                    <div class="fs-4 fw-bold text-primary">@Model.Stats.ReservedVehicles</div>
                </div>
                <div class="rounded bg-primary-subtle text-primary p-2">
                    <i class="bi bi-shield-shaded fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Retired / Inactive Units</div>
                    <div class="fs-4 fw-bold text-secondary">@Model.Stats.InactiveVehicles</div>
                </div>
                <div class="rounded bg-secondary-subtle text-secondary p-2">
                    <i class="bi bi-archive-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row g-4 mb-4">
    <!-- Category Distribution -->
    <div class="col-lg-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Vehicles by Category</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Fuel Type Distribution -->
    <div class="col-lg-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-fuel-pump-fill text-success me-2"></i>Fuel / Powertrain</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="fuelChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Ownership Breakdown -->
    <div class="col-lg-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-briefcase-fill text-warning me-2"></i>Ownership Model</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="ownershipChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Branch Distribution -->
    <div class="col-lg-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt-fill text-info me-2"></i>Fleet by Branch</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="branchChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CRITICAL ALERTS & RECENT VEHICLES -->
<div class="row g-4">
    <!-- Critical Compliance Alerts -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Compliance &amp; Expiry Alerts
                </h6>
                <span class="badge bg-danger-subtle text-danger">@Model.Stats.CriticalDocumentAlerts.Count Alert(s)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Stats.CriticalDocumentAlerts.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check fs-1 text-success mb-2 d-block"></i>
                        <p class="mb-0">All vehicle registrations and documents are compliant and up to date.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Vehicle</th>
                                    <th>Document</th>
                                    <th>Type</th>
                                    <th>Expiry Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.Stats.CriticalDocumentAlerts)
                                {
                                    <tr>
                                        <td class="fw-bold">
                                            <a href="/Vehicles/Details/@alert.VehicleId" class="text-decoration-none">
                                                @alert.VehicleNumber
                                            </a>
                                        </td>
                                        <td>@alert.DocumentTitle</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@alert.DocumentType</span></td>
                                        <td>@(alert.ExpiryDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            @if (alert.IsExpired)
                                            {
                                                <span class="badge bg-danger">EXPIRED</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@alert.DaysRemaining days left</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Fleet Additions -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Recently Registered Vehicles
                </h6>
                <a href="/Vehicles/Index" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Stats.RecentVehicles.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-truck fs-1 mb-2 d-block"></i>
                        <p class="mb-0">No vehicles registered yet.</p>
                        <a href="/Vehicles/Create" class="btn btn-primary btn-sm mt-3">Register Your First Vehicle</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Vehicle</th>
                                    <th>Make &amp; Model</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.Stats.RecentVehicles)
                                {
                                    <tr>
                                        <td>
                                            <a href="/Vehicles/Details/@v.Id" class="fw-bold text-decoration-none">
                                                @v.VehicleNumber
                                            </a>
                                            <div class="text-muted small">@v.DisplayName</div>
                                        </td>
                                        <td>@v.MakeName @v.ModelName</td>
                                        <td><span class="badge bg-light text-dark border">@v.CategoryName</span></td>
                                        <td>
                                            @switch (v.Status)
                                            {
                                                case ConnectedOps.Domain.Vehicles.VehicleStatus.InService:
                                                    <span class="badge bg-success-subtle text-success">In Service</span>
                                                    break;
                                                case ConnectedOps.Domain.Vehicles.VehicleStatus.UnderMaintenance:
                                                    <span class="badge bg-warning-subtle text-warning">Maintenance</span>
                                                    break;
                                                case ConnectedOps.Domain.Vehicles.VehicleStatus.OutOfService:
                                                    <span class="badge bg-danger-subtle text-danger">Out of Service</span>
                                                    break;
                                                case ConnectedOps.Domain.Vehicles.VehicleStatus.Reserved:
                                                    <span class="badge bg-info-subtle text-info">Reserved</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary-subtle text-secondary">@v.StatusName</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="/Vehicles/Details/@v.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chartColors = [
                '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6',
                '#06b6d4', '#ec4899', '#6366f1', '#14b8a6', '#f97316'
            ];

            // Category Chart
            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByCategory.Keys));
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByCategory.Values));
            if (catLabels.length > 0) {
                new Chart(document.getElementById('categoryChart'), {
                    type: 'doughnut',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            data: catData,
                            backgroundColor: chartColors.slice(0, catLabels.length)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }

            // Fuel Chart
            const fuelLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByFuelType.Keys));
            const fuelData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByFuelType.Values));
            if (fuelLabels.length > 0) {
                new Chart(document.getElementById('fuelChart'), {
                    type: 'pie',
                    data: {
                        labels: fuelLabels,
                        datasets: [{
                            data: fuelData,
                            backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#06b6d4']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }

            // Ownership Chart
            const ownLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByOwnershipType.Keys));
            const ownData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByOwnershipType.Values));
            if (ownLabels.length > 0) {
                new Chart(document.getElementById('ownershipChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ownLabels,
                        datasets: [{
                            data: ownData,
                            backgroundColor: ['#3b82f6', '#f59e0b', '#10b981', '#8b5cf6']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }

            // Branch Chart
            const branchLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByBranch.Keys));
            const branchData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stats.VehiclesByBranch.Values));
            if (branchLabels.length > 0) {
                new Chart(document.getElementById('branchChart'), {
                    type: 'bar',
                    data: {
                        labels: branchLabels,
                        datasets: [{
                            label: 'Vehicles',
                            data: branchData,
                            backgroundColor: '#06b6d4'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}
