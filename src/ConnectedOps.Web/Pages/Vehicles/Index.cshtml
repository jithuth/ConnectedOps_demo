@page "/Vehicles/Index"
@model ConnectedOps.Web.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Vehicle Directory";
    ViewData["Subtitle"] = "Unified catalog of enterprise fleet vehicles, lifecycle statuses, and assignments";
}

<!-- PAGE HEADER -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-truck text-primary me-2"></i>Fleet Vehicle Directory</h4>
        <p class="text-secondary small mb-0">Search, filter, monitor and configure all motorized and operational assets across branches.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Vehicles/Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
        <a href="/Vehicles/Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Vehicle
        </a>
    </div>
</div>

<!-- FEEDBACK ALERTS -->
@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Feedback"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FILTER CARD -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-body-tertiary"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" name="SearchTerm" value="@Model.Query.SearchTerm" placeholder="Search number, VIN, name..." />
                </div>
            </div>

            <div class="col-sm-6 col-md-2">
                <select name="CategoryId" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.Query.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="col-sm-6 col-md-2">
                <select name="MakeId" class="form-select form-select-sm">
                    <option value="">All Makes</option>
                    @foreach (var make in Model.Makes)
                    {
                        <option value="@make.Id" selected="@(Model.Query.MakeId == make.Id ? "selected" : null)">@make.Name</option>
                    }
                </select>
            </div>

            <div class="col-sm-6 col-md-2">
                <select name="BranchId" class="form-select form-select-sm">
                    <option value="">All Branches</option>
                    @foreach (var branch in Model.Branches)
                    {
                        <option value="@branch.Id" selected="@(Model.Query.BranchId == branch.Id ? "selected" : null)">@branch.Name</option>
                    }
                </select>
            </div>

            <div class="col-sm-6 col-md-1">
                <select name="Status" class="form-select form-select-sm">
                    <option value="">Status</option>
                    @foreach (var s in Enum.GetValues<ConnectedOps.Domain.Vehicles.VehicleStatus>())
                    {
                        <option value="@((int)s)" selected="@(Model.Query.Status == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>

            <div class="col-sm-6 col-md-1">
                <select name="FuelType" class="form-select form-select-sm">
                    <option value="">Fuel</option>
                    @foreach (var f in Enum.GetValues<ConnectedOps.Domain.Vehicles.FuelType>())
                    {
                        <option value="@((int)f)" selected="@(Model.Query.FuelType == f ? "selected" : null)">@f</option>
                    }
                </select>
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filter">
                    <i class="bi bi-funnel-fill"></i>
                </button>
                <a href="/Vehicles/Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- VEHICLES TABLE CARD -->
<div class="card border-0 shadow-sm bg-body">
    <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-card-list me-2 text-primary"></i>Vehicle Fleet Units
            <span class="badge bg-primary-subtle text-primary ms-2">@Model.Vehicles.TotalCount Result(s)</span>
        </h6>
        <div class="small text-muted">
            Page @Model.Vehicles.PageNumber of @(Model.Vehicles.TotalPages == 0 ? 1 : Model.Vehicles.TotalPages)
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Vehicles.Items.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-truck fs-1 text-secondary mb-3 d-block"></i>
                <h5>No vehicles found matching criteria</h5>
                <p class="small text-secondary mb-3">Try adjusting your filters or register a new vehicle into the fleet catalog.</p>
                <a href="/Vehicles/Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Register New Vehicle
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Vehicle</th>
                            <th>Make &amp; Model</th>
                            <th>Category</th>
                            <th>Lifecycle Status</th>
                            <th>Branch / Location</th>
                            <th>Odometer</th>
                            <th>Compliance</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Vehicles.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 0.85rem;">
                                            <i class="bi bi-truck"></i>
                                        </div>
                                        <div>
                                            <a href="/Vehicles/Details/@item.Id" class="fw-bold text-decoration-none text-body">
                                                @item.VehicleNumber
                                            </a>
                                            <div class="small text-muted">@item.DisplayName</div>
                                            @if (!string.IsNullOrWhiteSpace(item.RegistrationNumber))
                                            {
                                                <span class="badge bg-light text-secondary border mt-1" style="font-size: 0.7rem;">
                                                    <i class="bi bi-postcard me-1"></i>@item.RegistrationNumber
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.MakeName @item.ModelName</div>
                                    <div class="small text-muted">
                                        @(item.ModelYear?.ToString() ?? "Year N/A") &bull; @item.FuelTypeName &bull; @item.TransmissionTypeName
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case ConnectedOps.Domain.Vehicles.VehicleStatus.InService:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>In Service
                                            </span>
                                            break;
                                        case ConnectedOps.Domain.Vehicles.VehicleStatus.Active:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Active
                                            </span>
                                            break;
                                        case ConnectedOps.Domain.Vehicles.VehicleStatus.UnderMaintenance:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-wrench-adjustable me-1"></i>Maintenance
                                            </span>
                                            break;
                                        case ConnectedOps.Domain.Vehicles.VehicleStatus.OutOfService:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Out of Service
                                            </span>
                                            break;
                                        case ConnectedOps.Domain.Vehicles.VehicleStatus.Reserved:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                <i class="bi bi-bookmark me-1"></i>Reserved
                                            </span>
                                            break;
                                        case ConnectedOps.Domain.Vehicles.VehicleStatus.Draft:
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Draft</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">@item.StatusName</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.BranchName))
                                    {
                                        <div class="fw-semibold small"><i class="bi bi-geo-alt me-1 text-primary"></i>@item.BranchName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.LocationName))
                                        {
                                            <div class="small text-muted"><i class="bi bi-pin-map me-1 text-secondary"></i>@item.LocationName</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="small text-muted fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@item.CurrentOdometer.ToString("N0") <span class="small text-muted fw-normal">@item.OdometerUnit</span></div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-files me-1"></i>@item.DocumentCount
                                        </span>
                                        @if (item.ExpiringDocumentCount > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@item.ExpiringDocumentCount document(s) expiring soon">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@item.ExpiringDocumentCount
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Vehicles/Details/@item.Id" class="btn btn-outline-primary" title="View Control Center">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="visually-hidden">Toggle Dropdown</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item" href="/Vehicles/Edit/@item.Id">
                                                    <i class="bi bi-pencil me-2 text-warning"></i> Edit Vehicle
                                                </a>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#statusModal"
                                                        data-id="@item.Id" data-number="@item.VehicleNumber" data-status="@((int)item.Status)">
                                                    <i class="bi bi-arrow-repeat me-2 text-info"></i> Change Status
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                        data-id="@item.Id" data-number="@item.VehicleNumber">
                                                    <i class="bi bi-trash me-2"></i> Remove Vehicle
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            @if (Model.Vehicles.TotalPages > 1)
            {
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
                    <div class="small text-muted">
                        Showing @(((Model.Vehicles.PageNumber - 1) * Model.Vehicles.PageSize) + 1) to @(Math.Min(Model.Vehicles.PageNumber * Model.Vehicles.PageSize, Model.Vehicles.TotalCount)) of @Model.Vehicles.TotalCount entries
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.Vehicles.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" href="?PageNumber=@(Model.Vehicles.PageNumber - 1)&SearchTerm=@Model.Query.SearchTerm&CategoryId=@Model.Query.CategoryId&MakeId=@Model.Query.MakeId&BranchId=@Model.Query.BranchId&Status=@((int?)Model.Query.Status)&FuelType=@((int?)Model.Query.FuelType)">
                                    &laquo; Previous
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.Vehicles.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Vehicles.PageNumber ? "active" : "")">
                                    <a class="page-link" href="?PageNumber=@p&SearchTerm=@Model.Query.SearchTerm&CategoryId=@Model.Query.CategoryId&MakeId=@Model.Query.MakeId&BranchId=@Model.Query.BranchId&Status=@((int?)Model.Query.Status)&FuelType=@((int?)Model.Query.FuelType)">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(!Model.Vehicles.HasNextPage ? "disabled" : "")">
                                <a class="page-link" href="?PageNumber=@(Model.Vehicles.PageNumber + 1)&SearchTerm=@Model.Query.SearchTerm&CategoryId=@Model.Query.CategoryId&MakeId=@Model.Query.MakeId&BranchId=@Model.Query.BranchId&Status=@((int?)Model.Query.Status)&FuelType=@((int?)Model.Query.FuelType)">
                                    Next &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- CHANGE STATUS MODAL -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ChangeStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalVehicleId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="statusModalLabel">Change Vehicle Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Updating operational status for vehicle: <strong id="modalVehicleNumber" class="text-primary"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Status</label>
                        <select name="newStatus" id="modalStatusSelect" class="form-select" required>
                            @foreach (var s in Enum.GetValues<ConnectedOps.Domain.Vehicles.VehicleStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason / Operational Notes</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Reason for status change, maintenance details, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Save Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteVehicleId" />
                <div class="modal-header bg-danger-subtle">
                    <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Vehicle Removal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to remove vehicle <strong id="deleteVehicleNumber" class="text-danger"></strong>?</p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-info-circle me-1"></i> The vehicle will be soft-deleted. Historical telemetry, documents, and ledger logs will remain intact for auditing.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm">Yes, Remove Vehicle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const statusModal = document.getElementById('statusModal');
            if (statusModal) {
                statusModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const number = button.getAttribute('data-number');
                    const status = button.getAttribute('data-status');

                    document.getElementById('modalVehicleId').value = id;
                    document.getElementById('modalVehicleNumber').textContent = number;
                    if (status) {
                        document.getElementById('modalStatusSelect').value = status;
                    }
                });
            }

            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const number = button.getAttribute('data-number');

                    document.getElementById('deleteVehicleId').value = id;
                    document.getElementById('deleteVehicleNumber').textContent = number;
                });
            }
        });
    </script>
}
