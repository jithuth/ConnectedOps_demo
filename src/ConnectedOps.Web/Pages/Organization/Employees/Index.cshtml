@page "/Organization/Employees"
@model ConnectedOps.Web.Pages.Organization.Employees.IndexModel
@{
    ViewData["Title"] = "Employee Directory";
    ViewData["Subtitle"] = "Manage staff profiles, departmental placements, reporting lines, and login user bindings";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modal-new-employee">
        <i class="bi bi-person-plus"></i>
        <span>Enroll Employee</span>
    </button>
}

<!-- FILTERS CARD -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="BranchId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="DepartmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="TeamId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Teams</option>
                    @foreach (var t in Model.Teams)
                    {
                        <option value="@t.Id" selected="@(Model.TeamId == t.Id)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <a href="/Organization/Employees" class="btn btn-outline-secondary btn-sm w-100">Reset Filters</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm bg-body">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>EMPLOYEE</th>
                    <th>EMP #</th>
                    <th>CONTACT</th>
                    <th>ORGANIZATION PLACEMENT</th>
                    <th>MANAGER</th>
                    <th>SYSTEM USER</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Employees.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <i class="bi bi-people-slash fs-1 d-block mb-2 text-muted"></i>
                            <div>No employees found. Click "Enroll Employee" to add team members.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@emp.FullName</div>
                                <div class="small text-secondary">@(emp.JobTitle ?? "Staff")</div>
                            </td>
                            <td><code>@emp.EmployeeNumber</code></td>
                            <td>
                                <div class="small text-truncate" style="max-width: 180px;">@emp.Email</div>
                                <div class="small text-muted">@(emp.Phone ?? "-")</div>
                            </td>
                            <td>
                                <div><span class="badge bg-primary-subtle text-primary">@(emp.BranchName ?? "No Branch")</span></div>
                                <div class="small mt-1">@(emp.DepartmentName ?? "-") @(emp.TeamName != null ? $" / {emp.TeamName}" : "")</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(emp.ManagerName))
                                {
                                    <div class="small fw-semibold">@emp.ManagerName</div>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td>
                                @if (emp.IsLinkedToUser)
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-link-45deg me-1"></i>User Linked</span>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary py-0 px-2 small" onclick="openLinkUserModal('@emp.Id', '@emp.FullName')">
                                        <i class="bi bi-link me-1"></i>Link User
                                    </button>
                                }
                            </td>
                            <td>
                                <span class="badge @(emp.IsActive ? "badge-active" : "badge-disabled")">@emp.EmploymentStatusName</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" onclick="openEditEmployeeModal('@emp.Id', '@emp.EmployeeNumber', '@emp.FullName', '@emp.Email', '@(emp.JobTitle ?? "")')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (emp.IsLinkedToUser)
                                    {
                                        <form method="post" asp-page-handler="UnlinkUser" asp-route-id="@emp.Id" class="d-inline" title="Unlink system user">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning">
                                                <i class="bi bi-link-45deg"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@emp.Id" onsubmit="return confirm('Remove employee @emp.FullName?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: NEW EMPLOYEE -->
<div class="modal fade" id="modal-new-employee" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Enroll Employee</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Employee # <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.EmployeeNumber" class="form-control text-uppercase" required maxlength="50" placeholder="e.g. EMP-0104" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">First Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.FirstName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Last Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.LastName" class="form-control" required maxlength="100" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="CreateInput.Email" class="form-control" required maxlength="250" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Phone Number</label>
                        <input type="tel" name="CreateInput.Phone" class="form-control" maxlength="50" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Job Title / Designation</label>
                        <input type="text" name="CreateInput.JobTitle" class="form-control" maxlength="150" placeholder="e.g. Senior Fleet Coordinator" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Employment Type <span class="text-danger">*</span></label>
                        <select name="CreateInput.EmploymentType" class="form-select" required>
                            <option value="1" selected>FullTime</option>
                            <option value="2">PartTime</option>
                            <option value="3">Contract</option>
                            <option value="4">Temporary</option>
                            <option value="5">Intern</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Status <span class="text-danger">*</span></label>
                        <select name="CreateInput.EmploymentStatus" class="form-select" required>
                            <option value="1" selected>Active</option>
                            <option value="2">OnLeave</option>
                            <option value="3">Suspended</option>
                            <option value="4">Terminated</option>
                        </select>
                    </div>
                </div>
                <hr class="my-3" />
                <h6 class="fw-bold small text-secondary mb-3">ORGANIZATIONAL PLACEMENT</h6>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Branch Office</label>
                        <select name="CreateInput.BranchId" class="form-select">
                            <option value="">-- Select Branch --</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Department</label>
                        <select name="CreateInput.DepartmentId" class="form-select">
                            <option value="">-- Select Department --</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Team / Squad</label>
                        <select name="CreateInput.TeamId" class="form-select">
                            <option value="">-- Select Team --</option>
                            @foreach (var t in Model.Teams)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Reports To (Manager)</label>
                        <select name="CreateInput.ManagerEmployeeId" class="form-select">
                            <option value="">-- None (Reports to Top Executive) --</option>
                            @foreach (var e in Model.Employees)
                            {
                                <option value="@e.Id">@e.FullName (@e.JobTitle ?? "Staff")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Link to Existing Tenant User (Optional)</label>
                        <select name="CreateInput.UserId" class="form-select">
                            <option value="">-- Do Not Link Yet --</option>
                            @foreach (var u in Model.TenantUsers)
                            {
                                <option value="@u.UserId">@u.FullName (@u.Email)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Enroll Employee</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: LINK USER -->
<div class="modal fade" id="modal-link-user" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="form-link-user" asp-page-handler="LinkUser" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-link me-2 text-primary"></i>Link System User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-secondary mb-3">Link system login account to employee <strong id="link-emp-name"></strong>:</p>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Select Tenant User Account <span class="text-danger">*</span></label>
                    <select name="SelectedUserId" class="form-select" required>
                        <option value="">-- Choose User Account --</option>
                        @foreach (var u in Model.TenantUsers)
                        {
                            <option value="@u.UserId">@u.FullName (@u.Email)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Link User Account</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openLinkUserModal(employeeId, employeeName) {
            var form = document.getElementById('form-link-user');
            form.action = '/Organization/Employees?handler=LinkUser&id=' + employeeId;
            document.getElementById('link-emp-name').innerText = employeeName;
            new bootstrap.Modal(document.getElementById('modal-link-user')).show();
        }

        function openEditEmployeeModal(id, number, name, email, jobTitle) {
            alert('Edit employee modal for ' + name + ' (' + number + ')');
        }
    </script>
}
