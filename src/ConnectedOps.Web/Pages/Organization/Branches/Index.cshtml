@page "/Organization/Branches"
@model ConnectedOps.Web.Pages.Organization.Branches.IndexModel
@{
    ViewData["Title"] = "Branch Management";
    ViewData["Subtitle"] = "Manage company headquarters, regional operational depots, workshops, and facilities";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modal-new-branch">
        <i class="bi bi-plus-circle"></i>
        <span>Add Branch</span>
    </button>
}

<div class="card border-0 shadow-sm bg-body">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>BRANCH NAME</th>
                    <th>CODE</th>
                    <th>TYPE</th>
                    <th>HEAD OFFICE</th>
                    <th>CITY / REGION</th>
                    <th>FACILITIES</th>
                    <th>STAFF</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Branches.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-secondary">
                            <i class="bi bi-geo-alt-slash fs-1 d-block mb-2 text-muted"></i>
                            <div>No branches configured yet. Click "Add Branch" to set up your primary depot or headquarters.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in Model.Branches)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@b.Name</div>
                            </td>
                            <td><code>@b.Code</code></td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary">@b.TypeName</span>
                            </td>
                            <td>
                                @if (b.IsHeadOffice)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-star-fill me-1"></i>Head Office</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                <div class="small">@(string.IsNullOrWhiteSpace(b.City) ? "-" : b.City)</div>
                                @if (!string.IsNullOrWhiteSpace(b.CountryCode))
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">@b.CountryCode</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info">@b.LocationCount locations</span>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success">@b.EmployeeCount staff</span>
                            </td>
                            <td>
                                @if (b.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-disabled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" onclick="openEditBranchModal('@b.Id', '@b.Name', '@b.Code', '@((int)b.Type)', @(b.IsHeadOffice ? "true" : "false"), '@(b.City ?? "")', '@(b.CountryCode ?? "")')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id" onsubmit="return confirm('Are you sure you want to delete branch @b.Name?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: NEW BRANCH -->
<div class="modal fade" id="modal-new-branch" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Add Branch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Branch Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Name" class="form-control" required maxlength="200" placeholder="e.g. Central Depot Hub" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Branch Code <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Code" class="form-control text-uppercase" required maxlength="50" placeholder="e.g. BR-CENTRAL" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Branch Type <span class="text-danger">*</span></label>
                        <select name="CreateInput.Type" class="form-select" required>
                            <option value="1">HeadOffice</option>
                            <option value="2">RegionalOffice</option>
                            <option value="3" selected>Depot</option>
                            <option value="4">Warehouse</option>
                            <option value="5">Workshop</option>
                            <option value="6">Yard</option>
                            <option value="99">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-center pt-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="CreateInput.IsHeadOffice" value="true" id="chkNewIsHeadOffice">
                            <label class="form-check-label small fw-semibold" for="chkNewIsHeadOffice">Designate as Organization Head Office</label>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Email</label>
                        <input type="email" name="CreateInput.Email" class="form-control" maxlength="250" placeholder="depot@company.com" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Phone</label>
                        <input type="tel" name="CreateInput.Phone" class="form-control" maxlength="50" placeholder="+1 555-0199" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Address Line 1</label>
                        <input type="text" name="CreateInput.AddressLine1" class="form-control" maxlength="250" placeholder="Facility address" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">City</label>
                        <input type="text" name="CreateInput.City" class="form-control" maxlength="100" placeholder="City" />
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">State / Province</label>
                        <input type="text" name="CreateInput.StateOrProvince" class="form-control" maxlength="100" placeholder="State" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Postal Code</label>
                        <input type="text" name="CreateInput.PostalCode" class="form-control" maxlength="20" placeholder="ZIP" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Country Code</label>
                        <input type="text" name="CreateInput.CountryCode" class="form-control text-uppercase" maxlength="10" placeholder="US" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Create Branch</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDIT BRANCH -->
<div class="modal fade" id="modal-edit-branch" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" id="form-edit-branch" asp-page-handler="Edit" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Branch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Branch Name <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Name" id="edit-branch-name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Branch Code <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Code" id="edit-branch-code" class="form-control text-uppercase" required maxlength="50" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Branch Type <span class="text-danger">*</span></label>
                        <select name="EditInput.Type" id="edit-branch-type" class="form-select" required>
                            <option value="1">HeadOffice</option>
                            <option value="2">RegionalOffice</option>
                            <option value="3">Depot</option>
                            <option value="4">Warehouse</option>
                            <option value="5">Workshop</option>
                            <option value="6">Yard</option>
                            <option value="99">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-center pt-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="EditInput.IsHeadOffice" value="true" id="edit-branch-headoffice">
                            <label class="form-check-label small fw-semibold" for="edit-branch-headoffice">Designate as Organization Head Office</label>
                        </div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">City</label>
                        <input type="text" name="EditInput.City" id="edit-branch-city" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Country Code</label>
                        <input type="text" name="EditInput.CountryCode" id="edit-branch-country" class="form-control text-uppercase" maxlength="10" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditBranchModal(id, name, code, type, isHeadOffice, city, country) {
            var form = document.getElementById('form-edit-branch');
            form.action = '/Organization/Branches?handler=Edit&id=' + id;
            document.getElementById('edit-branch-name').value = name;
            document.getElementById('edit-branch-code').value = code;
            document.getElementById('edit-branch-type').value = type;
            document.getElementById('edit-branch-headoffice').checked = isHeadOffice;
            document.getElementById('edit-branch-city').value = city;
            document.getElementById('edit-branch-country').value = country;
            new bootstrap.Modal(document.getElementById('modal-edit-branch')).show();
        }
    </script>
}
