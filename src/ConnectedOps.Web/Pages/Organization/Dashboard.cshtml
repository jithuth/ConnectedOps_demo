@page "/Organization/Dashboard"
@model ConnectedOps.Web.Pages.Organization.DashboardModel
@{
    ViewData["Title"] = "Organization Dashboard";
    ViewData["Subtitle"] = "Real-time overview of branches, locations, departments, teams, and human resources";
}

<!-- STATS ROW -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Branches</div>
                    <div class="fs-3 fw-bold my-1 text-primary">@Model.Summary.TotalBranches</div>
                    <div class="small text-muted"><span class="text-success fw-semibold">@Model.Summary.ActiveBranches</span> active / operational</div>
                </div>
                <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                    <i class="bi bi-geo-alt-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Facilities / Locations</div>
                    <div class="fs-3 fw-bold my-1 text-info">@Model.Summary.TotalLocations</div>
                    <div class="small text-muted">Depots, yards, workshops</div>
                </div>
                <div class="rounded-circle bg-info-subtle p-3 text-info">
                    <i class="bi bi-pin-map-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Depts & Teams</div>
                    <div class="fs-3 fw-bold my-1 text-warning">@Model.Summary.TotalDepartments / @Model.Summary.TotalTeams</div>
                    <div class="small text-muted">@Model.Summary.TotalDepartments departments, @Model.Summary.TotalTeams teams</div>
                </div>
                <div class="rounded-circle bg-warning-subtle p-3 text-warning">
                    <i class="bi bi-diagram-2-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Employees</div>
                    <div class="fs-3 fw-bold my-1 text-success">@Model.Summary.TotalEmployees</div>
                    <div class="small text-muted"><span class="text-success fw-semibold">@Model.Summary.ActiveEmployees</span> active (@Model.Summary.LinkedUserEmployees user-linked)</div>
                </div>
                <div class="rounded-circle bg-success-subtle p-3 text-success">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-bottom d-flex align-items-center justify-content-between py-3">
                <h6 class="m-0 fw-bold"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Employees by Employment Type</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                @if (Model.Summary.EmployeesByEmploymentType.Count == 0)
                {
                    <div class="text-secondary py-5 text-center">
                        <i class="bi bi-person-x fs-1 d-block mb-2 text-muted"></i>
                        No employee data available yet.
                    </div>
                }
                else
                {
                    <div style="width: 100%; max-width: 320px; height: 260px;">
                        <canvas id="chartEmploymentType"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-bottom d-flex align-items-center justify-content-between py-3">
                <h6 class="m-0 fw-bold"><i class="bi bi-bar-chart-fill me-2 text-success"></i>Headcount by Department</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                @if (Model.Summary.EmployeesByDepartment.Count == 0)
                {
                    <div class="text-secondary py-5 text-center">
                        <i class="bi bi-diagram-3 fs-1 d-block mb-2 text-muted"></i>
                        No departmental assignments yet.
                    </div>
                }
                else
                {
                    <div style="width: 100%; height: 260px;">
                        <canvas id="chartDepartmentHeadcount"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- QUICK LINKS & DIRECTORY ROW -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-header bg-transparent border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 fw-bold"><i class="bi bi-grid-fill me-2 text-secondary"></i>Organization Directory Overview</h6>
                <a href="/Organization/Hierarchy" class="btn btn-sm btn-outline-primary"><i class="bi bi-bezier2 me-1"></i>View Hierarchy Tree</a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <a href="/Organization/Branches" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary-subtle p-2 text-primary">
                                <i class="bi bi-geo-alt fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Branch Offices & Hubs</div>
                                <div class="small text-secondary">Manage headquarters, regional branches, and operational centers</div>
                            </div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill fs-6 px-3">@Model.Summary.TotalBranches</span>
                    </a>
                    <a href="/Organization/Locations" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-info-subtle p-2 text-info">
                                <i class="bi bi-pin-map fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Physical Facilities & Geofences</div>
                                <div class="small text-secondary">Depots, warehouses, yards, workshops, and coordinates</div>
                            </div>
                        </div>
                        <span class="badge bg-info-subtle text-info rounded-pill fs-6 px-3">@Model.Summary.TotalLocations</span>
                    </a>
                    <a href="/Organization/Departments" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-warning-subtle p-2 text-warning">
                                <i class="bi bi-diagram-2 fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Departments & Functional Units</div>
                                <div class="small text-secondary">Divisions, nested sub-departments, and functional leadership</div>
                            </div>
                        </div>
                        <span class="badge bg-warning-subtle text-warning rounded-pill fs-6 px-3">@Model.Summary.TotalDepartments</span>
                    </a>
                    <a href="/Organization/Employees" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success-subtle p-2 text-success">
                                <i class="bi bi-person-lines-fill fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-bold">Employee Directory</div>
                                <div class="small text-secondary">Staff profiles, organizational placements, and system user linkages</div>
                            </div>
                        </div>
                        <span class="badge bg-success-subtle text-success rounded-pill fs-6 px-3">@Model.Summary.TotalEmployees</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-header bg-transparent border-bottom py-3">
                <h6 class="m-0 fw-bold"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Quick Actions</h6>
            </div>
            <div class="card-body p-3 d-flex flex-column gap-2">
                <a href="/Organization/Branches" class="btn btn-outline-primary d-flex align-items-center gap-2 text-start p-2">
                    <i class="bi bi-plus-circle fs-5"></i>
                    <div>
                        <div class="fw-semibold small">Add New Branch</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Create regional depot or hub</div>
                    </div>
                </a>
                <a href="/Organization/Employees" class="btn btn-outline-success d-flex align-items-center gap-2 text-start p-2">
                    <i class="bi bi-person-plus fs-5"></i>
                    <div>
                        <div class="fw-semibold small">Enroll Employee</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Add staff member to department</div>
                    </div>
                </a>
                <a href="/Organization/Users" class="btn btn-outline-info d-flex align-items-center gap-2 text-start p-2">
                    <i class="bi bi-person-badge fs-5"></i>
                    <div>
                        <div class="fw-semibold small">Create Tenant User</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Provision login account & assign roles</div>
                    </div>
                </a>
                <a href="/Organization/Profile" class="btn btn-outline-secondary d-flex align-items-center gap-2 text-start p-2">
                    <i class="bi bi-building-gear fs-5"></i>
                    <div>
                        <div class="fw-semibold small">Company Profile & Branding</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Legal entity details, tax IDs, time zone</div>
                    </div>
                </a>
                <a href="/Organization/Settings" class="btn btn-outline-secondary d-flex align-items-center gap-2 text-start p-2">
                    <i class="bi bi-sliders fs-5"></i>
                    <div>
                        <div class="fw-semibold small">Organization Policies</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Enforce branch/dept placements</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Employment Type Chart
            var typeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.EmployeesByEmploymentType));
            var typeLabels = Object.keys(typeData);
            var typeValues = Object.values(typeData);

            if (typeLabels.length > 0 && document.getElementById('chartEmploymentType')) {
                new Chart(document.getElementById('chartEmploymentType'), {
                    type: 'doughnut',
                    data: {
                        labels: typeLabels,
                        datasets: [{
                            data: typeValues,
                            backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }

            // Department Headcount Chart
            var deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.EmployeesByDepartment));
            var deptLabels = Object.keys(deptData);
            var deptValues = Object.values(deptData);

            if (deptLabels.length > 0 && document.getElementById('chartDepartmentHeadcount')) {
                new Chart(document.getElementById('chartDepartmentHeadcount'), {
                    type: 'bar',
                    data: {
                        labels: deptLabels,
                        datasets: [{
                            label: 'Employees',
                            data: deptValues,
                            backgroundColor: '#10b981',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1 } }
                        }
                    }
                });
            }
        });
    </script>
}
