@page "/Organization/Departments"
@model ConnectedOps.Web.Pages.Organization.Departments.IndexModel
@{
    ViewData["Title"] = "Departments & Divisions";
    ViewData["Subtitle"] = "Define operational structures, nested sub-departments, and functional leadership";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modal-new-dept">
        <i class="bi bi-plus-circle"></i>
        <span>Add Department</span>
    </button>
}

<!-- FILTER CARD -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="BranchId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Operating Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name (@b.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <a href="/Organization/Departments" class="btn btn-outline-secondary btn-sm w-100">Reset Filter</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm bg-body">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>DEPARTMENT NAME</th>
                    <th>CODE</th>
                    <th>BRANCH HUB</th>
                    <th>PARENT DEPARTMENT</th>
                    <th>TEAMS</th>
                    <th>STAFF</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Departments.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <i class="bi bi-diagram-2 fs-1 d-block mb-2 text-muted"></i>
                            <div>No departments configured. Click "Add Department" to create organizational units.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model.Departments)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@d.Name</div>
                            </td>
                            <td><code>@d.Code</code></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.BranchName))
                                {
                                    <span class="badge bg-primary-subtle text-primary">@d.BranchName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Organization-wide</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.ParentDepartmentName))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-arrow-return-right me-1"></i>@d.ParentDepartmentName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Top Level</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-warning-subtle text-warning">@d.TeamCount teams</span>
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success">@d.EmployeeCount staff</span>
                            </td>
                            <td>
                                @if (d.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-disabled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" onclick="openEditDeptModal('@d.Id', '@(d.BranchId?.ToString() ?? "")', '@(d.ParentDepartmentId?.ToString() ?? "")', '@d.Name', '@d.Code')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" onsubmit="return confirm('Delete department @d.Name?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: NEW DEPT -->
<div class="modal fade" id="modal-new-dept" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-diagram-2-fill me-2 text-primary"></i>Add Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Branch Office / Hub (Optional)</label>
                        <select name="CreateInput.BranchId" class="form-select">
                            <option value="">-- Organization-wide (No Branch) --</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name (@b.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Parent Department (Optional for sub-units)</label>
                        <select name="CreateInput.ParentDepartmentId" class="form-select">
                            <option value="">-- Top-Level Department --</option>
                            @foreach (var pd in Model.Departments)
                            {
                                <option value="@pd.Id">@pd.Name (@pd.Code)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Department Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Name" class="form-control" required maxlength="200" placeholder="e.g. Fleet Operations" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Department Code <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Code" class="form-control text-uppercase" required maxlength="50" placeholder="e.g. DEP-OPS" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Description / Scope</label>
                    <textarea name="CreateInput.Description" class="form-control" rows="2" maxlength="500" placeholder="Brief outline of functional mission..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Create Department</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDIT DEPT -->
<div class="modal fade" id="modal-edit-dept" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" id="form-edit-dept" asp-page-handler="Edit" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Branch Office / Hub (Optional)</label>
                        <select name="EditInput.BranchId" id="edit-dept-branch" class="form-select">
                            <option value="">-- Organization-wide (No Branch) --</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name (@b.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Parent Department</label>
                        <select name="EditInput.ParentDepartmentId" id="edit-dept-parent" class="form-select">
                            <option value="">-- Top-Level Department --</option>
                            @foreach (var pd in Model.Departments)
                            {
                                <option value="@pd.Id">@pd.Name (@pd.Code)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Department Name <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Name" id="edit-dept-name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Department Code <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Code" id="edit-dept-code" class="form-control text-uppercase" required maxlength="50" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditDeptModal(id, branchId, parentId, name, code) {
            var form = document.getElementById('form-edit-dept');
            form.action = '/Organization/Departments?handler=Edit&id=' + id;
            document.getElementById('edit-dept-branch').value = branchId;
            document.getElementById('edit-dept-parent').value = parentId;
            document.getElementById('edit-dept-name').value = name;
            document.getElementById('edit-dept-code').value = code;
            new bootstrap.Modal(document.getElementById('modal-edit-dept')).show();
        }
    </script>
}
