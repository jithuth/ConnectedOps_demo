@page "/Organization/Teams"
@model ConnectedOps.Web.Pages.Organization.Teams.IndexModel
@{
    ViewData["Title"] = "Teams & Operational Squads";
    ViewData["Subtitle"] = "Group departmental personnel into specialized operational teams, dispatch shifts, or crews";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modal-new-team">
        <i class="bi bi-plus-circle"></i>
        <span>Add Team</span>
    </button>
}

<!-- FILTER CARD -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="DepartmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Operating Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name (@d.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <a href="/Organization/Teams" class="btn btn-outline-secondary btn-sm w-100">Reset Filter</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm bg-body">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>TEAM NAME</th>
                    <th>CODE</th>
                    <th>DEPARTMENT</th>
                    <th>TEAM LEAD</th>
                    <th>MEMBERS</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Teams.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-people-slash fs-1 d-block mb-2 text-muted"></i>
                            <div>No teams configured. Click "Add Team" to organize staff members into squads or shifts.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var t in Model.Teams)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@t.Name</div>
                            </td>
                            <td><code>@t.Code</code></td>
                            <td>
                                <span class="badge bg-warning-subtle text-warning">@t.DepartmentName</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(t.TeamLeadName))
                                {
                                    <div class="small fw-semibold"><i class="bi bi-person-badge text-primary me-1"></i>@t.TeamLeadName</div>
                                }
                                else
                                {
                                    <span class="text-muted small">Unassigned</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success">@t.EmployeeCount members</span>
                            </td>
                            <td>
                                @if (t.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-disabled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" onclick="openEditTeamModal('@t.Id', '@t.DepartmentId', '@t.Name', '@t.Code', '@(t.TeamLeadEmployeeId?.ToString() ?? "")')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id" onsubmit="return confirm('Delete team @t.Name?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: NEW TEAM -->
<div class="modal fade" id="modal-new-team" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i>Add Team</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="CreateInput.DepartmentId" class="form-select" required>
                            <option value="">-- Select Parent Department --</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id">@d.Name (@d.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Team Lead / Supervisor (Optional)</label>
                        <select name="CreateInput.TeamLeadEmployeeId" class="form-select">
                            <option value="">-- Select Team Lead --</option>
                            @foreach (var e in Model.Employees)
                            {
                                <option value="@e.Id">@e.FullName (@e.EmployeeNumber)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Team Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Name" class="form-control" required maxlength="200" placeholder="e.g. Night Dispatch Crew" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Team Code <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Code" class="form-control text-uppercase" required maxlength="50" placeholder="e.g. TM-DISP-NIGHT" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Description</label>
                    <textarea name="CreateInput.Description" class="form-control" rows="2" maxlength="500" placeholder="Operational responsibilities..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Create Team</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDIT TEAM -->
<div class="modal fade" id="modal-edit-team" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" id="form-edit-team" asp-page-handler="Edit" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Team</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="EditInput.DepartmentId" id="edit-team-dept" class="form-select" required>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id">@d.Name (@d.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Team Lead</label>
                        <select name="EditInput.TeamLeadEmployeeId" id="edit-team-lead" class="form-select">
                            <option value="">-- No Team Lead --</option>
                            @foreach (var e in Model.Employees)
                            {
                                <option value="@e.Id">@e.FullName (@e.EmployeeNumber)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Team Name <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Name" id="edit-team-name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Team Code <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Code" id="edit-team-code" class="form-control text-uppercase" required maxlength="50" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditTeamModal(id, deptId, name, code, leadId) {
            var form = document.getElementById('form-edit-team');
            form.action = '/Organization/Teams?handler=Edit&id=' + id;
            document.getElementById('edit-team-dept').value = deptId;
            document.getElementById('edit-team-name').value = name;
            document.getElementById('edit-team-code').value = code;
            document.getElementById('edit-team-lead').value = leadId;
            new bootstrap.Modal(document.getElementById('modal-edit-team')).show();
        }
    </script>
}
