@page "/Organization/Locations"
@model ConnectedOps.Web.Pages.Organization.Locations.IndexModel
@{
    ViewData["Title"] = "Facilities & Locations";
    ViewData["Subtitle"] = "Manage operational depots, warehouses, workshops, yards, and geofenced zones";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modal-new-location">
        <i class="bi bi-plus-circle"></i>
        <span>Add Facility / Location</span>
    </button>
}

<!-- FILTER CARD -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="BranchId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Operating Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name (@b.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <a href="/Organization/Locations" class="btn btn-outline-secondary btn-sm w-100">Reset Filter</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm bg-body">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>LOCATION / FACILITY</th>
                    <th>CODE</th>
                    <th>BRANCH HUB</th>
                    <th>TYPE</th>
                    <th>COORDINATES</th>
                    <th>CITY / REGION</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Locations.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <i class="bi bi-pin-map-slash fs-1 d-block mb-2 text-muted"></i>
                            <div>No facilities found. Click "Add Facility / Location" to register depots and yards.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var loc in Model.Locations)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@loc.Name</div>
                            </td>
                            <td><code>@loc.Code</code></td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">@loc.BranchName</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary">@loc.TypeName</span>
                            </td>
                            <td>
                                @if (loc.Latitude.HasValue && loc.Longitude.HasValue)
                                {
                                    <span class="small font-monospace">@loc.Latitude.Value.ToString("F4"), @loc.Longitude.Value.ToString("F4")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Not mapped</span>
                                }
                            </td>
                            <td>
                                <div class="small">@(string.IsNullOrWhiteSpace(loc.City) ? "-" : loc.City)</div>
                            </td>
                            <td>
                                @if (loc.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-disabled">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" onclick="openEditLocationModal('@loc.Id', '@loc.BranchId', '@loc.Name', '@loc.Code', '@((int)loc.Type)', '@(loc.Latitude?.ToString() ?? "")', '@(loc.Longitude?.ToString() ?? "")', '@(loc.City ?? "")')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@loc.Id" onsubmit="return confirm('Delete location @loc.Name?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: NEW LOCATION -->
<div class="modal fade" id="modal-new-location" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-pin-map-fill me-2 text-primary"></i>Add Facility / Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Branch Office / Hub <span class="text-danger">*</span></label>
                        <select name="CreateInput.BranchId" class="form-select" required>
                            <option value="">-- Select Parent Branch --</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name (@b.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Facility Type <span class="text-danger">*</span></label>
                        <select name="CreateInput.Type" class="form-select" required>
                            <option value="1">Office</option>
                            <option value="2">Warehouse</option>
                            <option value="3" selected>Depot</option>
                            <option value="4">Yard</option>
                            <option value="5">Workshop</option>
                            <option value="6">CustomerSite</option>
                            <option value="99">Other</option>
                        </select>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Facility Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Name" class="form-control" required maxlength="200" placeholder="e.g. North Terminal Yard" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Location Code <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.Code" class="form-control text-uppercase" required maxlength="50" placeholder="e.g. LOC-NY-01" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Latitude</label>
                        <input type="number" step="any" name="CreateInput.Latitude" class="form-control font-monospace" placeholder="e.g. 40.7128" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Longitude</label>
                        <input type="number" step="any" name="CreateInput.Longitude" class="form-control font-monospace" placeholder="e.g. -74.0060" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Geofence Radius (Meters)</label>
                        <input type="number" name="CreateInput.GeofenceRadiusMeters" class="form-control" placeholder="e.g. 150" />
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">City</label>
                        <input type="text" name="CreateInput.City" class="form-control" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Country Code</label>
                        <input type="text" name="CreateInput.CountryCode" class="form-control text-uppercase" maxlength="10" placeholder="US" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Create Location</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDIT LOCATION -->
<div class="modal fade" id="modal-edit-location" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" id="form-edit-location" asp-page-handler="Edit" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Branch Office / Hub <span class="text-danger">*</span></label>
                        <select name="EditInput.BranchId" id="edit-loc-branch" class="form-select" required>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id">@b.Name (@b.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Facility Type <span class="text-danger">*</span></label>
                        <select name="EditInput.Type" id="edit-loc-type" class="form-select" required>
                            <option value="1">Office</option>
                            <option value="2">Warehouse</option>
                            <option value="3">Depot</option>
                            <option value="4">Yard</option>
                            <option value="5">Workshop</option>
                            <option value="6">CustomerSite</option>
                            <option value="99">Other</option>
                        </select>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Facility Name <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Name" id="edit-loc-name" class="form-control" required maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Location Code <span class="text-danger">*</span></label>
                        <input type="text" name="EditInput.Code" id="edit-loc-code" class="form-control text-uppercase" required maxlength="50" />
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Latitude</label>
                        <input type="number" step="any" name="EditInput.Latitude" id="edit-loc-lat" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Longitude</label>
                        <input type="number" step="any" name="EditInput.Longitude" id="edit-loc-lon" class="form-control font-monospace" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">City</label>
                        <input type="text" name="EditInput.City" id="edit-loc-city" class="form-control" maxlength="100" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditLocationModal(id, branchId, name, code, type, lat, lon, city) {
            var form = document.getElementById('form-edit-location');
            form.action = '/Organization/Locations?handler=Edit&id=' + id;
            document.getElementById('edit-loc-branch').value = branchId;
            document.getElementById('edit-loc-name').value = name;
            document.getElementById('edit-loc-code').value = code;
            document.getElementById('edit-loc-type').value = type;
            document.getElementById('edit-loc-lat').value = lat;
            document.getElementById('edit-loc-lon').value = lon;
            document.getElementById('edit-loc-city').value = city;
            new bootstrap.Modal(document.getElementById('modal-edit-location')).show();
        }
    </script>
}
