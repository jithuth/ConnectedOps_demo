@page "/Organization/Users"
@model ConnectedOps.Web.Pages.Organization.Users.IndexModel
@{
    ViewData["Title"] = "Tenant User Administration";
    ViewData["Subtitle"] = "Provision user accounts, assign tenant security roles, and link employee profiles";
}

@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-6"></i>
        <div>@TempData["Feedback"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2 px-3 mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section HeaderActions {
    <button class="btn btn-primary btn-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modal-new-tenant-user">
        <i class="bi bi-person-plus-fill"></i>
        <span>Create Tenant User</span>
    </button>
}

<div class="card border-0 shadow-sm bg-body">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-secondary">
                    <th>USER NAME</th>
                    <th>EMAIL / CONTACT</th>
                    <th>SECURITY ROLES</th>
                    <th>LINKED EMPLOYEE</th>
                    <th>JOINED</th>
                    <th>STATUS</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-secondary">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-muted"></i>
                            <div>No tenant users found.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@u.FullName</div>
                                <div class="small text-muted">ID: @u.UserId.ToString()[..8]...</div>
                            </td>
                            <td>
                                <div>@u.Email</div>
                                <div class="small text-muted">@(u.PhoneNumber ?? "-")</div>
                            </td>
                            <td>
                                @if (u.Roles.Count == 0)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">No Roles</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var r in u.Roles)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">@r</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (u.EmployeeId.HasValue)
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-person-check me-1"></i>@(u.EmployeeNumber ?? "Linked")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Not linked</span>
                                }
                            </td>
                            <td>
                                <div class="small">@u.JoinedAtUtc.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <span class="badge @(u.IsActive ? "badge-active" : "badge-disabled")">@(u.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (u.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@u.TenantUserId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Deactivate user">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" asp-route-id="@u.TenantUserId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Activate user">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Remove" asp-route-id="@u.TenantUserId" onsubmit="return confirm('Remove user @u.Email from organization?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Remove user">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: NEW TENANT USER -->
<div class="modal fade" id="modal-new-tenant-user" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" asp-page-handler="Create" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Create Tenant User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">First Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.FirstName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Last Name <span class="text-danger">*</span></label>
                        <input type="text" name="CreateInput.LastName" class="form-control" required maxlength="100" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Login Email <span class="text-danger">*</span></label>
                        <input type="email" name="CreateInput.Email" class="form-control" required maxlength="250" placeholder="user@company.com" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Initial Password <span class="text-danger">*</span></label>
                        <input type="password" name="CreateInput.Password" class="form-control" required minlength="8" placeholder="At least 8 characters" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Phone Number</label>
                    <input type="tel" name="CreateInput.PhoneNumber" class="form-control" maxlength="50" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold d-block">Assigned Security Roles</label>
                    <div class="border rounded p-3 bg-light d-flex flex-wrap gap-3">
                        @foreach (var r in Model.Roles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="@r.Id" id="role-@r.Id">
                                <label class="form-check-label small" for="role-@r.Id">@r.Name</label>
                            </div>
                        }
                    </div>
                </div>

                <hr class="my-3" />

                <!-- AUTO-CREATE EMPLOYEE SECTION -->
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="CreateInput.CreateLinkedEmployee" value="true" id="chkAutoEmployee" onchange="document.getElementById('sec-emp-placement').style.display = this.checked ? 'block' : 'none';">
                    <label class="form-check-label fw-semibold small" for="chkAutoEmployee">Automatically create & link an Employee record for this user</label>
                </div>

                <div id="sec-emp-placement" style="display: none;" class="border rounded p-3 bg-body-tertiary">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Branch Hub</label>
                            <select name="CreateInput.BranchId" class="form-select form-select-sm">
                                <option value="">-- No Branch --</option>
                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Department</label>
                            <select name="CreateInput.DepartmentId" class="form-select form-select-sm">
                                <option value="">-- No Dept --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Team</label>
                            <select name="CreateInput.TeamId" class="form-select form-select-sm">
                                <option value="">-- No Team --</option>
                                @foreach (var t in Model.Teams)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary btn-sm">Create User</button>
            </div>
        </form>
    </div>
</div>
