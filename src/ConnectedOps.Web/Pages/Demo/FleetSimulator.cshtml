@page
@model ConnectedOps.Web.Pages.Demo.FleetSimulatorModel
@{
    ViewData["Title"] = "Demo Vehicle Simulator";
    ViewData["Subtitle"] = "Simulate realistic moving fleet telemetry through the standard ingestion pipeline";
}

@Html.AntiForgeryToken()

@if (!Model.IsFeatureEnabled)
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center p-5">
            <i class="bi bi-shield-lock-fill fs-1 text-warning d-block mb-3"></i>
            <h4 class="fw-bold">Demo Fleet Simulator is Disabled</h4>
            <p class="text-muted" style="max-width: 500px; margin: 0 auto;">
                Demo simulation is disabled by default for production safety. To enable the simulator, update your configuration:
            </p>
            <div class="bg-dark text-light font-monospace p-3 rounded-2 text-start mt-3 mb-4 mx-auto" style="max-width: 450px; font-size: 0.85rem;">
                "DemoFleet": {<br />
                &nbsp;&nbsp;"Enabled": true<br />
                }
            </div>
            <a href="/Platform/Dashboard" class="btn btn-outline-primary btn-sm">Return to Platform Dashboard</a>
        </div>
    </div>
}
else
{
    <!-- CONTROLS & STATUS HEADER -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-3">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="fw-bold mb-0">Simulation Engine</h5>
                            <span id="sim-status-badge" class="badge @(Model.Status.IsRunning ? "bg-success" : "bg-secondary")">
                                @(Model.Status.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div class="small text-muted mt-1">
                            Dispatches normalized telemetry directly through <span class="badge bg-light text-dark border">ITelemetryIngestionService</span>
                        </div>
                    </div>
                </div>

                <!-- Simulation Action Controls -->
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm" id="btn-create-fleet" onclick="createDemoFleet()">
                        <i class="bi bi-plus-circle"></i>
                        <span>Create / Seed Fleet (10 Vehicles)</span>
                    </button>
                    <button type="button" class="btn btn-success d-flex align-items-center gap-1 shadow-sm" id="btn-start-sim" onclick="startSimulation()">
                        <i class="bi bi-play-fill"></i>
                        <span>Start</span>
                    </button>
                    <button type="button" class="btn btn-warning d-flex align-items-center gap-1 shadow-sm" id="btn-stop-sim" onclick="stopSimulation()">
                        <i class="bi bi-pause-fill"></i>
                        <span>Stop</span>
                    </button>
                    <button type="button" class="btn btn-light border d-flex align-items-center gap-1 shadow-sm" id="btn-step-sim" onclick="stepSimulation()">
                        <i class="bi bi-chevron-right"></i>
                        <span>Step 1 Tick</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger d-flex align-items-center gap-1 shadow-sm" id="btn-reset-sim" onclick="resetSimulation()">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- STATS STRIP -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-2 h-100">
                <div class="card-body p-2">
                    <h4 class="fw-bold text-primary mb-0" id="sim-vehicle-count">@Model.Status.TotalDemoVehicles</h4>
                    <span class="small text-muted fw-semibold text-uppercase">Simulated Vehicles</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-2 h-100">
                <div class="card-body p-2">
                    <h4 class="fw-bold text-info mb-0" id="sim-tick-count">@Model.Status.TotalTicksExecuted</h4>
                    <span class="small text-muted fw-semibold text-uppercase">Total Ingestion Ticks</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-2 h-100">
                <div class="card-body p-2">
                    <h4 class="fw-bold text-warning mb-0" id="sim-interval">@(Model.Status.UpdateIntervalSeconds)s</h4>
                    <span class="small text-muted fw-semibold text-uppercase">Tick Interval</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center py-2 h-100">
                <div class="card-body p-2">
                    <h4 class="fw-bold text-success mb-0" id="sim-online-count">@Model.Status.TotalDemoVehicles</h4>
                    <span class="small text-muted fw-semibold text-uppercase">Active Emitters</span>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN SIMULATION WORKSPACE: MAP & LIVE TABLE -->
    <div class="row g-3">
        <!-- Live Preview Map (Col 7) -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden position-relative" style="height: 580px;">
                <div class="card-header bg-transparent border-bottom p-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-uppercase text-muted"><i class="bi bi-map me-1 text-primary"></i>Simulated Fleet Real-Time Positions</span>
                    <a href="/Maps/Live" class="btn btn-sm btn-outline-primary py-0" style="font-size: 0.75rem;">Open Full Live Map</a>
                </div>
                <div id="sim-map-container" class="w-100 h-100" style="background: #e5e7eb;"></div>
            </div>
        </div>

        <!-- Simulated Fleet Table (Col 5) -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 d-flex flex-column" style="height: 580px;">
                <div class="card-header bg-transparent border-bottom p-2">
                    <span class="fw-bold small text-uppercase text-muted"><i class="bi bi-truck me-1 text-primary"></i>Simulated Vehicle Telemetry State</span>
                </div>
                <div class="card-body p-0 overflow-y-auto flex-grow-1">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="ps-2">Vehicle</th>
                                    <th>Route</th>
                                    <th>Speed</th>
                                    <th>Progress</th>
                                    <th class="text-end pe-2">Signal</th>
                                </tr>
                            </thead>
                            <tbody id="sim-vehicles-tbody">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted small">Loading simulated vehicles...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="~/vendor/maplibre-gl/maplibre-gl.css" />
    <script src="~/vendor/maplibre-gl/maplibre-gl.js"></script>
    <script src="~/js/maps/connectedops-map.js"></script>

    <script>
        let simMap = null;
        let pollTimer = null;
        const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        document.addEventListener('DOMContentLoaded', () => {
            if (document.getElementById('sim-map-container')) {
                simMap = new ConnectedOpsMap('sim-map-container', {
                    styleUrl: 'https://tiles.openfreemap.org/styles/bright',
                    enableClustering: false,
                    onReady: () => {
                        pollStatus();
                        startStatusPolling();
                    }
                });
            }
        });

        async function pollStatus() {
            try {
                const res = await fetch(`?handler=Status`);
                if (!res.ok) return;
                const data = await res.json();
                renderStatus(data.status, data.vehicles);
            } catch (e) {
                console.error('Error polling simulation status:', e);
            }
        }

        function startStatusPolling() {
            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(pollStatus, 2000);
        }

        function renderStatus(status, vehicles) {
            const badge = document.getElementById('sim-status-badge');
            if (badge && status) {
                if (status.isRunning) {
                    badge.className = 'badge bg-success';
                    badge.innerHTML = '<i class="bi bi-record-fill me-1"></i>Running';
                } else {
                    badge.className = 'badge bg-secondary';
                    badge.textContent = 'Stopped';
                }

                document.getElementById('sim-vehicle-count').textContent = status.totalDemoVehicles ?? 0;
                document.getElementById('sim-tick-count').textContent = status.totalTicksExecuted ?? 0;
                document.getElementById('sim-interval').textContent = `${status.updateIntervalSeconds ?? 3}s`;
            }

            const onlineCount = vehicles ? vehicles.filter(v => !v.isSimulatingOffline).length : (status ? status.totalDemoVehicles : 0);
            document.getElementById('sim-online-count').textContent = onlineCount;

            // Render Map Markers
            if (simMap && vehicles && vehicles.length > 0) {
                const mappedVehicles = vehicles.map(v => ({
                    id: v.vehicleId,
                    vehicleId: v.vehicleId,
                    vehicleName: v.displayName || v.vehicleNumber,
                    vehicleNumber: v.vehicleNumber,
                    latitude: v.latitude,
                    longitude: v.longitude,
                    headingDegrees: v.headingDegrees,
                    speedKph: v.speedKph,
                    ignitionOn: v.ignitionOn,
                    connectivityStatus: v.isSimulatingOffline ? 2 : 1,
                    isOnline: !v.isSimulatingOffline
                }));
                simMap.setVehicles(mappedVehicles);
            }

            // Render Table
            const tbody = document.getElementById('sim-vehicles-tbody');
            if (tbody) {
                if (!vehicles || vehicles.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted small">
                                No dummy vehicles created yet.<br/>
                                <button class="btn btn-sm btn-primary mt-2" onclick="createDemoFleet()">Create 10 Dummy Vehicles</button>
                            </td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = vehicles.map(v => {
                    const pct = v.totalRoutePoints > 0 ? Math.round((v.currentPointIndex / v.totalRoutePoints) * 100) : 0;
                    const signalBtn = v.isSimulatingOffline
                        ? `<button class="btn btn-sm btn-danger py-0 px-1" style="font-size: 0.7rem;" onclick="toggleOffline('${v.vehicleId}')">Offline (Reconnect)</button>`
                        : `<button class="btn btn-sm btn-outline-success py-0 px-1" style="font-size: 0.7rem;" onclick="toggleOffline('${v.vehicleId}')">Online (Disconnect)</button>`;

                    return `
                        <tr>
                            <td class="ps-2">
                                <div class="fw-bold small text-truncate" style="max-width: 110px;">${escapeHtml(v.displayName)}</div>
                                <span class="font-monospace text-muted" style="font-size: 0.65rem;">${escapeHtml(v.vehicleNumber)}</span>
                            </td>
                            <td class="small text-truncate" style="max-width: 100px;">
                                ${escapeHtml(v.routeName || 'Default Route')}
                            </td>
                            <td class="small font-monospace">
                                ${(v.speedKph || 0).toFixed(0)} km/h
                            </td>
                            <td>
                                <div class="progress" style="height: 6px; width: 60px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: ${pct}%"></div>
                                </div>
                                <div class="font-monospace text-muted" style="font-size: 0.6rem;">${v.currentPointIndex}/${v.totalRoutePoints}</div>
                            </td>
                            <td class="text-end pe-2">
                                ${signalBtn}
                            </td>
                        </tr>
                    `;
                }).join('');
            }
        }

        async function createDemoFleet() {
            const btn = document.getElementById('btn-create-fleet');
            btn.disabled = true;
            try {
                const res = await fetch(`?handler=CreateFleet`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken }
                });
                if (res.ok) {
                    await pollStatus();
                } else {
                    const err = await res.json();
                    alert('Failed to initialize demo fleet: ' + (err.errors ? err.errors.join(', ') : 'Unknown error'));
                }
            } catch (e) {
                alert('An error occurred');
            } finally {
                btn.disabled = false;
            }
        }

        async function startSimulation() {
            try {
                const res = await fetch(`?handler=Start`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken }
                });
                if (res.ok) await pollStatus();
            } catch (e) {}
        }

        async function stopSimulation() {
            try {
                const res = await fetch(`?handler=Stop`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken }
                });
                if (res.ok) await pollStatus();
            } catch (e) {}
        }

        async function stepSimulation() {
            try {
                const res = await fetch(`?handler=Step`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken }
                });
                if (res.ok) await pollStatus();
            } catch (e) {}
        }

        async function resetSimulation() {
            if (!confirm('Reset simulation routes to starting positions?')) return;
            try {
                const res = await fetch(`?handler=Reset`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken }
                });
                if (res.ok) await pollStatus();
            } catch (e) {}
        }

        async function toggleOffline(vehicleId) {
            try {
                const res = await fetch(`?handler=ToggleOffline&vehicleId=${vehicleId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken }
                });
                if (res.ok) await pollStatus();
            } catch (e) {}
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>"']/g, s => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[s]);
        }
    </script>
}
