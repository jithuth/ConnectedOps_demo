@page
@model ConnectedOps.Web.Pages.Tracking.LiveModel
@{
    ViewData["Title"] = "Customer Public Live Delivery Tracking";
    // Check if user is authenticated; if not, use a standalone layout or embed container
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white p-2 rounded-3 me-3 fs-3">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-dark">Live Order & Shipment Tracking</h3>
                        <p class="text-muted small mb-0">ConnectedOps Real-Time Customer Delivery Portal</p>
                    </div>
                </div>
                @if (isAuthenticated)
                {
                    <a href="/Dispatch/Jobs" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Dispatch
                    </a>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.TrackingInfo == null)
            {
                <!-- Token Search Prompt -->
                <div class="card border-0 shadow-sm p-4 text-center my-4">
                    <div class="py-5">
                        <div class="display-4 text-primary mb-3">
                            <i class="bi bi-search"></i>
                        </div>
                        <h4 class="fw-bold text-dark">Track Your Active Delivery</h4>
                        <p class="text-muted col-md-6 mx-auto mb-4">
                            Enter the high-entropy tracking token sent to your SMS or WhatsApp delivery notification to view the live GPS location of your courier.
                        </p>
                        <form method="get" class="row g-2 justify-content-center">
                            <div class="col-md-5">
                                <input type="text" name="Token" class="form-control form-control-lg text-center" placeholder="e.g. 7f8a9b1c2d3e4f5..." required />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-crosshair me-1"></i> Track
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                var info = Model.TrackingInfo;

                <!-- Status & ETA Banner -->
                <div class="card border-0 shadow-sm mb-4 bg-light">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge @(info.IsDelivered ? "bg-success" : "bg-primary") fs-6 px-3 py-2 me-2">
                                        <i class="bi @(info.IsDelivered ? "bi-check2-circle" : "bi-truck") me-1"></i>
                                        @(info.IsDelivered ? "Delivered" : "In Transit to You")
                                    </span>
                                    <span class="text-muted small">Token: <code>@info.TrackingToken.Substring(0, Math.Min(8, info.TrackingToken.Length))...</code></span>
                                </div>
                                <h4 class="fw-bold text-dark mb-1">@info.JobTitle</h4>
                                <p class="text-muted mb-0"><i class="bi bi-pin-map text-danger me-1"></i>@info.DeliveryAddress</p>
                            </div>

                            <div class="col-md-6 text-md-end">
                                @if (info.IsDelivered)
                                {
                                    <div class="display-6 fw-bold text-success mb-1">
                                        <i class="bi bi-check-circle-fill me-2"></i>Delivered
                                    </div>
                                    <span class="text-muted small">Package safely handed over</span>
                                }
                                else if (info.EstimatedMinutesRemaining.HasValue)
                                {
                                    <div class="d-inline-block text-start p-3 bg-white border rounded shadow-sm">
                                        <span class="text-muted small text-uppercase fw-semibold d-block">Estimated Arrival</span>
                                        <div class="display-6 fw-bold text-primary mb-0">
                                            @info.EstimatedMinutesRemaining.Value min
                                        </div>
                                        <span class="text-muted small">
                                            ETA: @(info.EstimatedArrivalUtc.HasValue ? info.EstimatedArrivalUtc.Value.ToString("HH:mm") : "--:--") UTC
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted">Courier is en route</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live Map & Details Row -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-bottom-0 pt-3 d-flex justify-content-between align-items-center">
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-map me-2 text-primary"></i>Live Courier Vehicle GPS</h5>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-broadcast me-1"></i> Live Telematics
                                </span>
                            </div>
                            <div class="card-body p-0">
                                <div id="publicTrackingMap" style="height: 420px; width: 100%; border-radius: 0 0 var(--bs-border-radius) var(--bs-border-radius);"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <!-- Courier Info Card -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body p-4">
                                <h6 class="fw-bold text-muted text-uppercase small mb-3">Your Delivery Courier</h6>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary text-white p-3 rounded-circle fs-4 me-3">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(info.DriverFirstName) ? "Assigned Driver" : info.DriverFirstName)</h5>
                                        <span class="text-muted small">Verified ConnectedOps Courier</span>
                                    </div>
                                </div>
                                <hr />
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Vehicle Assigned</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(info.VehiclePlateNumber) ? "Fleet Van" : info.VehiclePlateNumber)</span>
                                </div>
                                @if (info.CurrentVehicleSpeedKmh.HasValue)
                                {
                                    <div class="mb-2">
                                        <span class="text-muted small d-block">Speed</span>
                                        <span class="badge bg-light text-dark border">@Math.Round(info.CurrentVehicleSpeedKmh.Value, 0) km/h</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- CSAT Rating Widget -->
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-star-fill text-warning me-2"></i>Rate Your Experience</h6>
                                @if (info.Rating.HasValue)
                                {
                                    <div class="text-center py-3 bg-light rounded">
                                        <div class="text-warning fs-3 mb-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= info.Rating.Value ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <span class="fw-semibold text-dark">You rated @info.Rating.Value out of 5 stars</span>
                                        @if (!string.IsNullOrWhiteSpace(info.FeedbackComment))
                                        {
                                            <p class="text-muted small mt-2 mb-0 fst-italic">"@info.FeedbackComment"</p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Rating">
                                        <p class="text-muted small mb-3">How was your delivery service today? Let us know!</p>
                                        <div class="mb-3 text-center">
                                            <div class="btn-group w-100" role="group">
                                                @for (int r = 1; r <= 5; r++)
                                                {
                                                    <input type="radio" class="btn-check" name="rating" id="star-@r" value="@r" required @(r == 5 ? "checked" : "") />
                                                    <label class="btn btn-outline-warning" for="star-@r">@r <i class="bi bi-star-fill"></i></label>
                                                }
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <textarea name="feedbackComment" class="form-control" rows="2" placeholder="Optional comments on driver courtesy, speed, or condition..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="bi bi-send me-1"></i> Submit Feedback
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.TrackingInfo != null)
{
    var info = Model.TrackingInfo;
    var destLat = info.DestinationLatitude;
    var destLng = info.DestinationLongitude;
    var vehLat = info.CurrentVehicleLatitude ?? (destLat - 0.015);
    var vehLng = info.CurrentVehicleLongitude ?? (destLng - 0.012);

    @section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var destLat = @destLat.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var destLng = @destLng.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var vehLat = @vehLat.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var vehLng = @vehLng.ToString(System.Globalization.CultureInfo.InvariantCulture);

            var map = L.map('publicTrackingMap').setView([(destLat + vehLat) / 2, (destLng + vehLng) / 2], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Customer Destination Pin
            var destIcon = L.divIcon({
                className: 'dest-pin',
                html: '<div style="background-color: #dc3545; color: white; border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.3); border: 2px solid white;"><i class="bi bi-house-door-fill"></i></div>',
                iconSize: [34, 34],
                iconAnchor: [17, 17]
            });
            L.marker([destLat, destLng], { icon: destIcon })
                .addTo(map)
                .bindPopup('<b>Destination:</b><br/>@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(info.DeliveryAddress))')
                .openPopup();

            // Courier Vehicle Marker
            var truckIcon = L.divIcon({
                className: 'truck-pin',
                html: '<div style="background-color: #0d6efd; color: white; border-radius: 50%; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; box-shadow: 0 3px 8px rgba(0,0,0,0.4); border: 2px solid white;"><i class="bi bi-truck"></i></div>',
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });
            L.marker([vehLat, vehLng], { icon: truckIcon })
                .addTo(map)
                .bindPopup('<b>Courier Vehicle:</b><br/>@(info.VehiclePlateNumber ?? "Fleet Courier")');

            // Polyline
            L.polyline([[vehLat, vehLng], [destLat, destLng]], {
                color: '#0d6efd',
                dashArray: '8, 8',
                weight: 4,
                opacity: 0.7
            }).addTo(map);

            var bounds = L.latLngBounds([[vehLat, vehLng], [destLat, destLng]]);
            map.fitBounds(bounds, { padding: [50, 50] });
        });
    </script>
    }
}
