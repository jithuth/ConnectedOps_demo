@page
@model ConnectedOps.Web.Pages.Maintenance.ServiceTypes.IndexModel
@{
    ViewData["Title"] = "Maintenance Service Types";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-wrench-adjustable-circle text-primary me-2"></i>Service Types Catalog</h1>
                <p class="text-muted small mb-0">Standardized maintenance task definitions, categories, and duration benchmarks.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createServiceTypeModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Service Type
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- KPI SUMMARY -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-card-checklist fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Total Types</div>
                            <div class="fs-4 fw-bold">@Model.ServiceTypes.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-shield-check fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Preventive</div>
                            <div class="fs-4 fw-bold">@Model.ServiceTypes.Count(s => s.Category == ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Preventive)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                            <i class="bi bi-tools fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Corrective / Repairs</div>
                            <div class="fs-4 fw-bold">@Model.ServiceTypes.Count(s => s.Category == ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Corrective)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                            <i class="bi bi-clipboard2-check fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Inspection &amp; Safety</div>
                            <div class="fs-4 fw-bold">@Model.ServiceTypes.Count(s => s.Category == ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Inspection || s.Category == ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Safety)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Code</th>
                                <th>Name &amp; Description</th>
                                <th>Category</th>
                                <th>Estimated Duration</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ServiceTypes.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-wrench-adjustable fs-1 text-muted d-block mb-2"></i>
                                        No maintenance service types defined. Click "Add Service Type" to create standard catalog items.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var st in Model.ServiceTypes)
                                {
                                    <tr>
                                        <td class="fw-bold font-monospace">@st.Code</td>
                                        <td>
                                            <div class="fw-semibold">@st.Name</div>
                                            <div class="small text-muted">@(st.Description ?? "—")</div>
                                        </td>
                                        <td>
                                            @switch (st.Category)
                                            {
                                                case ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Preventive:
                                                    <span class="badge bg-success-subtle text-success">@st.CategoryName</span>
                                                    break;
                                                case ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Corrective:
                                                    <span class="badge bg-warning-subtle text-warning">@st.CategoryName</span>
                                                    break;
                                                case ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory.Inspection:
                                                    <span class="badge bg-purple-subtle text-purple">@st.CategoryName</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-info-subtle text-info">@st.CategoryName</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @(st.DefaultDurationHours.HasValue ? $"{st.DefaultDurationHours.Value:N1} hrs" : "—")
                                        </td>
                                        <td>
                                            <span class="badge @(st.IsActive ? "bg-success" : "bg-secondary")">
                                                @(st.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editModal-@st.Id">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete service type @st.Name?');">
                                                <input type="hidden" name="id" value="@st.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Service Type">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                            <!-- EDIT MODAL -->
                                            <div class="modal fade text-start" id="editModal-@st.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content border-0 shadow">
                                                        <form method="post" asp-page-handler="Update">
                                                            <input type="hidden" name="id" value="@st.Id" />
                                                            <div class="modal-header border-0 pb-0">
                                                                <h5 class="modal-title fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Edit Service Type</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row g-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                                                                        <input type="text" class="form-control font-monospace" name="code" value="@st.Code" required />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Category <span class="text-danger">*</span></label>
                                                                        <select class="form-select" name="category" required>
                                                                            @foreach (var cat in Enum.GetValues<ConnectedOps.Domain.Maintenance.MaintenanceServiceCategory>())
                                                                            {
                                                                                <option value="@cat" selected="@(st.Category == cat)">@cat</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <label class="form-label small fw-semibold">Name <span class="text-danger">*</span></label>
                                                                        <input type="text" class="form-control" name="name" value="@st.Name" required />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Est. Duration (Hours)</label>
                                                                        <input type="number" step="0.5" class="form-control" name="defaultDurationHours" value="@st.DefaultDurationHours" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Status</label>
                                                                        <div class="form-check form-switch mt-2">
                                                                            <input class="form-check-input" type="checkbox" name="isActive" value="true" @(st.IsActive ? "checked" : "") />
                                                                            <label class="form-check-label small">Active</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <label class="form-label small fw-semibold">Description</label>
                                                                        <textarea class="form-control" name="description" rows="2">@st.Description</textarea>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade" id="createServiceTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Add Service Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" name="code" placeholder="e.g. OIL-CHANGE-STD" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Category <span class="text-danger">*</span></label>
                            <select class="form-select" name="category" required>
                                <option value="Preventive" selected>Preventive</option>
                                <option value="Corrective">Corrective</option>
                                <option value="Inspection">Inspection</option>
                                <option value="Lubrication">Lubrication</option>
                                <option value="Tyre">Tyre</option>
                                <option value="Battery">Battery</option>
                                <option value="Brake">Brake</option>
                                <option value="Electrical">Electrical</option>
                                <option value="Engine">Engine</option>
                                <option value="Transmission">Transmission</option>
                                <option value="AirConditioning">Air Conditioning</option>
                                <option value="Body">Body</option>
                                <option value="Safety">Safety</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="name" placeholder="e.g. Engine Oil &amp; Filter Replacement" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Est. Duration (Hours)</label>
                            <input type="number" step="0.5" class="form-control" name="defaultDurationHours" placeholder="e.g. 1.5" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Status</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" checked />
                                <label class="form-check-label small">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description</label>
                            <textarea class="form-control" name="description" rows="2" placeholder="Describe standard scope of work..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Create Service Type</button>
                </div>
            </form>
        </div>
    </div>
</div>
