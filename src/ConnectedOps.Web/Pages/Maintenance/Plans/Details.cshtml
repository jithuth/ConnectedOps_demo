@page
@model ConnectedOps.Web.Pages.Maintenance.Plans.DetailsModel
@{
    ViewData["Title"] = $"Maintenance Plan: {Model.Plan.Name}";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2">
                    <h1 class="m-0 fw-bold"><i class="bi bi-clipboard2-pulse text-primary me-2"></i>@Model.Plan.Name</h1>
                    <span class="badge @(Model.Plan.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.Plan.IsActive ? "Active Plan" : "Inactive")
                    </span>
                </div>
                <p class="text-muted small mb-0">Plan Code: <span class="fw-bold font-monospace">@Model.Plan.Code</span> &bull; Category: <span class="fw-semibold">@(Model.Plan.VehicleCategoryName ?? "All Vehicle Categories")</span></p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editPlanModal">
                    <i class="bi bi-pencil me-1"></i> Edit Plan
                </button>
                <a href="/Maintenance/Plans" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Plans
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- METRICS ROW -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-list-check fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Service Rules</div>
                            <div class="fs-4 fw-bold">@Model.Plan.Rules.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-truck fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Assigned Vehicles</div>
                            <div class="fs-4 fw-bold">@Model.Assignments.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                            <i class="bi bi-info-circle fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Description</div>
                            <div class="small text-truncate" style="max-width: 250px;">@(Model.Plan.Description ?? "No description provided.")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABS NAV -->
        <ul class="nav nav-tabs mb-3" id="planTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="rules-tab" data-bs-toggle="tab" data-bs-target="#rules-pane" type="button" role="tab">
                    <i class="bi bi-card-checklist me-1"></i> Maintenance Rules (@Model.Plan.Rules.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="vehicles-tab" data-bs-toggle="tab" data-bs-target="#vehicles-pane" type="button" role="tab">
                    <i class="bi bi-truck me-1"></i> Assigned Vehicles (@Model.Assignments.Count)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="planTabsContent">
            <!-- TAB 1: RULES -->
            <div class="tab-pane fade show active" id="rules-pane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-3">
                        <h5 class="card-title fw-bold m-0">Plan Service Rules</h5>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addRuleModal">
                            <i class="bi bi-plus-circle me-1"></i> Add Rule
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Service Type</th>
                                        <th>Category</th>
                                        <th>Schedule Trigger</th>
                                        <th>Intervals</th>
                                        <th>Reminders &amp; Tolerance</th>
                                        <th>Mandatory</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Plan.Rules.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center py-5 text-muted">
                                                <i class="bi bi-clipboard-x fs-1 text-muted d-block mb-2"></i>
                                                No service rules configured for this plan yet. Click "Add Rule" to define schedules.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var rule in Model.Plan.Rules)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold">@rule.ServiceTypeName</div>
                                                    <div class="small text-muted font-monospace">@rule.ServiceTypeCode</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary-subtle text-secondary">@rule.ServiceCategoryName</span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary-subtle text-primary">@rule.ScheduleTypeName</span>
                                                </td>
                                                <td class="small">
                                                    @if (rule.IntervalKilometers.HasValue)
                                                    {
                                                        <div><i class="bi bi-speedometer2 me-1 text-muted"></i><strong>@rule.IntervalKilometers.Value.ToString("N0")</strong> km</div>
                                                    }
                                                    @if (rule.IntervalMiles.HasValue)
                                                    {
                                                        <div><i class="bi bi-speedometer me-1 text-muted"></i><strong>@rule.IntervalMiles.Value.ToString("N0")</strong> mi</div>
                                                    }
                                                    @if (rule.IntervalEngineHours.HasValue)
                                                    {
                                                        <div><i class="bi bi-hourglass-split me-1 text-muted"></i><strong>@rule.IntervalEngineHours.Value.ToString("N0")</strong> hrs</div>
                                                    }
                                                    @if (rule.IntervalMonths.HasValue)
                                                    {
                                                        <div><i class="bi bi-calendar3 me-1 text-muted"></i><strong>@rule.IntervalMonths.Value</strong> mos</div>
                                                    }
                                                    @if (rule.IntervalDays.HasValue)
                                                    {
                                                        <div><i class="bi bi-calendar-event me-1 text-muted"></i><strong>@rule.IntervalDays.Value</strong> days</div>
                                                    }
                                                </td>
                                                <td class="small text-muted">
                                                    <div>
                                                        <span class="fw-semibold">Reminder:</span>
                                                        @(rule.ReminderBeforeKilometers.HasValue ? $"{rule.ReminderBeforeKilometers.Value:N0} km " : "")
                                                        @(rule.ReminderBeforeDays.HasValue ? $"{rule.ReminderBeforeDays.Value} days " : "")
                                                        @(rule.ReminderBeforeEngineHours.HasValue ? $"{rule.ReminderBeforeEngineHours.Value:N0} hrs" : "")
                                                        @(!rule.ReminderBeforeKilometers.HasValue && !rule.ReminderBeforeDays.HasValue && !rule.ReminderBeforeEngineHours.HasValue ? "Standard" : "")
                                                    </div>
                                                    <div>
                                                        <span class="fw-semibold">Tolerance:</span>
                                                        @(rule.ToleranceKilometers.HasValue ? $"{rule.ToleranceKilometers.Value:N0} km " : "")
                                                        @(rule.ToleranceDays.HasValue ? $"{rule.ToleranceDays.Value} days " : "")
                                                        @(rule.ToleranceHours.HasValue ? $"{rule.ToleranceHours.Value:N0} hrs" : "")
                                                        @(!rule.ToleranceKilometers.HasValue && !rule.ToleranceDays.HasValue && !rule.ToleranceHours.HasValue ? "None" : "")
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (rule.IsMandatory)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-shield-lock me-1"></i>Mandatory</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary">Optional</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @(rule.IsActive ? "bg-success" : "bg-secondary")">
                                                        @(rule.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <form method="post" asp-page-handler="DeleteRule" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this rule?');">
                                                        <input type="hidden" name="id" value="@Model.Plan.Id" />
                                                        <input type="hidden" name="ruleId" value="@rule.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Rule">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: ASSIGNED VEHICLES -->
            <div class="tab-pane fade" id="vehicles-pane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center p-3">
                        <h5 class="card-title fw-bold m-0">Vehicles Assigned to this Plan</h5>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#assignVehicleModal">
                            <i class="bi bi-plus-circle me-1"></i> Assign Vehicle
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Vehicle Number</th>
                                        <th>Display Name / Reg</th>
                                        <th>Effective From</th>
                                        <th>Effective To</th>
                                        <th>Baseline Readings</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Assignments.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="bi bi-truck fs-1 text-muted d-block mb-2"></i>
                                                No vehicles assigned to this plan yet. Click "Assign Vehicle" to enroll fleet assets.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var assign in Model.Assignments)
                                        {
                                            <tr>
                                                <td class="fw-bold">
                                                    <a href="/Vehicles/Details/@assign.VehicleId" class="text-decoration-none">
                                                        @assign.VehicleNumber
                                                    </a>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@assign.VehicleDisplayName</div>
                                                    <div class="small text-muted">@(assign.RegistrationNumber ?? "No Reg Plate")</div>
                                                </td>
                                                <td class="small">@assign.EffectiveFromUtc.ToString("yyyy-MM-dd")</td>
                                                <td class="small text-muted">@(assign.EffectiveToUtc?.ToString("yyyy-MM-dd") ?? "Ongoing")</td>
                                                <td class="small">
                                                    <div>Odo: <strong>@(assign.BaselineOdometer.HasValue ? $"{assign.BaselineOdometer.Value:N0}" : "—")</strong></div>
                                                    <div>Hours: <strong>@(assign.BaselineEngineHours.HasValue ? $"{assign.BaselineEngineHours.Value:N0}" : "—")</strong></div>
                                                </td>
                                                <td>
                                                    <span class="badge @(assign.IsActive ? "bg-success" : "bg-secondary")">
                                                        @(assign.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <form method="post" asp-page-handler="RemoveAssignment" class="d-inline" onsubmit="return confirm('Remove vehicle assignment from this plan?');">
                                                        <input type="hidden" name="id" value="@Model.Plan.Id" />
                                                        <input type="hidden" name="assignmentId" value="@assign.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Assignment">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: ADD RULE -->
<div class="modal fade" id="addRuleModal" tabindex="-1" aria-labelledby="addRuleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AddRule">
                <input type="hidden" name="id" value="@Model.Plan.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="addRuleModalLabel"><i class="bi bi-plus-circle text-primary me-2"></i>Add Maintenance Rule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Service Type <span class="text-danger">*</span></label>
                            <select class="form-select" name="maintenanceServiceTypeId" required>
                                <option value="">-- Select Service Type --</option>
                                @foreach (var st in Model.ServiceTypes)
                                {
                                    <option value="@st.Id">@st.Name (@st.CategoryName - @st.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Schedule Type <span class="text-danger">*</span></label>
                            <select class="form-select" name="scheduleType" required>
                                <option value="Distance">Distance Interval</option>
                                <option value="Calendar">Calendar Interval</option>
                                <option value="EngineHours">Engine Hours Interval</option>
                                <option value="DistanceOrCalendar" selected>Distance OR Calendar (Whichever first)</option>
                                <option value="DistanceAndCalendar">Distance AND Calendar (Both required)</option>
                                <option value="EngineHoursOrCalendar">Engine Hours OR Calendar</option>
                                <option value="FixedDate">Fixed Date</option>
                            </select>
                        </div>

                        <!-- INTERVALS SECTION -->
                        <div class="col-12"><h6 class="fw-bold text-secondary border-bottom pb-1 mt-2">Trigger Intervals</h6></div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Interval (Kilometers)</label>
                            <input type="number" step="100" class="form-control" name="intervalKilometers" placeholder="e.g. 10000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Interval (Miles)</label>
                            <input type="number" step="100" class="form-control" name="intervalMiles" placeholder="e.g. 6000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Interval (Engine Hours)</label>
                            <input type="number" step="10" class="form-control" name="intervalEngineHours" placeholder="e.g. 250" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Interval (Months)</label>
                            <input type="number" step="1" class="form-control" name="intervalMonths" placeholder="e.g. 6" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Interval (Days)</label>
                            <input type="number" step="1" class="form-control" name="intervalDays" placeholder="e.g. 180" />
                        </div>

                        <!-- REMINDER & TOLERANCE SECTION -->
                        <div class="col-12"><h6 class="fw-bold text-secondary border-bottom pb-1 mt-2">Notification Window &amp; Tolerances</h6></div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Reminder Window (km)</label>
                            <input type="number" step="100" class="form-control" name="reminderBeforeKilometers" placeholder="e.g. 1000" />
                            <small class="text-muted">Flags 'Upcoming' this many km prior.</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Reminder Window (Days)</label>
                            <input type="number" step="1" class="form-control" name="reminderBeforeDays" placeholder="e.g. 14" />
                            <small class="text-muted">Flags 'Upcoming' this many days prior.</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Reminder Window (Hours)</label>
                            <input type="number" step="5" class="form-control" name="reminderBeforeEngineHours" placeholder="e.g. 20" />
                            <small class="text-muted">Flags 'Upcoming' this many hrs prior.</small>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tolerance (km)</label>
                            <input type="number" step="50" class="form-control" name="toleranceKilometers" placeholder="e.g. 500" />
                            <small class="text-muted">Overdue after due + tolerance.</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tolerance (Days)</label>
                            <input type="number" step="1" class="form-control" name="toleranceDays" placeholder="e.g. 7" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tolerance (Hours)</label>
                            <input type="number" step="5" class="form-control" name="toleranceHours" placeholder="e.g. 10" />
                        </div>

                        <!-- FLAGS & NOTES -->
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="isMandatory" value="true" checked />
                                <label class="form-check-label small fw-semibold">Mandatory Compliance Rule</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" checked />
                                <label class="form-check-label small fw-semibold">Active Rule</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold">Notes / Special Instructions</label>
                            <textarea class="form-control" name="notes" rows="2" placeholder="e.g. Inspect drive belts, replace filter elements..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Add Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ASSIGN VEHICLE -->
<div class="modal fade" id="assignVehicleModal" tabindex="-1" aria-labelledby="assignVehicleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AssignVehicle">
                <input type="hidden" name="id" value="@Model.Plan.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="assignVehicleModalLabel"><i class="bi bi-truck text-primary me-2"></i>Assign Vehicle to Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Select Vehicle <span class="text-danger">*</span></label>
                            <select class="form-select" name="vehicleId" required>
                                <option value="">-- Choose Vehicle --</option>
                                @foreach (var v in Model.Vehicles)
                                {
                                    <option value="@v.Id">@v.VehicleNumber - @v.DisplayName (@(v.RegistrationNumber ?? "No Reg"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Effective From <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="effectiveFromUtc" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Effective To (Optional)</label>
                            <input type="date" class="form-control" name="effectiveToUtc" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Baseline Odometer</label>
                            <input type="number" step="1" class="form-control" name="baselineOdometer" placeholder="e.g. 50000" />
                            <small class="text-muted">Start point for interval calc.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Baseline Engine Hours</label>
                            <input type="number" step="0.1" class="form-control" name="baselineEngineHours" placeholder="e.g. 1200" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Notes</label>
                            <textarea class="form-control" name="notes" rows="2" placeholder="e.g. Enrolled upon fleet acquisition"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Assign Vehicle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: EDIT PLAN -->
<div class="modal fade" id="editPlanModal" tabindex="-1" aria-labelledby="editPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="UpdatePlan">
                <input type="hidden" name="id" value="@Model.Plan.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editPlanModalLabel"><i class="bi bi-pencil text-primary me-2"></i>Edit Maintenance Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Plan Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="code" value="@Model.Plan.Code" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Plan Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="name" value="@Model.Plan.Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vehicle Category (Optional)</label>
                            <select class="form-select" name="vehicleCategoryId">
                                <option value="">-- Apply to All Categories --</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.Plan.VehicleCategoryId == cat.Id)">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Status</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" @(Model.Plan.IsActive ? "checked" : "") />
                                <label class="form-check-label small">Active Plan</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description</label>
                            <textarea class="form-control" name="description" rows="3">@Model.Plan.Description</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
