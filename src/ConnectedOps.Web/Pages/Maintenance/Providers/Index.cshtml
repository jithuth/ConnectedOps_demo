@page
@model ConnectedOps.Web.Pages.Maintenance.Providers.IndexModel
@{
    ViewData["Title"] = "Maintenance Providers & Workshops";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-buildings text-primary me-2"></i>Maintenance Providers &amp; Workshops</h1>
                <p class="text-muted small mb-0">Internal workshops, external service vendors, dealerships, and mobile mechanics.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createProviderModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Provider
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- KPI SUMMARY -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-buildings fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Total Facilities</div>
                            <div class="fs-4 fw-bold">@Model.Providers.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-house-gear fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Internal Workshops</div>
                            <div class="fs-4 fw-bold">@Model.Providers.Count(p => p.ProviderType == ConnectedOps.Domain.Maintenance.MaintenanceProviderType.InternalWorkshop)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                            <i class="bi bi-gear-wide-connected fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">External Service</div>
                            <div class="fs-4 fw-bold">@Model.Providers.Count(p => p.ProviderType == ConnectedOps.Domain.Maintenance.MaintenanceProviderType.ExternalWorkshop)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                            <i class="bi bi-truck-flatbed fs-3"></i>
                        </div>
                        <div>
                            <div class="text-muted small fw-semibold">Dealers &amp; Mobile</div>
                            <div class="fs-4 fw-bold">@Model.Providers.Count(p => p.ProviderType == ConnectedOps.Domain.Maintenance.MaintenanceProviderType.Dealer || p.ProviderType == ConnectedOps.Domain.Maintenance.MaintenanceProviderType.MobileService)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Code</th>
                                <th>Name &amp; Type</th>
                                <th>Contact Details</th>
                                <th>Branch / Base</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Providers.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-buildings fs-1 text-muted d-block mb-2"></i>
                                        No maintenance providers defined. Click "Add Provider" to register workshops and service partners.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in Model.Providers)
                                {
                                    <tr>
                                        <td class="fw-bold font-monospace">@p.Code</td>
                                        <td>
                                            <div class="fw-semibold">@p.Name</div>
                                            <span class="badge @(p.ProviderType == ConnectedOps.Domain.Maintenance.MaintenanceProviderType.InternalWorkshop ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                                @p.ProviderTypeName
                                            </span>
                                        </td>
                                        <td class="small">
                                            @if (!string.IsNullOrEmpty(p.ContactPerson))
                                            {
                                                <div><i class="bi bi-person me-1 text-muted"></i>@p.ContactPerson</div>
                                            }
                                            @if (!string.IsNullOrEmpty(p.Phone))
                                            {
                                                <div><i class="bi bi-telephone me-1 text-muted"></i>@p.Phone</div>
                                            }
                                            @if (!string.IsNullOrEmpty(p.Email))
                                            {
                                                <div><i class="bi bi-envelope me-1 text-muted"></i>@p.Email</div>
                                            }
                                            @if (string.IsNullOrEmpty(p.ContactPerson) && string.IsNullOrEmpty(p.Phone) && string.IsNullOrEmpty(p.Email))
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @(p.BranchName ?? "Organization-wide")
                                        </td>
                                        <td>
                                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                                @(p.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editModal-@p.Id">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete provider @p.Name?');">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Provider">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                            <!-- EDIT MODAL -->
                                            <div class="modal fade text-start" id="editModal-@p.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg">
                                                    <div class="modal-content border-0 shadow">
                                                        <form method="post" asp-page-handler="Update">
                                                            <input type="hidden" name="id" value="@p.Id" />
                                                            <div class="modal-header border-0 pb-0">
                                                                <h5 class="modal-title fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Edit Provider</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row g-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                                                                        <input type="text" class="form-control font-monospace" name="code" value="@p.Code" required />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Type <span class="text-danger">*</span></label>
                                                                        <select class="form-select" name="providerType" required>
                                                                            @foreach (var pt in Enum.GetValues<ConnectedOps.Domain.Maintenance.MaintenanceProviderType>())
                                                                            {
                                                                                <option value="@pt" selected="@(p.ProviderType == pt)">@pt</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-12">
                                                                        <label class="form-label small fw-semibold">Name <span class="text-danger">*</span></label>
                                                                        <input type="text" class="form-control" name="name" value="@p.Name" required />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Contact Person</label>
                                                                        <input type="text" class="form-control" name="contactPerson" value="@p.ContactPerson" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Phone</label>
                                                                        <input type="text" class="form-control" name="phone" value="@p.Phone" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Email</label>
                                                                        <input type="email" class="form-control" name="email" value="@p.Email" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Branch (Optional)</label>
                                                                        <select class="form-select" name="branchId">
                                                                            <option value="">-- Organization-wide --</option>
                                                                            @foreach (var b in Model.Branches)
                                                                            {
                                                                                <option value="@b.Id" selected="@(p.BranchId == b.Id)">@b.Name</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <label class="form-label small fw-semibold">Address</label>
                                                                        <input type="text" class="form-control" name="address" value="@p.Address" />
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label small fw-semibold">Status</label>
                                                                        <div class="form-check form-switch mt-2">
                                                                            <input class="form-check-input" type="checkbox" name="isActive" value="true" @(p.IsActive ? "checked" : "") />
                                                                            <label class="form-check-label small">Active</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <label class="form-label small fw-semibold">Notes</label>
                                                                        <textarea class="form-control" name="notes" rows="2">@p.Notes</textarea>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade" id="createProviderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Add Maintenance Provider</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" name="code" placeholder="e.g. WS-MAIN-HQ" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Type <span class="text-danger">*</span></label>
                            <select class="form-select" name="providerType" required>
                                <option value="InternalWorkshop" selected>Internal Workshop</option>
                                <option value="ExternalWorkshop">External Workshop</option>
                                <option value="Dealer">Authorized Dealer</option>
                                <option value="MobileService">Mobile Service Unit</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Provider / Workshop Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="name" placeholder="e.g. Central Depot Workshop" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Contact Person</label>
                            <input type="text" class="form-control" name="contactPerson" placeholder="e.g. John Doe (Lead Mechanic)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Phone</label>
                            <input type="text" class="form-control" name="phone" placeholder="e.g. +1 555-0199" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email</label>
                            <input type="email" class="form-control" name="email" placeholder="e.g. workshop@company.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Branch (Optional)</label>
                            <select class="form-select" name="branchId">
                                <option value="">-- Organization-wide --</option>
                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Physical Address</label>
                            <input type="text" class="form-control" name="address" placeholder="e.g. 100 Industrial Parkway, Bay 4" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Status</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" checked />
                                <label class="form-check-label small">Active Facility</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Notes</label>
                            <textarea class="form-control" name="notes" rows="2" placeholder="e.g. Operating hours, specialized diagnostic equipment..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Create Provider</button>
                </div>
            </form>
        </div>
    </div>
</div>
