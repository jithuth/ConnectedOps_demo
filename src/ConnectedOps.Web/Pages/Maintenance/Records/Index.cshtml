@page
@model ConnectedOps.Web.Pages.Maintenance.Records.IndexModel
@using ConnectedOps.Domain.Maintenance
@{
    ViewData["Title"] = "Maintenance Records";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-wrench-adjustable text-primary me-2"></i>Service Records</h1>
                <p class="text-muted small mb-0">Internal fleet maintenance log, workshop work history, parts and cost tracking.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Maintenance/Records/Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> New Service Record
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" name="Query.SearchTerm" value="@Model.Query.SearchTerm" placeholder="Search vehicle, ref #...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="Query.Status">
                            <option value="">All Statuses</option>
                            <option value="@((int)MaintenanceRecordStatus.Draft)" selected="@(Model.Query.Status == MaintenanceRecordStatus.Draft)">Draft</option>
                            <option value="@((int)MaintenanceRecordStatus.Scheduled)" selected="@(Model.Query.Status == MaintenanceRecordStatus.Scheduled)">Scheduled</option>
                            <option value="@((int)MaintenanceRecordStatus.InProgress)" selected="@(Model.Query.Status == MaintenanceRecordStatus.InProgress)">InProgress</option>
                            <option value="@((int)MaintenanceRecordStatus.Completed)" selected="@(Model.Query.Status == MaintenanceRecordStatus.Completed)">Completed</option>
                            <option value="@((int)MaintenanceRecordStatus.Cancelled)" selected="@(Model.Query.Status == MaintenanceRecordStatus.Cancelled)">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="Query.ServiceTypeId">
                            <option value="">All Services</option>
                            @foreach (var st in Model.ServiceTypes)
                            {
                                <option value="@st.Id" selected="@(Model.Query.ServiceTypeId == st.Id)">@st.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" name="Query.ProviderId">
                            <option value="">All Workshops / Providers</option>
                            @foreach (var p in Model.Providers)
                            {
                                <option value="@p.Id" selected="@(Model.Query.ProviderId == p.Id)">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                        <a href="/Maintenance/Records" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
                    </div>
                </form>
            </div>
        </div>

        <!-- RECORDS LIST -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Vehicle</th>
                                <th>Service Type</th>
                                <th>Type</th>
                                <th>Workshop</th>
                                <th>Service Date</th>
                                <th>Odometer</th>
                                <th>Total Cost</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Result.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="bi bi-wrench fs-1 text-muted d-block mb-2"></i>
                                        No maintenance service records found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Result.Items)
                                {
                                    var badgeClass = item.Status switch
                                    {
                                        MaintenanceRecordStatus.Completed => "bg-success text-white",
                                        MaintenanceRecordStatus.InProgress => "bg-info text-white",
                                        MaintenanceRecordStatus.Scheduled => "bg-primary text-white",
                                        MaintenanceRecordStatus.Draft => "bg-secondary text-white",
                                        MaintenanceRecordStatus.Cancelled => "bg-dark text-white",
                                        _ => "bg-secondary text-white"
                                    };

                                    <tr>
                                        <td>
                                            <a href="/Vehicles/Details?id=@item.VehicleId" class="fw-semibold text-decoration-none">@item.VehicleNumber</a>
                                            @if (!string.IsNullOrEmpty(item.RegistrationNumber))
                                            {
                                                <div class="small text-muted">@item.RegistrationNumber</div>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@item.ServiceTypeName</div>
                                            <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">@item.ServiceCategoryName</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@item.MaintenanceTypeName</span>
                                        </td>
                                        <td class="small">
                                            @(item.ProviderName ?? "Internal Workshop")
                                        </td>
                                        <td class="small">
                                            @item.ServiceDateUtc.ToString("MMM dd, yyyy")
                                        </td>
                                        <td class="small">
                                            @(item.OdometerReading.HasValue ? $"{item.OdometerReading.Value:N0} {item.OdometerUnit}" : "—")
                                        </td>
                                        <td class="fw-semibold @(item.TotalCost > 0 ? "text-success" : "text-muted")">
                                            @item.TotalCost.ToString("N2") @item.CurrencyCode
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass">@item.StatusName</span>
                                        </td>
                                        <td class="text-end">
                                            <a href="/Maintenance/Records/Details?id=@item.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- PAGINATION -->
            @if (Model.Result.TotalPages > 1)
            {
                <div class="card-footer bg-transparent py-2 d-flex justify-content-between align-items-center">
                    <small class="text-muted">Showing page @Model.Result.PageNumber of @Model.Result.TotalPages (@Model.Result.TotalCount items)</small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="/Maintenance/Records?Query.PageNumber=@(Model.Result.PageNumber - 1)&Query.SearchTerm=@Model.Query.SearchTerm&Query.Status=@Model.Query.Status&Query.ServiceTypeId=@Model.Query.ServiceTypeId&Query.ProviderId=@Model.Query.ProviderId">Prev</a>
                        </li>
                        @for (int p = 1; p <= Model.Result.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Result.PageNumber ? "active" : "")">
                                <a class="page-link" href="/Maintenance/Records?Query.PageNumber=@p&Query.SearchTerm=@Model.Query.SearchTerm&Query.Status=@Model.Query.Status&Query.ServiceTypeId=@Model.Query.ServiceTypeId&Query.ProviderId=@Model.Query.ProviderId">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="/Maintenance/Records?Query.PageNumber=@(Model.Result.PageNumber + 1)&Query.SearchTerm=@Model.Query.SearchTerm&Query.Status=@Model.Query.Status&Query.ServiceTypeId=@Model.Query.ServiceTypeId&Query.ProviderId=@Model.Query.ProviderId">Next</a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
