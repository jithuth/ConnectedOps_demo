@page
@model ConnectedOps.Web.Pages.Maintenance.DueModel
@using ConnectedOps.Domain.Maintenance
@{
    ViewData["Title"] = "Due Maintenance";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-alarm text-warning me-2"></i>Due Maintenance</h1>
                <p class="text-muted small mb-0">Track and schedule upcoming, due, and overdue vehicle maintenance services.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Maintenance/Records/Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> New Service Record
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- COUNTS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <a href="/Maintenance/Due?Query.Status=@((int)MaintenanceDueStatus.Upcoming)" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-3 @(Model.Query.Status == MaintenanceDueStatus.Upcoming ? "border border-2 border-warning" : "")">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Upcoming</span>
                                <h3 class="fw-bold mb-0 text-warning">@Model.UpcomingCount</h3>
                                <small class="text-muted">Inside reminder window</small>
                            </div>
                            <div class="rounded-circle bg-warning-subtle text-warning p-3">
                                <i class="bi bi-hourglass-split fs-4"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="/Maintenance/Due?Query.Status=@((int)MaintenanceDueStatus.Due)" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-3 @(Model.Query.Status == MaintenanceDueStatus.Due ? "border border-2 border-danger" : "")">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Due Now</span>
                                <h3 class="fw-bold mb-0 text-danger">@Model.DueCount</h3>
                                <small class="text-muted">Threshold reached</small>
                            </div>
                            <div class="rounded-circle bg-danger-subtle text-danger p-3">
                                <i class="bi bi-exclamation-circle fs-4"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a href="/Maintenance/Due?Query.Status=@((int)MaintenanceDueStatus.Overdue)" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-3 @(Model.Query.Status == MaintenanceDueStatus.Overdue ? "border border-2 border-dark" : "")">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Overdue</span>
                                <h3 class="fw-bold mb-0 text-dark">@Model.OverdueCount</h3>
                                <small class="text-danger fw-semibold">Exceeded tolerance boundary</small>
                            </div>
                            <div class="rounded-circle bg-dark text-white p-3">
                                <i class="bi bi-exclamation-triangle fs-4"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- FILTERS -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" name="Query.SearchTerm" value="@Model.Query.SearchTerm" placeholder="Search vehicle or service...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="Query.Status">
                            <option value="">All Due Statuses</option>
                            <option value="@((int)MaintenanceDueStatus.Upcoming)" selected="@(Model.Query.Status == MaintenanceDueStatus.Upcoming)">Upcoming</option>
                            <option value="@((int)MaintenanceDueStatus.Due)" selected="@(Model.Query.Status == MaintenanceDueStatus.Due)">Due</option>
                            <option value="@((int)MaintenanceDueStatus.Overdue)" selected="@(Model.Query.Status == MaintenanceDueStatus.Overdue)">Overdue</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="Query.ServiceTypeId">
                            <option value="">All Services</option>
                            @foreach (var st in Model.ServiceTypes)
                            {
                                <option value="@st.Id" selected="@(Model.Query.ServiceTypeId == st.Id)">@st.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm" name="Query.BranchId">
                            <option value="">All Branches</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" selected="@(Model.Query.BranchId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i>Filter</button>
                        <a href="/Maintenance/Due" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
                    </div>
                </form>
            </div>
        </div>

        <!-- DUE GRID TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Vehicle</th>
                                <th>Service / Plan</th>
                                <th>Current Usage</th>
                                <th>Due Target</th>
                                <th>Remaining</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Result.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
                                        No maintenance items match the selected filter criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Result.Items)
                                {
                                    var badgeClass = item.DueStatus switch
                                    {
                                        MaintenanceDueStatus.Overdue => "bg-dark text-white",
                                        MaintenanceDueStatus.Due => "bg-danger text-white",
                                        MaintenanceDueStatus.Upcoming => "bg-warning text-dark",
                                        _ => "bg-secondary text-white"
                                    };

                                    <tr>
                                        <td>
                                            <a href="/Vehicles/Details?id=@item.VehicleId" class="fw-semibold text-decoration-none">@item.VehicleNumber</a>
                                            @if (!string.IsNullOrEmpty(item.RegistrationNumber))
                                            {
                                                <div class="small text-muted">@item.RegistrationNumber</div>
                                            }
                                            @if (!string.IsNullOrEmpty(item.BranchName))
                                            {
                                                <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">@item.BranchName</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@item.ServiceTypeName</div>
                                            <div class="small text-muted">Plan: @item.PlanName (@item.ScheduleTypeName)</div>
                                        </td>
                                        <td class="small">
                                            @if (item.CurrentOdometer.HasValue)
                                            {
                                                <div><i class="bi bi-speedometer me-1 text-muted"></i>@item.CurrentOdometer.Value.ToString("N0") @item.VehicleOdometerUnit</div>
                                            }
                                            @if (item.CurrentEngineHours.HasValue)
                                            {
                                                <div><i class="bi bi-clock me-1 text-muted"></i>@item.CurrentEngineHours.Value.ToString("N1") hrs</div>
                                            }
                                        </td>
                                        <td class="small">
                                            @if (item.NextDueOdometer.HasValue)
                                            {
                                                <div><i class="bi bi-speedometer me-1 text-muted"></i>@item.NextDueOdometer.Value.ToString("N0") @item.VehicleOdometerUnit</div>
                                            }
                                            @if (item.NextDueDateUtc.HasValue)
                                            {
                                                <div><i class="bi bi-calendar me-1 text-muted"></i>@item.NextDueDateUtc.Value.ToString("MMM dd, yyyy")</div>
                                            }
                                            @if (item.NextDueEngineHours.HasValue)
                                            {
                                                <div><i class="bi bi-clock me-1 text-muted"></i>@item.NextDueEngineHours.Value.ToString("N1") hrs</div>
                                            }
                                        </td>
                                        <td class="small">
                                            @if (item.RemainingDistance.HasValue)
                                            {
                                                <div class="@(item.RemainingDistance.Value < 0 ? "text-danger fw-bold" : "")">
                                                    @(item.RemainingDistance.Value < 0 ? $"{Math.Abs(item.RemainingDistance.Value):N0} {item.VehicleOdometerUnit} overdue" : $"{item.RemainingDistance.Value:N0} {item.VehicleOdometerUnit} left")
                                                </div>
                                            }
                                            @if (item.RemainingDays.HasValue)
                                            {
                                                <div class="@(item.RemainingDays.Value < 0 ? "text-danger fw-bold" : "")">
                                                    @(item.RemainingDays.Value < 0 ? $"{Math.Abs(item.RemainingDays.Value)} days overdue" : $"{item.RemainingDays.Value} days left")
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass">@item.DueStatusName</span>
                                            @if (item.IsMandatory)
                                            {
                                                <span class="badge bg-danger-subtle text-danger ms-1" title="Mandatory Service"><i class="bi bi-shield-exclamation"></i></span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/Maintenance/Records/Create?VehicleId=@item.VehicleId&ServiceTypeId=@item.ServiceTypeId&PlanId=@item.MaintenancePlanId&RuleId=@item.MaintenancePlanRuleId" class="btn btn-primary" title="Create Service Record">
                                                    <i class="bi bi-wrench"></i> Service
                                                </a>
                                                <a href="/Vehicles/Details?id=@item.VehicleId#tab-maintenance" class="btn btn-outline-secondary" title="View History">
                                                    <i class="bi bi-clock-history"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- PAGINATION -->
            @if (Model.Result.TotalPages > 1)
            {
                <div class="card-footer bg-transparent py-2 d-flex justify-content-between align-items-center">
                    <small class="text-muted">Showing page @Model.Result.PageNumber of @Model.Result.TotalPages (@Model.Result.TotalCount items)</small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Result.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="/Maintenance/Due?Query.PageNumber=@(Model.Result.PageNumber - 1)&Query.SearchTerm=@Model.Query.SearchTerm&Query.Status=@Model.Query.Status&Query.ServiceTypeId=@Model.Query.ServiceTypeId&Query.BranchId=@Model.Query.BranchId">Prev</a>
                        </li>
                        @for (int p = 1; p <= Model.Result.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Result.PageNumber ? "active" : "")">
                                <a class="page-link" href="/Maintenance/Due?Query.PageNumber=@p&Query.SearchTerm=@Model.Query.SearchTerm&Query.Status=@Model.Query.Status&Query.ServiceTypeId=@Model.Query.ServiceTypeId&Query.BranchId=@Model.Query.BranchId">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Result.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="/Maintenance/Due?Query.PageNumber=@(Model.Result.PageNumber + 1)&Query.SearchTerm=@Model.Query.SearchTerm&Query.Status=@Model.Query.Status&Query.ServiceTypeId=@Model.Query.ServiceTypeId&Query.BranchId=@Model.Query.BranchId">Next</a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
