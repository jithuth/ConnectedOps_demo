@page
@using ConnectedOps.Domain.Inspections
@model ConnectedOps.Web.Pages.Inspections.DvirModel
@{
    ViewData["Title"] = "Driver Vehicle Inspection Reports (DVIR)";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="m-0 fs-3 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard2-check-fill text-success"></i> Vehicle Inspections (DVIR)
                </h1>
                <p class="text-muted small mb-0">
                    Pre-trip and post-trip electronic safety walkaround audits, defect tracking &amp; automatic grounding enforcement
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newInspectionModal">
                    <i class="bi bi-plus-circle"></i> Log Walkaround Inspection
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@Model.SuccessMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@Model.ErrorMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- METRIC KPI CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Inspections Today</span>
                                <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.Metrics.TotalInspectionsToday</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-clipboard-check fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Pre-trip &amp; post-trip checks submitted
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Grounded Vehicles</span>
                                <h3 class="fw-bold mb-0 mt-1 @(Model.Metrics.GroundedVehiclesCount > 0 ? "text-danger" : "text-success")">
                                    @Model.Metrics.GroundedVehiclesCount
                                </h3>
                            </div>
                            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-shield-slash-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Critical safety defects discovered
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Active Defects</span>
                                <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.Metrics.ActiveDefectsCount</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-tools fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Minor or major items pending workshop repair
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Certified Today</span>
                                <h3 class="fw-bold mb-0 mt-1 text-success">@Model.Metrics.CertifiedTodayCount</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                                <i class="bi bi-patch-check-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Mechanic safe-to-drive sign-offs
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- INSPECTIONS TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Inspections == null || !Model.Inspections.Items.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard-x text-muted display-4 mb-3"></i>
                        <h5 class="fw-bold text-dark">No Inspection Reports Found</h5>
                        <p class="text-muted small">Drivers have not logged any pre-trip or post-trip safety checklists yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Report #</th>
                                    <th>Type</th>
                                    <th>Vehicle &amp; Model</th>
                                    <th>Driver</th>
                                    <th>Odometer / Location</th>
                                    <th>Safety Status</th>
                                    <th>Defects Found</th>
                                    <th>Inspected At</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Inspections.Items)
                                {
                                    <tr>
                                        <td class="font-monospace fw-bold text-primary">@item.InspectionNumber</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@item.InspectionTypeName</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@item.VehiclePlateNumber</div>
                                            <div class="text-muted small">@item.VehicleMakeModel</div>
                                        </td>
                                        <td>
                                            <div><i class="bi bi-person me-1"></i> @item.DriverName</div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold">@item.Odometer.ToString("N0") km</div>
                                            <div class="text-muted small">@item.LocationName</div>
                                        </td>
                                        <td>
                                            @if (item.Status == DvirStatus.Passed)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Passed Safe</span>
                                            }
                                            else if (item.Status == DvirStatus.VehicleGrounded)
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-slash-circle me-1"></i> GROUNDED</span>
                                            }
                                            else if (item.Status == DvirStatus.DefectsReported)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i> Defects Reported</span>
                                            }
                                            else if (item.Status == DvirStatus.CertifiedSafe)
                                            {
                                                <span class="badge bg-info text-dark"><i class="bi bi-patch-check me-1"></i> Certified Safe</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@item.StatusName</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var failedItems = item.Items.Where(i => !i.IsPassed).ToList();
                                            }
                                            @if (!failedItems.Any())
                                            {
                                                <span class="text-success small fw-semibold">0 Defects</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-column gap-1">
                                                    @foreach (var defect in failedItems)
                                                    {
                                                        <span class="badge @(defect.Severity == DefectSeverity.Critical ? "bg-danger" : "bg-warning text-dark") text-start">
                                                            @defect.ItemName (@defect.SeverityName)
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-muted small">@item.InspectedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (item.Status == DvirStatus.VehicleGrounded || item.Status == DvirStatus.DefectsReported)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#certifyModal-@item.Id">
                                                    <i class="bi bi-patch-check"></i> Mechanic Sign-Off
                                                </button>
                                            }
                                            else if (item.Status == DvirStatus.CertifiedSafe)
                                            {
                                                <span class="badge bg-light text-muted border">
                                                    By @item.MechanicName
                                                </span>
                                            }

                                            <!-- CERTIFY MODAL -->
                                            <div class="modal fade" id="certifyModal-@item.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered text-start">
                                                    <div class="modal-content">
                                                        <form method="post" asp-page-handler="Certify">
                                                            <input type="hidden" name="inspectionId" value="@item.Id" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold">Mechanic Safety Certification</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="alert alert-info py-2 small">
                                                                    Certifying this vehicle verifies that all reported defects have been inspected, repaired, and the vehicle is safe to return to road service.
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Certified Mechanic / Inspector Name</label>
                                                                    <input type="text" class="form-control" name="mechanicName" placeholder="e.g. Lead Technician Ahmed" required />
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Repair / Inspection Sign-Off Notes</label>
                                                                    <textarea class="form-control" name="mechanicNotes" rows="3" placeholder="Brake pads replaced, calibrated and road tested OK..." required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-success">
                                                                    <i class="bi bi-patch-check me-1"></i> Sign-Off &amp; Return to Service
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- NEW INSPECTION MODAL -->
<div class="modal fade" id="newInspectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateInspection">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Submit Driver Vehicle Inspection Report (DVIR)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vehicle</label>
                            <select class="form-select" name="vehicleId" required>
                                <option value="">Select vehicle...</option>
                                @foreach (var v in Model.Vehicles)
                                {
                                    <option value="@v.Id">@(v.RegistrationNumber ?? v.VehicleNumber) - @v.MakeName @v.ModelName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Driver</label>
                            <select class="form-select" name="driverId" required>
                                <option value="">Select driver...</option>
                                @foreach (var d in Model.Drivers)
                                {
                                    <option value="@d.Id">@d.DisplayName (@d.DriverNumber)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Inspection Type</label>
                            <select class="form-select" name="inspectionType" required>
                                <option value="1">Pre-Trip Safety Inspection</option>
                                <option value="2">Post-Trip Walkaround</option>
                                <option value="3">Interim / Roadside Inspection</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Current Odometer (km)</label>
                            <input type="number" step="0.1" class="form-control" name="odometer" placeholder="e.g. 84500" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Inspection Location</label>
                            <input type="text" class="form-control" name="locationName" placeholder="e.g. Dubai Central Depot" required />
                        </div>
                    </div>

                    <h6 class="fw-bold mt-4 mb-2">Safety Walkaround Checklist</h6>
                    <div class="table-responsive border rounded mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Component</th>
                                    <th>Check Items</th>
                                    <th class="text-center" style="width: 120px;">Passed</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-semibold">Brakes</td>
                                    <td class="text-muted small">Service foot brakes, parking brake, air pressure build-up</td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" name="brakesPassed" value="true" checked />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Tires &amp; Wheels</td>
                                    <td class="text-muted small">Tire pressure, tread depth, lug nuts, rim condition</td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" name="tiresPassed" value="true" checked />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Lighting &amp; Signals</td>
                                    <td class="text-muted small">Headlights, brake lights, hazards, clearance indicators</td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" name="lightsPassed" value="true" checked />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Steering Mechanism</td>
                                    <td class="text-muted small">Steering wheel play, linkage, power steering fluid level</td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" name="steeringPassed" value="true" checked />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Horn &amp; Wipers</td>
                                    <td class="text-muted small">Audible horn warning, windshield wipers and washer spray</td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" name="hornPassed" value="true" checked />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Mirrors &amp; Glass</td>
                                    <td class="text-muted small">Side rear-view mirrors clean, undamaged windshield glass</td>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" name="mirrorsPassed" value="true" checked />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h6 class="fw-bold mt-3 mb-2">Defect Details (If Any Failed)</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Defect Severity</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="defectIsCritical" id="defectIsCritical" value="true" />
                                <label class="form-check-label text-danger fw-semibold small" for="defectIsCritical">
                                    CRITICAL DEFECT: Automatically ground vehicle immediately
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Defect Description / Notes</label>
                            <input type="text" class="form-control" name="defectDescription" placeholder="e.g. Brake warning light illuminated, soft pedal feel" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Submit Inspection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
