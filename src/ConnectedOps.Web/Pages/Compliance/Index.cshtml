@page
@model ConnectedOps.Web.Pages.Compliance.IndexModel
@{
    ViewData["Title"] = "Compliance Subject Directory";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i>Compliance Subject Directory</h1>
                <p class="text-muted small mb-0">Live compliance evaluation status across all fleet vehicles, licensed drivers, and operational assets.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Compliance/Dashboard" class="btn btn-outline-secondary btn-sm me-1">
                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                </a>
                <a href="/Compliance/Requirements" class="btn btn-outline-primary btn-sm me-1">
                    <i class="bi bi-list-task me-1"></i> Requirements
                </a>
                <a href="/Compliance/Exceptions" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-file-earmark-diff me-1"></i> Exceptions
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- FILTER CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Search Subjects</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="Name, plate, license, S/N..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Subject Type</label>
                        <select name="SubjectType" class="form-select form-select-sm">
                            <option value="">All Subject Types</option>
                            <option value="Vehicle" selected="@(Model.SubjectType?.ToString() == "Vehicle")">Vehicles</option>
                            <option value="Driver" selected="@(Model.SubjectType?.ToString() == "Driver")">Drivers</option>
                            <option value="Asset" selected="@(Model.SubjectType?.ToString() == "Asset")">Assets &amp; Tools</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Overall Status</label>
                        <select name="Status" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            <option value="Valid" selected="@(Model.Status?.ToString() == "Valid")">Valid (Compliant)</option>
                            <option value="ExpiringSoon" selected="@(Model.Status?.ToString() == "ExpiringSoon")">Expiring Soon</option>
                            <option value="Expired" selected="@(Model.Status?.ToString() == "Expired")">Expired</option>
                            <option value="Missing" selected="@(Model.Status?.ToString() == "Missing")">Missing Mandatory</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Branch</label>
                        <select name="BranchId" class="form-select form-select-sm">
                            <option value="">All Branches</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Value" selected="@b.Selected">@b.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a href="/Compliance" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- SUBJECTS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Subjects.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-shield-slash text-muted fs-1 d-block mb-3"></i>
                        <h5 class="fw-semibold text-muted">No Subjects Found</h5>
                        <p class="text-muted small">No fleet subjects matched your query or filter criteria.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Subject Name &amp; ID</th>
                                    <th>Type</th>
                                    <th>Branch</th>
                                    <th class="text-center">Requirements Health</th>
                                    <th class="text-center">Score</th>
                                    <th>Overall Status</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subject in Model.Subjects)
                                {
                                    var detailUrl = subject.SubjectType switch
                                    {
                                        ConnectedOps.Domain.Compliance.ComplianceSubjectType.Vehicle => $"/Compliance/Vehicles/Details?id={subject.SubjectId}",
                                        ConnectedOps.Domain.Compliance.ComplianceSubjectType.Driver => $"/Compliance/Drivers/Details?id={subject.SubjectId}",
                                        _ => $"/Compliance/Assets/Details?id={subject.SubjectId}"
                                    };

                                    var typeIcon = subject.SubjectType switch
                                    {
                                        ConnectedOps.Domain.Compliance.ComplianceSubjectType.Vehicle => "bi-truck",
                                        ConnectedOps.Domain.Compliance.ComplianceSubjectType.Driver => "bi-person-badge",
                                        _ => "bi-tools"
                                    };

                                    var statusBadge = subject.OverallStatus switch
                                    {
                                        ConnectedOps.Domain.Compliance.ComplianceStatus.Valid => "bg-success-subtle text-success border border-success-subtle",
                                        ConnectedOps.Domain.Compliance.ComplianceStatus.ExpiringSoon => "bg-warning-subtle text-warning border border-warning-subtle",
                                        ConnectedOps.Domain.Compliance.ComplianceStatus.Expired => "bg-danger-subtle text-danger border border-danger-subtle",
                                        ConnectedOps.Domain.Compliance.ComplianceStatus.Missing => "bg-danger text-white",
                                        _ => "bg-secondary-subtle text-secondary"
                                    };

                                    var scoreBadge = subject.Score switch
                                    {
                                        >= 90 => "bg-success",
                                        >= 75 => "bg-info",
                                        >= 60 => "bg-warning text-dark",
                                        _ => "bg-danger"
                                    };

                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-light border p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                    <i class="bi @typeIcon text-primary"></i>
                                                </div>
                                                <div>
                                                    <a href="@detailUrl" class="fw-bold text-decoration-none text-body">@subject.SubjectDisplayName</a>
                                                    <div class="small text-muted">@subject.SubjectIdentifier</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary">@subject.SubjectType</span>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold text-muted">@(subject.BranchName ?? "Unassigned")</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-1 small">
                                                <span class="badge bg-success-subtle text-success" title="Valid">@subject.ValidCount V</span>
                                                <span class="badge bg-warning-subtle text-warning" title="Expiring">@subject.ExpiringCount E</span>
                                                <span class="badge bg-danger-subtle text-danger" title="Expired">@subject.ExpiredCount X</span>
                                                <span class="badge bg-dark-subtle text-dark" title="Missing">@subject.MissingCount M</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @scoreBadge px-2 py-1">@subject.Score% (@subject.Grade)</span>
                                        </td>
                                        <td>
                                            <span class="badge @statusBadge px-2 py-1">@subject.OverallStatus</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <a href="@detailUrl" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-shield-check me-1"></i> Audit Center
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
