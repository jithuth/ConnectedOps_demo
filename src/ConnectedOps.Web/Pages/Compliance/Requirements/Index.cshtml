@page
@model ConnectedOps.Web.Pages.Compliance.Requirements.IndexModel
@{
    ViewData["Title"] = "Compliance Requirements Catalog";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-list-task text-primary me-2"></i>Compliance Requirements Catalog</h1>
                <p class="text-muted small mb-0">Define mandatory documents, certifications, permits, inspections, and recurring validity policies.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newRequirementModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Requirement
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTER CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="Code, name, description..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Subject</label>
                        <select name="SubjectType" class="form-select form-select-sm">
                            <option value="">All Subjects</option>
                            <option value="Vehicle" selected="@(Model.SubjectType?.ToString() == "Vehicle")">Vehicles</option>
                            <option value="Driver" selected="@(Model.SubjectType?.ToString() == "Driver")">Drivers</option>
                            <option value="Asset" selected="@(Model.SubjectType?.ToString() == "Asset")">Assets / Tools</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Mandatory</label>
                        <select name="IsMandatory" class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="true" selected="@(Model.IsMandatory == true)">Mandatory</option>
                            <option value="false" selected="@(Model.IsMandatory == false)">Optional</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                        <select name="IsActive" class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="true" selected="@(Model.IsActive == true)">Active</option>
                            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a href="/Compliance/Requirements" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- REQUIREMENTS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Requirements.Items.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-list-task text-muted fs-1 d-block mb-3"></i>
                        <h5 class="fw-semibold text-muted">No Compliance Requirements Configured</h5>
                        <p class="text-muted small">Add requirements to enforce compliance policies for vehicles, drivers, or equipment.</p>
                        <button type="button" class="btn btn-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#newRequirementModal">
                            <i class="bi bi-plus-circle me-1"></i> Add Requirement
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Code &amp; Name</th>
                                    <th>Subject</th>
                                    <th>Category</th>
                                    <th>Mandatory</th>
                                    <th>Validity Policy</th>
                                    <th>Notice (Days)</th>
                                    <th>Rules</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model.Requirements.Items)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold">@req.Name</div>
                                            <div class="small text-muted font-monospace">@req.Code</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary">@req.AppliesTo</span>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold">@req.RequirementType</span>
                                        </td>
                                        <td>
                                            @if (req.IsMandatory)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Mandatory">Mandatory</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Optional</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small">@req.ValidityType</div>
                                            @if (req.DefaultValidityDays.HasValue)
                                            {
                                                <div class="text-muted" style="font-size: 0.75rem;">Period: @req.DefaultValidityDays days</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="small fw-semibold text-warning">@req.DefaultReminderDays d</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@req.RuleCount rule(s)</span>
                                        </td>
                                        <td>
                                            @if (req.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@req.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this requirement?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Deactivate">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- NEW REQUIREMENT MODAL -->
<div class="modal fade" id="newRequirementModal" tabindex="-1" aria-labelledby="newRequirementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="newRequirementModalLabel"><i class="bi bi-plus-circle text-primary me-2"></i>Add Compliance Requirement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Requirement Code *</label>
                            <input type="text" asp-for="NewRequirement.Code" class="form-control form-control-sm" placeholder="e.g. VEH-REG-01" required />
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-semibold">Requirement Name *</label>
                            <input type="text" asp-for="NewRequirement.Name" class="form-control form-control-sm" placeholder="e.g. Annual Commercial Registration" required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Applies To *</label>
                            <select asp-for="NewRequirement.AppliesTo" class="form-select form-select-sm">
                                <option value="Vehicle">Vehicle</option>
                                <option value="Driver">Driver</option>
                                <option value="Asset">Asset / Equipment</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Requirement Category *</label>
                            <select asp-for="NewRequirement.RequirementType" class="form-select form-select-sm">
                                <option value="Registration">Registration</option>
                                <option value="Insurance">Insurance</option>
                                <option value="License">Driver License</option>
                                <option value="Inspection">Inspection</option>
                                <option value="Certification">Certification</option>
                                <option value="Permit">Permit</option>
                                <option value="Calibration">Calibration</option>
                                <option value="Training">Training</option>
                                <option value="MedicalFitness">Medical Fitness</option>
                                <option value="SafetyCheck">Safety Check</option>
                                <option value="MaintenanceCompliance">Maintenance Compliance</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Validity Policy</label>
                            <select asp-for="NewRequirement.ValidityType" class="form-select form-select-sm">
                                <option value="Recurring">Recurring Period</option>
                                <option value="Duration">Fixed Duration</option>
                                <option value="FixedDate">Fixed Date</option>
                                <option value="NoExpiry">No Expiry (Permanent)</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Default Validity (Days)</label>
                            <input type="number" asp-for="NewRequirement.DefaultValidityDays" class="form-control form-control-sm" placeholder="365" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Reminder Notice (Days Before Expiry)</label>
                            <input type="number" asp-for="NewRequirement.DefaultReminderDays" class="form-control form-control-sm" placeholder="30" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description / Policy Scope</label>
                            <textarea asp-for="NewRequirement.Description" class="form-control form-control-sm" rows="2" placeholder="Describe regulatory mandate or operational standard..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="NewRequirement.IsMandatory" id="chkMandatory" />
                                <label class="form-check-label small fw-semibold" for="chkMandatory">Is Mandatory (Subject marked Non-Compliant if missing or expired)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-circle me-1"></i>Create Requirement</button>
                </div>
            </form>
        </div>
    </div>
</div>
