@page
@model ConnectedOps.Web.Pages.Expenses.DriverExpensesModel
@using ConnectedOps.Domain.Expenses
@{
    ViewData["Title"] = "Driver In-Trip & Roadside Expenses";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark fw-bold">
                    <i class="bi bi-wallet2 text-success me-2"></i>Driver Trip Expenses & Reimbursements
                </h1>
                <p class="text-muted small mb-0">Roadside incident expenses, emergency fueling, toll receipts, tire repairs, and reimbursement approvals.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#submitExpenseModal">
                    <i class="bi bi-plus-circle me-1"></i> Submit Roadside Expense
                </button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- KPI Strip -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Pending Approval</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1">@Model.Dashboard.TotalPendingApprovalAmount.ToString("N2") AED</h3>
                            <span class="text-muted small">@Model.Dashboard.PendingApprovalCount claims awaiting review</span>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-3">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Approved (Pending Payout)</span>
                            <h3 class="fw-bold text-primary mb-0 mt-1">@Model.Dashboard.TotalApprovedPendingPayout.ToString("N2") AED</h3>
                            <span class="text-muted small">@Model.Dashboard.ApprovedCount approved vouchers</span>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Reimbursed This Month</span>
                            <h3 class="fw-bold text-success mb-0 mt-1">@Model.Dashboard.TotalReimbursedThisMonth.ToString("N2") AED</h3>
                            <span class="text-muted small">@Model.Dashboard.ReimbursedCount settled claims</span>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body py-3">
                <form method="get" class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1 fw-semibold">Driver</label>
                        <select name="DriverIdFilter" class="form-select">
                            <option value="">All Drivers</option>
                            @foreach (var d in Model.Drivers)
                            {
                                <option value="@d.Id" selected="@(Model.DriverIdFilter == d.Id ? "selected" : null)">
                                    @d.DisplayName (@d.DriverNumber)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1 fw-semibold">Status</label>
                        <select name="StatusFilter" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Submitted" selected="@(Model.StatusFilter == ExpenseStatus.Submitted ? "selected" : null)">Submitted (Pending)</option>
                            <option value="Approved" selected="@(Model.StatusFilter == ExpenseStatus.Approved ? "selected" : null)">Approved</option>
                            <option value="Rejected" selected="@(Model.StatusFilter == ExpenseStatus.Rejected ? "selected" : null)">Rejected</option>
                            <option value="Reimbursed" selected="@(Model.StatusFilter == ExpenseStatus.Reimbursed ? "selected" : null)">Reimbursed</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1 fw-semibold">Category</label>
                        <select name="CategoryFilter" class="form-select">
                            <option value="">All Categories</option>
                            <option value="Toll" selected="@(Model.CategoryFilter == ExpenseCategory.Toll ? "selected" : null)">Toll / Salik</option>
                            <option value="Parking" selected="@(Model.CategoryFilter == ExpenseCategory.Parking ? "selected" : null)">Parking Fee</option>
                            <option value="FuelEmergency" selected="@(Model.CategoryFilter == ExpenseCategory.FuelEmergency ? "selected" : null)">Fuel Emergency</option>
                            <option value="VehicleFluid" selected="@(Model.CategoryFilter == ExpenseCategory.VehicleFluid ? "selected" : null)">Vehicle Fluids / Oil</option>
                            <option value="TireRepair" selected="@(Model.CategoryFilter == ExpenseCategory.TireRepair ? "selected" : null)">Tire Repair / Puncture</option>
                            <option value="MealAllowance" selected="@(Model.CategoryFilter == ExpenseCategory.MealAllowance ? "selected" : null)">Meal Allowance</option>
                            <option value="Other" selected="@(Model.CategoryFilter == ExpenseCategory.Other ? "selected" : null)">Other</option>
                        </select>
                    </div>
                    <div class="col-md-3 text-end">
                        <button type="submit" class="btn btn-outline-primary w-100 mt-md-4">
                            <i class="bi bi-funnel me-1"></i> Filter Ledger
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Expenses Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pt-3">
                <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Trip Expense Claims Ledger</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date (UTC)</th>
                                <th>Driver</th>
                                <th>Vehicle</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Audit Info</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Expenses.Items.Count > 0)
                            {
                                @foreach (var exp in Model.Expenses.Items)
                                {
                                    <tr>
                                        <td>@exp.IncurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="fw-semibold">@exp.DriverName</td>
                                        <td>@(string.IsNullOrWhiteSpace(exp.VehiclePlateNumber) ? "-" : exp.VehiclePlateNumber)</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @switch (exp.Category)
                                                {
                                                    case ExpenseCategory.Toll:
                                                        <i class="bi bi-badge-ad me-1 text-primary"></i>
                                                        break;
                                                    case ExpenseCategory.FuelEmergency:
                                                        <i class="bi bi-fuel-pump me-1 text-danger"></i>
                                                        break;
                                                    case ExpenseCategory.TireRepair:
                                                        <i class="bi bi-tools me-1 text-warning"></i>
                                                        break;
                                                    case ExpenseCategory.Parking:
                                                        <i class="bi bi-p-circle me-1 text-info"></i>
                                                        break;
                                                    default:
                                                        <i class="bi bi-tag me-1 text-secondary"></i>
                                                        break;
                                                }
                                                @exp.CategoryName
                                            </span>
                                        </td>
                                        <td>@exp.Description</td>
                                        <td class="fw-bold text-dark">@exp.Amount.ToString("N2") @exp.Currency</td>
                                        <td>
                                            @switch (exp.Status)
                                            {
                                                case ExpenseStatus.Submitted:
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Submitted</span>
                                                    break;
                                                case ExpenseStatus.Approved:
                                                    <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                                    break;
                                                case ExpenseStatus.Rejected:
                                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                                    break;
                                                case ExpenseStatus.Reimbursed:
                                                    <span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Reimbursed</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @if (exp.Status == ExpenseStatus.Reimbursed)
                                            {
                                                <span>Ref: @exp.ReimbursementReference</span>
                                            }
                                            else if (exp.Status == ExpenseStatus.Rejected)
                                            {
                                                <span class="text-danger">@exp.RejectionReason</span>
                                            }
                                            else if (exp.Status == ExpenseStatus.Approved)
                                            {
                                                <span>Approved on @exp.ApprovedAtUtc?.ToString("MMM dd")</span>
                                            }
                                            else
                                            {
                                                <span>Pending Review</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (exp.Status == ExpenseStatus.Submitted)
                                            {
                                                <form method="post" asp-page-handler="Approve" class="d-inline">
                                                    <input type="hidden" name="expenseId" value="@exp.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success me-1" title="Approve Claim">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@exp.Id" title="Reject Claim">
                                                    <i class="bi bi-x-lg"></i> Reject
                                                </button>

                                                <!-- Modal: Reject -->
                                                <div class="modal fade" id="rejectModal-@exp.Id" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content text-start">
                                                            <form method="post" asp-page-handler="Reject">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title fw-bold">Reject Expense Claim</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <input type="hidden" name="expenseId" value="@exp.Id" />
                                                                    <div class="mb-3">
                                                                        <label class="form-label fw-semibold">Reason for Rejection</label>
                                                                        <textarea name="reason" class="form-control" rows="3" placeholder="e.g. Missing valid receipt tax invoice, or unauthorized expense." required></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else if (exp.Status == ExpenseStatus.Approved)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reimburseModal-@exp.Id">
                                                    <i class="bi bi-cash me-1"></i> Reimburse
                                                </button>

                                                <!-- Modal: Reimburse -->
                                                <div class="modal fade" id="reimburseModal-@exp.Id" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content text-start">
                                                            <form method="post" asp-page-handler="Reimburse">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title fw-bold">Mark Expense Reimbursed</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <input type="hidden" name="expenseId" value="@exp.Id" />
                                                                    <p class="text-muted small">Confirm payout of <strong>@exp.Amount.ToString("N2") @exp.Currency</strong> to <strong>@exp.DriverName</strong>.</p>
                                                                    <div class="mb-3">
                                                                        <label class="form-label fw-semibold">Payment / Bank Transfer Reference</label>
                                                                        <input type="text" name="reference" class="form-control" placeholder="e.g. TXN-78492048 / Petty Cash Voucher #104" required />
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-primary">Mark as Paid</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">
                                        No expense claims matching the filter criteria.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal: Submit Roadside Expense -->
<div class="modal fade" id="submitExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Submit">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-wallet2 text-success me-2"></i>Submit Driver Trip Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Driver</label>
                        <select name="driverId" class="form-select" required>
                            @foreach (var d in Model.Drivers)
                            {
                                <option value="@d.Id">@d.DisplayName (@d.DriverNumber)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assigned Vehicle</label>
                        <select name="vehicleId" class="form-select">
                            <option value="">-- None / Non-vehicle specific --</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id">@v.VehicleNumber (@v.RegistrationNumber)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="category" class="form-select" required>
                                <option value="Toll">Toll / Salik</option>
                                <option value="Parking">Parking Fee</option>
                                <option value="FuelEmergency">Emergency Fuel</option>
                                <option value="VehicleFluid">Vehicle Fluids / Oil</option>
                                <option value="TireRepair">Tire Repair / Puncture</option>
                                <option value="MealAllowance">Meal Allowance</option>
                                <option value="Other">Other Roadside Incident</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Amount</label>
                            <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" min="1" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Currency</label>
                            <input type="text" name="currency" class="form-control" value="AED" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Incurred Date & Time (UTC)</label>
                        <input type="datetime-local" name="incurredAtUtc" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description / Vendor Details</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="e.g. Emergency tire puncture vulcanizing at ADNOC station on Sheikh Zayed Rd" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i> Submit Expense Claim</button>
                </div>
            </form>
        </div>
    </div>
</div>
