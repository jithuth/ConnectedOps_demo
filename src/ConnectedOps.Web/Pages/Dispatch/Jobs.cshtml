@page
@using ConnectedOps.Domain.Dispatch
@model ConnectedOps.Web.Pages.Dispatch.JobsModel
@{
    ViewData["Title"] = "Jobs & Orders - Dispatch";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="m-0 fs-3 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-check text-primary"></i> Jobs &amp; Orders Management
                </h1>
                <p class="text-muted small mb-0">
                    Schedule, track and dispatch customer pickup, delivery and on-site service jobs
                </p>
            </div>
            <div>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#createJobModal">
                    <i class="bi bi-plus-lg"></i> Create New Job
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Filter Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" class="form-control border-start-0" placeholder="Search customer, title, address..." value="@Model.SearchTerm" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="Status" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Statuses</option>
                            @foreach (DispatchJobStatus st in Enum.GetValues(typeof(DispatchJobStatus)))
                            {
                                <option value="@st" selected="@(Model.Status == st)">@st</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="Priority" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Priorities</option>
                            @foreach (DispatchJobPriority pr in Enum.GetValues(typeof(DispatchJobPriority)))
                            {
                                <option value="@pr" selected="@(Model.Priority == pr)">@pr</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="JobType" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Job Types</option>
                            @foreach (DispatchJobType jt in Enum.GetValues(typeof(DispatchJobType)))
                            {
                                <option value="@jt" selected="@(Model.JobType == jt)">@jt</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-secondary flex-grow-1">Filter</button>
                        <a href="/Dispatch/Jobs" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Jobs Table Card -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Jobs.Items.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                        <h5>No dispatch jobs found</h5>
                        <p class="small text-muted mb-3">Create your first customer order or adjust the active filters.</p>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createJobModal">
                            <i class="bi bi-plus-lg"></i> Create New Job
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Job #</th>
                                    <th>Title / Type</th>
                                    <th>Priority</th>
                                    <th>Customer</th>
                                    <th>Destination Address</th>
                                    <th>Cargo</th>
                                    <th>Window</th>
                                    <th>Route</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in Model.Jobs.Items)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold text-dark">@job.JobNumber</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@job.Title</div>
                                            <span class="badge bg-light text-dark border">@job.JobTypeName</span>
                                        </td>
                                        <td>
                                            @switch (job.Priority)
                                            {
                                                case DispatchJobPriority.Urgent:
                                                    <span class="badge bg-danger">Urgent</span>
                                                    break;
                                                case DispatchJobPriority.High:
                                                    <span class="badge bg-warning text-dark">High</span>
                                                    break;
                                                case DispatchJobPriority.Standard:
                                                    <span class="badge bg-secondary bg-opacity-25 text-dark">Standard</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-muted border">Low</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@job.CustomerName</div>
                                            @if (!string.IsNullOrWhiteSpace(job.CustomerPhone))
                                            {
                                                <div class="small text-muted"><i class="bi bi-telephone"></i> @job.CustomerPhone</div>
                                            }
                                        </td>
                                        <td>
                                            <div class="text-truncate text-dark small" style="max-width: 200px;" title="@job.Address">
                                                <i class="bi bi-geo-alt text-danger"></i> @job.Address
                                            </div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                @job.Latitude.ToString("F4"), @job.Longitude.ToString("F4")
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold">@(job.WeightKg.HasValue ? $"{job.WeightKg.Value:N1} kg" : "--")</div>
                                            @if (job.VolumeM3.HasValue && job.VolumeM3 > 0)
                                            {
                                                <div class="small text-muted">@job.VolumeM3.Value.ToString("N2") m³</div>
                                            }
                                        </td>
                                        <td>
                                            @if (job.TimeWindowStartUtc.HasValue)
                                            {
                                                <div class="small fw-semibold">@job.TimeWindowStartUtc.Value.ToString("MMM dd HH:mm")</div>
                                                <div class="small text-muted">@(job.TimeWindowEndUtc.HasValue ? job.TimeWindowEndUtc.Value.ToString("HH:mm") : "Open")</div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Anytime</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(job.AssignedRouteNumber) && job.AssignedRouteId.HasValue)
                                            {
                                                <a href="/Dispatch/RouteDetails/@job.AssignedRouteId.Value" class="badge bg-primary text-decoration-none">
                                                    @job.AssignedRouteNumber
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Unassigned</span>
                                            }
                                        </td>
                                        <td>
                                            @switch (job.Status)
                                            {
                                                case DispatchJobStatus.Completed:
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Completed</span>
                                                    break;
                                                case DispatchJobStatus.InProgress:
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">In Progress</span>
                                                    break;
                                                case DispatchJobStatus.Scheduled:
                                                case DispatchJobStatus.Dispatched:
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">@job.StatusName</span>
                                                    break;
                                                case DispatchJobStatus.Cancelled:
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Cancelled</span>
                                                    break;
                                                case DispatchJobStatus.Failed:
                                                    <span class="badge bg-danger">Failed</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">@job.StatusName</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (job.Status != DispatchJobStatus.Completed && job.Status != DispatchJobStatus.Cancelled)
                                            {
                                                <form method="post" asp-page-handler="Cancel" asp-route-jobId="@job.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this job?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Job">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.Jobs.TotalPages > 1)
                    {
                        <div class="card-footer bg-white border-top py-2 d-flex justify-content-between align-items-center">
                            <span class="small text-muted">
                                Showing @(((Model.Jobs.PageNumber - 1) * Model.Jobs.PageSize) + 1) to @Math.Min(Model.Jobs.PageNumber * Model.Jobs.PageSize, Model.Jobs.TotalCount) of @Model.Jobs.TotalCount jobs
                            </span>
                            <ul class="pagination pagination-sm mb-0">
                                @for (var i = 1; i <= Model.Jobs.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Jobs.PageNumber ? "active" : "")">
                                        <a class="page-link" href="?PageNumber=@i&SearchTerm=@Model.SearchTerm&Status=@Model.Status&Priority=@Model.Priority&JobType=@Model.JobType">@i</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- CREATE JOB MODAL -->
<div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createJobModalLabel">
                        <i class="bi bi-plus-circle text-primary me-1"></i> Create New Dispatch Job
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Job Title *</label>
                            <input type="text" asp-for="CreateInput.Title" class="form-control form-control-sm" required placeholder="e.g. Standard Warehouse Delivery" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Job Type</label>
                            <select asp-for="CreateInput.JobType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<DispatchJobType>()"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Priority</label>
                            <select asp-for="CreateInput.Priority" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<DispatchJobPriority>()"></select>
                        </div>

                        <hr class="my-2" />
                        <h6 class="fw-bold mb-0 text-dark small text-uppercase"><i class="bi bi-person me-1"></i> Customer &amp; Contact Details</h6>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Customer Name *</label>
                            <input type="text" asp-for="CreateInput.CustomerName" class="form-control form-control-sm" required placeholder="e.g. Acme Corporation" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Phone Number *</label>
                            <input type="text" asp-for="CreateInput.CustomerPhone" class="form-control form-control-sm" required placeholder="+971 50 123 4567" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Email Address</label>
                            <input type="email" asp-for="CreateInput.CustomerEmail" class="form-control form-control-sm" placeholder="contact@acme.com" />
                        </div>

                        <hr class="my-2" />
                        <h6 class="fw-bold mb-0 text-dark small text-uppercase"><i class="bi bi-geo-alt me-1"></i> Destination &amp; Cargo Information</h6>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Destination Address *</label>
                            <input type="text" asp-for="CreateInput.Address" class="form-control form-control-sm" required placeholder="e.g. Al Quoz Industrial 3, Street 18" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Latitude</label>
                            <input type="number" step="0.000001" asp-for="CreateInput.Latitude" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Longitude</label>
                            <input type="number" step="0.000001" asp-for="CreateInput.Longitude" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Weight (kg)</label>
                            <input type="number" step="0.1" asp-for="CreateInput.WeightKg" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Volume (m³)</label>
                            <input type="number" step="0.01" asp-for="CreateInput.VolumeM3" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Package Count</label>
                            <input type="number" asp-for="CreateInput.PackageCount" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Service Duration (mins)</label>
                            <input type="number" asp-for="CreateInput.ServiceDurationMinutes" class="form-control form-control-sm" />
                        </div>

                        <hr class="my-2" />
                        <h6 class="fw-bold mb-0 text-dark small text-uppercase"><i class="bi bi-clock me-1"></i> Delivery Window &amp; Special Instructions</h6>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Window Start (UTC)</label>
                            <input type="datetime-local" asp-for="CreateInput.TimeWindowStartUtc" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Window End (UTC)</label>
                            <input type="datetime-local" asp-for="CreateInput.TimeWindowEndUtc" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Special Delivery Instructions</label>
                            <textarea asp-for="CreateInput.SpecialInstructions" rows="2" class="form-control form-control-sm" placeholder="Security gate code #4921, enter through loading bay B"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-check-lg"></i> Create Job
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
