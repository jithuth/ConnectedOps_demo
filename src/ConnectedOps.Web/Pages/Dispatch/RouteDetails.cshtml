@page "{id:guid}"
@using ConnectedOps.Domain.Dispatch
@using System.Text.Json
@model ConnectedOps.Web.Pages.Dispatch.RouteDetailsModel
@{
    ViewData["Title"] = $"Route {Model.Route.RouteNumber} - Dispatch";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        #routeMap {
            height: 520px;
            width: 100%;
            border-radius: 8px;
            z-index: 1;
        }
        .stop-number-icon {
            background-color: #2563eb;
            color: #ffffff;
            border-radius: 50%;
            text-align: center;
            font-weight: bold;
            font-size: 13px;
            line-height: 28px;
            width: 28px;
            height: 28px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
            border: 2px solid #ffffff;
        }
        .stop-number-icon.completed {
            background-color: #10b981;
        }
        .stop-number-icon.arrived {
            background-color: #f59e0b;
        }
        .stop-number-icon.failed {
            background-color: #ef4444;
        }
        .depot-icon {
            background-color: #1e293b;
            color: #ffffff;
            border-radius: 50%;
            text-align: center;
            font-size: 14px;
            line-height: 32px;
            width: 32px;
            height: 32px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.4);
            border: 2px solid #ffffff;
        }
        .signature-pad-container {
            border: 2px dashed #cbd5e1;
            background-color: #f8fafc;
            border-radius: 8px;
            position: relative;
            touch-action: none;
        }
        #signatureCanvas {
            width: 100%;
            height: 180px;
            display: block;
            cursor: crosshair;
        }
    </style>
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="/Dispatch/Routes" class="text-muted text-decoration-none small">&larr; Back to Routes</a>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">@Model.Route.RouteNumber</span>
                    @switch (Model.Route.Status)
                    {
                        case DispatchRouteStatus.InProgress:
                            <span class="badge bg-primary px-2 py-1"><i class="bi bi-play-fill"></i> In Progress</span>
                            break;
                        case DispatchRouteStatus.Dispatched:
                            <span class="badge bg-info text-dark px-2 py-1">Dispatched</span>
                            break;
                        case DispatchRouteStatus.Completed:
                            <span class="badge bg-success px-2 py-1"><i class="bi bi-check2"></i> Completed</span>
                            break;
                        default:
                            <span class="badge bg-secondary px-2 py-1">@Model.Route.StatusName</span>
                            break;
                    }
                </div>
                <h1 class="m-0 fs-3 fw-bold text-dark">@Model.Route.Name</h1>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addStopModal">
                    <i class="bi bi-plus-circle"></i> Add Stop
                </button>

                @if (Model.Route.Stops.Count > 1)
                {
                    <form method="post" asp-page-handler="Optimize" class="d-inline" onsubmit="return confirm('Recalculate and optimize route stop sequence using nearest-neighbor TSP?');">
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-magic"></i> Optimize Sequence (TSP)
                        </button>
                    </form>
                }

                @if (Model.Route.Status != DispatchRouteStatus.InProgress && Model.Route.Status != DispatchRouteStatus.Completed)
                {
                    <form method="post" asp-page-handler="StartRoute" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-play-fill"></i> Start Route
                        </button>
                    </form>
                }
                else if (Model.Route.Status == DispatchRouteStatus.InProgress)
                {
                    <form method="post" asp-page-handler="CompleteRoute" class="d-inline" onsubmit="return confirm('Complete this route itinerary?');">
                        <button type="submit" class="btn btn-sm btn-success">
                            <i class="bi bi-check2-circle"></i> Mark Route Completed
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- SUMMARY STATS CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <div class="row g-3 text-center align-items-center">
                    <div class="col-md-2 col-6 border-end">
                        <span class="text-muted small">Vehicle</span>
                        <div class="fw-bold text-dark mt-1">@(Model.Route.VehicleRegistration ?? Model.Route.VehicleNumber ?? "Unassigned")</div>
                    </div>
                    <div class="col-md-2 col-6 border-end">
                        <span class="text-muted small">Driver</span>
                        <div class="fw-bold text-dark mt-1">@(Model.Route.DriverName ?? "Unassigned")</div>
                    </div>
                    <div class="col-md-2 col-6 border-end">
                        <span class="text-muted small">Total Distance</span>
                        <div class="fw-bold text-primary mt-1">@Model.Route.EstimatedDistanceKm.ToString("F1") km</div>
                    </div>
                    <div class="col-md-2 col-6 border-end">
                        <span class="text-muted small">Est. Duration</span>
                        <div class="fw-bold text-primary mt-1">@Model.Route.EstimatedDurationMinutes mins</div>
                    </div>
                    <div class="col-md-2 col-6 border-end">
                        <span class="text-muted small">Stops Completed</span>
                        <div class="fw-bold text-success mt-1">
                            @Model.Route.CompletedStopsCount / @Model.Route.TotalStopsCount
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <span class="text-muted small">Scheduled</span>
                        <div class="fw-bold text-dark mt-1">@Model.Route.ScheduledDate.ToString("dd MMM yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN SPLIT VIEW: INTERACTIVE MAP & STOPS TIMELINE -->
        <div class="row g-3">
            <!-- Left: Interactive Map -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-map text-primary"></i> Live Route Map
                        </h5>
                        <span class="badge bg-light text-dark border">
                            @(Model.Route.Stops.Count > 0 ? $"{Model.Route.Stops.Count} Waypoints" : "No Waypoints")
                        </span>
                    </div>
                    <div class="card-body p-2">
                        <div id="routeMap"></div>
                    </div>
                </div>
            </div>

            <!-- Right: Ordered Stops Timeline -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-list-ol text-primary"></i> Sequenced Itinerary (@Model.Route.Stops.Count Stops)
                        </h5>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addStopModal">
                            <i class="bi bi-plus-lg"></i> Add
                        </button>
                    </div>
                    <div class="card-body p-0" style="max-height: 520px; overflow-y: auto;">
                        @if (!Model.Route.Stops.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-pin-map fs-1 d-block mb-2 opacity-50"></i>
                                <p class="mb-2">No stops added to this route yet.</p>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addStopModal">
                                    Add Your First Stop
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var stop in Model.Route.Stops)
                                {
                                    <div class="list-group-item p-3 position-relative">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @(stop.Status == RouteStopStatus.Completed ? "bg-success" : stop.Status == RouteStopStatus.Arrived ? "bg-warning text-dark" : "bg-primary") rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">
                                                    @stop.SequenceOrder
                                                </span>
                                                <div>
                                                    <div class="fw-bold text-dark">@stop.JobTitle</div>
                                                    <span class="badge bg-light text-secondary border">@stop.JobNumber (@stop.JobType)</span>
                                                </div>
                                            </div>
                                            <div>
                                                @switch (stop.Status)
                                                {
                                                    case RouteStopStatus.Completed:
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Completed</span>
                                                        break;
                                                    case RouteStopStatus.Arrived:
                                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Arrived</span>
                                                        break;
                                                    case RouteStopStatus.EnRoute:
                                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">En Route</span>
                                                        break;
                                                    case RouteStopStatus.Failed:
                                                        <span class="badge bg-danger">Failed</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@stop.StatusName</span>
                                                        break;
                                                }
                                            </div>
                                        </div>

                                        <div class="small text-muted mb-1 mt-2">
                                            <i class="bi bi-geo-alt text-danger"></i> @stop.Address
                                        </div>

                                        <div class="d-flex justify-content-between text-muted small mt-2 pt-2 border-top">
                                            <span><i class="bi bi-signpost me-1"></i> +@stop.EstimatedDistanceKm.ToString("F1") km</span>
                                            <span><i class="bi bi-clock me-1"></i> +@stop.EstimatedMinutes mins</span>
                                            <span><i class="bi bi-person me-1"></i> @stop.CustomerName</span>
                                        </div>

                                        <!-- Stop Action Bar -->
                                        <div class="d-flex gap-1 justify-content-end mt-2 pt-2 border-top">
                                            @if (stop.Status == RouteStopStatus.Pending)
                                            {
                                                <form method="post" asp-page-handler="UpdateStatus" asp-route-stopId="@stop.Id" asp-route-status="@RouteStopStatus.EnRoute" class="d-inline">
                                                    <button type="submit" class="btn btn-xs btn-outline-info btn-sm py-0 px-2" title="Mark En Route">
                                                        <i class="bi bi-truck"></i> En Route
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="UpdateStatus" asp-route-stopId="@stop.Id" asp-route-status="@RouteStopStatus.Arrived" class="d-inline">
                                                    <button type="submit" class="btn btn-xs btn-outline-warning btn-sm py-0 px-2" title="Mark Arrived">
                                                        <i class="bi bi-geo-fill"></i> Arrived
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="RemoveStop" asp-route-stopId="@stop.Id" class="d-inline" onsubmit="return confirm('Remove stop?');">
                                                    <button type="submit" class="btn btn-xs btn-outline-danger btn-sm py-0 px-2" title="Remove Stop">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (stop.Status == RouteStopStatus.EnRoute)
                                            {
                                                <form method="post" asp-page-handler="UpdateStatus" asp-route-stopId="@stop.Id" asp-route-status="@RouteStopStatus.Arrived" class="d-inline">
                                                    <button type="submit" class="btn btn-xs btn-warning btn-sm py-0 px-2 text-dark" title="Mark Arrived">
                                                        <i class="bi bi-geo-fill"></i> Mark Arrived
                                                    </button>
                                                </form>
                                            }

                                            @if (stop.Status != RouteStopStatus.Completed && stop.Status != RouteStopStatus.Failed)
                                            {
                                                <button type="button" class="btn btn-xs btn-success btn-sm py-0 px-2"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#podModal"
                                                        data-job-id="@stop.JobId"
                                                        data-stop-id="@stop.Id"
                                                        data-customer="@stop.CustomerName"
                                                        data-lat="@stop.Latitude"
                                                        data-lng="@stop.Longitude">
                                                    <i class="bi bi-pen"></i> Complete &amp; Sign POD
                                                </button>
                                            }
                                            else if (stop.Status == RouteStopStatus.Completed && stop.HasPod)
                                            {
                                                <span class="badge bg-success small py-1 px-2">
                                                    <i class="bi bi-check2-circle"></i> POD Verified
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD STOP MODAL -->
<div class="modal fade" id="addStopModal" tabindex="-1" aria-labelledby="addStopModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddStop">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addStopModalLabel">
                        <i class="bi bi-plus-circle text-primary me-1"></i> Add Stop to Route
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Option 1: Select pending unassigned job -->
                    @if (Model.AvailableJobs.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Assign Existing Job (Optional)</label>
                            <select asp-for="NewStop.JobId" id="selectJobDropdown" class="form-select form-select-sm">
                                <option value="">-- Or enter custom destination below --</option>
                                @foreach (var job in Model.AvailableJobs)
                                {
                                    <option value="@job.Id"
                                            data-title="@job.Title"
                                            data-name="@job.CustomerName"
                                            data-phone="@job.CustomerPhone"
                                            data-address="@job.Address"
                                            data-lat="@job.Latitude"
                                            data-lng="@job.Longitude"
                                            data-weight="@(job.WeightKg ?? 0)"
                                            data-dur="@job.ServiceDurationMinutes">
                                        @job.JobNumber - @job.Title (@job.CustomerName)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="text-center text-muted small mb-2">&mdash; OR CREATE QUICK STOP &mdash;</div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Stop / Order Title</label>
                            <input type="text" asp-for="NewStop.Title" id="stopTitleInput" class="form-control form-control-sm" placeholder="e.g. Express Parts Delivery" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Customer Name *</label>
                            <input type="text" asp-for="NewStop.CustomerName" id="stopCustInput" class="form-control form-control-sm" placeholder="e.g. Acme LLC" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Phone Number</label>
                            <input type="text" asp-for="NewStop.CustomerPhone" id="stopPhoneInput" class="form-control form-control-sm" placeholder="+971 50 123 4567" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Stop Address *</label>
                            <input type="text" asp-for="NewStop.Address" id="stopAddressInput" class="form-control form-control-sm" placeholder="e.g. Al Barsha 1, Street 23" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Latitude</label>
                            <input type="number" step="0.000001" asp-for="NewStop.Latitude" id="stopLatInput" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Longitude</label>
                            <input type="number" step="0.000001" asp-for="NewStop.Longitude" id="stopLngInput" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Cargo Weight (kg)</label>
                            <input type="number" step="0.1" asp-for="NewStop.WeightKg" id="stopWeightInput" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Service Duration (mins)</label>
                            <input type="number" asp-for="NewStop.ServiceDurationMinutes" id="stopDurInput" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Special Instructions</label>
                            <input type="text" asp-for="NewStop.Notes" class="form-control form-control-sm" placeholder="e.g. Call customer upon arrival" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Add Stop</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DIGITAL PROOF OF DELIVERY (POD) MODAL -->
<div class="modal fade" id="podModal" tabindex="-1" aria-labelledby="podModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="RecordPod" id="podForm">
                <input type="hidden" asp-for="PodForm.JobId" id="podJobId" />
                <input type="hidden" asp-for="PodForm.StopId" id="podStopId" />
                <input type="hidden" asp-for="PodForm.SignatureData" id="podSignatureData" />
                <input type="hidden" asp-for="PodForm.Latitude" id="podLat" />
                <input type="hidden" asp-for="PodForm.Longitude" id="podLng" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="podModalLabel">
                        <i class="bi bi-pen text-success me-1"></i> Digital Proof of Delivery (POD)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Recipient Full Name *</label>
                        <input type="text" asp-for="PodForm.RecipientName" id="podRecipientName" class="form-control form-control-sm" required placeholder="Name of person receiving goods" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Verification Method</label>
                        <select asp-for="PodForm.VerificationType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<PodVerificationType>()"></select>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold mb-0">Customer Signature Capture</label>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger text-decoration-none" id="clearSignatureBtn">
                                <i class="bi bi-arrow-counterclockwise"></i> Clear Canvas
                            </button>
                        </div>
                        <div class="signature-pad-container">
                            <canvas id="signatureCanvas" width="450" height="180"></canvas>
                        </div>
                        <span class="text-muted" style="font-size: 0.75rem;">Draw signature using mouse, stylus, or fingertip touch.</span>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Delivery Notes / Remarks</label>
                        <textarea asp-for="PodForm.Notes" rows="2" class="form-control form-control-sm" placeholder="Goods inspected and verified in perfect condition."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success" id="submitPodBtn">
                        <i class="bi bi-check-circle"></i> Verify &amp; Complete Delivery
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Initialize Leaflet Map
            const stops = @Html.Raw(JsonSerializer.Serialize(Model.Route.Stops.Select(s => new {
                id = s.Id,
                jobId = s.JobId,
                seq = s.SequenceOrder,
                title = s.JobTitle,
                jobNumber = s.JobNumber,
                customer = s.CustomerName,
                address = s.Address,
                lat = s.Latitude,
                lng = s.Longitude,
                status = s.Status.ToString(),
                dist = s.EstimatedDistanceKm
            })));

            const defaultLat = stops.length > 0 ? stops[0].lat : 25.2048;
            const defaultLng = stops.length > 0 ? stops[0].lng : 55.2708;

            const map = L.map('routeMap').setView([defaultLat, defaultLng], stops.length > 0 ? 12 : 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            if (stops.length > 0) {
                const bounds = L.latLngBounds();
                const latLngs = [];

                stops.forEach(function (stop) {
                    latLngs.push([stop.lat, stop.lng]);
                    bounds.extend([stop.lat, stop.lng]);

                    let statusClass = '';
                    if (stop.status === 'Completed') statusClass = 'completed';
                    else if (stop.status === 'Arrived') statusClass = 'arrived';
                    else if (stop.status === 'Failed') statusClass = 'failed';

                    const stopIcon = L.divIcon({
                        className: 'stop-marker',
                        html: `<div class="stop-number-icon ${statusClass}">${stop.seq}</div>`,
                        iconSize: [28, 28],
                        iconAnchor: [14, 14]
                    });

                    const marker = L.marker([stop.lat, stop.lng], { icon: stopIcon }).addTo(map);
                    marker.bindPopup(`
                        <div style="font-size: 13px;">
                            <strong>Stop #${stop.seq}: ${stop.title}</strong><br/>
                            <span class="text-muted">${stop.address}</span><br/>
                            <span class="badge bg-secondary mt-1">${stop.status}</span>
                            <div class="small mt-1">+${stop.dist.toFixed(1)} km from prev</div>
                        </div>
                    `);
                });

                if (latLngs.length > 1) {
                    L.polyline(latLngs, {
                        color: '#2563eb',
                        weight: 4,
                        opacity: 0.8,
                        dashArray: '8, 8'
                    }).addTo(map);

                    map.fitBounds(bounds, { padding: [40, 40] });
                }
            }

            // 2. Job selector fill logic for Add Stop Modal
            const jobSelect = document.getElementById('selectJobDropdown');
            if (jobSelect) {
                jobSelect.addEventListener('change', function () {
                    const selected = this.options[this.selectedIndex];
                    if (selected && selected.value) {
                        document.getElementById('stopTitleInput').value = selected.getAttribute('data-title') || '';
                        document.getElementById('stopCustInput').value = selected.getAttribute('data-name') || '';
                        document.getElementById('stopPhoneInput').value = selected.getAttribute('data-phone') || '';
                        document.getElementById('stopAddressInput').value = selected.getAttribute('data-address') || '';
                        document.getElementById('stopLatInput').value = selected.getAttribute('data-lat') || '';
                        document.getElementById('stopLngInput').value = selected.getAttribute('data-lng') || '';
                        document.getElementById('stopWeightInput').value = selected.getAttribute('data-weight') || '';
                        document.getElementById('stopDurInput').value = selected.getAttribute('data-dur') || '15';
                    }
                });
            }

            // 3. Digital Proof of Delivery Canvas Signature Capture
            const canvas = document.getElementById('signatureCanvas');
            const ctx = canvas ? canvas.getContext('2d') : null;
            let isDrawing = false;
            let hasSignature = false;

            if (canvas && ctx) {
                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = 2.5;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';

                function getCanvasPos(evt) {
                    const rect = canvas.getBoundingClientRect();
                    const scaleX = canvas.width / rect.width;
                    const scaleY = canvas.height / rect.height;
                    const clientX = evt.clientX || (evt.touches && evt.touches[0].clientX);
                    const clientY = evt.clientY || (evt.touches && evt.touches[0].clientY);
                    return {
                        x: (clientX - rect.left) * scaleX,
                        y: (clientY - rect.top) * scaleY
                    };
                }

                function startDrawing(e) {
                    e.preventDefault();
                    isDrawing = true;
                    const pos = getCanvasPos(e);
                    ctx.beginPath();
                    ctx.moveTo(pos.x, pos.y);
                }

                function draw(e) {
                    if (!isDrawing) return;
                    e.preventDefault();
                    hasSignature = true;
                    const pos = getCanvasPos(e);
                    ctx.lineTo(pos.x, pos.y);
                    ctx.stroke();
                }

                function stopDrawing() {
                    if (isDrawing) {
                        isDrawing = false;
                        ctx.closePath();
                    }
                }

                // Mouse events
                canvas.addEventListener('mousedown', startDrawing);
                canvas.addEventListener('mousemove', draw);
                canvas.addEventListener('mouseup', stopDrawing);
                canvas.addEventListener('mouseleave', stopDrawing);

                // Touch events
                canvas.addEventListener('touchstart', startDrawing);
                canvas.addEventListener('touchmove', draw);
                canvas.addEventListener('touchend', stopDrawing);

                // Clear button
                const clearBtn = document.getElementById('clearSignatureBtn');
                if (clearBtn) {
                    clearBtn.addEventListener('click', function () {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        hasSignature = false;
                        document.getElementById('podSignatureData').value = '';
                    });
                }

                // POD modal trigger population
                const podModal = document.getElementById('podModal');
                if (podModal) {
                    podModal.addEventListener('show.bs.modal', function (event) {
                        const button = event.relatedTarget;
                        const jobId = button.getAttribute('data-job-id');
                        const stopId = button.getAttribute('data-stop-id');
                        const customer = button.getAttribute('data-customer');
                        const lat = button.getAttribute('data-lat');
                        const lng = button.getAttribute('data-lng');

                        document.getElementById('podJobId').value = jobId;
                        document.getElementById('podStopId').value = stopId;
                        document.getElementById('podRecipientName').value = customer || '';
                        document.getElementById('podLat').value = lat || '';
                        document.getElementById('podLng').value = lng || '';

                        // Reset canvas
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        hasSignature = false;
                    });
                }

                // Submit handler captures canvas data URL
                const podForm = document.getElementById('podForm');
                if (podForm) {
                    podForm.addEventListener('submit', function () {
                        if (hasSignature) {
                            document.getElementById('podSignatureData').value = canvas.toDataURL('image/png');
                        }
                    });
                }
            }
        });
    </script>
}
