@page
@using ConnectedOps.Domain.Dispatch
@model ConnectedOps.Web.Pages.Dispatch.DashboardModel
@{
    ViewData["Title"] = "Dispatch Operations Console";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="m-0 fs-3 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2 text-primary"></i> Dispatch Operations Console
                </h1>
                <p class="text-muted small mb-0">
                    Live multi-stop route dispatch, schedule monitoring, and digital delivery verification
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Dispatch/Jobs" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-plus-circle"></i> New Dispatch Job
                </a>
                <a href="/Dispatch/Routes" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-signpost-split"></i> Plan &amp; Dispatch Route
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- KPI METRICS ROW -->
        <div class="row g-3 mb-4">
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Active Routes</span>
                                <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.Metrics.ActiveRoutes</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-signpost-2-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span class="text-success fw-semibold"><i class="bi bi-arrow-up-right"></i> Live</span> in field
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Pending Jobs</span>
                                <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.Metrics.PendingJobsToday</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-hourglass-split fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span>Awaiting assignment</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">In Progress</span>
                                <h3 class="fw-bold mb-0 mt-1 text-info">@Model.Metrics.InProgressJobsToday</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-info bg-opacity-10 text-info">
                                <i class="bi bi-truck fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span>Active transit</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Completed Today</span>
                                <h3 class="fw-bold mb-0 mt-1 text-success">@Model.Metrics.CompletedJobsToday</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                                <i class="bi bi-check-circle-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span>Verified delivery</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">On-Time Rate</span>
                                <h3 class="fw-bold mb-0 mt-1 text-dark">@Model.Metrics.OnTimeDeliveryRate.ToString("F1")%</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-secondary bg-opacity-10 text-dark">
                                <i class="bi bi-lightning-charge-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span>SLA performance</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Distance Today</span>
                                <h3 class="fw-bold mb-0 mt-1 text-dark">@Model.Metrics.TotalDistanceKmToday.ToString("N1") <span class="fs-6 text-muted">km</span></h3>
                            </div>
                            <div class="rounded-circle p-2 bg-dark bg-opacity-10 text-dark">
                                <i class="bi bi-geo-alt-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            <span>Fleet route coverage</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN SPLIT WORKSPACE -->
        <div class="row g-3">
            <!-- Active Routes -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-signpost-split text-primary fs-5"></i>
                            <h5 class="fw-bold mb-0">Active &amp; Dispatched Routes</h5>
                        </div>
                        <a href="/Dispatch/Routes" class="btn btn-sm btn-outline-secondary">View All Routes</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Metrics.ActiveRoutesList.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-map fs-1 d-block mb-2 opacity-50"></i>
                                <p class="mb-2">No active routes currently underway.</p>
                                <a href="/Dispatch/Routes" class="btn btn-sm btn-primary">Plan a New Route</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Route</th>
                                            <th>Vehicle &amp; Driver</th>
                                            <th>Progress</th>
                                            <th>Est. Distance</th>
                                            <th>Status</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var route in Model.Metrics.ActiveRoutesList)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">@route.RouteNumber</div>
                                                    <div class="small text-muted">@route.Name</div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-1 text-dark small fw-semibold">
                                                        <i class="bi bi-truck text-secondary"></i> @(route.VehicleRegistration ?? route.VehicleNumber ?? "Unassigned")
                                                    </div>
                                                    <div class="small text-muted">
                                                        <i class="bi bi-person"></i> @(route.DriverName ?? "Unassigned")
                                                    </div>
                                                </td>
                                                <td style="min-width: 140px;">
                                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                                        <span>@route.CompletedStopsCount / @route.TotalStopsCount stops</span>
                                                        <span>@route.CompletionPercentage%</span>
                                                    </div>
                                                    <div class="progress" style="height: 6px;">
                                                        <div class="progress-bar bg-success" role="progressbar" style="width: @(route.CompletionPercentage)%"></div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="small fw-semibold">@route.EstimatedDistanceKm.ToString("F1") km</span>
                                                    <div class="small text-muted">@route.EstimatedDurationMinutes mins</div>
                                                </td>
                                                <td>
                                                    @switch (route.Status)
                                                    {
                                                        case DispatchRouteStatus.InProgress:
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">In Progress</span>
                                                            break;
                                                        case DispatchRouteStatus.Dispatched:
                                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Dispatched</span>
                                                            break;
                                                        case DispatchRouteStatus.Completed:
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Completed</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-secondary px-2 py-1">@route.StatusName</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a href="/Dispatch/RouteDetails/@route.Id" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye"></i> Manage
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Critical & High Priority Jobs -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle text-warning fs-5"></i>
                            <h5 class="fw-bold mb-0">Urgent &amp; Critical Jobs</h5>
                        </div>
                        <a href="/Dispatch/Jobs" class="btn btn-sm btn-outline-secondary">View All Jobs</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Metrics.RecentCriticalJobs.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-clipboard-check fs-1 d-block mb-2 text-success opacity-75"></i>
                                <p class="mb-0">All high priority jobs have been dispatched!</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var job in Model.Metrics.RecentCriticalJobs)
                                {
                                    <div class="list-group-item p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <div>
                                                <span class="fw-bold text-dark">@job.JobNumber</span>
                                                <span class="badge ms-1 @(job.Priority == DispatchJobPriority.Urgent ? "bg-danger" : "bg-warning text-dark")">@job.PriorityName</span>
                                                <span class="badge bg-light text-dark border ms-1">@job.JobTypeName</span>
                                            </div>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@job.StatusName</span>
                                        </div>
                                        <div class="text-dark small fw-semibold">
                                            <i class="bi bi-person text-muted"></i> @job.CustomerName
                                            @if (!string.IsNullOrWhiteSpace(job.CustomerPhone))
                                            {
                                                <span class="text-muted fw-normal ms-1">(@job.CustomerPhone)</span>
                                            }
                                        </div>
                                        <div class="text-muted small text-truncate mt-1">
                                            <i class="bi bi-geo-alt text-danger"></i> @job.Address
                                        </div>
                                        @if (job.TimeWindowStartUtc.HasValue)
                                        {
                                            <div class="small text-muted mt-1">
                                                <i class="bi bi-clock"></i> Window: @job.TimeWindowStartUtc.Value.ToString("MMM dd HH:mm") - @(job.TimeWindowEndUtc.HasValue ? job.TimeWindowEndUtc.Value.ToString("HH:mm") : "Any")
                                            </div>
                                        }
                                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                            <span class="small text-muted">Weight: @(job.WeightKg.HasValue ? $"{job.WeightKg.Value:N1} kg" : "--")</span>
                                            <a href="/Dispatch/Routes" class="btn btn-sm btn-link p-0 text-primary text-decoration-none">
                                                Assign to Route &rarr;
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
