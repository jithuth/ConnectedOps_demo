@page
@using ConnectedOps.Domain.TollsAndFines
@model ConnectedOps.Web.Pages.TollsAndFines.IndexModel
@{
    ViewData["Title"] = "Tolls, Violations & Liability Management";
}

<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="m-0 fs-3 fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-receipt-cutoff text-primary"></i> Tolls, Violations &amp; Driver Liability
                </h1>
                <p class="text-muted small mb-0">
                    Automated Salik &amp; Darb toll tracking, police violation ingestion &amp; trip-session liability attribution
                </p>
            </div>
            <div class="d-flex gap-2">
                <form method="post" asp-page-handler="AutoMatch" class="d-inline">
                    <button type="submit" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1 shadow-sm">
                        <i class="bi bi-magic"></i> Auto-Match Drivers
                    </button>
                </form>
                <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newTollModal">
                    <i class="bi bi-plus-circle"></i> Ingest Toll
                </button>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#newViolationModal">
                    <i class="bi bi-exclamation-octagon"></i> Ingest Violation
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@Model.SuccessMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@Model.ErrorMessage</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- METRIC KPI CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Tolls This Month</span>
                                <h3 class="fw-bold mb-0 mt-1 text-primary">AED @Model.Dashboard.TotalTollsAmountThisMonth.ToString("N2")</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-cash-stack fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            @Model.Dashboard.TotalTollsCountThisMonth Salik &amp; Darb transactions
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Pending Fines Total</span>
                                <h3 class="fw-bold mb-0 mt-1 text-danger">AED @Model.Dashboard.TotalFinesAmountPending.ToString("N2")</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-shield-exclamation fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            @Model.Dashboard.PendingFinesCount fines awaiting deduction / settlement
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Disputed Violations</span>
                                <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.Dashboard.DisputedFinesCount</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-question-diamond fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Contested with traffic authorities
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Liability Reconciled</span>
                                <h3 class="fw-bold mb-0 mt-1 text-success">100% Automated</h3>
                            </div>
                            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success">
                                <i class="bi bi-person-check-fill fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted small">
                            Cross-referenced against shift check-out telemetry
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN TABS -->
        <ul class="nav nav-pills mb-3" id="tollTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="violations-tab" data-bs-toggle="tab" data-bs-target="#violationsTabPane" type="button" role="tab">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Traffic Violations &amp; Fines (@(Model.Violations?.TotalCount ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tolls-tab" data-bs-toggle="tab" data-bs-target="#tollsTabPane" type="button" role="tab">
                    <i class="bi bi-signpost-fill me-1"></i> Toll Transactions (Salik &amp; Darb) (@(Model.Tolls?.TotalCount ?? 0))
                </button>
            </li>
        </ul>

        <div class="tab-content" id="tollTabsContent">
            <!-- TAB 1: TRAFFIC VIOLATIONS -->
            <div class="tab-pane fade show active" id="violationsTabPane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        @if (Model.Violations == null || !Model.Violations.Items.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-shield-check text-success display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">No Traffic Violations Found</h5>
                                <p class="text-muted small">Your fleet has maintained a pristine compliance record with 0 recorded fines.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ticket #</th>
                                            <th>Authority</th>
                                            <th>Description</th>
                                            <th>Vehicle</th>
                                            <th>Fine &amp; Points</th>
                                            <th>Assigned Driver</th>
                                            <th>Liability Status</th>
                                            <th>Violation Time</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in Model.Violations.Items)
                                        {
                                            <tr>
                                                <td class="font-monospace fw-bold text-dark">@v.TicketNumber</td>
                                                <td><span class="badge bg-secondary">@v.AuthorityName</span></td>
                                                <td>
                                                    <div class="fw-bold text-dark">@v.Description</div>
                                                    <div class="text-muted small">Code: @v.ViolationCode @(v.Location != null ? $"• {v.Location}" : "")</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">
                                                        <i class="bi bi-truck me-1"></i> @v.VehiclePlateNumber
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-danger">AED @v.FineAmount.ToString("N2")</div>
                                                    @if (v.BlackPoints > 0)
                                                    {
                                                        <span class="badge bg-dark text-white">@v.BlackPoints Pts</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(v.MatchedDriverName))
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                            <i class="bi bi-person-fill me-1"></i> @v.MatchedDriverName
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning">Unmatched</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (v.LiabilityStatus == ViolationLiabilityStatus.PendingReview)
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending Review</span>
                                                    }
                                                    else if (v.LiabilityStatus == ViolationLiabilityStatus.AssignedToDriver)
                                                    {
                                                        <span class="badge bg-info text-dark">Driver Assigned</span>
                                                    }
                                                    else if (v.LiabilityStatus == ViolationLiabilityStatus.PayrollDeducted)
                                                    {
                                                        <span class="badge bg-success">Payroll Deducted</span>
                                                    }
                                                    else if (v.LiabilityStatus == ViolationLiabilityStatus.CompanyPaid)
                                                    {
                                                        <span class="badge bg-secondary">Company Paid</span>
                                                    }
                                                    else if (v.LiabilityStatus == ViolationLiabilityStatus.Disputed)
                                                    {
                                                        <span class="badge bg-danger">Disputed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark">@v.LiabilityStatusName</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="text-muted small">@v.ViolationTimeUtc.ToString("yyyy-MM-dd HH:mm")</span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignModal-@v.Id" title="Assign Liability">
                                                            <i class="bi bi-person-check"></i> Assign
                                                        </button>
                                                        <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#disputeModal-@v.Id" title="Dispute Fine">
                                                            <i class="bi bi-chat-square-dots"></i> Dispute
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#settleModal-@v.Id" title="Settle Fine">
                                                            <i class="bi bi-check2-circle"></i> Settle
                                                        </button>
                                                    </div>

                                                    <!-- ASSIGN MODAL -->
                                                    <div class="modal fade" id="assignModal-@v.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered text-start">
                                                            <div class="modal-content">
                                                                <form method="post" asp-page-handler="AssignLiability">
                                                                    <input type="hidden" name="violationId" value="@v.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Assign Fine Liability</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p class="mb-2"><strong>Ticket:</strong> @v.TicketNumber (AED @v.FineAmount.ToString("N2"))</p>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Select Liable Driver</label>
                                                                            <select class="form-select" name="driverId" required>
                                                                                <option value="">Choose driver...</option>
                                                                                @foreach (var d in Model.Drivers)
                                                                                {
                                                                                    <option value="@d.Id">@d.DisplayName (@d.DriverNumber)</option>
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-primary">Assign Driver</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- DISPUTE MODAL -->
                                                    <div class="modal fade" id="disputeModal-@v.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered text-start">
                                                            <div class="modal-content">
                                                                <form method="post" asp-page-handler="Dispute">
                                                                    <input type="hidden" name="violationId" value="@v.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Dispute Traffic Fine</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p class="mb-2"><strong>Ticket:</strong> @v.TicketNumber (AED @v.FineAmount.ToString("N2"))</p>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Dispute Ground / Police Objection Reason</label>
                                                                            <textarea class="form-control" name="disputeReason" rows="3" placeholder="Incorrect vehicle plate captured on radar, emergency dispatch response..." required></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-warning">Submit Dispute</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- SETTLE MODAL -->
                                                    <div class="modal fade" id="settleModal-@v.Id" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered text-start">
                                                            <div class="modal-content">
                                                                <form method="post" asp-page-handler="Settle">
                                                                    <input type="hidden" name="violationId" value="@v.Id" />
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Settle Traffic Violation</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p class="mb-2"><strong>Ticket:</strong> @v.TicketNumber (AED @v.FineAmount.ToString("N2"))</p>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Settlement Mechanism</label>
                                                                            <select class="form-select" name="status" required>
                                                                                <option value="4">Payroll Deducted (Driver Ledger)</option>
                                                                                <option value="3">Company Paid (Fleet Expense)</option>
                                                                                <option value="6">Dismissed (Authority Cancelled)</option>
                                                                            </select>
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label small fw-semibold">Settlement Notes / Reference</label>
                                                                            <input type="text" class="form-control" name="notes" placeholder="Receipt #, payroll deduction period..." />
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-success">Record Settlement</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 2: TOLLS -->
            <div class="tab-pane fade" id="tollsTabPane" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        @if (Model.Tolls == null || !Model.Tolls.Items.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-tag text-muted display-4 mb-3"></i>
                                <h5 class="fw-bold text-dark">No Toll Transactions Ingested</h5>
                                <p class="text-muted small">Salik and Darb electronic toll transactions will appear here as vehicles cross toll gates.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Toll System</th>
                                            <th>Gate Name &amp; Code</th>
                                            <th>Vehicle</th>
                                            <th>Toll Amount</th>
                                            <th>Matched Driver</th>
                                            <th>Tag #</th>
                                            <th>Transaction Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in Model.Tolls.Items)
                                        {
                                            <tr>
                                                <td>
                                                    @if (t.TollSystem == TollSystemType.Salik)
                                                    {
                                                        <span class="badge bg-warning text-dark fw-bold">SALIK (Dubai)</span>
                                                    }
                                                    else if (t.TollSystem == TollSystemType.Darb)
                                                    {
                                                        <span class="badge bg-info text-dark fw-bold">DARB (Abu Dhabi)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@t.TollSystemName</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark">@t.TollGateName</div>
                                                    <div class="text-muted small">Code: @t.TollGateCode</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">
                                                        <i class="bi bi-truck me-1"></i> @t.VehiclePlateNumber
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="fw-bold text-dark">AED @t.Amount.ToString("N2")</span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(t.MatchedDriverName))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                            <i class="bi bi-person-fill me-1"></i> @t.MatchedDriverName
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Unassigned</span>
                                                    }
                                                </td>
                                                <td><span class="font-monospace small">@(t.TagNumber ?? "-")</span></td>
                                                <td>
                                                    <span class="text-muted small">@t.TransactionTimeUtc.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- INGEST TOLL MODAL -->
<div class="modal fade" id="newTollModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateToll">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Ingest Toll Transaction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Toll System</label>
                            <select class="form-select" name="tollSystem" required>
                                <option value="1">Salik (Dubai)</option>
                                <option value="2">Darb (Abu Dhabi)</option>
                                <option value="3">Other Regional Toll</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Toll Amount (AED)</label>
                            <input type="number" step="0.5" class="form-control" name="amount" value="4.00" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Toll Gate Name</label>
                            <input type="text" class="form-control" name="tollGateName" placeholder="e.g. Al Barsha Toll Gate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Gate Code</label>
                            <input type="text" class="form-control" name="tollGateCode" placeholder="e.g. SLK-DXB-04" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Vehicle</label>
                        <select class="form-select" name="vehicleId" required>
                            <option value="">Select vehicle...</option>
                            @foreach (var v in Model.Vehicles)
                            {
                                <option value="@v.Id">@(v.RegistrationNumber ?? v.VehicleNumber) - @v.MakeName @v.ModelName</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tag Number</label>
                            <input type="text" class="form-control" name="tagNumber" placeholder="e.g. 018274619" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Transaction Time (UTC)</label>
                            <input type="datetime-local" class="form-control" name="transactionTimeUtc" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Record Toll</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- INGEST VIOLATION MODAL -->
<div class="modal fade" id="newViolationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateViolation">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Ingest Traffic Fine / Violation Ticket</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Ticket #</label>
                            <input type="text" class="form-control" name="ticketNumber" placeholder="e.g. DXB-2026-98124" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Issuing Authority</label>
                            <input type="text" class="form-control" name="authorityName" value="Dubai Police" required />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Violation Code</label>
                            <input type="text" class="form-control" name="violationCode" placeholder="e.g. SPD-RAD-10" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Fine Amount (AED)</label>
                            <input type="number" step="10" class="form-control" name="fineAmount" placeholder="e.g. 600" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Black Points</label>
                            <input type="number" class="form-control" name="blackPoints" value="0" min="0" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Violation Description</label>
                        <input type="text" class="form-control" name="description" placeholder="Exceeding maximum speed limit by 20 to 30 km/h" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vehicle</label>
                            <select class="form-select" name="vehicleId" required>
                                <option value="">Select vehicle...</option>
                                @foreach (var v in Model.Vehicles)
                                {
                                    <option value="@v.Id">@(v.RegistrationNumber ?? v.VehicleNumber) - @v.MakeName @v.ModelName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Location</label>
                            <input type="text" class="form-control" name="location" placeholder="Sheikh Zayed Road, Near Exit 39" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Violation Timestamp (UTC)</label>
                        <input type="datetime-local" class="form-control" name="violationTimeUtc" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Ingest Traffic Fine</button>
                </div>
            </form>
        </div>
    </div>
</div>
