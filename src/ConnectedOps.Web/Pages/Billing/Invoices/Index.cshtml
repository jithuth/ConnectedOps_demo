@page "/Billing/Invoices"
@model ConnectedOps.Web.Pages.Billing.Invoices.IndexModel
@using ConnectedOps.Domain.Billing
@{
    ViewData["Title"] = "Invoices & Billing";
    ViewData["Subtitle"] = "Issue, track, and manage invoices for subscription fees and telematics services";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- STATS ROW -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Invoiced</div>
                    <div class="fs-3 fw-bold my-1 text-primary">$@Model.TotalInvoiced.ToString("N2")</div>
                    <div class="small text-muted">Across all issued invoices</div>
                </div>
                <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                    <i class="bi bi-receipt fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Collected</div>
                    <div class="fs-3 fw-bold my-1 text-success">$@Model.TotalPaid.ToString("N2")</div>
                    <div class="small text-muted">Paid in full or partial</div>
                </div>
                <div class="rounded-circle bg-success-subtle p-3 text-success">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Outstanding</div>
                    <div class="fs-3 fw-bold my-1 text-warning">$@Model.TotalOutstanding.ToString("N2")</div>
                    <div class="small text-muted">Accounts receivable balance</div>
                </div>
                <div class="rounded-circle bg-warning-subtle p-3 text-warning">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Overdue Invoices</div>
                    <div class="fs-3 fw-bold my-1 text-danger">@Model.OverdueCount</div>
                    <div class="small text-muted">Action required</div>
                </div>
                <div class="rounded-circle bg-danger-subtle p-3 text-danger">
                    <i class="bi bi-exclamation-octagon fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- INVOICES TABLE CARD -->
<div class="card border-0 shadow-sm bg-body">
    <div class="card-header border-0 bg-transparent py-3 px-4 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Invoices</h5>
            <div class="small text-secondary">Billing records and receivable statements</div>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">
            <i class="bi bi-plus-lg me-1"></i> Create Invoice
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Invoice #</th>
                        <th>Title / Contact</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Balance Due</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Invoices.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No invoices recorded yet. Click "Create Invoice" to generate your first invoice.
                            </td>
                        </tr>
                    }
                    @foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                <a href="/Billing/Invoices/Details?id=@inv.Id" class="text-decoration-none text-primary">
                                    @inv.InvoiceNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@inv.Title</div>
                                @if (!string.IsNullOrWhiteSpace(inv.BillingContactName))
                                {
                                    <div class="text-secondary small">@inv.BillingContactName (@inv.BillingEmail)</div>
                                }
                            </td>
                            <td class="small text-secondary">@inv.IssueDateUtc.ToString("MMM dd, yyyy")</td>
                            <td class="small @(inv.DueDateUtc < DateTime.UtcNow && inv.BalanceDue > 0 ? "text-danger fw-bold" : "text-secondary")">
                                @inv.DueDateUtc.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end fw-semibold">$@inv.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-success">$@inv.AmountPaid.ToString("N2")</td>
                            <td class="text-end fw-bold @(inv.BalanceDue > 0 ? "text-danger" : "text-muted")">
                                $@inv.BalanceDue.ToString("N2")
                            </td>
                            <td class="text-center">
                                @switch (inv.Status)
                                {
                                    case InvoiceStatus.Draft:
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill">Draft</span>
                                        break;
                                    case InvoiceStatus.Issued:
                                        <span class="badge bg-primary-subtle text-primary px-2 py-1 rounded-pill">Issued</span>
                                        break;
                                    case InvoiceStatus.Paid:
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Paid</span>
                                        break;
                                    case InvoiceStatus.PartiallyPaid:
                                        <span class="badge bg-info-subtle text-info px-2 py-1 rounded-pill">Partially Paid</span>
                                        break;
                                    case InvoiceStatus.Overdue:
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">Overdue</span>
                                        break;
                                    case InvoiceStatus.Void:
                                        <span class="badge bg-dark-subtle text-dark px-2 py-1 rounded-pill">Voided</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="/Billing/Invoices/Details?id=@inv.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (inv.Status == InvoiceStatus.Draft)
                                    {
                                        <form method="post" asp-page-handler="Issue" class="d-inline">
                                            <input type="hidden" name="invoiceId" value="@inv.Id" />
                                            <button type="submit" class="btn btn-outline-primary" title="Issue & Post to Ledger">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (inv.Status != InvoiceStatus.Paid && inv.Status != InvoiceStatus.Void)
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Void"
                                                onclick="openVoidModal('@inv.Id', '@inv.InvoiceNumber')">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: CREATE INVOICE -->
<div class="modal fade" id="createInvoiceModal" tabindex="-1" aria-labelledby="createInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="createInvoiceModalLabel">Create New Invoice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Invoice Title / Description <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Monthly Fleet Telematics - October" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Due Date <span class="text-danger">*</span></label>
                            <input type="date" name="dueDateUtc" class="form-control" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Contact Name</label>
                            <input type="text" name="billingContactName" class="form-control" placeholder="Acme Logistics Inc." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Contact Email</label>
                            <input type="email" name="billingEmail" class="form-control" placeholder="billing@acme.com" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Currency</label>
                            <select name="currency" class="form-select">
                                <option value="USD" selected>USD ($)</option>
                                <option value="EUR">EUR (€)</option>
                                <option value="GBP">GBP (£)</option>
                                <option value="CAD">CAD ($)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Billing Address</label>
                        <input type="text" name="billingAddress" class="form-control" placeholder="100 Commercial Blvd, Suite 400, Chicago, IL" />
                    </div>

                    <!-- LINE ITEMS SECTION -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold mb-0">Line Items</label>
                            <button type="button" class="btn btn-xs btn-outline-primary" onclick="addLineItem()">
                                <i class="bi bi-plus-circle me-1"></i> Add Line Item
                            </button>
                        </div>
                        <div id="lineItemsContainer">
                            <div class="row g-2 line-item-row mb-2">
                                <div class="col-md-5">
                                    <input type="text" name="itemDescription" class="form-control form-control-sm" placeholder="Service description" value="SaaS Fleet Monitoring (Monthly)" required />
                                </div>
                                <div class="col-md-2">
                                    <input type="number" name="itemQuantity" class="form-control form-control-sm item-qty" placeholder="Qty" value="1" min="1" step="1" oninput="calculateTotals()" required />
                                </div>
                                <div class="col-md-2">
                                    <input type="number" name="itemUnitPrice" class="form-control form-control-sm item-price" placeholder="Unit Price" value="149.00" min="0" step="0.01" oninput="calculateTotals()" required />
                                </div>
                                <div class="col-md-2">
                                    <input type="number" name="itemTaxRate" class="form-control form-control-sm item-tax" placeholder="Tax %" value="0" min="0" max="100" step="0.1" oninput="calculateTotals()" />
                                </div>
                                <div class="col-md-1 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeLineItem(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="card bg-body-secondary border-0 p-3 mt-3">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span>Subtotal:</span>
                                <span class="fw-semibold text-body" id="subtotalDisplay">$149.00</span>
                            </div>
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span>Tax:</span>
                                <span class="fw-semibold text-body" id="taxDisplay">$0.00</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold fs-6 text-primary pt-1 border-top">
                                <span>Total:</span>
                                <span id="totalDisplay">$149.00</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Notes (Optional)</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Visible to customer..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Terms and Conditions</label>
                            <textarea name="termsAndConditions" class="form-control" rows="2" placeholder="Payment due net 30 days..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Draft Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: VOID INVOICE -->
<div class="modal fade" id="voidInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Void">
                <input type="hidden" id="voidInvoiceId" name="invoiceId" />
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-danger">Void Invoice <span id="voidInvoiceNum"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-0">
                    <p class="text-secondary small">Voiding an invoice marks it permanently canceled and reverses any ledger entries posted.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Voiding</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Incorrect billing amount, customer cancellation, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Confirm Void</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openVoidModal(id, num) {
            document.getElementById('voidInvoiceId').value = id;
            document.getElementById('voidInvoiceNum').innerText = num;
            new bootstrap.Modal(document.getElementById('voidInvoiceModal')).show();
        }

        function addLineItem() {
            const container = document.getElementById('lineItemsContainer');
            const row = document.createElement('div');
            row.className = 'row g-2 line-item-row mb-2';
            row.innerHTML = `
                <div class="col-md-5">
                    <input type="text" name="itemDescription" class="form-control form-control-sm" placeholder="Service description" required />
                </div>
                <div class="col-md-2">
                    <input type="number" name="itemQuantity" class="form-control form-control-sm item-qty" placeholder="Qty" value="1" min="1" step="1" oninput="calculateTotals()" required />
                </div>
                <div class="col-md-2">
                    <input type="number" name="itemUnitPrice" class="form-control form-control-sm item-price" placeholder="Unit Price" value="0.00" min="0" step="0.01" oninput="calculateTotals()" required />
                </div>
                <div class="col-md-2">
                    <input type="number" name="itemTaxRate" class="form-control form-control-sm item-tax" placeholder="Tax %" value="0" min="0" max="100" step="0.1" oninput="calculateTotals()" />
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeLineItem(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            container.appendChild(row);
            calculateTotals();
        }

        function removeLineItem(button) {
            const container = document.getElementById('lineItemsContainer');
            if (container.getElementsByClassName('line-item-row').length > 1) {
                button.closest('.line-item-row').remove();
                calculateTotals();
            } else {
                alert('At least one line item is required.');
            }
        }

        function calculateTotals() {
            let subtotal = 0;
            let taxTotal = 0;
            const rows = document.querySelectorAll('.line-item-row');
            rows.forEach(r => {
                const qty = parseFloat(r.querySelector('.item-qty').value) || 0;
                const price = parseFloat(r.querySelector('.item-price').value) || 0;
                const taxRate = parseFloat(r.querySelector('.item-tax').value) || 0;
                const lineSub = qty * price;
                const lineTax = lineSub * (taxRate / 100);
                subtotal += lineSub;
                taxTotal += lineTax;
            });
            const total = subtotal + taxTotal;
            document.getElementById('subtotalDisplay').innerText = '$' + subtotal.toFixed(2);
            document.getElementById('taxDisplay').innerText = '$' + taxTotal.toFixed(2);
            document.getElementById('totalDisplay').innerText = '$' + total.toFixed(2);
        }
    </script>
}
