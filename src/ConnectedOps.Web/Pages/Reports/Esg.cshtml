@page
@model ConnectedOps.Web.Pages.Reports.EsgModel
@{
    ViewData["Title"] = "ESG & Carbon Scope 1 Analytics";
    ViewData["Subtitle"] = "Greenhouse Gas Protocol (GHG) Scope 1 direct combustion emissions and EV transition modeling";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">ESG &amp; Carbon Analytics (Scope 1)</h1>
                <p class="text-muted small mb-0">Measure direct fuel combustion emissions according to EPA &amp; GHG Protocol corporate standards</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="./Dashboard" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-arrow-left"></i>
                    <span>Executive BI</span>
                </a>
                <a asp-page-handler="Export" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-success d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-download"></i>
                    <span>Export ESG (CSV)</span>
                </a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Start Date</label>
                        <input type="date" name="StartDate" class="form-control form-control-sm" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">End Date</label>
                        <input type="date" name="EndDate" class="form-control form-control-sm" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <span class="small fw-semibold text-muted d-block mb-1">Quick Presets</span>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(30)">Last 30D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(90)">Last 90D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(365)">Last 1 Year</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterYtd()">YTD</button>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-success w-100 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-filter"></i> Apply
                        </button>
                        <a asp-page="./Esg" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- TOP ESG KPI CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #064e3b 0%, #059669 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Total Scope 1 GHG</div>
                                <div class="fs-3 fw-bold my-1">@Model.Report.TotalCo2MetricTons.ToString("N2") <span class="fs-6 fw-normal">MT CO2e</span></div>
                                <div class="small text-white-50">@Model.Report.DirectScope1FuelTons.ToString("N2") MT from fuel combustion</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-cloud-haze2 fs-3 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Fleet Carbon Intensity</div>
                                <div class="fs-3 fw-bold my-1">@((Model.Report.AverageKgCo2PerKm * 1000m).ToString("F1")) <span class="fs-6 fw-normal">g/km</span></div>
                                <div class="small text-white-50">@Model.Report.AverageKgCo2PerKm.ToString("F3") kg CO2e / km</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-speedometer2 fs-3 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #78350f 0%, #d97706 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Fleet Green Score</div>
                                <div class="fs-3 fw-bold my-1">@Model.Report.FleetGreenIndexScore.ToString("F1") <span class="fs-6 fw-normal">/ 100</span></div>
                                <div class="small text-white-50">@Model.Report.TotalElectricVehicles EVs, @Model.Report.TotalHybridVehicles Hybrids</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-award fs-3 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #14532d 0%, #16a34a 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Tree Offset Equivalent</div>
                                <div class="fs-3 fw-bold my-1">@((Model.Report.TotalCo2MetricTons * 45m).ToString("N0")) <span class="fs-6 fw-normal">Trees</span></div>
                                <div class="small text-white-50">Forest absorption equivalence</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-tree-fill fs-3 text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- EV TRANSITION SCENARIO SIMULATOR (INTERACTIVE) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 border-start border-4 border-success">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold mb-1 text-success"><i class="bi bi-lightning-charge-fill me-2"></i>Fleet Electrification &amp; EV Transition Simulator</h5>
                        <p class="text-muted small mb-0">Model the ESG decarbonization impact and operational fuel cost reduction from transitioning combustion vehicles to Battery Electric Vehicles (BEVs).</p>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6">
                        Net Zero Accelerator
                    </span>
                </div>

                <div class="row align-items-center g-4">
                    <div class="col-lg-5">
                        <label for="evSlider" class="form-label fw-semibold small text-muted">
                            Target Fleet Electrification Percentage: <span id="evPercentDisplay" class="fw-bold text-success fs-5">50%</span>
                        </label>
                        <input type="range" class="form-range" min="10" max="100" step="5" value="50" id="evSlider" oninput="updateEvSimulator(this.value)" />
                        <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                            <span>10% Pilot</span>
                            <span>50% Fleet Target</span>
                            <span>100% Full Net-Zero</span>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="row g-2 text-center">
                            <div class="col-sm-4">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="text-muted small">GHG Avoidance</div>
                                    <div class="fs-4 fw-bold text-success my-1" id="simGhgAvoided">
                                        @((Model.Report.PotentialEvCo2SavingsMetricTons * 0.5m).ToString("N1")) MT
                                    </div>
                                    <div class="text-muted" style="font-size: 0.7rem;">CO2e Eliminated</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="text-muted small">Estimated Fuel Savings</div>
                                    <div class="fs-4 fw-bold text-primary my-1" id="simFuelSavings">
                                        $@((Model.Report.EstimatedEvFuelCostSavings * 0.5m).ToString("N0"))
                                    </div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Net Operating OpEx</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="text-muted small">Trees Equivalent</div>
                                    <div class="fs-4 fw-bold text-success my-1" id="simTreesPreserved">
                                        @((Model.Report.PotentialEvCo2SavingsMetricTons * 0.5m * 45m).ToString("N0"))
                                    </div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Forest Capacity</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- EMISSION BREAKDOWN ROW -->
        <div class="row g-3 mb-4">
            <!-- Fuel Source Breakdown Table -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-2">
                        <h6 class="fw-bold mb-0"><i class="bi bi-fuel-pump text-primary me-2"></i>Combustion Breakdown by Fuel Type</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Fuel Type</th>
                                    <th class="text-end">Total Volume</th>
                                    <th class="text-end">CO2e (MT)</th>
                                    <th class="text-end">% of Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Report.FuelBreakdown.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No fuel consumption logged in this period.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var f in Model.Report.FuelBreakdown)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">
                                                <i class="bi bi-droplet-fill text-primary me-1"></i>
                                                @f.FuelType
                                            </td>
                                            <td class="text-end text-muted">@f.TotalVolume.ToString("N0") @f.Unit</td>
                                            <td class="text-end fw-bold text-dark">@f.Co2MetricTons.ToString("N2") MT</td>
                                            <td class="text-end">
                                                <span class="badge bg-light text-dark border">
                                                    @f.PercentageOfTotal.ToString("F1")%
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Doughnut Chart: Emissions by Fuel -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0">
                        <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-success me-2"></i>Carbon Emissions by Fuel Type</h6>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
                        <div style="position: relative; height: 230px; width: 100%;">
                            <canvas id="fuelEmissionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MONTHLY EMISSIONS TREND -->
        @if (Model.Report.MonthlyTrends.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                    <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Monthly GHG Scope 1 Trajectory</h6>
                </div>
                <div class="card-body p-3">
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="monthlyEsgChart"></canvas>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        function setFilterDates(days) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - days);
            document.querySelector('input[name="StartDate"]').value = start.toISOString().split('T')[0];
            document.querySelector('input[name="EndDate"]').value = end.toISOString().split('T')[0];
        }

        function setFilterYtd() {
            const end = new Date();
            const start = new Date(end.getFullYear(), 0, 1);
            document.querySelector('input[name="StartDate"]').value = start.toISOString().split('T')[0];
            document.querySelector('input[name="EndDate"]').value = end.toISOString().split('T')[0];
        }

        const potentialGhg = @Model.Report.PotentialEvCo2SavingsMetricTons;
        const potentialSavings = @Model.Report.EstimatedEvFuelCostSavings;

        function updateEvSimulator(percent) {
            document.getElementById('evPercentDisplay').textContent = percent + '%';
            const ratio = percent / 100.0;
            const ghgAvoided = (potentialGhg * ratio).toFixed(1);
            const fuelSavings = Math.round(potentialSavings * ratio).toLocaleString();
            const trees = Math.round(potentialGhg * ratio * 45).toLocaleString();

            document.getElementById('simGhgAvoided').textContent = ghgAvoided + ' MT';
            document.getElementById('simFuelSavings').textContent = '$' + fuelSavings;
            document.getElementById('simTreesPreserved').textContent = trees;
        }

        // Fuel Emission Doughnut Chart
        const fuelLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.FuelBreakdown.Select(x => x.FuelType)));
        const fuelEmissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.FuelBreakdown.Select(x => x.Co2MetricTons)));

        const fuelCtx = document.getElementById('fuelEmissionChart').getContext('2d');
        new Chart(fuelCtx, {
            type: 'doughnut',
            data: {
                labels: fuelLabels.length ? fuelLabels : ['Diesel', 'Gasoline'],
                datasets: [{
                    data: fuelEmissions.length ? fuelEmissions : [1, 0],
                    backgroundColor: ['#059669', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899'],
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '65%'
            }
        });

        // Monthly ESG Trend Line Chart
        @if (Model.Report.MonthlyTrends.Count > 0)
        {
            <text>
            const monthlyMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlyTrends.Select(x => x.YearMonth)));
            const monthlyCo2 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlyTrends.Select(x => x.Co2MetricTons)));
            const monthlyIntensity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlyTrends.Select(x => x.EmissionIntensityGramsPerKm)));

            const monthlyEsgCtx = document.getElementById('monthlyEsgChart').getContext('2d');
            new Chart(monthlyEsgCtx, {
                type: 'line',
                data: {
                    labels: monthlyMonths,
                    datasets: [
                        {
                            label: 'Emissions (MT CO2e)',
                            data: monthlyCo2,
                            borderColor: '#059669',
                            backgroundColor: 'rgba(5, 150, 105, 0.1)',
                            fill: true,
                            tension: 0.3,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Intensity (g CO2/km)',
                            data: monthlyIntensity,
                            borderColor: '#3b82f6',
                            borderDash: [5, 5],
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: { display: true, text: 'Metric Tons CO2e' }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'g/km' }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
