@page
@model ConnectedOps.Web.Pages.Reports.DashboardModel
@{
    ViewData["Title"] = "Executive BI & Operations Dashboard";
    ViewData["Subtitle"] = "Cross-fleet operational intelligence, financial expenditure, and ESG emissions analytics";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">Executive BI &amp; Reports</h1>
                <p class="text-muted small mb-0">Cross-subsystem intelligence connecting assets, fuel, maintenance, safety, and ESG emissions</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="./Tco" class="btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-cash-coin"></i>
                    <span>TCO Analysis</span>
                </a>
                <a asp-page="./Utilization" class="btn btn-outline-success d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-pie-chart"></i>
                    <span>Utilization</span>
                </a>
                <a asp-page="./Esg" class="btn btn-outline-emerald text-success d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-tree"></i>
                    <span>ESG &amp; Carbon</span>
                </a>
                <a asp-page-handler="Export" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-download"></i>
                    <span>Export CSV</span>
                </a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Start Date</label>
                        <input type="date" name="StartDate" class="form-control form-control-sm" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">End Date</label>
                        <input type="date" name="EndDate" class="form-control form-control-sm" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <span class="small fw-semibold text-muted d-block mb-1">Quick Presets</span>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(7)">Last 7D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(30)">Last 30D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(90)">Last 90D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterYtd()">YTD</button>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-filter"></i> Apply
                        </button>
                        <a asp-page="./Dashboard" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- TOP KPI CARDS -->
        <div class="row g-3 mb-4">
            <!-- Total Operational Cost -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Total Operating Cost</div>
                                <div class="fs-3 fw-bold my-1">$@Model.Report.TotalFleetOperatingCost.ToString("N2")</div>
                                <div class="small text-white-50">Fuel + Maintenance + Incidents</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-currency-dollar fs-3 text-white"></i>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 border-top border-white border-opacity-25 d-flex justify-content-between small">
                            <span>Cost / km: <strong>$@Model.Report.CostPerKilometer.ToString("F3")</strong></span>
                            <span>Fuel: <strong>$@Model.Report.TotalFuelSpend.ToString("N0")</strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fleet Availability -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #065f46 0%, #10b981 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Fleet Availability</div>
                                <div class="fs-3 fw-bold my-1">@Model.Report.FleetAvailabilityPercent.ToString("F1")%</div>
                                <div class="small text-white-50">@Model.Report.ActiveVehiclesCount of @Model.Report.TotalVehiclesCount Vehicles Active</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-pie-chart fs-3 text-white"></i>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 border-top border-white border-opacity-25 d-flex justify-content-between small">
                            <span>Total Dist: <strong>@Model.Report.TotalDistanceKm.ToString("N0") km</strong></span>
                            <span>In Shop: <strong>@Model.Report.VehiclesInMaintenanceCount</strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Safety & Incidents -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #991b1b 0%, #ef4444 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Safety &amp; Incidents</div>
                                <div class="fs-3 fw-bold my-1">@Model.Report.TotalIncidentsCount</div>
                                <div class="small text-white-50">Estimated Damage: $@Model.Report.TotalIncidentCosts.ToString("N0")</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-shield-exclamation fs-3 text-white"></i>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 border-top border-white border-opacity-25 d-flex justify-content-between small">
                            <span>Violations: <strong>@Model.Report.TotalViolationsCount</strong></span>
                            <span>Maintenance: <strong>$@Model.Report.TotalMaintenanceSpend.ToString("N0")</strong></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scope 1 ESG Emissions -->
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient" style="background: linear-gradient(135deg, #14532d 0%, #22c55e 100%); color: #fff;">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Scope 1 Carbon (CO2e)</div>
                                <div class="fs-3 fw-bold my-1">@Model.Report.TotalCo2MetricTons.ToString("N2") <span class="fs-6 fw-normal">MT</span></div>
                                <div class="small text-white-50">@Model.Report.TotalFuelLiters.ToString("N0") Liters Consumed</div>
                            </div>
                            <div class="bg-white bg-opacity-25 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-tree fs-3 text-white"></i>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 border-top border-white border-opacity-25 d-flex justify-content-between small">
                            <span>Carbon Intensity: <strong>@Model.Report.AverageCo2PerKmGrams.ToString("F1") g/km</strong></span>
                            <span class="badge bg-white text-success">EPA / GHG</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHARTS ROW -->
        <div class="row g-3 mb-4">
            <!-- Cost Breakdown Doughnut -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Cost Distribution</h6>
                        <span class="badge bg-light text-dark">Expenditure Share</span>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
                        <div style="position: relative; height: 230px; width: 100%;">
                            <canvas id="costBreakdownChart"></canvas>
                        </div>
                        <div class="row w-100 text-center mt-3 g-2 small">
                            <div class="col-4 border-end">
                                <span class="text-muted d-block">Fuel</span>
                                <strong class="text-primary">$@Model.Report.TotalFuelSpend.ToString("N0")</strong>
                            </div>
                            <div class="col-4 border-end">
                                <span class="text-muted d-block">Maintenance</span>
                                <strong class="text-warning">$@Model.Report.TotalMaintenanceSpend.ToString("N0")</strong>
                            </div>
                            <div class="col-4">
                                <span class="text-muted d-block">Incidents</span>
                                <strong class="text-danger">$@Model.Report.TotalIncidentCosts.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Monthly Financial Spend Trend -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Monthly Operational Spend Trend</h6>
                        <span class="badge bg-light text-dark">Fuel vs Maintenance vs Incidents</span>
                    </div>
                    <div class="card-body p-3">
                        <div style="position: relative; height: 270px; width: 100%;">
                            <canvas id="monthlyTrendChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CATEGORY COSTS AND BENCHMARKS -->
        <div class="row g-3 mb-4">
            <!-- Category Cost Breakdown -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-tags-fill text-primary me-2"></i>Cost Distribution by Vehicle Category</h6>
                        <a asp-page="./Tco" class="small text-decoration-none">Full TCO Breakdown &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th class="text-center">Vehicles</th>
                                    <th class="text-end">Total Expenditure</th>
                                    <th class="text-end">Avg Cost / Vehicle</th>
                                    <th class="text-end">% of Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Report.CategoryCosts.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No category expenditure logged in this date range.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in Model.Report.CategoryCosts)
                                    {
                                        var pct = Model.Report.TotalFleetOperatingCost > 0 ? (c.TotalCost / Model.Report.TotalFleetOperatingCost * 100m) : 0m;
                                        <tr>
                                            <td class="fw-bold text-dark">@c.CategoryName</td>
                                            <td class="text-center">@c.VehicleCount</td>
                                            <td class="text-end fw-bold text-dark">$@c.TotalCost.ToString("N2")</td>
                                            <td class="text-end text-muted">$@((c.VehicleCount > 0 ? c.TotalCost / c.VehicleCount : 0m).ToString("N2"))</td>
                                            <td class="text-end">
                                                <span class="badge bg-light text-dark border">@pct.ToString("F1")%</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Operational Benchmarks -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0">
                        <h6 class="fw-bold mb-0"><i class="bi bi-cpu-fill text-info me-2"></i>Operational Benchmarks</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Fleet Operational Availability</span>
                                    <strong>@Model.Report.FleetAvailabilityPercent.ToString("F1")%</strong>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.Report.FleetAvailabilityPercent.ToString("F0")%"></div>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Maintenance Ratio (% of Fleet)</span>
                                    <strong>@((Model.Report.TotalVehiclesCount > 0 ? (decimal)Model.Report.VehiclesInMaintenanceCount / Model.Report.TotalVehiclesCount * 100m : 0m).ToString("F1"))%</strong>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-warning" role="progressbar" style="width: @((Model.Report.TotalVehiclesCount > 0 ? (decimal)Model.Report.VehiclesInMaintenanceCount / Model.Report.TotalVehiclesCount * 100m : 0m).ToString("F0"))%"></div>
                                </div>
                            </div>

                            <hr class="my-1" />

                            <div class="bg-light rounded p-2 small">
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Cost per Kilometer:</span>
                                    <span class="fw-semibold">$@Model.Report.CostPerKilometer.ToString("F3")/km</span>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Carbon Footprint:</span>
                                    <span class="fw-semibold">@Model.Report.TotalCo2MetricTons.ToString("N2") MT CO2e</span>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Avg Carbon Intensity:</span>
                                    <span class="fw-semibold">@Model.Report.AverageCo2PerKmGrams.ToString("F1") g/km</span>
                                </div>
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Fuel Consumption per 100km:</span>
                                    <span class="fw-semibold">@((Model.Report.TotalDistanceKm > 0 ? (Model.Report.TotalFuelLiters / Model.Report.TotalDistanceKm * 100m) : 0m).ToString("F1")) L/100km</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        function setFilterDates(days) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - days);
            document.querySelector('input[name="StartDate"]').value = start.toISOString().split('T')[0];
            document.querySelector('input[name="EndDate"]').value = end.toISOString().split('T')[0];
        }

        function setFilterYtd() {
            const end = new Date();
            const start = new Date(end.getFullYear(), 0, 1);
            document.querySelector('input[name="StartDate"]').value = start.toISOString().split('T')[0];
            document.querySelector('input[name="EndDate"]').value = end.toISOString().split('T')[0];
        }

        // Cost Breakdown Doughnut
        const costCtx = document.getElementById('costBreakdownChart').getContext('2d');
        const fuelCost = @Model.Report.TotalFuelSpend;
        const maintCost = @Model.Report.TotalMaintenanceSpend;
        const incidentCost = @Model.Report.TotalIncidentCosts;

        new Chart(costCtx, {
            type: 'doughnut',
            data: {
                labels: ['Fuel', 'Maintenance', 'Incidents'],
                datasets: [{
                    data: [fuelCost, maintCost, incidentCost],
                    backgroundColor: ['#3b82f6', '#f59e0b', '#ef4444'],
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '65%'
            }
        });

        // Monthly Spend Trend
        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlySpends.Select(x => x.YearMonth)));
        const trendFuel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlySpends.Select(x => x.FuelSpend)));
        const trendMaint = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlySpends.Select(x => x.MaintenanceSpend)));
        const trendInc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.MonthlySpends.Select(x => x.IncidentCost)));

        const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'bar',
            data: {
                labels: trendLabels.length ? trendLabels : ['Current Period'],
                datasets: [
                    { label: 'Fuel ($)', data: trendFuel.length ? trendFuel : [fuelCost], backgroundColor: '#3b82f6' },
                    { label: 'Maintenance ($)', data: trendMaint.length ? trendMaint : [maintCost], backgroundColor: '#f59e0b' },
                    { label: 'Incidents ($)', data: trendInc.length ? trendInc : [incidentCost], backgroundColor: '#ef4444' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, beginAtZero: true }
                },
                plugins: {
                    legend: { position: 'top' }
                }
            }
        });
    </script>
}
