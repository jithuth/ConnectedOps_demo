@page
@model ConnectedOps.Web.Pages.Reports.TcoModel
@{
    ViewData["Title"] = "Total Cost of Ownership (TCO)";
    ViewData["Subtitle"] = "Comprehensive lifecycle financial analysis: Acquisition, Fuel, Maintenance, and Safety costs per vehicle";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h1 class="m-0 text-dark fw-bold">Total Cost of Ownership (TCO)</h1>
                <p class="text-muted small mb-0">Understand true asset lifecycle costs, cost-per-kilometer, and capital efficiency</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="./Dashboard" class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-arrow-left"></i>
                    <span>Executive BI</span>
                </a>
                <a asp-page-handler="Export" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-download"></i>
                    <span>Export TCO (CSV)</span>
                </a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Start Date</label>
                        <input type="date" name="StartDate" class="form-control form-control-sm" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">End Date</label>
                        <input type="date" name="EndDate" class="form-control form-control-sm" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-4">
                        <span class="small fw-semibold text-muted d-block mb-1">Quick Presets</span>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(30)">Last 30D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(90)">Last 90D</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterDates(365)">Last 1 Year</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="setFilterAll()">All Time</button>
                        </div>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-filter"></i> Apply
                        </button>
                        <a asp-page="./Tco" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- TCO SUMMARY CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-dark text-white">
                    <div class="card-body p-3">
                        <div class="text-white-50 small text-uppercase fw-semibold">Grand Total TCO</div>
                        <div class="fs-4 fw-bold my-1">$@Model.Report.GrandTotalTco.ToString("N0")</div>
                        <div class="small text-white-50">@Model.Report.Vehicles.Count Vehicles Analyzed</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-secondary text-white">
                    <div class="card-body p-3">
                        <div class="text-white-50 small text-uppercase fw-semibold">Acquisition (CapEx)</div>
                        <div class="fs-4 fw-bold my-1">$@Model.Report.GrandTotalAcquisition.ToString("N0")</div>
                        <div class="small text-white-50">Purchase / Lease</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-primary text-white">
                    <div class="card-body p-3">
                        <div class="text-white-50 small text-uppercase fw-semibold">Fuel Spent</div>
                        <div class="fs-4 fw-bold my-1">$@Model.Report.GrandTotalFuel.ToString("N0")</div>
                        <div class="small text-white-50">Operating Fuel</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-warning text-dark">
                    <div class="card-body p-3">
                        <div class="text-dark small text-uppercase fw-semibold">Maintenance</div>
                        <div class="fs-4 fw-bold my-1">$@Model.Report.GrandTotalMaintenance.ToString("N0")</div>
                        <div class="small text-dark text-opacity-75">Parts &amp; Labor</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-danger text-white">
                    <div class="card-body p-3">
                        <div class="text-white-50 small text-uppercase fw-semibold">Incident Damage</div>
                        <div class="fs-4 fw-bold my-1">$@Model.Report.GrandTotalIncidents.ToString("N0")</div>
                        <div class="small text-white-50">Collisions &amp; Safety</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-info text-dark">
                    <div class="card-body p-3">
                        <div class="text-dark small text-uppercase fw-semibold">Avg Fleet $/km</div>
                        <div class="fs-4 fw-bold my-1">$@Model.Report.OverallCostPerKm.ToString("F3")</div>
                        <div class="small text-dark text-opacity-75">Operating Cost / km</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHARTS SECTION -->
        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Top Vehicles by Operational Expenditure</h6>
                        <span class="badge bg-light text-dark">Fuel + Maint + Incidents</span>
                    </div>
                    <div class="card-body p-3">
                        <div style="position: relative; height: 280px; width: 100%;">
                            <canvas id="topTcoVehiclesChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0">
                        <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-success me-2"></i>TCO Component Share</h6>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
                        <div style="position: relative; height: 250px; width: 100%;">
                            <canvas id="tcoShareChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DETAILED TCO DATA TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-table text-primary me-2"></i>Detailed Vehicle TCO Breakdown</h6>
                <div class="d-flex align-items-center gap-2">
                    <input type="text" id="tableSearch" class="form-control form-control-sm" placeholder="Search vehicle..." style="width: 200px;" onkeyup="filterTcoTable()" />
                    <span class="badge bg-light text-dark border">@Model.Report.Vehicles.Count items</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small" id="tcoTable">
                    <thead class="table-light">
                        <tr>
                            <th>Vehicle</th>
                            <th>Category</th>
                            <th class="text-end">Acquisition</th>
                            <th class="text-end">Fuel Cost</th>
                            <th class="text-end">Maint Cost</th>
                            <th class="text-end">Incident Cost</th>
                            <th class="text-end">Operating Cost</th>
                            <th class="text-end">Total TCO</th>
                            <th class="text-end">Odometer</th>
                            <th class="text-end">Cost / km</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Report.Vehicles.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-4 text-muted">No vehicles matching the selected filter criteria.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var v in Model.Report.Vehicles)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@v.LicensePlate</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@v.Make @v.Model @(v.Year > 0 ? $"({v.Year})" : "")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@v.CategoryName</span>
                                    </td>
                                    <td class="text-end text-muted">$@v.AcquisitionPrice.ToString("N0")</td>
                                    <td class="text-end text-primary fw-semibold">$@v.FuelCost.ToString("N0")</td>
                                    <td class="text-end text-warning fw-semibold">$@v.MaintenanceCost.ToString("N0")</td>
                                    <td class="text-end text-danger fw-semibold">$@v.IncidentCost.ToString("N0")</td>
                                    <td class="text-end fw-semibold text-dark">$@v.TotalOperatingCost.ToString("N2")</td>
                                    <td class="text-end fw-bold text-dark fs-6">$@v.TotalTco.ToString("N2")</td>
                                    <td class="text-end text-muted">@v.OdometerKm.ToString("N0") km</td>
                                    <td class="text-end">
                                        <span class="badge @(v.CostPerKm > 2.0m ? "bg-danger" : v.CostPerKm > 1.0m ? "bg-warning text-dark" : "bg-success")">
                                            $@v.CostPerKm.ToString("F3")/km
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/Vehicles/Details?id=@v.VehicleId" class="btn btn-xs btn-outline-secondary btn-sm" title="View Vehicle Details">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        function setFilterDates(days) {
            const end = new Date();
            const start = new Date();
            start.setDate(end.getDate() - days);
            document.querySelector('input[name="StartDate"]').value = start.toISOString().split('T')[0];
            document.querySelector('input[name="EndDate"]').value = end.toISOString().split('T')[0];
        }

        function setFilterAll() {
            document.querySelector('input[name="StartDate"]').value = '';
            document.querySelector('input[name="EndDate"]').value = '';
        }

        function filterTcoTable() {
            const input = document.getElementById("tableSearch");
            const filter = input.value.toLowerCase();
            const table = document.getElementById("tcoTable");
            const tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                const td = tr[i].getElementsByTagName("td")[0];
                if (td) {
                    const txtValue = td.textContent || td.innerText;
                    tr[i].style.display = txtValue.toLowerCase().indexOf(filter) > -1 ? "" : "none";
                }
            }
        }

        // Top TCO Horizontal Bar Chart
        const topLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.Vehicles.OrderByDescending(x => x.TotalOperatingCost).Take(8).Select(x => x.LicensePlate)));
        const fuelData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.Vehicles.OrderByDescending(x => x.TotalOperatingCost).Take(8).Select(x => x.FuelCost)));
        const maintData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.Vehicles.OrderByDescending(x => x.TotalOperatingCost).Take(8).Select(x => x.MaintenanceCost)));
        const incidentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Report.Vehicles.OrderByDescending(x => x.TotalOperatingCost).Take(8).Select(x => x.IncidentCost)));

        const topCtx = document.getElementById('topTcoVehiclesChart').getContext('2d');
        new Chart(topCtx, {
            type: 'bar',
            data: {
                labels: topLabels,
                datasets: [
                    { label: 'Fuel ($)', data: fuelData, backgroundColor: '#3b82f6' },
                    { label: 'Maintenance ($)', data: maintData, backgroundColor: '#f59e0b' },
                    { label: 'Incidents ($)', data: incidentData, backgroundColor: '#ef4444' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, beginAtZero: true }
                },
                plugins: {
                    legend: { position: 'top' }
                }
            }
        });

        // TCO Share Doughnut Chart
        const shareCtx = document.getElementById('tcoShareChart').getContext('2d');
        const acq = @Model.Report.GrandTotalAcquisition;
        const fuel = @Model.Report.GrandTotalFuel;
        const maint = @Model.Report.GrandTotalMaintenance;
        const inc = @Model.Report.GrandTotalIncidents;

        new Chart(shareCtx, {
            type: 'doughnut',
            data: {
                labels: ['Acquisition', 'Fuel', 'Maintenance', 'Incidents'],
                datasets: [{
                    data: [acq, fuel, maint, inc],
                    backgroundColor: ['#64748b', '#3b82f6', '#f59e0b', '#ef4444'],
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '60%'
            }
        });
    </script>
}
