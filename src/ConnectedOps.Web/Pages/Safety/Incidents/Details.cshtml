                            <select name="violationType" class="form-select form-select-sm">
                                <option value="Speeding">Speeding</option>
                                <option value="HarshBraking">Harsh Braking</option>
                                <option value="HarshAcceleration">Harsh Acceleration</option>
                                <option value="MobilePhoneUsage">Distracted / Mobile Phone</option>
                                <option value="SeatbeltNotFastened">Seatbelt Unfastened</option>
                                <option value="RedLightViolation">Red Light Violation</option>
                                <option value="Tailgating">Tailgating / Distance</option>
                                <option value="Other">Other Safety Violation</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Severity</label>
                            <select name="severity" class="form-select form-select-sm">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Driver</label>
                            <select name="driverId" class="form-select form-select-sm">
