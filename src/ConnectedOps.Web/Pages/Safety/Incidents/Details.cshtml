                                @foreach (var d in Model.DriversList)
                                {
                                    <option value="@d.Value">@d.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Occurred At</label>
                            <input type="datetime-local" name="occurredAtUtc" class="form-control form-control-sm" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description *</label>
                            <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="e.g. Exceeded speed limit by 25 km/h before impact" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm text-dark">Save Violation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD CORRECTIVE ACTION MODAL -->
<div class="modal fade" id="addActionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddAction">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-check2-circle text-success me-2"></i>Create Corrective Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Action Title *</label>
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="e.g. Schedule Defensive Driving Refresher" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Priority</label>
                            <select name="priority" class="form-select form-select-sm">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Due Date</label>
                            <input type="date" name="dueDateUtc" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(14).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Assignee (Employee)</label>
                            <select name="assignedEmployeeId" class="form-select form-select-sm">
                                <option value="">Select Assignee...</option>
                                @foreach (var emp in Model.EmployeesList)
                                {
                                    <option value="@emp.Value">@emp.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Description / Remediation Instructions *</label>
                            <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="Describe the specific action items required..." required></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="verificationRequired" value="true" id="chkVerifyA" checked>
                                <label class="form-check-label small fw-semibold" for="chkVerifyA">Requires Verification by Safety Officer</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm">Assign Action Item</button>
                </div>
            </form>
        </div>
    </div>
</div>
