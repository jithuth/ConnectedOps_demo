@page
@model ConnectedOps.Web.Pages.Safety.DashboardModel
@{
    ViewData["Title"] = "Fleet Safety & Incident Intelligence";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-shield-exclamation text-danger me-2"></i>Fleet Safety &amp; Incident Intelligence</h1>
                <p class="text-muted small mb-0">Incident tracking, safety risk analytics, driver violations, and corrective action workflows.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="/Safety/Incidents/Create" class="btn btn-danger btn-sm me-1">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i> Report Incident
                </a>
                <a href="/Safety/Violations" class="btn btn-outline-warning btn-sm me-1">
                    <i class="bi bi-cone-striped me-1"></i> Violations
                </a>
                <a href="/Safety/CorrectiveActions" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-check2-circle me-1"></i> Corrective Actions
                </a>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <!-- TOP KPI ROW -->
        <div class="row g-3 mb-4">
            <!-- Safety Score Card -->
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm rounded-3 h-100 bg-gradient text-white position-relative overflow-hidden"
                     style="background: linear-gradient(135deg, #111827 0%, #1f2937 100%);">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill">
                                    <i class="bi bi-speedometer2 me-1"></i> Fleet Safety Score
                                </span>
                                @{
                                    var riskBadge = Model.Dashboard.OverallRiskLevel switch
                                    {
                                        ConnectedOps.Domain.Safety.SafetyRiskLevel.Low => "bg-success text-white",
                                        ConnectedOps.Domain.Safety.SafetyRiskLevel.Medium => "bg-warning text-dark",
                                        ConnectedOps.Domain.Safety.SafetyRiskLevel.High => "bg-danger text-white",
                                        _ => "bg-dark text-white border border-danger"
                                    };
                                }
                                <span class="badge @riskBadge fw-bold px-3 py-1 rounded-pill">
                                    Risk: @Model.Dashboard.OverallRiskLevel
                                </span>
                            </div>
                            <h2 class="display-3 fw-bold mb-0">@Model.Dashboard.SafetyScore<small class="fs-4 fw-normal opacity-75">/100</small></h2>
                            <p class="mb-0 opacity-75 mt-1">Algorithmic risk evaluation based on open incidents, critical severity, and unresolved violations.</p>
                        </div>

                        <div class="row g-2 mt-3 pt-3 border-top border-white border-opacity-25 text-center">
                            <div class="col-4">
                                <div class="small opacity-75">Incidents (Mo)</div>
                                <div class="fs-5 fw-bold">@Model.Dashboard.IncidentsThisMonth</div>
                            </div>
                            <div class="col-4 border-start border-white border-opacity-25">
                                <div class="small opacity-75">Near Misses</div>
                                <div class="fs-5 fw-bold">@Model.Dashboard.NearMissesThisMonth</div>
                            </div>
                            <div class="col-4 border-start border-white border-opacity-25">
                                <div class="small opacity-75">Open Actions</div>
                                <div class="fs-5 fw-bold text-warning">@Model.Dashboard.OpenCorrectiveActions</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Operational Incident Counters -->
            <div class="col-12 col-xl-8">
                <div class="row g-3 h-100">
                    <!-- Open Incidents -->
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-danger">
                            <div class="card-body p-3">
                                <span class="text-muted small text-uppercase fw-semibold">Open Incidents</span>
                                <h3 class="fw-bold mb-0 mt-1 text-danger">@Model.Dashboard.OpenIncidents</h3>
                                <small class="text-danger fw-semibold">@Model.Dashboard.CriticalIncidents Critical</small>
                            </div>
                        </div>
                    </div>

                    <!-- Open Violations -->
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
                            <div class="card-body p-3">
                                <span class="text-muted small text-uppercase fw-semibold">Open Violations</span>
                                <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.Dashboard.OpenViolations</h3>
                                <small class="text-muted">Driver infractions</small>
                            </div>
                        </div>
                    </div>

                    <!-- Overdue Actions -->
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-danger">
                            <div class="card-body p-3">
                                <span class="text-muted small text-uppercase fw-semibold">Overdue Actions</span>
                                <h3 class="fw-bold mb-0 mt-1 text-danger">@Model.Dashboard.OverdueCorrectiveActions</h3>
                                <small class="text-muted">Past target date</small>
                            </div>
                        </div>
                    </div>

                    <!-- Actions in Pipeline -->
                    <div class="col-6 col-md-3">
                        <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                            <div class="card-body p-3">
                                <span class="text-muted small text-uppercase fw-semibold">Corrective Actions</span>
                                <h3 class="fw-bold mb-0 mt-1 text-success">@Model.Dashboard.OpenCorrectiveActions</h3>
                                <small class="text-muted">In remediation</small>
                            </div>
                        </div>
                    </div>

                    <!-- Incident Severity Distribution -->
                    <div class="col-12 col-md-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-transparent border-0 pt-3 px-3">
                                <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart text-danger me-2"></i>Incidents by Severity</h6>
                            </div>
                            <div class="card-body p-3 pt-0">
                                @if (Model.Dashboard.IncidentsBySeverity.Count == 0)
                                {
                                    <span class="text-muted small">No incidents recorded.</span>
                                }
                                else
                                {
                                    @foreach (var sev in Model.Dashboard.IncidentsBySeverity)
                                    {
                                        var barColor = sev.Severity switch
                                        {
                                            ConnectedOps.Domain.Safety.SafetyIncidentSeverity.Critical => "bg-danger",
                                            ConnectedOps.Domain.Safety.SafetyIncidentSeverity.High => "bg-warning",
                                            ConnectedOps.Domain.Safety.SafetyIncidentSeverity.Moderate => "bg-info",
                                            _ => "bg-secondary"
                                        };
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between small mb-1">
                                                <span>@sev.SeverityName</span>
                                                <span class="fw-bold">@sev.Count</span>
                                            </div>
                                            <div class="progress" style="height: 5px;">
                                                <div class="progress-bar @barColor" style="width: @(Math.Min(100, sev.Count * 20))%"></div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Incident Type Breakdown -->
                    <div class="col-12 col-md-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-header bg-transparent border-0 pt-3 px-3">
                                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart text-primary me-2"></i>Incidents by Type</h6>
                            </div>
                            <div class="card-body p-3 pt-0">
                                @if (Model.Dashboard.IncidentsByType.Count == 0)
                                {
                                    <span class="text-muted small">No incidents recorded.</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var typ in Model.Dashboard.IncidentsByType)
                                        {
                                            <span class="badge bg-light text-dark border p-2">
                                                @typ.TypeName: <strong class="text-danger ms-1">@typ.Count</strong>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT INCIDENTS & VIOLATIONS ROW -->
        <div class="row g-3 mb-4">
            <!-- Recent Incidents -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-octagon text-danger me-2"></i>Recent Safety Incidents</h6>
                        <a href="/Safety/Incidents" class="small text-decoration-none">View All Incidents</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Dashboard.RecentIncidents.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-shield-check text-success fs-1 d-block mb-2"></i>
                                <span>No safety incidents logged. Safe operations!</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Incident #</th>
                                            <th>Type</th>
                                            <th>Severity</th>
                                            <th>Occurred</th>
                                            <th>Status</th>
                                            <th class="text-end pe-3">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var inc in Model.Dashboard.RecentIncidents)
                                        {
                                            var sevBadge = inc.Severity switch
                                            {
                                                ConnectedOps.Domain.Safety.SafetyIncidentSeverity.Critical => "bg-danger",
                                                ConnectedOps.Domain.Safety.SafetyIncidentSeverity.High => "bg-warning text-dark",
                                                ConnectedOps.Domain.Safety.SafetyIncidentSeverity.Moderate => "bg-info text-dark",
                                                _ => "bg-secondary"
                                            };

                                            var statusBadge = inc.Status switch
                                            {
                                                ConnectedOps.Domain.Safety.SafetyIncidentStatus.Closed => "bg-success-subtle text-success border border-success-subtle",
                                                ConnectedOps.Domain.Safety.SafetyIncidentStatus.UnderInvestigation => "bg-warning-subtle text-warning border border-warning-subtle",
                                                ConnectedOps.Domain.Safety.SafetyIncidentStatus.Open => "bg-danger-subtle text-danger border border-danger-subtle",
                                                _ => "bg-secondary-subtle text-secondary"
                                            };

                                            <tr>
                                                <td class="ps-3">
                                                    <a href="/Safety/Incidents/Details?id=@inc.Id" class="fw-bold text-decoration-none font-monospace">@inc.IncidentNumber</a>
                                                    <div class="small text-muted text-truncate" style="max-width: 200px;">@inc.Title</div>
                                                </td>
                                                <td><span class="small fw-semibold">@inc.IncidentType</span></td>
                                                <td><span class="badge @sevBadge">@inc.Severity</span></td>
                                                <td><span class="small text-muted">@inc.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</span></td>
                                                <td><span class="badge @statusBadge px-2 py-1">@inc.Status</span></td>
                                                <td class="text-end pe-3">
                                                    <a href="/Safety/Incidents/Details?id=@inc.Id" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.8rem;">
                                                        Hub
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Repeated Violations -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-transparent border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0"><i class="bi bi-cone-striped text-warning me-2"></i>Top Repeated Violations</h6>
                        <a href="/Safety/Violations" class="small text-decoration-none">View All</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Dashboard.TopRepeatedViolationTypes.Count == 0)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                                <span>No safety infractions recorded.</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Infraction Type</th>
                                            <th class="text-end pe-3">Occurrences</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in Model.Dashboard.TopRepeatedViolationTypes)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="fw-semibold small">@v.TypeName</div>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <span class="badge bg-warning-subtle text-warning fw-bold px-2 py-1">@v.Count</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
