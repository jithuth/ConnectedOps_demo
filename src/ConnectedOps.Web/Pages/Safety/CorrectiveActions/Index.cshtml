@page
@model ConnectedOps.Web.Pages.Safety.CorrectiveActions.IndexModel
@{
    ViewData["Title"] = "Corrective & Preventive Action Items (CAPA)";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-check2-circle text-success me-2"></i>Corrective &amp; Preventive Actions (CAPA)</h1>
                <p class="text-muted small mb-0">Central tracking for safety remediations, driver retraining, mechanical repairs, and policy updates.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#newActionModal">
                    <i class="bi bi-plus-circle me-1"></i> New Action Item
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTER CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="Title, description..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                        <select name="Status" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            <option value="Draft" selected="@(Model.Status?.ToString() == "Draft")">Draft</option>
                            <option value="Assigned" selected="@(Model.Status?.ToString() == "Assigned")">Assigned</option>
                            <option value="InProgress" selected="@(Model.Status?.ToString() == "InProgress")">In Progress</option>
                            <option value="Completed" selected="@(Model.Status?.ToString() == "Completed")">Completed</option>
                            <option value="Verified" selected="@(Model.Status?.ToString() == "Verified")">Verified</option>
                            <option value="Cancelled" selected="@(Model.Status?.ToString() == "Cancelled")">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Priority</label>
                        <select name="Priority" class="form-select form-select-sm">
                            <option value="">All Priorities</option>
                            <option value="Low" selected="@(Model.Priority?.ToString() == "Low")">Low</option>
                            <option value="Medium" selected="@(Model.Priority?.ToString() == "Medium")">Medium</option>
                            <option value="High" selected="@(Model.Priority?.ToString() == "High")">High</option>
                            <option value="Critical" selected="@(Model.Priority?.ToString() == "Critical")">Critical</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Assignee</label>
                        <select name="AssignedEmployeeId" class="form-select form-select-sm">
                            <option value="">All Assignees</option>
                            @foreach (var emp in Model.EmployeesList)
                            {
                                <option value="@emp.Value" selected="@emp.Selected">@emp.Text</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a href="/Safety/CorrectiveActions" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- ACTIONS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Actions.Items.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-check2-all text-success fs-1 d-block mb-3"></i>
                        <h5 class="fw-semibold text-muted">No Action Items Found</h5>
                        <p class="text-muted small">All corrective and preventive remediations are clear.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Action Item</th>
                                    <th>Linked Incident</th>
                                    <th>Priority</th>
                                    <th>Assignee</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Verification</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var act in Model.Actions.Items)
                                {
                                    var priBadge = act.Priority switch
                                    {
                                        ConnectedOps.Domain.Safety.CorrectiveActionPriority.Critical => "bg-danger",
                                        ConnectedOps.Domain.Safety.CorrectiveActionPriority.High => "bg-warning text-dark",
                                        ConnectedOps.Domain.Safety.CorrectiveActionPriority.Medium => "bg-info text-dark",
                                        _ => "bg-secondary"
                                    };

                                    var statusBadge = act.Status switch
                                    {
                                        ConnectedOps.Domain.Safety.CorrectiveActionStatus.Verified => "bg-success-subtle text-success border border-success-subtle",
                                        ConnectedOps.Domain.Safety.CorrectiveActionStatus.Completed => "bg-info-subtle text-info border border-info-subtle",
                                        ConnectedOps.Domain.Safety.CorrectiveActionStatus.InProgress => "bg-primary-subtle text-primary border border-primary-subtle",
                                        _ => "bg-secondary-subtle text-secondary"
                                    };

                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold small">@act.Title</div>
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">@act.Description</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(act.IncidentNumber))
                                            {
                                                <a href="/Safety/Incidents/Details?id=@act.SafetyIncidentId" class="small text-muted font-monospace text-decoration-none">
                                                    <i class="bi bi-link-45deg"></i>@act.IncidentNumber
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">General Policy</span>
                                            }
                                        </td>
                                        <td><span class="badge @priBadge">@act.Priority</span></td>
                                        <td><span class="small fw-semibold">@(act.AssignedEmployeeName ?? "Unassigned")</span></td>
                                        <td>
                                            <span class="small @(act.IsOverdue ? "text-danger fw-bold" : "")">
                                                @(act.DueDateUtc?.ToString("yyyy-MM-dd") ?? "-")
                                            </span>
                                            @if (act.IsOverdue)
                                            {
                                                <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Overdue</span>
                                            }
                                        </td>
                                        <td><span class="badge @statusBadge px-2 py-1">@act.Status</span></td>
                                        <td>
                                            @if (act.VerifiedAtUtc.HasValue)
                                            {
                                                <span class="badge bg-success-subtle text-success" title="Verified by @act.VerifiedByUserName"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                                            }
                                            else if (act.VerificationRequired)
                                            {
                                                <span class="badge bg-light text-dark border">Requires Signoff</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Not Required</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                @if (act.Status == ConnectedOps.Domain.Safety.CorrectiveActionStatus.Open)
                                                {
                                                    <form method="post" asp-page-handler="Start" asp-route-id="@act.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2">Start</button>
                                                    </form>
                                                }
                                                else if (act.Status == ConnectedOps.Domain.Safety.CorrectiveActionStatus.InProgress)
                                                {
                                                    <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#completeModal_@act.Id">
                                                        Complete
                                                    </button>
                                                }
                                                else if (act.Status == ConnectedOps.Domain.Safety.CorrectiveActionStatus.Completed && act.VerificationRequired && !act.VerifiedAtUtc.HasValue)
                                                {
                                                    <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#verifyModal_@act.Id">
                                                        Verify
                                                    </button>
                                                }
                                            </div>

                                            <!-- COMPLETE MODAL -->
                                            <div class="modal fade text-start" id="completeModal_@act.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form method="post" asp-page-handler="Complete" asp-route-id="@act.Id">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold"><i class="bi bi-check2-circle text-success me-2"></i>Complete Action Item</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Remediation Notes / Actions Taken</label>
                                                                    <textarea name="resolutionNotes" class="form-control form-control-sm" rows="3" placeholder="Describe actions performed to resolve the finding..." required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-success btn-sm">Mark Completed</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- VERIFY MODAL -->
                                            <div class="modal fade text-start" id="verifyModal_@act.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form method="post" asp-page-handler="Verify" asp-route-id="@act.Id">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold"><i class="bi bi-patch-check-fill text-success me-2"></i>Verify Remediation Sign-off</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-semibold">Verification Audit Remarks</label>
                                                                    <textarea name="verificationNotes" class="form-control form-control-sm" rows="3" placeholder="Verify evidence and confirm root cause addressed..." required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-success btn-sm">Sign-off &amp; Verify</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- NEW ACTION MODAL -->
<div class="modal fade" id="newActionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-check2-circle text-success me-2"></i>Create Corrective Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Action Title *</label>
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="e.g. Conduct Defensive Driving Training" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Priority</label>
                            <select name="priority" class="form-select form-select-sm">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Target Due Date</label>
                            <input type="date" name="dueDateUtc" class="form-control form-control-sm" value="@DateTime.UtcNow.AddDays(14).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Assigned Employee</label>
                            <select name="assignedEmployeeId" class="form-select form-select-sm">
                                <option value="">Select Assignee...</option>
                                @foreach (var emp in Model.EmployeesList)
                                {
                                    <option value="@emp.Value">@emp.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Action Description &amp; Scope *</label>
                            <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Specify corrective or preventive measures required..." required></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="verificationRequired" value="true" id="chkVer" checked>
                                <label class="form-check-label small fw-semibold" for="chkVer">Requires Safety Officer Verification</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm">Assign Action</button>
                </div>
            </form>
        </div>
    </div>
</div>
