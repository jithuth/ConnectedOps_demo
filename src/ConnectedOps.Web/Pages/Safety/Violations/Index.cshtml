@page
@model ConnectedOps.Web.Pages.Safety.Violations.IndexModel
@{
    ViewData["Title"] = "Safety Violations & Infractions Log";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row align-items-center mb-3">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold"><i class="bi bi-cone-striped text-warning me-2"></i>Safety Violations &amp; Infractions Log</h1>
                <p class="text-muted small mb-0">Record speeding, harsh maneuvers, seatbelt infractions, and telematics safety triggers.</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <button type="button" class="btn btn-warning btn-sm text-dark" data-bs-toggle="modal" data-bs-target="#newViolationModal">
                    <i class="bi bi-plus-circle me-1"></i> Log Manual Infraction
                </button>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- FILTER CARD -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchTerm" class="form-control" placeholder="Description, driver, ref..." value="@Model.SearchTerm">
                        </div>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Violation Type</label>
                        <select name="ViolationType" class="form-select form-select-sm">
                            <option value="">All Types</option>
                            <option value="Speeding" selected="@(Model.ViolationType?.ToString() == "Speeding")">Speeding</option>
                            <option value="HarshBraking" selected="@(Model.ViolationType?.ToString() == "HarshBraking")">Harsh Braking</option>
                            <option value="HarshAcceleration" selected="@(Model.ViolationType?.ToString() == "HarshAcceleration")">Harsh Acceleration</option>
                            <option value="Cornering" selected="@(Model.ViolationType?.ToString() == "Cornering")">Harsh Cornering</option>
                            <option value="MobilePhoneUsage" selected="@(Model.ViolationType?.ToString() == "MobilePhoneUsage")">Distracted Driving</option>
                            <option value="SeatbeltNotFastened" selected="@(Model.ViolationType?.ToString() == "SeatbeltNotFastened")">Seatbelt Not Fastened</option>
                            <option value="RedLightViolation" selected="@(Model.ViolationType?.ToString() == "RedLightViolation")">Red Light Violation</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Severity</label>
                        <select name="Severity" class="form-select form-select-sm">
                            <option value="">All Severities</option>
                            <option value="Low" selected="@(Model.Severity?.ToString() == "Low")">Low</option>
                            <option value="Medium" selected="@(Model.Severity?.ToString() == "Medium")">Medium</option>
                            <option value="High" selected="@(Model.Severity?.ToString() == "High")">High</option>
                            <option value="Critical" selected="@(Model.Severity?.ToString() == "Critical")">Critical</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Source</label>
                        <select name="Source" class="form-select form-select-sm">
                            <option value="">All Sources</option>
                            <option value="Telematics" selected="@(Model.Source?.ToString() == "Telematics")">Telematics</option>
                            <option value="Manual" selected="@(Model.Source?.ToString() == "Manual")">Manual Report</option>
                            <option value="Incident" selected="@(Model.Source?.ToString() == "Incident")">Incident Linked</option>
                            <option value="Inspection" selected="@(Model.Source?.ToString() == "Inspection")">QA Inspection</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a href="/Safety/Violations" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- VIOLATIONS TABLE -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                @if (Model.Violations.Items.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-shield-check text-success fs-1 d-block mb-3"></i>
                        <h5 class="fw-semibold text-muted">No Violations Found</h5>
                        <p class="text-muted small">No safety infractions on file matching your search criteria.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Violation Type</th>
                                    <th>Driver / Employee</th>
                                    <th>Vehicle</th>
                                    <th>Severity</th>
                                    <th>Source</th>
                                    <th>Occurred (UTC)</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.Violations.Items)
                                {
                                    var sevBadge = v.Severity switch
                                    {
                                        ConnectedOps.Domain.Safety.SafetyIncidentSeverity.Critical => "bg-danger",
                                        ConnectedOps.Domain.Safety.SafetyIncidentSeverity.High => "bg-warning text-dark",
                                        ConnectedOps.Domain.Safety.SafetyIncidentSeverity.Moderate => "bg-info text-dark",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold small text-warning">@v.ViolationType</div>
                                            @if (!string.IsNullOrEmpty(v.IncidentNumber))
                                            {
                                                <a href="/Safety/Incidents/Details?id=@v.SafetyIncidentId" class="small text-muted font-monospace text-decoration-none">
                                                    <i class="bi bi-link-45deg"></i>@v.IncidentNumber
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            <span class="small fw-semibold">@(v.DriverName ?? v.EmployeeName ?? "-")</span>
                                        </td>
                                        <td>
                                            <span class="small font-monospace">@(v.VehiclePlate ?? "-")</span>
                                        </td>
                                        <td><span class="badge @sevBadge">@v.Severity</span></td>
                                        <td><span class="badge bg-light text-dark border">@v.Source</span></td>
                                        <td><span class="small text-muted">@v.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</span></td>
                                        <td><span class="small text-truncate d-inline-block" style="max-width: 250px;">@v.Description</span></td>
                                        <td>
                                            @if (v.IsResolved)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Resolved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Open</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (!v.IsResolved)
                                            {
                                                <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#resolveModal_@v.Id" title="Resolve Violation">
                                                    <i class="bi bi-check2"></i> Resolve
                                                </button>

                                                <!-- RESOLVE MODAL -->
                                                <div class="modal fade text-start" id="resolveModal_@v.Id" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <form method="post" asp-page-handler="Resolve" asp-route-id="@v.Id">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title fw-bold"><i class="bi bi-check2-circle text-success me-2"></i>Resolve Safety Violation</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="mb-3">
                                                                        <label class="form-label small fw-semibold">Resolution Notes / Corrective Actions Taken</label>
                                                                        <textarea name="resolutionNotes" class="form-control form-control-sm" rows="3" placeholder="e.g. Driver coached on speed management; incident reviewed." required></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-success btn-sm">Mark Resolved</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- NEW VIOLATION MODAL -->
<div class="modal fade" id="newViolationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cone-striped text-warning me-2"></i>Log Safety Infraction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Infraction Type *</label>
                            <select name="violationType" class="form-select form-select-sm">
                                <option value="Speeding">Speeding</option>
                                <option value="HarshBraking">Harsh Braking</option>
                                <option value="HarshAcceleration">Harsh Acceleration</option>
                                <option value="Cornering">Harsh Cornering</option>
                                <option value="MobilePhoneUsage">Mobile Phone Usage / Distracted</option>
                                <option value="SeatbeltNotFastened">Seatbelt Not Fastened</option>
                                <option value="HoursOfServiceExceeded">Hours of Service (HOS) Exceeded</option>
                                <option value="UnauthorizedUsage">Unauthorized Vehicle Usage</option>
                                <option value="RedLightViolation">Red Light / Stop Sign Violation</option>
                                <option value="Tailgating">Tailgating / Inadequate Following Distance</option>
                                <option value="IdlingExcessive">Excessive Idling</option>
                                <option value="RouteDeviation">Route Deviation</option>
                                <option value="DocumentNonCompliance">Document Non-Compliance</option>
                                <option value="Other">Other Safety Infraction</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Severity</label>
                            <select name="severity" class="form-select form-select-sm">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Detection Source</label>
                            <select name="source" class="form-select form-select-sm">
                                <option value="Manual" selected>Manual Report / Supervisor Citation</option>
                                <option value="Telematics">Telematics / Geotab / CAN-Bus</option>
                                <option value="Inspection">QA Vehicle Inspection</option>
                                <option value="Audit">Safety Audit</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Date &amp; Time Occurred *</label>
                            <input type="datetime-local" name="occurredAtUtc" class="form-control form-control-sm" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Involved Driver</label>
                            <select name="driverId" class="form-select form-select-sm">
                                <option value="">Select Driver...</option>
                                @foreach (var d in Model.DriversList)
                                {
                                    <option value="@d.Value">@d.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Involved Vehicle</label>
                            <select name="vehicleId" class="form-select form-select-sm">
                                <option value="">Select Vehicle...</option>
                                @foreach (var v in Model.VehiclesList)
                                {
                                    <option value="@v.Value">@v.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold">Violation Description *</label>
                            <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Describe the safety event, telemetry reading, or observed violation..." required></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold">External Reference / Citation #</label>
                            <input type="text" name="reference" class="form-control form-control-sm" placeholder="e.g. POLICE-TICKET-88219" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm text-dark"><i class="bi bi-check-circle me-1"></i>Record Infraction</button>
                </div>
            </form>
        </div>
    </div>
</div>
