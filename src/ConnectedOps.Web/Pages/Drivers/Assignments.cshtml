@page "/Drivers/Assignments"
@model ConnectedOps.Web.Pages.Drivers.AssignmentsModel
@using ConnectedOps.Domain.Drivers
@{
    ViewData["Title"] = "Vehicle Assignments";
    ViewData["Subtitle"] = "Active driver-vehicle assignments, operator allocation, and eligibility verification";
}

<!-- ALERTS -->
@if (TempData["Feedback"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Feedback"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- HEADER & ACTION BAR -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-arrow-left-right text-primary me-2"></i>Fleet Vehicle Assignments</h4>
        <p class="text-secondary small mb-0">Manage authorized driver allocations to fleet vehicles with automatic compliance and eligibility verification.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newAssignmentModal">
            <i class="bi bi-plus-lg me-1"></i> New Assignment
        </button>
        <a href="/Drivers/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-people me-1"></i> Driver Directory
        </a>
    </div>
</div>

<!-- STATS ROW -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase">Active Assignments</div>
                    <div class="fs-3 fw-bold text-primary my-1">@Model.ActiveAssignments.Count</div>
                    <div class="text-muted small">Vehicles currently paired with drivers</div>
                </div>
                <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                    <i class="bi bi-truck fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase">Available Active Drivers</div>
                    <div class="fs-3 fw-bold text-success my-1">@Model.AvailableDrivers.Count(d => d.CurrentVehicleId == null)</div>
                    <div class="text-muted small">Ready for new vehicle allocation</div>
                </div>
                <div class="rounded-circle bg-success-subtle p-3 text-success">
                    <i class="bi bi-person-check-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 shadow-sm bg-body">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase">Active Fleet Units</div>
                    <div class="fs-3 fw-bold text-info my-1">@Model.AvailableVehicles.Count</div>
                    <div class="text-muted small">Total fleet pool available</div>
                </div>
                <div class="rounded-circle bg-info-subtle text-info p-3">
                    <i class="bi bi-speedometer2 fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ACTIVE ASSIGNMENTS TABLE -->
<div class="card border-0 shadow-sm bg-body">
    <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-primary">
            <i class="bi bi-list-check me-2"></i>Active Driver-Vehicle Assignments
            <span class="badge bg-secondary-subtle text-secondary ms-2">@Model.ActiveAssignments.Count Active</span>
        </h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.ActiveAssignments.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-arrow-left-right fs-1 text-secondary mb-2 d-block"></i>
                <h5>No active assignments</h5>
                <p class="small mb-3">All vehicles and authorized drivers are currently unassigned.</p>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newAssignmentModal">
                    Create First Assignment
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Driver</th>
                            <th>Vehicle</th>
                            <th>Type</th>
                            <th>Assigned Since</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.ActiveAssignments)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                            @(a.DriverDisplayName.Length > 0 ? a.DriverDisplayName[0].ToString() : "D")
                                        </div>
                                        <div>
                                            <a href="/Drivers/Details/@a.DriverId" class="fw-bold text-decoration-none">
                                                @a.DriverDisplayName
                                            </a>
                                            <div class="text-muted small">@a.DriverNumber</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <a href="/Vehicles/Details/@a.VehicleId" class="fw-bold text-decoration-none">
                                            @a.VehicleNumber
                                        </a>
                                        <div class="text-muted small">@a.VehicleDisplayName</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">@a.AssignmentType</span>
                                    @if (a.IsPrimary)
                                    {
                                        <span class="badge bg-primary-subtle text-primary ms-1">Primary</span>
                                    }
                                </td>
                                <td>
                                    <div>@a.AssignedFromUtc.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@a.AssignedFromUtc.ToString("HH:mm") UTC</div>
                                </td>
                                <td>
                                    <span class="badge bg-success">ACTIVE</span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2" data-bs-toggle="modal" data-bs-target="#endAssignmentModal"
                                            data-assignment-id="@a.Id" data-driver-name="@a.DriverDisplayName" data-vehicle-number="@a.VehicleNumber">
                                        <i class="bi bi-stop-circle me-1"></i> End
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- NEW ASSIGNMENT MODAL -->
<div class="modal fade" id="newAssignmentModal" tabindex="-1" aria-labelledby="newAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateAssignment">
                <div class="modal-header">
                    <h5 class="modal-title" id="newAssignmentModalLabel">New Driver-Vehicle Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Eligibility Alert Box -->
                    <div id="eligibilityBox" class="alert d-none mb-3" role="alert">
                        <div id="eligibilityContent"></div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold required">Select Driver</label>
                            <select id="assignDriverSelect" asp-for="AssignmentInput.DriverId" class="form-select" required>
                                <option value="">-- Choose Authorized Driver --</option>
                                @foreach (var d in Model.AvailableDrivers)
                                {
                                    <option value="@d.Id" selected="@(Model.AssignmentInput.DriverId == d.Id)">
                                        @d.DriverNumber - @d.DisplayName (@d.DriverType)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold required">Select Vehicle</label>
                            <select id="assignVehicleSelect" asp-for="AssignmentInput.VehicleId" class="form-select" required>
                                <option value="">-- Choose Fleet Vehicle --</option>
                                @foreach (var v in Model.AvailableVehicles)
                                {
                                    <option value="@v.Id">
                                        @v.VehicleNumber - @v.MakeName @v.ModelName (@v.StatusName)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold required">Assignment Type</label>
                            <select asp-for="AssignmentInput.AssignmentType" class="form-select" required>
                                @foreach (var t in Enum.GetValues<AssignmentType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold required">Assigned From (UTC)</label>
                            <input type="datetime-local" asp-for="AssignmentInput.AssignedFromUtc" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assigned To (Optional Scheduled End)</label>
                            <input type="datetime-local" asp-for="AssignmentInput.AssignedToUtc" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-4">
                            <div class="form-check">
                                <input type="checkbox" asp-for="AssignmentInput.IsPrimary" class="form-check-input" id="isPrimaryAssign" />
                                <label class="form-check-label" for="isPrimaryAssign">Primary Driver Assignment</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Notes / Operational Purpose</label>
                            <textarea asp-for="AssignmentInput.Notes" class="form-control" rows="2" placeholder="Assignment purpose, route notes, or equipment details..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="submitAssignmentBtn" class="btn btn-primary">Create Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- END ASSIGNMENT MODAL -->
<div class="modal fade" id="endAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EndAssignment">
                <input type="hidden" id="endAssignmentId" name="assignmentId" />
                <div class="modal-header">
                    <h5 class="modal-title">End Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        Ending vehicle assignment between driver <strong id="endDriverName"></strong> and vehicle <strong id="endVehicleNumber"></strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Return notes, vehicle handover condition..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">End Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const driverSelect = document.getElementById('assignDriverSelect');
            const vehicleSelect = document.getElementById('assignVehicleSelect');
            const eligibilityBox = document.getElementById('eligibilityBox');
            const eligibilityContent = document.getElementById('eligibilityContent');
            const submitBtn = document.getElementById('submitAssignmentBtn');

            async function checkEligibility() {
                const driverId = driverSelect.value;
                const vehicleId = vehicleSelect.value;

                if (!driverId || !vehicleId) {
                    eligibilityBox.classList.add('d-none');
                    return;
                }

                try {
                    const response = await fetch(`?handler=CheckEligibility&driverId=${driverId}&vehicleId=${vehicleId}`);
                    if (response.ok) {
                        const data = await response.json();
                        eligibilityBox.classList.remove('d-none');
                        if (data.isEligible) {
                            eligibilityBox.className = 'alert alert-success mb-3';
                            eligibilityContent.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i><strong>Eligible:</strong> Driver license and vehicle status are valid for this assignment.';
                            submitBtn.disabled = false;
                        } else {
                            eligibilityBox.className = 'alert alert-danger mb-3';
                            let reasons = '<ul>' + data.reasons.map(r => `<li>${r}</li>`).join('') + '</ul>';
                            eligibilityContent.innerHTML = '<i class="bi bi-exclamation-octagon-fill me-2"></i><strong>Ineligible:</strong>' + reasons;
                        }
                    }
                } catch (e) {
                    console.error("Eligibility check failed", e);
                }
            }

            driverSelect.addEventListener('change', checkEligibility);
            vehicleSelect.addEventListener('change', checkEligibility);

            const endModal = document.getElementById('endAssignmentModal');
            if (endModal) {
                endModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    document.getElementById('endAssignmentId').value = button.getAttribute('data-assignment-id');
                    document.getElementById('endDriverName').textContent = button.getAttribute('data-driver-name');
                    document.getElementById('endVehicleNumber').textContent = button.getAttribute('data-vehicle-number');
                });
            }
        });
    </script>
}
