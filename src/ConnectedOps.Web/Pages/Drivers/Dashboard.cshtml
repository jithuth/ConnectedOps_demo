@page "/Drivers/Dashboard"
@model ConnectedOps.Web.Pages.Drivers.DashboardModel
@{
    ViewData["Title"] = "Driver Intelligence Dashboard";
    ViewData["Subtitle"] = "Operational readiness, workforce availability, licensing compliance, and vehicle assignment metrics";
}

<!-- ACTION BAR -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>Driver Intelligence &amp; Readiness</h4>
        <p class="text-secondary small mb-0">Monitor operator licensing, active deployments, compliance expiries, and workforce status.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Drivers/Assignments" class="btn btn-outline-info btn-sm">
            <i class="bi bi-arrow-left-right me-1"></i> Assignment Board
        </a>
        <a href="/Drivers/Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-people me-1"></i> Driver Directory
        </a>
        <a href="/Drivers/Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Driver
        </a>
    </div>
</div>

<!-- PRIMARY METRICS ROW -->
<div class="row g-3 mb-4">
    <!-- Total Drivers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Total Drivers</div>
                    <div class="fs-2 fw-bold my-1 text-primary">@Model.Summary.TotalDrivers</div>
                    <div class="small text-muted"><span class="text-success fw-semibold">@Model.Summary.ActiveDrivers</span> active operators</div>
                </div>
                <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Available for Dispatch -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Available for Assignment</div>
                    <div class="fs-2 fw-bold my-1 text-success">@Model.Summary.AvailableDrivers</div>
                    <div class="small text-muted">Ready for vehicle allocation</div>
                </div>
                <div class="rounded-circle bg-success-subtle p-3 text-success">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Currently Assigned -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Assigned to Vehicles</div>
                    <div class="fs-2 fw-bold my-1 text-info">@Model.Summary.AssignedDrivers</div>
                    <div class="small text-muted">Active vehicle pairings</div>
                </div>
                <div class="rounded-circle bg-info-subtle p-3 text-info">
                    <i class="bi bi-truck fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Compliance / Expiries -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-body metric-card h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-bold text-uppercase">Compliance Attention</div>
                    <div class="fs-2 fw-bold my-1 @(Model.Summary.ExpiredLicenses + Model.Summary.ExpiredDocuments + Model.Summary.ExpiredCertifications > 0 ? "text-danger" : "text-muted")">
                        @(Model.Summary.ExpiredLicenses + Model.Summary.ExpiredDocuments + Model.Summary.ExpiredCertifications)
                    </div>
                    <div class="small text-muted">
                        <span class="text-warning fw-semibold">@(Model.Summary.LicensesExpiringSoon + Model.Summary.DocumentsExpiringSoon + Model.Summary.CertificationsExpiringSoon)</span> expiring soon (&le;30d)
                    </div>
                </div>
                <div class="rounded-circle @(Model.Summary.ExpiredLicenses + Model.Summary.ExpiredDocuments + Model.Summary.ExpiredCertifications > 0 ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary") p-3">
                    <i class="bi bi-exclamation-octagon-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECONDARY STATUS ROW -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">On Leave / Rest</div>
                    <div class="fs-4 fw-bold text-warning">@Model.Summary.OnLeaveDrivers</div>
                    <div class="text-muted small">Temporarily unavailable</div>
                </div>
                <div class="rounded bg-warning-subtle text-warning p-2">
                    <i class="bi bi-calendar-event fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Suspended</div>
                    <div class="fs-4 fw-bold text-danger">@Model.Summary.SuspendedDrivers</div>
                    <div class="text-muted small">Restricted from vehicle assignment</div>
                </div>
                <div class="rounded bg-danger-subtle text-danger p-2">
                    <i class="bi bi-shield-x fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-secondary small fw-semibold">Inactive / Terminated</div>
                    <div class="fs-4 fw-bold text-secondary">@Model.Summary.InactiveDrivers</div>
                    <div class="text-muted small">Archived driver records</div>
                </div>
                <div class="rounded bg-secondary-subtle text-secondary p-2">
                    <i class="bi bi-archive-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row g-4 mb-4">
    <!-- Drivers by Employment Type -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Drivers by Type</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="typeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Drivers by Status -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-pie-chart text-success me-2"></i>Status Breakdown</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Drivers by Branch -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt-fill text-info me-2"></i>Drivers by Branch</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; width: 100%; max-height: 220px;">
                    <canvas id="branchChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- EXPIRING COMPLIANCE & RECENT DRIVERS -->
<div class="row g-4">
    <!-- Upcoming Expiries & Compliance Attention -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Upcoming &amp; Expired Compliance Items
                </h6>
                <span class="badge bg-danger-subtle text-danger">@Model.Summary.UpcomingExpiries.Count Item(s)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Summary.UpcomingExpiries.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-shield-check fs-1 text-success mb-2 d-block"></i>
                        <p class="mb-0">All driver licenses, medical cards, and certifications are fully compliant.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Driver</th>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Expiry Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Summary.UpcomingExpiries)
                                {
                                    <tr>
                                        <td class="fw-bold">
                                            <a href="/Drivers/Details/@item.DriverId" class="text-decoration-none">
                                                @item.DriverName
                                            </a>
                                            <div class="text-muted small">@item.DriverNumber</div>
                                        </td>
                                        <td>@item.ItemTitle</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@item.ItemType</span></td>
                                        <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (item.IsExpired)
                                            {
                                                <span class="badge bg-danger">EXPIRED</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@item.DaysRemaining days left</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Drivers -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-body h-100">
            <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Recently Registered Drivers
                </h6>
                <a href="/Drivers/Index" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Summary.RecentDrivers.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-people fs-1 mb-2 d-block"></i>
                        <p class="mb-0">No drivers registered yet.</p>
                        <a href="/Drivers/Create" class="btn btn-primary btn-sm mt-3">Add Your First Driver</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Driver</th>
                                    <th>Type</th>
                                    <th>Branch</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Summary.RecentDrivers)
                                {
                                    <tr>
                                        <td>
                                            <a href="/Drivers/Details/@d.Id" class="fw-bold text-decoration-none">
                                                @d.DisplayName
                                            </a>
                                            <div class="text-muted small">@d.DriverNumber</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@d.DriverType</span></td>
                                        <td>@(d.BranchName ?? "—")</td>
                                        <td>
                                            @switch (d.Status)
                                            {
                                                case ConnectedOps.Domain.Drivers.DriverStatus.Active:
                                                    <span class="badge bg-success-subtle text-success">Active</span>
                                                    break;
                                                case ConnectedOps.Domain.Drivers.DriverStatus.OnLeave:
                                                    <span class="badge bg-warning-subtle text-warning">On Leave</span>
                                                    break;
                                                case ConnectedOps.Domain.Drivers.DriverStatus.Suspended:
                                                    <span class="badge bg-danger-subtle text-danger">Suspended</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary-subtle text-secondary">@d.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="/Drivers/Details/@d.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chartColors = [
                '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6',
                '#06b6d4', '#ec4899', '#6366f1', '#14b8a6', '#f97316'
            ];

            // Type Chart
            const typeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.DriversByType.Select(x => x.TypeName)));
            const typeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.DriversByType.Select(x => x.DriverCount)));
            if (typeLabels.length > 0) {
                new Chart(document.getElementById('typeChart'), {
                    type: 'doughnut',
                    data: {
                        labels: typeLabels,
                        datasets: [{
                            data: typeData,
                            backgroundColor: chartColors.slice(0, typeLabels.length)
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }

            // Status Chart
            const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.DriversByStatus.Select(x => x.StatusName)));
            const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.DriversByStatus.Select(x => x.DriverCount)));
            if (statusLabels.length > 0) {
                new Chart(document.getElementById('statusChart'), {
                    type: 'pie',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusData,
                            backgroundColor: ['#10b981', '#f59e0b', '#ef4444', '#64748b']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                    }
                });
            }

            // Branch Chart
            const branchLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.DriversByBranch.Select(x => x.BranchName)));
            const branchData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.DriversByBranch.Select(x => x.DriverCount)));
            if (branchLabels.length > 0) {
                new Chart(document.getElementById('branchChart'), {
                    type: 'bar',
                    data: {
                        labels: branchLabels,
                        datasets: [{
                            label: 'Drivers',
                            data: branchData,
                            backgroundColor: '#06b6d4'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}
