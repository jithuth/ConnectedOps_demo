                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Document</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- END ASSIGNMENT MODAL -->
<div class="modal fade" id="endAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="EndAssignment">
                <input type="hidden" id="endAssignmentId" name="assignmentId" />
                <div class="modal-header">
                    <h5 class="modal-title">End Vehicle Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Ending assignment with vehicle: <strong id="endVehicleNumber"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Optional notes on vehicle return condition..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">End Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const addCatModal = document.getElementById('addCategoryModal');
            if (addCatModal) {
                addCatModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    document.getElementById('categoryLicenseId').value = button.getAttribute('data-license-id');
                    document.getElementById('categoryLicenseNumber').textContent = button.getAttribute('data-license-number');
                });
            }

            const endModal = document.getElementById('endAssignmentModal');
            if (endModal) {
                endModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    document.getElementById('endAssignmentId').value = button.getAttribute('data-assignment-id');
                    document.getElementById('endVehicleNumber').textContent = button.getAttribute('data-vehicle-number');
                });
            }
        });
    </script>
}
