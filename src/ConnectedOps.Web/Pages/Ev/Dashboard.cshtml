@page
@model ConnectedOps.Web.Pages.Ev.DashboardModel
@using ConnectedOps.Domain.Ev
@{
    ViewData["Title"] = "Electric Vehicle (EV) Fleet & Smart Charging";
    ViewData["Subtitle"] = "Real-time battery telemetry, depot charging infrastructure, and off-peak tariff cost optimization";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
        <div>@Model.SuccessMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI METRIC CARDS -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm h-100 bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Monitored EV Fleet</span>
                    <h3 class="mb-0 fw-bold mt-1 text-primary">@Model.Dashboard.TotalEvCount</h3>
                    <div class="small text-secondary mt-1">
                        <i class="bi bi-lightning-charge-fill text-warning"></i> @Model.Dashboard.ActiveChargingCount currently charging
                    </div>
                </div>
                <div class="metric-icon bg-primary-subtle text-primary">
                    <i class="bi bi-ev-front fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm h-100 bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Avg State of Charge (SoC)</span>
                    <h3 class="mb-0 fw-bold mt-1 text-success">@Model.Dashboard.AverageSocPercent%</h3>
                    <div class="progress mt-2" style="height: 6px; width: 120px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.Dashboard.AverageSocPercent%"></div>
                    </div>
                </div>
                <div class="metric-icon bg-success-subtle text-success">
                    <i class="bi bi-battery-charging fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm h-100 bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Battery Health (SoH)</span>
                    <h3 class="mb-0 fw-bold mt-1 text-info">@Model.Dashboard.AverageSohPercent%</h3>
                    <div class="small text-secondary mt-1">
                        <i class="bi bi-shield-check text-success"></i> Fleet pack integrity: Optimal
                    </div>
                </div>
                <div class="metric-icon bg-info-subtle text-info">
                    <i class="bi bi-heart-pulse-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card border-0 shadow-sm h-100 bg-body">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">CO2 Offset & Energy</span>
                    <h3 class="mb-0 fw-bold mt-1 text-success">@Model.Dashboard.TotalCo2SavedKg.ToString("N0") <span class="fs-6 fw-normal text-secondary">kg</span></h3>
                    <div class="small text-secondary mt-1">
                        <i class="bi bi-plug-fill text-warning"></i> @Model.Dashboard.TotalEnergyDeliveredKwh.ToString("N1") kWh delivered
                    </div>
                </div>
                <div class="metric-icon bg-success-subtle text-success">
                    <i class="bi bi-tree-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ACTIONS TOOLBAR -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-0">Depot Charging Stations & Infrastructure</h5>
        <span class="text-secondary small">Manage live chargers, high-power DC fast stations, and peak/off-peak pricing</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#newStationModal">
            <i class="bi bi-plus-circle me-1"></i> Register Station
        </button>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#startSessionModal">
            <i class="bi bi-plug-fill me-1"></i> Start Charging Session
        </button>
    </div>
</div>

<!-- CHARGING STATIONS GRID -->
<div class="row g-3 mb-4">
    @if (Model.Dashboard.Stations.Count == 0)
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm p-4 text-center bg-body">
                <i class="bi bi-ev-station fs-1 text-secondary mb-2"></i>
                <h6>No Charging Stations Registered</h6>
                <p class="text-secondary small mb-3">Register your first depot or partner charging station to begin smart energy scheduling.</p>
                <div>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#newStationModal">Register Station</button>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var station in Model.Dashboard.Stations)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 bg-body">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-primary-subtle text-primary mb-1">@station.Code</span>
                                <h6 class="fw-bold mb-0">@station.Name</h6>
                                <span class="text-secondary small"><i class="bi bi-geo-alt"></i> @(station.Address ?? "Depot Facility")</span>
                            </div>
                            <span class="badge @(station.AvailablePlugs > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-2 py-1">
                                <i class="bi bi-plug"></i> @station.AvailablePlugs / @station.TotalPlugs Plugs Free
                            </span>
                        </div>

                        <div class="bg-body-secondary rounded p-2 small my-2">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-secondary">Standard:</span>
                                <span class="fw-semibold">@station.ConnectorType</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-secondary">Max Power:</span>
                                <span class="fw-bold text-warning">@station.MaxPowerKw kW @(station.MaxPowerKw >= 50 ? "(DC Fast)" : "(AC)")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-secondary">Off-Peak Rate:</span>
                                <span class="fw-semibold text-success">$@station.OffPeakRatePerKwh.ToString("F2") / kWh</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-secondary">Peak Rate:</span>
                                <span class="fw-semibold text-danger">$@station.PeakRatePerKwh.ToString("F2") / kWh</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-muted small">Status: <strong class="text-success">Online &amp; Ready</strong></span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="prefillStation('@station.Id')">Plug-in EV</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- LIVE VEHICLE BATTERIES TABLE -->
<div class="card border-0 shadow-sm mb-4 bg-body">
    <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h6 class="fw-bold mb-0"><i class="bi bi-battery-half text-success me-2"></i>Live EV Battery Telemetry &amp; Health Telematics</h6>
            <span class="text-secondary small">Real-time SoC %, pack temperatures, smart charging thresholds, and battery life degradation</span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th>VEHICLE</th>
                        <th>BATTERY PACK</th>
                        <th>STATE OF CHARGE (SOC)</th>
                        <th>RANGE (EST)</th>
                        <th>TEMPERATURE</th>
                        <th>STATE OF HEALTH</th>
                        <th>STATUS</th>
                        <th class="text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Dashboard.Vehicles.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-secondary">
                                No EV battery telemetry records found. Telematics will stream automatically upon vehicle ignition or plug-in.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in Model.Dashboard.Vehicles)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@v.VehicleName</div>
                                    <span class="text-secondary font-monospace" style="font-size: 0.75rem;">VIN: @v.VehicleVin</span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@v.BatteryCapacityKwh.ToString("N0") kWh</span>
                                    <div class="text-secondary small">Cycles: @v.CycleCount</div>
                                </td>
                                <td style="min-width: 150px;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold @(v.StateOfChargePercent < 20 ? "text-danger" : v.StateOfChargePercent < 50 ? "text-warning" : "text-success")">
                                            @v.StateOfChargePercent%
                                        </span>
                                        <span class="text-secondary" style="font-size: 0.75rem;">Limit: @v.TargetSocLimitPercent%</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @(v.StateOfChargePercent < 20 ? "bg-danger" : v.StateOfChargePercent < 50 ? "bg-warning" : "bg-success")"
                                             role="progressbar" style="width: @v.StateOfChargePercent%"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@v.RemainingRangeKm.ToString("N0") km</span>
                                </td>
                                <td>
                                    <span class="badge @(v.BatteryPackTempCelsius > 45 ? "bg-danger-subtle text-danger" : v.BatteryPackTempCelsius > 35 ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success")">
                                        <i class="bi bi-thermometer-half"></i> @v.BatteryPackTempCelsius°C
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@v.StateOfHealthPercent%</span>
                                    <span class="badge bg-secondary-subtle text-secondary ms-1">@v.HealthCondition</span>
                                </td>
                                <td>
                                    @switch (v.ChargingStatus)
                                    {
                                        case EvChargingStatus.ChargingDcFast:
                                            <span class="badge bg-warning-subtle text-warning"><i class="bi bi-lightning-charge-fill"></i> DC Fast (@v.ActiveChargingPowerKw kW)</span>
                                            break;
                                        case EvChargingStatus.ChargingAc:
                                            <span class="badge bg-primary-subtle text-primary"><i class="bi bi-plug-fill"></i> AC Charging (@v.ActiveChargingPowerKw kW)</span>
                                            break;
                                        case EvChargingStatus.FullyCharged:
                                            <span class="badge bg-success-subtle text-success"><i class="bi bi-check-all"></i> Full</span>
                                            break;
                                        case EvChargingStatus.ConnectedIdle:
                                            <span class="badge bg-info-subtle text-info"><i class="bi bi-hourglass-split"></i> Idle Plugged</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary">Disconnected</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" onclick="configureSmartCharging('@v.VehicleId', @v.TargetSocLimitPercent, @(v.IsOffPeakOnlyCharging ? "true" : "false"))">
                                        <i class="bi bi-gear"></i> Smart Schedule
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ACTIVE SESSIONS TABLE -->
<div class="card border-0 shadow-sm bg-body mb-4">
    <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h6 class="fw-bold mb-0"><i class="bi bi-arrow-repeat text-warning me-2"></i>Active Charging Sessions</h6>
            <span class="text-secondary small">Real-time electricity metering, target SoC progress, and completion logging</span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th>SESSION ID</th>
                        <th>VEHICLE</th>
                        <th>STATION</th>
                        <th>START TIME</th>
                        <th>START SOC</th>
                        <th>SCHEDULED</th>
                        <th class="text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Dashboard.ActiveSessions.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3 text-secondary">No active charging sessions currently running.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model.Dashboard.ActiveSessions)
                        {
                            <tr>
                                <td class="font-monospace text-secondary">@s.Id.ToString()[..8]</td>
                                <td class="fw-bold">@s.VehicleVin</td>
                                <td>@s.StationName</td>
                                <td>@s.StartedAtUtc.ToString("g")</td>
                                <td><span class="badge bg-info-subtle text-info">@s.StartSocPercent%</span></td>
                                <td>
                                    @if (s.IsScheduled)
                                    {
                                        <span class="badge bg-warning-subtle text-warning"><i class="bi bi-clock"></i> Off-Peak Schedule</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">Immediate</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success" onclick="openCompleteSessionModal('@s.Id', @s.StartSocPercent)">
                                        <i class="bi bi-check-circle"></i> Complete Session
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: REGISTER STATION -->
<div class="modal fade" id="newStationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateStation">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-ev-station me-2"></i>Register Charging Station</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Station Code</label>
                            <input type="text" name="code" class="form-control form-control-sm" placeholder="e.g. CHG-DEPOT-01" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Station Name</label>
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Central Depot Fast Charger" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Station Type</label>
                            <select name="stationType" class="form-select form-select-sm">
                                <option value="@((int)ChargingStationType.DepotPrivate)">Depot Private</option>
                                <option value="@((int)ChargingStationType.PublicCommercial)">Public Commercial</option>
                                <option value="@((int)ChargingStationType.DestinationPartner)">Destination Partner</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Connector Type</label>
                            <select name="connectorType" class="form-select form-select-sm">
                                <option value="@((int)ChargingConnectorType.Ccs2)">CCS2 Combo (High-Power DC)</option>
                                <option value="@((int)ChargingConnectorType.TeslaNacs)">Tesla NACS</option>
                                <option value="@((int)ChargingConnectorType.Type2Menno)">Type 2 (Mennekes AC)</option>
                                <option value="@((int)ChargingConnectorType.Chademo)">CHAdeMO</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Max Power (kW)</label>
                            <input type="number" step="0.1" name="maxPowerKw" class="form-control form-control-sm" value="150" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Total Plugs</label>
                            <input type="number" name="totalPlugs" class="form-control form-control-sm" value="4" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Address / Location</label>
                            <input type="text" name="address" class="form-control form-control-sm" placeholder="e.g. 742 Evergreen Logistics Way" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Off-Peak Rate ($/kWh)</label>
                            <input type="number" step="0.01" name="offPeakRatePerKwh" class="form-control form-control-sm" value="0.12" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Peak Rate ($/kWh)</label>
                            <input type="number" step="0.01" name="peakRatePerKwh" class="form-control form-control-sm" value="0.32" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save Station</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: START SESSION -->
<div class="modal fade" id="startSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="StartSession">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plug-fill me-2"></i>Initiate Charging Session</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Select EV Vehicle</label>
                        <select name="vehicleId" class="form-select form-select-sm" required>
                            @foreach (var v in Model.Dashboard.Vehicles)
                            {
                                <option value="@v.VehicleId">@v.VehicleName (SoC: @v.StateOfChargePercent%)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Charging Station</label>
                        <select name="chargingStationId" id="sessionStationSelect" class="form-select form-select-sm" required>
                            @foreach (var s in Model.Dashboard.Stations)
                            {
                                <option value="@s.Id">@s.Name (@s.MaxPowerKw kW, Free: @s.AvailablePlugs)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Current State of Charge (SoC %)</label>
                        <input type="number" step="0.1" name="startSocPercent" class="form-control form-control-sm" value="35" min="0" max="100" required />
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isScheduled" value="true" id="isScheduledSwitch">
                        <label class="form-check-label small" for="isScheduledSwitch">Schedule for Off-Peak Tariff Window (23:00 - 06:00)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success">Plug-in &amp; Start</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: COMPLETE SESSION -->
<div class="modal fade" id="completeSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CompleteSession">
                <input type="hidden" name="sessionId" id="completeSessionId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-check2-all me-2"></i>Complete Charging Session</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Final State of Charge (SoC %)</label>
                        <input type="number" step="0.1" name="endSocPercent" id="completeEndSoc" class="form-control form-control-sm" value="95" min="0" max="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Energy Delivered (kWh)</label>
                        <input type="number" step="0.1" name="energyDeliveredKwh" class="form-control form-control-sm" value="48.5" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Calculated Total Cost ($)</label>
                        <input type="number" step="0.01" name="totalCost" class="form-control form-control-sm" value="8.73" min="0" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success">Save &amp; Unplug</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: SMART CHARGING CONFIG -->
<div class="modal fade" id="smartChargingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ConfigureSmartCharging">
                <input type="hidden" name="vehicleId" id="smartVehicleId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-sliders me-2"></i>Smart Charging &amp; Battery Longevity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target SoC Limit (% for Daily Routine)</label>
                        <input type="number" name="targetSocLimitPercent" id="smartTargetSoc" class="form-control form-control-sm" min="50" max="100" value="80" required />
                        <span class="text-secondary small">Restricting daily charge to 80% extends Li-ion battery lifecycle up to 3x.</span>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isOffPeakOnlyCharging" value="true" id="smartOffPeakOnly">
                        <label class="form-check-label small" for="smartOffPeakOnly">Enforce Off-Peak Tariff Only (reduces charging cost up to 60%)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Apply Policy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function prefillStation(stationId) {
        const select = document.getElementById('sessionStationSelect');
        if (select) select.value = stationId;
        const modal = new bootstrap.Modal(document.getElementById('startSessionModal'));
        modal.show();
    }

    function openCompleteSessionModal(sessionId, startSoc) {
        document.getElementById('completeSessionId').value = sessionId;
        document.getElementById('completeEndSoc').value = Math.min(100, Math.max(startSoc, 90));
        const modal = new bootstrap.Modal(document.getElementById('completeSessionModal'));
        modal.show();
    }

    function configureSmartCharging(vehicleId, targetSoc, offPeakOnly) {
        document.getElementById('smartVehicleId').value = vehicleId;
        document.getElementById('smartTargetSoc').value = targetSoc || 80;
        document.getElementById('smartOffPeakOnly').checked = offPeakOnly;
        const modal = new bootstrap.Modal(document.getElementById('smartChargingModal'));
        modal.show();
    }
</script>
}
